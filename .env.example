# Autamedica - Complete Environment Variables for Production
# Copy to .env.local and configure all required variables

# =============================================================================
# 🔧 SISTEMA - Variables de Sistema
# =============================================================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# 🔑 SEGURIDAD CRÍTICA - Variables Obligatorias
# =============================================================================
# JWT y Autenticación (generar strings de 64+ caracteres aleatorios)
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
NEXTAUTH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# =============================================================================
# 🗄️ BASE DE DATOS - Supabase (Configurado)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://qxjjrpksmwwrmubhvjew.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres.qxjjrpksmwwrmubhvjew:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# =============================================================================
# 🗄️ CACHE - Upstash Redis (Configurado)
# =============================================================================
REDIS_URL=ROTATE_THIS_rediss://default:TOKEN@YOUR_INSTANCE.upstash.io:6380
UPSTASH_REDIS_REST_URL=ROTATE_THIS_https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=ROTATE_THIS_UPSTASH_TOKEN

# =============================================================================
# 🌐 URLs Y DOMINIOS - Producción
# =============================================================================
# URLs Públicas (Cliente)
NEXT_PUBLIC_API_URL=https://api.autamedica.com
NEXT_PUBLIC_APP_URL=https://autamedica.com
NEXT_PUBLIC_VERCEL_URL=https://autamedica.com
NEXT_PUBLIC_DOCTORS_URL=https://doctor.autamedica.com
NEXT_PUBLIC_PATIENTS_URL=https://paciente.autamedica.com
NEXT_PUBLIC_COMPANIES_URL=https://empresa.autamedica.com

# URLs Internas (Servidor)
DOMAIN=autamedica.com
NEXTAUTH_URL=https://autamedica.com
ALLOWED_ORIGINS=https://autamedica.com,https://doctor.autamedica.com,https://paciente.autamedica.com,https://empresa.autamedica.com

# =============================================================================
# 📊 MONITORING - Sentry (Configurado)
# =============================================================================
PUBLIC_SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
SENTRY_ORG=autamedica
SENTRY_PROJECT=javascript-astro
SENTRY_AUTH_TOKEN=REPLACE_WITH_SENTRY_AUTH_TOKEN

# =============================================================================
# 🔐 reCAPTCHA - Protección (Configurado)
# =============================================================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LcMF7QrAAAAAOnF1JHDnxzPgGuwE6ZJtjaHSJL-
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_WEB=6LcMF7QrAAAAAOnF1JHDnxzPgGuwE6ZJtjaHSJL-
RECAPTCHA_SECRET_KEY=REPLACE_WITH_RECAPTCHA_SECRET_KEY
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY_IOS=REPLACE_WITH_IOS_KEY
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY_ANDROID=REPLACE_WITH_ANDROID_KEY

# =============================================================================
# 💳 PAGOS - MercadoPago LATAM
# =============================================================================
MERCADOPAGO_ACCESS_TOKEN=REPLACE_WITH_PRODUCTION_ACCESS_TOKEN
MERCADOPAGO_PUBLIC_KEY=REPLACE_WITH_PRODUCTION_PUBLIC_KEY
MERCADOPAGO_ENVIRONMENT=production
MERCADOPAGO_COUNTRY=AR
MERCADOPAGO_CURRENCY=ARS
MERCADOPAGO_WEBHOOK_URL=https://api.autamedica.com/api/v1/payments/mercadopago/webhook
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
# Test credentials (development only)
# MERCADOPAGO_TEST_ACCESS_TOKEN=TEST-YOUR_TEST_ACCESS_TOKEN
# MERCADOPAGO_TEST_PUBLIC_KEY=TEST-YOUR_TEST_PUBLIC_KEY

# =============================================================================
# 🤖 IA Y SERVICIOS EXTERNOS
# =============================================================================
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# ⚠️ CUIDADO: OpenAI en cliente (evaluar si es necesario)
# NEXT_PUBLIC_OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# ALLOW_CLIENT_OPENAI_KEY=true

# =============================================================================
# 🎥 TELEMEDICINA - WebRTC
# =============================================================================
# TURN Server
TURN_SERVER_URL=ROTATE_THIS_your-turn-server.example.com
TURN_SERVER_URLS=turn:ROTATE_THIS_your-turn-server.example.com:3478,turns:ROTATE_THIS_your-turn-server.example.com:5349
TURN_USERNAME=ROTATE_THIS_TURN_USERNAME
TURN_PASSWORD=ROTATE_THIS_TURN_PASSWORD
TURN_SECRET=ROTATE_THIS_TURN_SECRET_64_CHAR_HEX
TURN_REALM=turn.autamedica.com

# WebRTC Cliente
NEXT_PUBLIC_ICE_SERVERS=[{"urls":["turn:ROTATE_THIS_your-turn-server.example.com:3478"],"username":"ROTATE_THIS_USERNAME","credential":"ROTATE_THIS_PASSWORD"}]
NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302
NEXT_PUBLIC_WEBRTC_SIGNALING_URL=wss://api.autamedica.com
NEXT_PUBLIC_MEDIASOUP_URL=wss://api.autamedica.com

# Configuración Telemedicina
TELEMEDICINE_AI_PROVIDERS=openai,anthropic
TELEMEDICINE_VIDEO_CODEC=h264
TELEMEDICINE_ICE_POOL=10
TELEMEDICINE_CONN_TIMEOUT=30000
TELEMEDICINE_MAX_RECONNECT=5
TELEMEDICINE_RECORDING_FORMAT=webm
TELEMEDICINE_RECORDING_MAX=120
TELEMEDICINE_DATA_RETENTION_DAYS=30
ENABLE_CLOUD_RECORDING=false

# =============================================================================
# 📧 EMAIL Y COMUNICACIONES
# =============================================================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@autamedica.com
SMTP_PASS=REPLACE_WITH_APP_PASSWORD
FROM_EMAIL=admin@autamedica.com
FROM_NAME=AutaMedica

# WhatsApp Business (Opcional)
# WHATSAPP_BUSINESS_TOKEN=REPLACE_WITH_WHATSAPP_TOKEN
# WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_WEBHOOK_TOKEN

# =============================================================================
# 🗺️ MAPAS Y GEOLOCALIZACIÓN
# =============================================================================
PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_PRODUCTION_GOOGLE_MAPS_KEY
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=REPLACE_WITH_MAPBOX_TOKEN

# =============================================================================
# 🏥 COMPLIANCE MÉDICO - HIPAA
# =============================================================================
HIPAA_ENCRYPTION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
DATA_RETENTION_DAYS=2555
PHI_ENCRYPTION_ENABLED=true
PHI_ENCRYPTION_ALGORITHM=AES-256-GCM
AUDIT_LOG_RETENTION_DAYS=2555
ENCRYPTION_KEY_ROTATION_DAYS=90
RBAC_ENABLED=true
RATE_LIMIT_ENABLED=true
AUDIT_HASH_CHAIN_ENABLED=true

# =============================================================================
# 🚩 FEATURE FLAGS - Funcionalidades
# =============================================================================
NEXT_PUBLIC_AI_PREDICTOR_ENABLED=true
NEXT_PUBLIC_PATIENT_CRYSTAL_BALL_ENABLED=true
NEXT_PUBLIC_DIGITAL_PRESCRIPTION_ENABLED=true
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=true
NEXT_PUBLIC_MARKETPLACE_ENABLED=true
NEXT_PUBLIC_HOSPITAL_REDISTRIBUTION_ENABLED=true
NEXT_PUBLIC_WHATSAPP_BUSINESS_ENABLED=true
NEXT_PUBLIC_IOT_SENSORS_ENABLED=true
NEXT_PUBLIC_HOSPITAL_API_ENABLED=true
NEXT_PUBLIC_ADMIN_PANEL_ENABLED=true
NEXT_PUBLIC_PROMETHEUS_ENABLED=true
NEXT_PUBLIC_HIPAA_AUDIT_ENABLED=true
NEXT_PUBLIC_DATABASE_ADMIN_ENABLED=true
NEXT_PUBLIC_AUDIT_LOGS_ENABLED=true

# =============================================================================
# ⚡ PERFORMANCE Y ANALYTICS
# =============================================================================
ENABLE_ANALYTICS=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# =============================================================================
# ⚠️ VARIABLES QUE DEBES REEMPLAZAR ANTES DE PRODUCCIÓN
# =============================================================================
# 1. Todos los JWT_SECRET, ENCRYPTION_KEY, etc. (generar 64+ chars aleatorios)
# 2. MercadoPago Production Tokens
# 3. OpenAI/Anthropic API Keys
# 4. Google Maps Production Key
# 5. SMTP Password (App Password de Gmail)
# 6. Sentry Auth Token
# 7. reCAPTCHA Secret Keys
#
# Variables que requieren configuración en plataforma de deploy:
# → Supabase: Dashboard → Settings → API
# → Redis: Upstash console
# → TURN: servidor propio o servicio gestionado
# → Sentry: Dashboard → Settings → Auth Tokens
# → reCAPTCHA: Google reCAPTCHA Admin Console
# → MercadoPago: Portal de desarrolladores

# =============================================================================
# 🧾 FARMALINK - Receta Electronica / Homologacion
# =============================================================================
# No cargar credenciales del catalogo. Usar solo las credenciales OAuth entregadas por Farmalink Seguridad.
FARMALINK_ENABLED=false
FARMALINK_BASE_URL=https://test-servicios.farmalink.com.ar
FARMALINK_TOKEN_PATH=/api/oauth/token/generate
FARMALINK_RECETA_BASE_PATH=/api/recetaElect/v3
FARMALINK_GRANT_TYPE=PASSWORD
FARMALINK_SCOPE=Switch.RecetaElectRest
FARMALINK_OAUTH_USERNAME=
FARMALINK_OAUTH_PASSWORD=
FARMALINK_BASIC_USER=
FARMALINK_BASIC_PASSWORD=
FARMALINK_ORG_ID=182
FARMALINK_ORG_TYPE=NMD
# puntoEmisor must be omitted for the AutaMedica Farmalink account.
FARMALINK_IP_ORIGIN=
FARMALINK_BROWSER_INFO=AutaMedica
FARMALINK_PRESCRIPTION_TYPE=
FARMALINK_HOMOLOGATION_COD_ENTIDAD=
FARMALINK_HOMOLOGATION_CREDENCIAL=
FARMALINK_HOMOLOGATION_PLAN=NO POSEE
FARMALINK_DEFAULT_PRODUCT_CODE=
FARMALINK_DEFAULT_DRUG_CODE=
FARMALINK_PRESCRIBER_DOCUMENT_NUMBER=
FARMALINK_PRESCRIBER_BIRTH_DATE=
FARMALINK_PRESCRIBER_CUIL=
FARMALINK_PRESCRIBER_SEX=
FARMALINK_PRESCRIBER_LICENSE_TYPE=MN
FARMALINK_PRESCRIBER_LICENSE_PROVINCE=C
