#!/usr/bin/env sh
[ "$HUSKY" = "0" ] && exit 0

# Auto-sync Claude Code agents after merge
# This ensures agents are always up-to-date with agentic-config.json

echo "🤖 Syncing Claude Code agents..."

# Check if agentic-config.json changed
if git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD | grep -q "\.claude/agentic-config.json"; then
  echo "📝 agentic-config.json changed, re-registering agents..."
  node scripts/register-claude-agents.mjs
  # Registrar también agentes para ChatGPT/OpenAI
  node scripts/register-openai-agents.mjs || echo "⚠️  OpenAI agents sync failed"
  echo "✅ Agents synchronized!"
else
  echo "ℹ️  No agent config changes detected"
fi
