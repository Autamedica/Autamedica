#!/usr/bin/env sh
[ "$HUSKY" = "0" ] && exit 0

echo "🚀 Pre-push: Validaciones rápidas..."

# Si hay más de 100 archivos, skip (correrá en CI)
CHANGED_FILES=$(git diff --name-only origin/main...HEAD 2>/dev/null | wc -l)
if [ "$CHANGED_FILES" -gt 100 ]; then
  echo "⏭️  $CHANGED_FILES archivos cambiados — delegando a CI"
  exit 0
fi

# 1. SEO parity — verifica que sitemap y pages estén sincronizados
echo "🔎 Validando paridad SEO..."
pnpm seo:validate:parity || exit 1
pnpm seo:validate:assets || exit 1

# 2. Unit tests — atrapa tests rotos antes de que lleguen a CI
echo "🧪 Ejecutando tests unitarios..."
pnpm test:unit --run || {
  echo "❌ Tests unitarios fallaron. Corregir antes de push."
  exit 1
}

# 3. Turbo directory permissions (previene fallos opacos en CI local)
for TURBO_DIR in $(find . -maxdepth 3 -type d -name ".turbo" \
  -not -path "./node_modules/*" \
  -not -path "./apps/*/node_modules/*" \
  -not -path "./packages/*/node_modules/*" 2>/dev/null); do
  if [ ! -w "$TURBO_DIR" ]; then
    echo "❌ Sin permisos de escritura: $TURBO_DIR"
    echo "💡 Fix: sudo chown -R $(id -un):$(id -gn) $TURBO_DIR"
    exit 1
  fi
done

echo "✅ Pre-push OK — typecheck y build corren en CI"
