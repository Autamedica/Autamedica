#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔎 Pre-commit: Validaciones de código..."

# 1. Validar convenciones de nomenclatura (SSK_FAE/Router)
echo "📋 Validando convenciones (SSK_FAE, Router)..."
node scripts/validate-conventions.mjs || {
  echo "❌ Convenciones violadas. Ver errores arriba."
  exit 1
}

# 2. Verificar estructura de Router (no pages/)
echo "🗂️  Verificando App Router (no pages/)..."
if ls -d apps/**/pages 2>/dev/null | grep -v node_modules | grep .; then
  echo "❌ Se detectó directorio pages/ - AutaMedica usa App Router (app/)"
  exit 1
fi

# 3. Bloquear etiquetas de deuda técnica sin referencia en líneas staged
echo "🧾 Validando debt tags en staged..."
node scripts/ci/check-staged-debt.mjs || exit 1

# 4. Check if database-related files are being committed
DB_FILES=$(
  git diff --cached --name-only --diff-filter=ACMRTUXB -- \
    'supabase/**' \
    'docs/database/**' \
    'packages/types/src/supabase/database.types.ts' \
    'scripts/database-glossary/**' \
    2>/dev/null || true
)

if [ -n "$DB_FILES" ]; then
  echo "📊 Archivos de base de datos detectados, ejecutando validación..."
  # DB Glossary check (rápido)
  pnpm docs:db:ci || exit 1
  pnpm docs:db:check-diff || exit 1
  # Migration lint (solo staged)
  node scripts/ci/lint-migrations.mjs || exit 1
else
  echo "✅ No hay cambios en base de datos, omitiendo validación DB"
fi

# 5. Guard de drift tipos DB (migraciones + cambios apps/packages sin types)
node scripts/ci/check-db-type-drift.mjs || exit 1

# 6. Export validation — solo cuando cambian archivos de packages
PACKAGE_FILES=$(git diff --cached --name-only | grep -E "^packages/" || true)

if [ -n "$PACKAGE_FILES" ]; then
  echo "📝 Validando exports vs glosario (cambios en packages detectados)..."
  pnpm docs:validate || exit 1
else
  echo "✅ Sin cambios en packages, omitiendo validación de exports"
fi

# 7. Lint staged files
echo "🧹 Ejecutando lint en archivos staged..."
pnpm lint-staged || exit 1

echo "✅ Pre-commit validations passed!"
