#!/usr/bin/env sh
[ "$HUSKY" = "0" ] && exit 0

echo "🔎 Pre-commit: Validaciones de código..."

# 1. Convenciones de nomenclatura (PascalCase, snake_case, kebab-case)
echo "📋 Validando convenciones..."
node scripts/validate-conventions.mjs || {
  echo "❌ Convenciones violadas. Ver errores arriba."
  exit 1
}

# 2. Debt tags — bloquear deuda técnica sin referencia de ticket
echo "🧾 Validando debt tags en staged..."
node scripts/ci/check-staged-debt.mjs || exit 1

# 3. DB validation (solo si hay archivos de base de datos staged)
DB_FILES=$(
  git diff --cached --name-only --diff-filter=ACMRTUXB -- \
    'supabase/**' \
    'docs/database/**' \
    'packages/types/src/supabase/database.types.ts' \
    'scripts/database-glossary/**' \
    2>/dev/null || true
)

if [ -n "$DB_FILES" ]; then
  echo "📊 Archivos de base de datos detectados, ejecutando validación..."
  # DB Glossary check (rápido)
  pnpm docs:db:ci || exit 1
  pnpm docs:db:check-diff || exit 1
  # Migration lint (solo staged)
  node scripts/ci/lint-migrations.mjs || exit 1
else
  echo "✅ No hay cambios en base de datos, omitiendo validación DB"
fi

# 4. DB type drift guard
node scripts/ci/check-db-type-drift.mjs || exit 1

# 5. Lint staged files (ESLint + Prettier)
echo "🧹 Ejecutando lint en archivos staged..."
pnpm lint-staged || exit 1

echo "✅ Pre-commit validations passed!"
