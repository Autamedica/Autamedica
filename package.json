{
  "name": "autamedica-reboot",
  "private": true,
  "engines": {
    "node": ">=20.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "test:e2e": "node tests/run-playwright.cjs",
    "test:e2e:ui": "playwright test --ui",
    "test:doctor-videocall": "playwright test tests/e2e/doctor-video-call-flow.spec.ts --config=tests/e2e/playwright.doctor-videocall.config.ts",
    "test:doctor-videocall:headless": "playwright test tests/e2e/doctor-video-call-flow.spec.ts --config=tests/e2e/playwright.doctor-videocall.config.ts --headed=false",
    "test:doctor-videocall:report": "playwright test tests/e2e/doctor-video-call-flow.spec.ts --config=tests/e2e/playwright.doctor-videocall.config.ts --reporter=html,json",
    "test:doctor-videocall:ci": "./scripts/doctor-videocall-test-automation.sh --ci --headless --report",
    "test:doctor-videocall:git-flow": "node scripts/git-flow-doctor-videocall-test.js --ci --headless --report --notify",
    "test:signaling-e2e": "PATCHRIGHT_HEADLESS=0 patchright test -c tests/e2e/patchright.signaling.config.ts",
    "test:signaling-e2e:ci": "CI=1 PATCHRIGHT_HEADLESS=1 patchright test -c tests/e2e/patchright.signaling.config.ts",
    "test:signaling-e2e:headless": "PATCHRIGHT_HEADLESS=1 patchright test -c tests/e2e/patchright.signaling.config.ts",
    "test:rls": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/rls_core_tables.sql",
    "test:auth": "vitest run --config vitest.browser.config.ts",
    "test:auth:watch": "vitest --config vitest.browser.config.ts",
    "test:auth:ui": "vitest --config vitest.browser.config.ts --ui",
    "test:auth:browser": "vitest run --config vitest.browser.config.ts --browser.headless=false",
    "test:auth:debug": "vitest --config vitest.browser.config.ts --browser.headless=false",
    "test:auth:ci": "vitest run --config vitest.browser.config.ts --browser.headless=true",
    "test:auth:extensive": "vitest run tests/integration/auth-extensive.browser.test.ts --config vitest.browser.config.ts --browser.headless=false --reporter=verbose",
    "test:auth:extensive:watch": "vitest tests/integration/auth-extensive.browser.test.ts --config vitest.browser.config.ts --browser.headless=false --reporter=verbose",
    "release:org-roles": "./scripts/release-org-roles.sh",
    "build": "turbo run build",
    "build:packages": "pnpm run build:packages:core",
    "build:packages:core": "turbo run build --filter=@autamedica/types --filter=@autamedica/shared --filter=@autamedica/auth --filter=@autamedica/hooks --filter=@autamedica/session --filter=@autamedica/tailwind-config --filter=@autamedica/telemedicine --filter=@autamedica/ui --filter=@autamedica/scheduling --filter=@autamedica/prescriptions --filter=@autamedica/supabase-client --log-order stream",
    "build:packages-fallback": "cd packages/types && pnpm build && cd ../shared && pnpm build && cd ../auth && pnpm build && cd ../hooks && pnpm build",
    "build:apps": "turbo run build --filter='./apps/*'",
    "build:all": "bash scripts/build-all.sh build",
    "typecheck:all": "bash scripts/build-all.sh typecheck",
    "lint:all": "bash scripts/build-all.sh lint",
    "arch:v2:check": "node scripts/ci/check-architecture-v2.mjs",
    "arch:v2:changed": "node scripts/ci/check-architecture-v2.mjs --changed",
    "arch:v2:imports:changed": "node scripts/ci/check-architecture-v2-imports.mjs --changed",
    "dev": "turbo run dev --concurrency=20",
    "dev:videoconsulta": "turbo run dev --filter=@autamedica/signaling-server --filter=@autamedica/web --parallel",
    "lint": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint .",
    "lint:fix": "eslint . --fix",
    "watch:lint": "nodemon --watch 'apps/**/*.{ts,tsx}' --watch 'packages/**/*.{ts,tsx}' --ext ts,tsx --exec 'eslint .'",
    "depcruise": "depcruise -c .dependency-cruiser.cjs apps packages scripts",
    "dup": "jscpd --config .jscpd.json",
    "ci:quality": "pnpm -w lint && pnpm -w depcruise && pnpm -w dup",
    "typecheck": "turbo run typecheck",
    "type-check": "node scripts/type-check.mjs",
    "check-types": "turbo run check-types",
    "audit:api": "bun scripts/audit-api-routes.ts",
    "check:policy": "node scripts/check-policy.mjs",
    "check:prod": "node scripts/ensure-env.mjs && pnpm lint && pnpm -w type-check && pnpm build:packages && pnpm check:policy",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "routes:validate": "node scripts/validate-internal-routes.mjs",
    "seo:validate:parity": "node scripts/seo/validate-parity.mjs",
    "seo:validate:assets": "node scripts/seo/validate-social-assets.mjs",
    "types:analyze": "node scripts/analyze-type-duplication.mjs",
    "db:validate": "node scripts/validate-database-schema.mjs",
    "db:generate": "node scripts/generate-db-types.mjs",
    "db:sync": "node scripts/generate-db-types.mjs && node scripts/validate-database-schema.mjs",
    "db:test": "node scripts/test-db-generation.mjs",
    "types:db:gen": "supabase gen types typescript --project-id qxjjrpksmwwrmubhvjew --schema auth --schema growth_os --schema public > packages/types/src/supabase/database.types.ts && cp packages/types/src/supabase/database.types.ts packages/shared/src/types/database.types.ts && tsx scripts/postprocess-db-types.ts",
    "types:db:postprocess": "tsx scripts/postprocess-db-types.ts",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:sync:watch": "node scripts/docs-watch.mjs",
    "docs:db": "GLOSSARY_MODE=pg tsx scripts/database-glossary/cli/index.ts generate",
    "docs:db:ci": "GLOSSARY_MODE=sql tsx scripts/database-glossary/cli/index.ts generate",
    "docs:db:validate": "tsx scripts/database-glossary/cli/index.ts validate",
    "docs:db:test": "tsx scripts/database-glossary/cli/index.ts test",
    "docs:db:check-diff": "git diff --exit-code -- docs/database/_generated/ docs/database/schema.md || (echo '❌ DB Glossary desincronizado. Ejecutá pnpm docs:db' && exit 1)",
    "env:validate": "node scripts/validate-env.mjs",
    "env:validate:production": "node scripts/validate-production-values.mjs",
    "env:validate:staging": "node scripts/validate-staging.mjs",
    "env:validate:dev": "NODE_ENV=development node scripts/validate-env.mjs",
    "security:validate": "node scripts/validate-security-headers.mjs",
    "security:check": "node scripts/security-check.mjs",
    "security:audit": "pnpm audit --audit-level moderate",
    "security:full": "pnpm run security:check && pnpm run security:audit",
    "monitor:auth": "node scripts/auth-monitoring.js",
    "monitor:auth:watch": "node scripts/monitor-auth.mjs --watch",
    "setup:auth-hooks": "node scripts/apply-auth-hooks.js",
    "test:unit": "turbo run test:unit",
    "test": "turbo run test",
    "health": "node scripts/health-check.mjs",
    "policies:validate": "node scripts/validate-policies.mjs",
    "glossary:check": "node scripts/check-glossary.js",
    "hardcode:check": "node scripts/validate-no-hardcode.mjs",
    "ci:fix": "./scripts/fix-ci-autamedica",
    "pre-deploy": "pnpm run policies:validate && pnpm run hardcode:check && pnpm run lint && pnpm run type-check && pnpm run glossary:check",
    "start-claude": "node scripts/start-claude.mjs",
    "claude": "node scripts/start-claude.mjs",
    "agents:register": "node scripts/register-claude-agents.mjs && node scripts/register-openai-agents.mjs",
    "agents:list": "ls -lah ~/.claude/agents || true && ls -lah ~/.openai/agents || true",
    "agents:watch": "node scripts/watch-agents-config.mjs",
    "codex": "codex",
    "vscode": "./vscode-root.sh",
    "cursor": "./cursor-root.sh",
    "screenshot": "node scripts/visual-snapshot.js single",
    "screenshot:watch": "node scripts/visual-snapshot.js watch",
    "visual:snapshot": "pnpm screenshot",
    "visual:monitor": "pnpm screenshot:watch",
    "visual:analyze": "node scripts/visual-analyzer.js full",
    "visual:health": "node scripts/visual-analyzer.js health",
    "dev:watch": "concurrently \"pnpm dev\" \"pnpm watch:types\" \"pnpm watch:lint\"",
    "deploy:setup": "./scripts/deploy-setup.sh",
    "cloudflare:dns:reconcile": "node scripts/cloudflare/reconcile-pages-domains.mjs",
    "cloudflare:dns:audit": "node scripts/cloudflare/reconcile-pages-domains.mjs --audit --json",
    "cloudflare:dns:audit:secure": "bash scripts/cloudflare/cloudflare-dns-audit-secure.sh",
    "cloudflare:dns:cron": "bash scripts/cloudflare/cloudflare-dns-cron.sh",
    "cloudflare:dns:cron:install": "bash scripts/cloudflare/cloudflare-dns-cron-install.sh --install",
    "cloudflare:dns:cron:show": "bash scripts/cloudflare/cloudflare-dns-cron-install.sh --show",
    "cloudflare:dns:cron:uninstall": "bash scripts/cloudflare/cloudflare-dns-cron-install.sh --uninstall",
    "cloudflare:token:install": "bash scripts/cloudflare/cloudflare-token-install.sh",
    "cloudflare:token-flow": "bash scripts/cloudflare/cloudflare-token-flow.sh",
    "cloudflare:token-flow:tmux": "bash scripts/cloudflare/cloudflare-token-flow.sh --tmux --open-token-page",
    "deploy:web": "cd apps/web && pnpm build && wrangler pages deploy dist --project-name autamedica-web",
    "watch:types": "node scripts/watch-types.mjs",
    "check:all": "pnpm run lint && pnpm run type-check && pnpm run policies:validate",
    "check:staged:debt": "node scripts/ci/check-staged-debt.mjs",
    "lint:migrations:staged": "node scripts/ci/lint-migrations.mjs",
    "check:db:type-drift": "node scripts/ci/check-db-type-drift.mjs",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "changed:ts": "git diff --name-only --cached --diff-filter=ACMRTUXB | grep -E '\\.(ts|tsx)$' || true",
    "changed:js": "git diff --name-only --cached --diff-filter=ACMRTUXB | grep -E '\\.(js|jsx)$' || true",
    "lint:changed": "FILES=\"$(pnpm -s changed:ts) $(pnpm -s changed:js)\"; [ -z \"$FILES\" ] || eslint --max-warnings 0 $FILES",
    "typecheck:fast": "tsc -p tsconfig.json --noEmit",
    "prepush": "pnpm -s lint:changed && pnpm -s typecheck:fast",
    "ai:review": "bash scripts/ai-pr-review.sh",
    "smoke:all": "bash scripts/smoke-all.sh",
    "db:apply:ai": "bash scripts/db/apply-ai-personalization.sh",
    "db:probe": "node scripts/db/probe-supabase-schema.mjs",
    "dev:mobile": "pnpm -C apps/mobile start",
    "android:mobile": "pnpm -C apps/mobile android",
    "ios:mobile": "pnpm -C apps/mobile ios",
    "dev:web": "pnpm -C apps/web dev",
    "dev:newsletter-worker": "pnpm -C apps/newsletter-worker dev",
    "deploy:newsletter-worker": "pnpm -C apps/newsletter-worker deploy",
    "newsletter:sync-audience": "pnpm -C apps/newsletter-worker sync-audience",
    "newsletter:sync-audience:apply": "pnpm -C apps/newsletter-worker sync-audience:apply",
    "e2e:patients": "node scripts/e2e/patients-login.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^24.11.0",
    "@types/pg": "^8.18.0",
    "@types/react": "19.1.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "change-case": "^5.4.4",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^17.3.8",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^58.1.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "globby": "^11.1.0",
    "handlebars": "^4.7.8",
    "happy-dom": "^20.0.2",
    "husky": "^9.1.0",
    "jscpd": "^4.0.8",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.14",
    "patchright": "^1.58.2",
    "pg": "^8.19.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@google/generative-ai": "^0.24.1",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@supabase/supabase-js": "^2.98.0",
    "glob": "^11.1.0",
    "jose": "^6.1.3",
    "node-forge": "^1.4.0",
    "onnxruntime-web": "^1.24.2",
    "react-signature-canvas": "1.1.0-alpha.2",
    "turbo": "^2.8.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.2",
  "pnpm": {
    "overrides": {
      "@supabase/supabase-js": "^2.98.0",
      "vite": ">=8.0.5",
      "@vitejs/plugin-react": "^6.0.1",
      "baseline-browser-mapping": "^2.10.13",
      "browserslist": "^4.28.2",
      "caniuse-lite": "^1.0.30001784",
      "esbuild": "^0.28.1",
      "shell-quote": ">=1.8.4",
      "undici": ">=7.24.0",
      "cookie": "^0.7.0",
      "@types/react": "19.1.0",
      "@types/react-dom": "19.1.0",
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "vitest": "^4.1.6",
      "devalue": ">=5.8.1",
      "h3": ">=1.15.6",
      "rollup": ">=4.59.0",
      "update-browserslist-db": "^1.2.3",
      "wrangler": ">=4.59.1",
      "minimatch": ">=10.2.3",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "socket.io-parser": ">=4.2.6",
      "path-to-regexp": ">=0.1.12",
      "jws": ">=3.2.3",
      "svgo": ">=4.0.1",
      "crypto-js": ">=4.2.0",
      "dompurify": "3.4.1",
      "flatted": ">=3.4.2",
      "handlebars": ">=4.7.9",
      "fast-uri": ">=3.1.2",
      "happy-dom": ">=20.8.8",
      "lodash": "4.18.1",
      "@testing-library/jest-dom": "6.9.1",
      "yaml-language-server": "1.21.0",
      "@astrojs/check": "^0.9.8",
      "protobufjs": "7.5.6",
      "@xmldom/xmldom": ">=0.8.13"
    },
    "patchedDependencies": {
      "astro": "patches/astro.patch"
    }
  }
}
