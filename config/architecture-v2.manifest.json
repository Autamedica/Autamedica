      "id": "platform-core-imports",
      "fromDomain": "platform-core",
      "allowSameDomain": true,
      "allowContracts": [
        "platform-core-public",
        "clinical-core-public",
        "clinical-core-platform-composition",
        "adjacent-products-platform-composition"
