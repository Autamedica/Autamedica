{
  "name": "@autamedica/reminder-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "start:growth-agent": "bun src/growth-agent-worker.ts",
    "start:inbound": "bun src/inbound-watcher.ts",
    "start:adherence": "bun src/adherence-reminder.ts",
    "start:patient-whatsapp": "bun src/patient-whatsapp-worker.ts",
    "start:all": "bun src/index.ts & bun src/inbound-watcher.ts & bun src/adherence-reminder.ts & bun src/growth-agent-worker.ts",
    "dev": "bun --watch src/index.ts",
    "dev:growth-agent": "bun --watch src/growth-agent-worker.ts",
    "dev:inbound": "bun --watch src/inbound-watcher.ts",
    "dev:adherence": "bun --watch src/adherence-reminder.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@autamedica/prescriptions": "workspace:*",
    "@autamedica/scheduling": "workspace:*",
    "@autamedica/shared": "workspace:*",
    "@autamedica/types": "workspace:*",
    "@supabase/supabase-js": "^2.98.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^5.9.2"
  }
}
