    <!-- Psychiatry: TDAH Evaluation Screen -->
    <string name="tdah_screen_title">Escala TDAH (ASRS v1.1)</string>
    <string name="tdah_back_cd">Voltar</string>
    <string name="tdah_card_title">Rastreio Clínico de TDAH em Adultos</string>
    <string name="tdah_card_subtitle">Responda com base na sua experiência habitual nos últimos 6 meses. Este teste serve como orientação clínica e não substitui o diagnóstico psiquiátrico formal.</string>
    <string name="tdah_option_never">Nunca</string>
    <string name="tdah_option_rarely">Raramente</string>
    <string name="tdah_option_sometimes">Às vezes</string>
    <string name="tdah_option_often">Frequentemente</string>
    <string name="tdah_option_very_often">Muito frequentemente</string>
    <string name="tdah_question_1">Com que frequência tem dificuldade para finalizar os detalhes de um projeto?</string>
    <string name="tdah_question_2">Com que frequência tem dificuldade para colocar as coisas em ordem em tarefas de organização?</string>
    <string name="tdah_question_3">Com que frequência tem problemas para se lembrar de compromissos ou obrigações?</string>
    <string name="tdah_question_4">Quando tem uma tarefa que exige muito esforço mental, com que frequência a evita ou adia?</string>
    <string name="tdah_question_5">Com que frequência mexe ou balança as mãos ou os pés quando precisa permanecer sentado?</string>
    <string name="tdah_question_6">Com que frequência se sente excessivamente ativo ou impulsionado por um motor interno?</string>
    <string name="tdah_submit_button">Calcular e Guardar Avaliação</string>
    <string name="tdah_result_title">Resultado da Avaliação</string>
    <string name="tdah_result_high">Probabilidade ALTA de sintomas consistentes com TDAH no adulto (Pontuação: %1$d/24). Recomenda-se avaliação psiquiátrica formal.</string>
    <string name="tdah_result_moderate">Probabilidade MODERADA (Pontuação: %1$d/24). Sugere-se acompanhamento e registo de sintomas.</string>
    <string name="tdah_result_low">Baixa probabilidade de TDAH (Pontuação: %1$d/24). Critérios clínicos padrão não atingidos.</string>

