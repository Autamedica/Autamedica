<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ═══════════════════════════════════════════════
         Cruz medica de cristal cuantico con nucleo sinaptico
         Zona segura: 21-87 (66dp). Cruz: 27-81 (54dp).
         ═══════════════════════════════════════════════ -->

    <!-- Capa 1: Resplandor atmosferico difuso detras de la cruz -->
    <path android:pathData="M24,54 A30,30,0,1,1,84,54 A30,30,0,1,1,24,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30">
                <item android:offset="0" android:color="#35A78BFA"/>
                <item android:offset="0.4" android:color="#2038BDF8"/>
                <item android:offset="0.7" android:color="#100284C7"/>
                <item android:offset="1" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Capa 2: Cruz - relleno de cristal cuantico translucido -->
    <path android:pathData="M53,27 H55 A8,8,0,0,1,63,35 V45 H73 A8,8,0,0,1,81,53 V55 A8,8,0,0,1,73,63 H63 V73 A8,8,0,0,1,55,81 H53 A8,8,0,0,1,45,73 V63 H35 A8,8,0,0,1,27,55 V53 A8,8,0,0,1,35,45 H45 V35 A8,8,0,0,1,53,27 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="27"
                android:endX="81"
                android:endY="81">
                <item android:offset="0" android:color="#B0ffffff"/>
                <item android:offset="0.15" android:color="#30ffffff"/>
                <item android:offset="0.45" android:color="#0Dffffff"/>
                <item android:offset="0.75" android:color="#20ffffff"/>
                <item android:offset="1" android:color="#55ffffff"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Capa 3: Cruz - borde iridiscente (reflejo del cristal) -->
    <path
        android:pathData="M53,27 H55 A8,8,0,0,1,63,35 V45 H73 A8,8,0,0,1,81,53 V55 A8,8,0,0,1,73,63 H63 V73 A8,8,0,0,1,55,81 H53 A8,8,0,0,1,45,73 V63 H35 A8,8,0,0,1,27,55 V53 A8,8,0,0,1,35,45 H45 V35 A8,8,0,0,1,53,27 Z"
        android:fillColor="#00000000"
        android:strokeWidth="1">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27"
                android:startY="27"
                android:endX="81"
                android:endY="81">
                <item android:offset="0" android:color="#DDffffff"/>
                <item android:offset="0.3" android:color="#55C4B5FD"/>
                <item android:offset="0.7" android:color="#307DD3FC"/>
                <item android:offset="1" android:color="#88ffffff"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Capa 4: Nucleo sinaptico (motor bio-digital central) -->
    <path android:pathData="M36,54 A18,18,0,1,1,72,54 A18,18,0,1,1,36,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="18">
                <item android:offset="0" android:color="#FFffffff"/>
                <item android:offset="0.18" android:color="#EEA78BFA"/>
                <item android:offset="0.45" android:color="#AA38BDF8"/>
                <item android:offset="0.75" android:color="#4038BDF8"/>
                <item android:offset="1" android:color="#0038BDF8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Capa 5: Destello estelar vertical (precision quirurgica) -->
    <path
        android:pathData="M54,43 L54,65"
        android:fillColor="#00000000"
        android:strokeColor="#BBffffff"
        android:strokeWidth="1.5"/>

    <!-- Capa 6: Destello estelar horizontal -->
    <path
        android:pathData="M43,54 L65,54"
        android:fillColor="#00000000"
        android:strokeColor="#BBffffff"
        android:strokeWidth="1.5"/>
</vector>
