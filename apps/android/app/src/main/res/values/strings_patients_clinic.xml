    <!-- Psychiatry: TDAH Evaluation Screen -->
    <string name="tdah_screen_title">Escala TDAH (ASRS v1.1)</string>
    <string name="tdah_back_cd">Volver</string>
    <string name="tdah_card_title">Screening Clínico de TDAH en Adultos</string>
    <string name="tdah_card_subtitle">Responda con base en su experiencia habitual en los últimos 6 meses. Esta prueba sirve como orientación clínica y no reemplaza el diagnóstico psiquiátrico formal.</string>
    <string name="tdah_option_never">Nunca</string>
    <string name="tdah_option_rarely">Rara vez</string>
    <string name="tdah_option_sometimes">A veces</string>
    <string name="tdah_option_often">Frecuente</string>
    <string name="tdah_option_very_often">Muy frecuente</string>
    <string name="tdah_question_1">¿Con qué frecuencia tiene dificultad para terminar los detalles finales de un proyecto?</string>
    <string name="tdah_question_2">¿Con qué frecuencia tiene dificultad para ordenar las cosas en tareas organizativas?</string>
    <string name="tdah_question_3">¿Con qué frecuencia tiene problemas para recordar citas u obligaciones?</string>
    <string name="tdah_question_4">¿Cuándo tiene una tarea que requiere pensar mucho, con qué frecuencia la evita o posterga?</string>
    <string name="tdah_question_5">¿Con qué frecuencia mueve o retuerce las manos o los pies al tener que permanecer sentado?</string>
    <string name="tdah_question_6">¿Con qué frecuencia se siente demasiado activo o impulsado por un motor interno?</string>
    <string name="tdah_submit_button">Calcular y Guardar Evaluación</string>
    <string name="tdah_result_title">Resultado de la Evaluación</string>
    <string name="tdah_result_high">Probabilidad ALTA de síntomas consistentes con TDAH del adulto (Score: %1$d/24). Se recomienda evaluación psiquiátrica formal.</string>
    <string name="tdah_result_moderate">Probabilidad MODERADA (Score: %1$d/24). Sugerido seguimiento y registro de síntomas.</string>
    <string name="tdah_result_low">Baja probabilidad de TDAH (Score: %1$d/24). Criterios clínicos estándar no alcanzados.</string>

