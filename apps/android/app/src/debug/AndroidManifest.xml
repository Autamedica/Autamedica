<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Secondary QA-only launcher for sanitized crash evidence. -->
        <activity
            android:name=".QaDiagnosticsActivity"
            android:exported="true"
            android:label="AutaMedica QA Diagnóstico"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".service.DebugNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.autamedica.android.TEST_DISPATCH_NOTIFICATION" />
                <action android:name="com.autamedica.android.TEST_CALL_NOTIFICATION" />
                <action android:name="com.autamedica.android.CLEAR_ALL_NOTIFICATIONS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
