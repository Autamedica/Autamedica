<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#F0FDF4;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#DCFCE7;stop-opacity:1" />
            </linearGradient>
            <clipPath id="clip">
                <rect x="50" y="50" width="700" height="350" rx="40" />
            </clipPath>
        </defs>
        
        <rect width="800" height="450" fill="url(#grad)" />
        
        <!-- Background Patterns -->
        <g opacity="0.4">
            <circle cx="100" cy="100" r="80" fill="#22C55E" opacity="0.1" />
            <circle cx="700" cy="350" r="120" fill="#22C55E" opacity="0.05" />
            <path d="M0 450 L800 450 L800 400 Q400 300 0 400 Z" fill="white" opacity="0.5" />
        </g>

        <!-- Category Label -->
        <text x="400" y="380" font-family="Plus Jakarta Sans, sans-serif" font-size="12" font-weight="800" fill="#22C55E" text-anchor="middle" letter-spacing="4" opacity="0.6">ALERGOLOGÍA</text>
        
        <!-- Abstract Medical Icon -->
        <g transform="translate(0, -20)">
            <circle cx="400" cy="200" r="60" fill="white" opacity="0.8" />
            <path d="M380 200 Q400 150 420 200 T460 200" stroke="#22C55E" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="400" cy="200" r="80" stroke="#22C55E" stroke-width="1" fill="none" stroke-dasharray="4 8" opacity="0.3" />
        </g>

        <rect x="0" y="0" width="800" height="450" fill="none" stroke="white" stroke-width="20" opacity="0.2" />
    </svg>