# AutaMedica — Cache Control Headers for Cloudflare Pages
# Prevents stale content on mobile browsers after deploys.

# HTML pages: never cache (always fetch fresh from server)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Root and all pages (SSR routes): no cache
/
  Cache-Control: no-cache, no-store, must-revalidate
/patients/*
  Cache-Control: no-cache, no-store, must-revalidate
/doctors/*
  Cache-Control: no-cache, no-store, must-revalidate
/auth/*
  Cache-Control: no-cache, no-store, must-revalidate
/api/*
  Cache-Control: no-store

# Hashed assets (Vite/Astro generates unique filenames): cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets with content hashes: cache 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts: cache 1 year (they don't change)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images: cache 1 week (may update occasionally)
/images/*
  Cache-Control: public, max-age=604800

# Videos: cache 1 month
/videos/*
  Cache-Control: public, max-age=2592000
