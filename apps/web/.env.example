# AutaMedica - apps/web (Astro)
# Proyecto Supabase: qxjjrpksmwwrmubhvjew
# Obtener keys: https://supabase.com/dashboard/project/qxjjrpksmwwrmubhvjew/settings/api

PUBLIC_SUPABASE_URL=https://qxjjrpksmwwrmubhvjew.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Aliases NEXT_PUBLIC_* para compatibilidad con @autamedica/shared
NEXT_PUBLIC_SUPABASE_URL=https://qxjjrpksmwwrmubhvjew.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

PUBLIC_APP_URL=http://localhost:3000
PUBLIC_WHATSAPP_SUPPORT_URL=https://wa.me/5491168261552?text=Hola%20AutaMedica%20necesito%20soporte%20tecnico
PUBLIC_PATIENTS_URL=https://autamedica-patients.pages.dev
PUBLIC_COMPANIES_URL=https://autamedica-companies.pages.dev
PUBLIC_ADMIN_URL=https://autamedica-admin.pages.dev

# Landing copy variant opcional (a | b)
# PUBLIC_LANDING_COPY_VARIANT=a

# Signaling server para telemedicina WebRTC
# Dev local: ws://localhost:8888
# Produccion: wss://autamedica-signaling-server.<account>.workers.dev/signaling
PUBLIC_SIGNALING_URL=ws://localhost:8888

# Cloudflare Calls TURN — obtener en Cloudflare Dashboard > Calls > TURN Keys
# Necesario para videollamadas en redes restrictivas (NAT simetrico, firewalls)
CLOUDFLARE_CALLS_TURN_KEY_ID=
CLOUDFLARE_CALLS_TURN_TOKEN=

# Guest call tokens — HMAC-SHA256 secret (min 32 chars, generate with: openssl rand -hex 32)
GUEST_TOKEN_SECRET=

# IA para reportes SOAP post-consulta (al menos uno requerido para generacion)
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# MercadoPago — Billing & Subscriptions
# Obtener en https://www.mercadopago.com.ar/developers/panel/app/<app-id>/credentials
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Farmalink Receta Electronica — homologacion
# No cargar las credenciales del catalogo. Farmalink Seguridad debe entregar estas credenciales OAuth.
# Production AR issuance remains disabled until provider homologation AND
# successful verifiable doctor signature are independently evidenced.
# Never enable based on test/demo API responses or a local CUIR alone.
AR_RX_PRODUCTION_APPROVED=false
FARMALINK_ENABLED=false
FARMALINK_BASE_URL=https://test-servicios.farmalink.com.ar
FARMALINK_TOKEN_PATH=/api/oauth/token/generate
FARMALINK_RECETA_BASE_PATH=/api/recetaElect/v3
FARMALINK_GRANT_TYPE=PASSWORD
FARMALINK_SCOPE=Switch.RecetaElectRest
FARMALINK_OAUTH_USERNAME=
FARMALINK_OAUTH_PASSWORD=
FARMALINK_BASIC_USER=
FARMALINK_BASIC_PASSWORD=
FARMALINK_ORG_ID=182
FARMALINK_ORG_TYPE=NMD
# puntoEmisor must be omitted for the AutaMedica Farmalink account.
FARMALINK_IP_ORIGIN=
FARMALINK_BROWSER_INFO=AutaMedica
FARMALINK_PRESCRIPTION_TYPE=
FARMALINK_HOMOLOGATION_COD_ENTIDAD=
FARMALINK_HOMOLOGATION_CREDENCIAL=
FARMALINK_HOMOLOGATION_PLAN=NO POSEE
FARMALINK_DEFAULT_PRODUCT_CODE=
FARMALINK_DEFAULT_DRUG_CODE=
FARMALINK_PRESCRIBER_DOCUMENT_NUMBER=
FARMALINK_PRESCRIBER_BIRTH_DATE=
FARMALINK_PRESCRIBER_CUIL=
FARMALINK_PRESCRIBER_SEX=
FARMALINK_PRESCRIBER_LICENSE_TYPE=MN
FARMALINK_PRESCRIBER_LICENSE_PROVINCE=C
