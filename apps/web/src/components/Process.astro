---
const steps = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
    title: "Buscá tu especialidad",
    description: "Escribís lo que te pasa. Ves los médicos disponibles ahora mismo, con especialidad, años de experiencia y reseñas de otros pacientes."
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>`,
    title: "Elegís el horario que te cierra",
    description: "Hoy, mañana, en 20 minutos — vos elegís. No hay lista de espera ni secretaria que te dé turno para el mes que viene."
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15.6 11.6a1 1 0 0 1 0 1.4l-4.2 4.2a1 1 0 0 1-1.4 0l-2.2-2.2a1 1 0 0 1 0-1.4"/><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: "Consulta por videollamada",
    description: "Te conectás desde el celular o la computadora. Si ya consultaste antes, el médico ve tu historial y el contexto completo."
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg>`,
    title: "La receta llega al celular",
    description: "Terminando la consulta, la receta digital te llega al teléfono. La farmacia la acepta. No hay papel, no hay escáner."
  }
];
---

<section id="proceso" class="process" aria-label="Como funciona">
  <div class="process-inner">
    <div class="process-header animate-on-scroll">
      <h2 class="process-title">Así funciona, en serio</h2>
      <p class="process-subtitle">De buscar el médico a tener la receta. Sin llamar a nadie.</p>
    </div>

    <div class="process-timeline">
      <div class="timeline-line" aria-hidden="true"></div>
      {steps.map((step) => (
        <article class="step animate-on-scroll">
          <span class="step-icon" set:html={step.icon} />
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process {
    padding: var(--section-py) var(--section-px);
    background: var(--au-surface);
  }

  .process-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .process-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .process-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.03em;
  }

  .process-subtitle {
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
    margin: 0;
  }

  .process-timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    position: relative;
  }

  .timeline-line {
    position: absolute;
    top: 2.25rem;
    left: calc(12.5% + var(--space-6));
    right: calc(12.5% + var(--space-6));
    height: 1px;
    background: var(--au-border);
  }

  .step {
    position: relative;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--au-glass-border);
    background: var(--au-glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--au-glass-highlight);
    transition: all var(--au-transition-smooth);
  }

  .step:hover {
    border-color: var(--au-glass-border-hover);
    background: var(--au-glass-bg-hover);
    transform: translateY(-4px);
    box-shadow: var(--au-glass-shadow-hover);
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--au-accent-soft);
    border: 1px solid var(--au-border);
    color: var(--au-accent);
    margin-bottom: var(--space-4);
  }

  .step-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-2);
  }

  .step-desc {
    font-size: var(--text-sm);
    color: var(--au-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .process-timeline {
      grid-template-columns: repeat(2, 1fr);
    }

    .timeline-line {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .process-timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
