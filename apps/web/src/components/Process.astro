---
import { getI18n } from '../i18n';
const locale = Astro.locals.locale ?? 'es';
const { t, dict } = getI18n(locale);

const stepIcons = [
  `<svg width="24" height="24" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="14" stroke-opacity="0.2" stroke-width="1.5"/><circle cx="16" cy="16" r="9" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="2 3"/><path d="M16 1 L16 7 M16 25 L16 31 M1 16 L7 16 M25 16 L31 16" stroke-opacity="0.5" stroke-width="1.5"/><path d="M6.1 6.1 L8.2 8.2 M25.9 6.1 L23.8 8.2 M6.1 25.9 L8.2 23.8 M25.9 25.9 L23.8 23.8" stroke-opacity="0.35" stroke-width="1.5"/><path d="M16 11 L16 13 M16 19 L16 21 M11 16 L13 16 M19 16 L21 16" stroke="#38bdf8" stroke-width="1.5"/><circle cx="16" cy="16" r="2.5" fill="#38bdf8"/><path d="M16 5 A 11 11 0 0 1 27 16" stroke="#38bdf8" stroke-width="1.5"/><circle cx="27" cy="16" r="1.5" fill="#38bdf8"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="14" stroke-opacity="0.2" stroke-width="1.5"/><circle cx="16" cy="16" r="8" stroke-opacity="0.2" stroke-width="1"/><circle cx="16" cy="16" r="4" stroke-opacity="0.15" stroke-width="1" stroke-dasharray="2 2"/><path d="M16 2 L16 5 M16 27 L16 30 M2 16 L5 16 M27 16 L30 16" stroke-opacity="0.5" stroke-width="1.5"/><path d="M23 3.88 L22 5.61 M28.12 9 L26.39 10 M28.12 23 L26.39 22 M23 28.12 L22 26.39 M9 28.12 L10 26.39 M3.88 23 L5.61 22 M3.88 9 L5.61 10 M9 3.88 L10 5.61" stroke-opacity="0.3" stroke-width="1.5"/><circle cx="16" cy="16" r="1.5" fill="currentColor" fill-opacity="0.5"/><path d="M16 16 L16 9" stroke-opacity="0.5" stroke-width="1.5"/><path d="M16 16 L21.5 21.5" stroke-opacity="0.3" stroke-width="1.5"/><path d="M25.9 6.1 A 14 14 0 0 1 30 16" stroke="#38bdf8" stroke-width="2"/><circle cx="25.9" cy="6.1" r="2.5" fill="#ffffff"/><circle cx="25.9" cy="6.1" r="1.2" fill="#10b981"/><circle cx="30" cy="16" r="1.5" fill="#38bdf8"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M7 21l1.5-1.5h7L17 21" stroke-linecap="round" stroke-opacity="0.5"/><path d="M10.5 17v2.5M13.5 17v2.5" stroke-linecap="round" stroke-opacity="0.5"/><path d="M6 3h12l3 3v8l-3 3H6l-3-3V6l3-3z" stroke-opacity="0.7"/><circle cx="12" cy="10" r="3.5" stroke-opacity="0.4"/><path d="M9 10 Q12 8.5 15 10 Q12 11.5 9 10 Z" stroke-opacity="0.3" fill="none"/><circle cx="12" cy="10" r="1.25" fill="#38bdf8" stroke="none"/><circle cx="18" cy="6" r="0.75" fill="#38bdf8" stroke="none"/><path d="M7.5 6.8a5.5 5.5 0 0 0 0 6.4" stroke="#38bdf8" stroke-dasharray="0 3" stroke-linecap="round"/><path d="M16.5 6.8a5.5 5.5 0 0 1 0 6.4" stroke="#38bdf8" stroke-dasharray="0 3" stroke-linecap="round"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M6 4l2-2h6l5 5v13l-2 2H8l-2-2V4z" stroke-opacity="0.7"/><circle cx="9" cy="5" r="0.5" fill="currentColor" stroke="none"/><circle cx="11" cy="5" r="0.5" fill="currentColor" stroke="none"/><path d="M9 8h6M9 12h8M9 16h1.5M9 20h1.5" stroke-opacity="0.25" stroke-linecap="round"/><circle cx="15.5" cy="16.5" r="3.5" stroke="#10b981"/><circle cx="15.5" cy="16.5" r="2.5" stroke="#10b981" stroke-opacity="0.3"/><path d="M13.5 16.5h1l0.5-2l1 4l0.5-2h1" stroke="#10b981" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
];
const steps = dict.landing.process.steps.map((step, i) => ({
  ...step,
  icon: stepIcons[i] ?? '',
}));
---

<section id="proceso" class="process" aria-label="Como funciona">
  <div class="process-inner">
    <div class="process-header animate-on-scroll">
      <h2 class="process-title">{t('landing.process.title')}</h2>
      <p class="process-subtitle">{t('landing.process.subtitle')}</p>
    </div>

    <div class="process-timeline">
      <div class="timeline-line" aria-hidden="true"></div>
      {steps.map((step) => (
        <article class="step animate-on-scroll">
          <span class="step-icon" set:html={step.icon} />
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process {
    padding: var(--section-py) var(--section-px);
    background: var(--au-surface);
  }

  .process-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .process-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .process-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.03em;
  }

  .process-subtitle {
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
    margin: 0;
  }

  .process-timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    position: relative;
  }

  .timeline-line {
    position: absolute;
    top: 2.25rem;
    left: calc(12.5% + var(--space-6));
    right: calc(12.5% + var(--space-6));
    height: 1px;
    background: var(--au-border);
  }

  .step {
    position: relative;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--au-glass-border);
    background: var(--au-glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--au-glass-highlight);
    transition: all var(--au-transition-smooth);
  }

  .step:hover {
    border-color: var(--au-glass-border-hover);
    background: var(--au-glass-bg-hover);
    transform: translateY(-4px);
    box-shadow: var(--au-glass-shadow-hover);
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--au-accent-soft);
    border: 1px solid var(--au-border);
    color: var(--au-accent);
    margin-bottom: var(--space-4);
  }

  .step-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-2);
  }

  .step-desc {
    font-size: var(--text-sm);
    color: var(--au-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .process-timeline {
      grid-template-columns: repeat(2, 1fr);
    }

    .timeline-line {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .process-timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
