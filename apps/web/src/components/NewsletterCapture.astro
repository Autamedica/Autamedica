---
import { getI18n } from '../i18n';
const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);

interface Props {
  vertical?: string;
  intent?: string;
  formId?: string;
  title?: string;
  subtitle?: string;
  buttonLabel?: string;
  placeholder?: string;
  note?: string;
}

const { 
  vertical = 'general', 
  intent = 'newsletter',
  formId = 'newsletter',
  title = t('landing.newsletter.title'),
  subtitle = t('landing.newsletter.subtitle'),
  buttonLabel = t('landing.newsletter.button'),
  placeholder = t('landing.newsletter.placeholder'),
  note = t('landing.newsletter.note')
} = Astro.props;
---

<section class="newsletter-capture" aria-label="Lead Capture">
  <div class="newsletter-inner">
    <h2 class="newsletter-title">{title}</h2>
    <p class="newsletter-subtitle">{subtitle}</p>
    <form 
      id={`capture-form-${formId}`} 
      class="newsletter-form capture-form" 
      action="/api/growth-leads" 
      method="post"
      data-vertical={vertical}
      data-intent={intent}
      data-form-id={formId}
    >
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder={placeholder}
        class="newsletter-input"
      />
      <label class="newsletter-honeypot" aria-hidden="true">
        Empresa
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
      <button type="submit" class="newsletter-button">
        {buttonLabel}
      </button>
    </form>
    <p class="capture-status newsletter-status" aria-live="polite"></p>
    <p class="newsletter-note">{note}</p>
  </div>
</section>

<style>
  .newsletter-capture {
    padding: var(--section-py) var(--section-px);
    background: var(--au-bg);
  }

  .newsletter-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }

  .newsletter-subtitle {
    font-size: var(--text-base);
    color: var(--au-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-8);
  }

  .newsletter-form {
    display: flex;
    gap: var(--space-3);
    max-width: 440px;
    margin: 0 auto var(--space-4);
  }

  .newsletter-input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--au-text-primary);
    background: var(--au-surface);
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-fast);
  }

  .newsletter-input::placeholder {
    color: var(--au-text-tertiary);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--au-accent);
  }

  .newsletter-button {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--au-bg);
    background: var(--au-text-primary);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity var(--transition-fast);
  }

  .newsletter-button:hover {
    opacity: 0.85;
  }

  .newsletter-button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .newsletter-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .newsletter-status {
    min-height: 1.25rem;
    font-size: var(--text-xs);
    color: var(--au-text-secondary);
    margin: 0 0 var(--space-2);
  }

  .newsletter-status[data-state='success'] {
    color: #047857;
  }

  .newsletter-status[data-state='error'] {
    color: #b91c1c;
  }

  .newsletter-note {
    font-size: var(--text-xs);
    color: var(--au-text-tertiary);
    margin: 0;
  }

  @media (max-width: 480px) {
    .newsletter-form {
      flex-direction: column;
    }
  }
</style>

<script>
  const SUCCESS_MESSAGE = 'Listo. Registramos tu interés.';
  const ERROR_MESSAGE = 'No pudimos guardar tu email. Probá de nuevo.';
  const LOADING_MESSAGE = 'Guardando...';

  function initCaptureForms() {
    const forms = document.querySelectorAll('.capture-form');
    
    forms.forEach(form => {
      if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;

      const status = form.parentElement?.querySelector('.capture-status');
      const button = form.querySelector('button[type="submit"]');
      form.dataset.bound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        const email = String(formData.get('email') || '').trim();
        const companyTrap = String(formData.get('company') || '').trim();

        if (!email) return;

        if (button instanceof HTMLButtonElement) button.disabled = true;
        if (status instanceof HTMLElement) {
          status.dataset.state = 'loading';
          status.textContent = LOADING_MESSAGE;
        }

        try {
          const growth = window.AutaGrowth;
          const vertical = form.dataset.vertical || 'general';
          const intent = form.dataset.intent || 'newsletter';
          const form_id = form.dataset.formId || 'newsletter';

          const response = await fetch('/api/growth-leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email,
              hp: companyTrap,
              form_id,
              intent,
              vertical,
              consent_marketing: true,
              consent_source: `capture_${form_id}`,
              page_url: window.location.href,
              referrer: document.referrer || null,
              attribution: growth?.getAttribution?.() ?? {},
              anonymous_id: growth?.getAnonymousId?.() ?? null,
              session_id: growth?.getSessionId?.() ?? null,
              metadata: {
                form_id,
                locale: document.documentElement.lang,
              },
            }),
          });

          if (!response.ok) throw new Error(`lead_capture_${response.status}`);

          form.reset();
          if (status instanceof HTMLElement) {
            status.dataset.state = 'success';
            status.textContent = SUCCESS_MESSAGE;
          }
        } catch {
          if (status instanceof HTMLElement) {
            status.dataset.state = 'error';
            status.textContent = ERROR_MESSAGE;
          }
        } finally {
          if (button instanceof HTMLButtonElement) button.disabled = false;
        }
      });
    });
  }

  initCaptureForms();
  document.addEventListener('astro:after-swap', initCaptureForms);
</script>
