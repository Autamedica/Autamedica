---
import { getI18n } from '../i18n';
const locale = Astro.locals.locale ?? 'es';
const { t, dict } = getI18n(locale);
const featureMeta = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="m9 16 2 2 4-4"/></svg>`,
    video: "/videos/patient_agendamiento.mp4",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><circle cx="12" cy="10" r="2"/></svg>`,
    video: "/videos/patient_consulta_virtual.mp4",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14h6M9 18h6M9 10h6"/></svg>`,
    video: "/videos/patient_historia_clinica.mp4",
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg>`,
    video: "/videos/patient_seguimiento.mp4",
  },
];
const features = dict.landing.productShowcase.features.map((f, i) => ({
  ...f,
  ...featureMeta[i],
}));
---

<section id="producto" class="showcase" aria-label="Producto en acción">
  <div class="showcase-inner">
    <div class="showcase-header animate-on-scroll">
      <h2 class="showcase-title">{t('landing.productShowcase.title')}</h2>
      <p class="showcase-subtitle">{t('landing.productShowcase.subtitle')}</p>
    </div>

    {features.map((f, i) => (
      <div class={`showcase-row ${i % 2 === 1 ? 'reversed' : ''} animate-on-scroll`}>
        <div class="showcase-text">
          <span class="showcase-step" set:html={f.icon} />
          <h3 class="showcase-feature-title">{f.title}</h3>
          <p class="showcase-feature-desc">{f.description}</p>
        </div>
        <div class="showcase-video-wrap">
          <video
            class="showcase-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          >
            <source src={f.video} type="video/mp4" />
          </video>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .showcase {
    padding: var(--section-py) var(--section-px);
    background: var(--au-bg);
  }

  .showcase-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .showcase-header {
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .showcase-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.03em;
  }

  .showcase-subtitle {
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
    margin: 0;
  }

  .showcase-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    margin-bottom: var(--space-16);
  }

  .showcase-row:last-child {
    margin-bottom: 0;
  }

  .showcase-row.reversed .showcase-text {
    order: 2;
  }

  .showcase-row.reversed .showcase-video-wrap {
    order: 1;
  }

  .showcase-step {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--au-accent-soft);
    border: 1px solid var(--au-border);
    color: var(--au-accent);
    margin-bottom: var(--space-4);
  }

  .showcase-feature-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-4);
    letter-spacing: -0.03em;
  }

  .showcase-feature-desc {
    font-size: var(--text-base);
    color: var(--au-text-secondary);
    line-height: 1.7;
    margin: 0;
    max-width: 420px;
  }

  .showcase-video-wrap {
    border-radius: var(--radius-md);
    border: 1px solid var(--au-border);
    overflow: hidden;
    background: var(--au-surface);
  }

  .showcase-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .showcase-row {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .showcase-row.reversed .showcase-text,
    .showcase-row.reversed .showcase-video-wrap {
      order: unset;
    }

    .showcase-row .showcase-video-wrap {
      order: -1;
    }

    .showcase-feature-desc {
      max-width: none;
    }
  }
</style>
