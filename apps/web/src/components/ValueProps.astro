---
import { InteractiveBentoCard } from './ui/InteractiveBentoCard';
import { getI18n } from '../i18n';
const locale = Astro.locals.locale ?? 'es';
const { t, dict } = getI18n(locale);
const featureMeta = [
  {
    iconSvg: `<svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><g opacity="0.2"><rect x="2" y="2" width="28" height="28" rx="6" stroke="#38bdf8" stroke-width="1"/><rect x="6" y="6" width="20" height="20" rx="4" stroke="#38bdf8" stroke-width="1.5"/></g><g opacity="0.5"><path d="M10 2H8a6 6 0 0 0-6 6v2 m0 12v2a6 6 0 0 0 6 6h2 m12 0h2a6 6 0 0 0 6-6v-2 m0-12v-2a6 6 0 0 0-6-6h-2" stroke="#7dd3fc" stroke-width="1.5" stroke-linecap="round"/><path d="M16 4v4 m0 16v4 m-12-12h4 m16 0h4" stroke="#7dd3fc" stroke-width="1.5" stroke-linecap="round"/><circle cx="6" cy="6" r="0.75" fill="#38bdf8"/><circle cx="26" cy="6" r="0.75" fill="#38bdf8"/><circle cx="6" cy="26" r="0.75" fill="#38bdf8"/><circle cx="26" cy="26" r="0.75" fill="#38bdf8"/></g><g><rect x="11" y="11" width="10" height="10" rx="2" stroke="#ffffff" stroke-width="1.5"/><path d="M13 11v-3 m3 3v-3 m3 3v-3 M13 21v3 m3-3v3 m3-3v3 M11 13H8 m3 3H8 m3 3H8 M21 13h3 m-3 3h3 m-3 3h3" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round"/><circle cx="16" cy="16" r="3.5" stroke="#7dd3fc" stroke-width="0.75" stroke-dasharray="1 1"/><circle cx="16" cy="16" r="2.5" stroke="#38bdf8" stroke-width="1.2"/><circle cx="16" cy="16" r="1" fill="#10b981"/><circle cx="23" cy="9" r="0.5" fill="#10b981"/></g></svg>`,
    imageSrc: "/images/ai_molecular.webp",
    isLarge: false,
  },
  {
    iconSvg: `<svg width="36" height="36" viewBox="0 0 40 40" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="lens-gradient" x1="16" y1="8" x2="24" y2="32" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="currentColor" stop-opacity="0.0"/><stop offset="50%" stop-color="currentColor" stop-opacity="0.18"/><stop offset="100%" stop-color="currentColor" stop-opacity="0.0"/></linearGradient><linearGradient id="active-beam" x1="20" y1="20" x2="28" y2="20" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#38bdf8" stop-opacity="1"/><stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/></linearGradient></defs><g stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><line x1="2" y1="20" x2="16" y2="20" stroke-opacity="0.15" stroke-dasharray="1 3"/><path d="M 2 20 C 6 12, 10 12, 14 20 C 15.5 23, 17.5 23, 19 20" stroke-opacity="0.2"/><path d="M 2 20 C 6 28, 10 28, 14 20 C 15.5 17, 17.5 17, 19 20" stroke-opacity="0.2"/></g><g stroke-linecap="round" stroke-linejoin="round"><path d="M 20 6 Q 14 20, 20 34 Q 26 20, 20 6 Z" stroke-width="1.2" stroke-opacity="0.45" fill="url(#lens-gradient)"/><rect x="25" y="8" width="13" height="24" rx="2" stroke-width="1" stroke-opacity="0.2"/><line x1="28" y1="13" x2="34" y2="13" stroke-width="1" stroke-opacity="0.15"/><line x1="28" y1="17" x2="36" y2="17" stroke-width="1" stroke-opacity="0.15"/><line x1="28" y1="21" x2="35" y2="21" stroke-width="1" stroke-opacity="0.15"/><line x1="28" y1="25" x2="33" y2="25" stroke-width="1" stroke-opacity="0.15"/><line x1="28" y1="13" x2="34" y2="17" stroke-width="1" stroke-opacity="0.25"/><line x1="34" y1="17" x2="28" y2="25" stroke-width="1" stroke-opacity="0.25"/><line x1="28" y1="25" x2="32" y2="29" stroke-width="1" stroke-opacity="0.25"/><circle cx="28" cy="13" r="1.5" stroke-width="1" stroke-opacity="0.45" fill="#000"/><circle cx="34" cy="17" r="1.5" stroke-width="1" stroke-opacity="0.45" fill="#000"/><circle cx="28" cy="25" r="1.5" stroke-width="1" stroke-opacity="0.45" fill="#000"/><circle cx="32" cy="29" r="1.5" stroke-width="1" stroke-opacity="0.45" fill="#000"/></g><g fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M 8 20 C 12 15, 16 15, 20 20" stroke="#38bdf8" stroke-width="1.5"/><circle cx="20" cy="20" r="1.25" fill="#38bdf8" stroke="none"/><line x1="20" y1="20" x2="28" y2="20" stroke="url(#active-beam)" stroke-width="1.5"/><circle cx="28" cy="20" r="1.5" fill="#38bdf8" stroke="none"/><path d="M 28 20 L 34 20 L 34 23.5" stroke="#38bdf8" stroke-width="1.5"/><path d="M 28 20 L 28 17.5" stroke="#38bdf8" stroke-width="1.5"/><circle cx="28" cy="16" r="1" fill="#38bdf8" stroke="none"/><circle cx="34" cy="25" r="2" stroke="#38bdf8" stroke-width="1.5" fill="#000"/><circle cx="34" cy="25" r="0.5" fill="#38bdf8" stroke="none"/></g></svg>`,
    videoSrc: "/videos/alta-agent-ia.mp4",
    isLarge: true,
  },
  {
    iconSvg: `<svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><defs><linearGradient id="cyanBeam" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="currentColor" stop-opacity="0.3"/><stop offset="100%" stop-color="#38bdf8"/></linearGradient><radialGradient id="nodeGlow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#38bdf8" stop-opacity="0.5"/><stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/></radialGradient></defs><circle cx="16" cy="16" r="14" stroke-width="1" stroke-opacity="0.15"/><circle cx="16" cy="16" r="10" stroke-width="1" stroke-opacity="0.2" stroke-dasharray="2 3"/><path d="M 16 2 L 16 4 M 16 28 L 16 30 M 2 16 L 4 16 M 28 16 L 30 16" stroke-width="1.5" stroke-opacity="0.4"/><path d="M 6.1 6.1 L 7.5 7.5 M 25.9 25.9 L 24.5 24.5 M 6.1 25.9 L 7.5 24.5 M 25.9 6.1 L 24.5 7.5" stroke-width="1" stroke-opacity="0.3"/><circle cx="9" cy="23" r="3" stroke-width="1.25" stroke-opacity="0.5"/><circle cx="9" cy="23" r="1.5" fill="currentColor" fill-opacity="0.7"/><circle cx="23" cy="9" r="3" stroke-width="1.5" stroke="#38bdf8" stroke-opacity="0.6"/><circle cx="23" cy="9" r="1.5" fill="#38bdf8"/><circle cx="23" cy="9" r="5" fill="url(#nodeGlow)"/><line x1="11" y1="21" x2="21" y2="11" stroke="url(#cyanBeam)" stroke-width="2"/><path d="M 10.5 21.5 A 14 14 0 0 1 21.5 10.5" stroke="#38bdf8" stroke-width="1" stroke-opacity="0.8"/><path d="M 10.5 21.5 A 14 14 0 0 0 21.5 10.5" stroke="currentColor" stroke-width="1" stroke-opacity="0.4"/><path d="M 13 17 L 15 19 M 17 13 L 19 15" stroke="#38bdf8" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    imageSrc: "/images/patient_serenity.webp",
    isLarge: false,
  },
];
const features = dict.landing.valueProps.items.map((item, i) => ({
  ...item,
  ...featureMeta[i],
}));
---

<section class="relative bg-black py-24 sm:py-32 overflow-hidden" aria-label="Propuesta de valor">
  {/* Ambient glowing background behind the grid */}
  <div class="absolute left-1/2 top-1/2 -z-10 h-[600px] w-[800px] -translate-x-1/2 -translate-y-1/2 opacity-20 blur-[120px]" style="background: radial-gradient(circle, rgba(56,189,248,0.4) 0%, transparent 60%);"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8 relative z-10">
    
    <div class="mx-auto max-w-3xl lg:text-center mb-16 animate-on-scroll">
      <h2 class="text-xs font-bold tracking-[0.25em] text-sky-400 uppercase">{t('landing.valueProps.label')}</h2>
      <p class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl text-balance">
        {t('landing.valueProps.title')}
      </p>
      <p class="mt-4 text-base sm:text-lg text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        {t('landing.valueProps.subtitle')}
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-2">
        {features.map((feature) => {
          const gridClass = feature.isLarge 
            ? "lg:col-span-2 lg:row-span-2 min-h-[400px] lg:min-h-[500px]" 
            : "lg:col-span-1 lg:row-span-1 min-h-[300px]";

          return (
            <div class={`animate-on-scroll ${gridClass} flex w-full`}>
              <InteractiveBentoCard 
                client:visible
                title={feature.title} 
                description={feature.description} 
                iconSvg={feature.iconSvg}
                videoSrc={feature.videoSrc}
                imageSrc={feature.imageSrc}
                isLarge={feature.isLarge}
                className="flex w-full"
              />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
