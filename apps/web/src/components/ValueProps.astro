---
import { InteractiveBentoCard } from './ui/InteractiveBentoCard';
import { getI18n } from '../i18n';
const locale = Astro.locals.locale ?? 'es';
const { dict } = getI18n(locale);
const featureMeta = [
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    imageSrc: "/images/ai_molecular.png",
    isLarge: false,
  },
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3"/></svg>`,
    videoSrc: "/videos/alta-agent-ia.mp4",
    isLarge: true,
  },
  {
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    imageSrc: "/images/patient_serenity.png",
    isLarge: false,
  },
];
const features = dict.landing.valueProps.items.map((item, i) => ({
  ...item,
  ...featureMeta[i],
}));
---

<section class="relative bg-black py-24 sm:py-32 overflow-hidden" aria-label="Propuesta de valor">
  {/* Ambient glowing background behind the grid */}
  <div class="absolute left-1/2 top-1/2 -z-10 h-[600px] w-[800px] -translate-x-1/2 -translate-y-1/2 opacity-20 blur-[120px]" style="background: radial-gradient(circle, rgba(56,189,248,0.4) 0%, transparent 60%);"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8 relative z-10">
    
    <div class="mx-auto max-w-2xl lg:text-center mb-16 animate-on-scroll">
      <h2 class="text-base font-semibold leading-7 text-primary/80 tracking-widest uppercase">La Diferencia</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl text-balance">
        Menos burocracia.<br class="hidden sm:block" /> Más medicina.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-2">
        {features.map((feature) => {
          const gridClass = feature.isLarge 
            ? "lg:col-span-2 lg:row-span-2 min-h-[400px] lg:min-h-[500px]" 
            : "lg:col-span-1 lg:row-span-1 min-h-[300px]";

          return (
            <div class={`animate-on-scroll ${gridClass} flex w-full`}>
              <InteractiveBentoCard 
                client:visible
                title={feature.title} 
                description={feature.description} 
                iconSvg={feature.iconSvg}
                videoSrc={feature.videoSrc}
                imageSrc={feature.imageSrc}
                isLarge={feature.isLarge}
                className="flex w-full"
              />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
