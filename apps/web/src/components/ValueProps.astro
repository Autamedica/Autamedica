---
const props = [
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: "Consulta en minutos",
    description: "Sin esperas. Conecta con un profesional disponible al instante desde cualquier dispositivo."
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: "Seguridad HIPAA",
    description: "Tus datos medicos cifrados y protegidos bajo estandares internacionales de salud."
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3"/></svg>`,
    title: "IA Medica Integrada",
    description: "Asistente inteligente que agiliza el diagnostico, seguimiento y gestion clinica."
  }
];
---

<section class="value-props" aria-label="Propuesta de valor">
  <div class="value-props-inner">
    {props.map((prop) => (
      <article class="value-card animate-on-scroll">
        <div class="value-icon" set:html={prop.icon} />
        <h3 class="value-title">{prop.title}</h3>
        <p class="value-desc">{prop.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .value-props {
    padding: var(--section-py) var(--section-px);
    background: var(--au-bg);
  }

  .value-props-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .value-card {
    padding: var(--space-8);
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    transition: border-color var(--transition-slow), box-shadow var(--transition-slow);
  }

  .value-card:hover {
    border-color: var(--au-border-hover);
    box-shadow: var(--shadow-glow);
  }

  .value-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--au-accent-soft);
    border: 1px solid var(--au-border);
    color: var(--au-accent);
    margin-bottom: var(--space-6);
  }

  .value-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.01em;
  }

  .value-desc {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--au-text-secondary);
    margin: 0;
  }

  @media (max-width: 768px) {
    .value-props-inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
