---
import twitchSchedule from '../../../../tools/obs/twitch_schedule.json';

const locale = Astro.locals.locale ?? 'es';

// Text translations based on locale
const content = {
  es: {
    title: 'Streams y Debates en Vivo',
    subtitle: 'Acompañanos en Twitch para debates de salud, demostraciones de producto y live coding de la plataforma.',
    upcomingTitle: 'Próximos streams programados',
    noStreams: 'No hay streams programados actualmente. ¡Seguinos en Twitch para enterarte de la próxima transmisión!',
    viewOnTwitch: 'Ir al Canal de Twitch',
    subscribeCalendar: 'Añadir a mi Calendario (iCal)',
    weeklyBadge: 'Transmisión Programada',
    categoryLabel: 'Categoría',
    timeLabel: 'Horario',
    daily: 'Todos los días',
    monday: 'Lunes',
    tuesday: 'Martes',
    wednesday: 'Miércoles',
    thursday: 'Jueves',
    friday: 'Viernes',
    saturday: 'Sábado',
    sunday: 'Domingo',
    justChatting: 'Charla general',
  },
  pt: {
    title: 'Transmissões e Debates ao Vivo',
    subtitle: 'Junte-se a nós na Twitch para debates de saúde, demonstrações de produtos e live coding da plataforma.',
    upcomingTitle: 'Próximas transmissões agendadas',
    noStreams: 'Não há transmissões agendadas no momento. Siga-nos na Twitch para saber da próxima transmissão!',
    viewOnTwitch: 'Ir para o Canal da Twitch',
    subscribeCalendar: 'Adicionar ao meu Calendário (iCal)',
    weeklyBadge: 'Transmissão Agendada',
    categoryLabel: 'Categoria',
    timeLabel: 'Horário',
    daily: 'Todos los dias',
    monday: 'Segunda-feira',
    tuesday: 'Terça-feira',
    wednesday: 'Quarta-feira',
    thursday: 'Quinta-feira',
    friday: 'Sexta-feira',
    saturday: 'Sábado',
    sunday: 'Domingo',
    justChatting: 'Conversa geral',
  }
};

const texts = content[locale as 'es' | 'pt'] || content.es;

// Helpers to format day and time
const getDayName = (weekday: string, recurrence: string) => {
  if (weekday) {
    switch (weekday) {
      case 'MO': return texts.monday;
      case 'TU': return texts.tuesday;
      case 'WE': return texts.wednesday;
      case 'TH': return texts.thursday;
      case 'FR': return texts.friday;
      case 'SA': return texts.saturday;
      case 'SU': return texts.sunday;
    }
  }
  
  const rec = recurrence.toUpperCase();
  if (rec.includes('FREQ=DAILY')) return texts.daily;
  if (rec.includes('BYDAY=MO')) return texts.monday;
  if (rec.includes('BYDAY=TU')) return texts.tuesday;
  if (rec.includes('BYDAY=WE')) return texts.wednesday;
  if (rec.includes('BYDAY=TH')) return texts.thursday;
  if (rec.includes('BYDAY=FR')) return texts.friday;
  if (rec.includes('BYDAY=SA')) return texts.saturday;
  if (rec.includes('BYDAY=SU')) return texts.sunday;
  return texts.daily;
};

const formatTime = (timeStr: string) => {
  try {
    const date = new Date(timeStr);
    return date.toLocaleTimeString('es-AR', {
      timeZone: 'America/Buenos_Aires',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }) + ' hs';
  } catch (e) {
    // Fallback if Date parsing fails (e.g. old format '20260615T120000')
    if (timeStr && timeStr.includes('T')) {
      const timePart = timeStr.split('T')[1];
      return `${timePart.slice(0, 2)}:${timePart.slice(2, 4)} hs`;
    }
    return timeStr;
  }
};

const events = twitchSchedule.events || [];

// Filter and group events by unique weekday code to present a clean weekly calendar
const uniqueEventsMap = new Map();
events.forEach(event => {
  const dayKey = event.weekday || (event.recurrence.includes('BYDAY=') ? event.recurrence.split('BYDAY=')[1].slice(0, 2) : 'DAILY');
  if (!uniqueEventsMap.has(dayKey)) {
    uniqueEventsMap.set(dayKey, event);
  }
});

const displayEvents = Array.from(uniqueEventsMap.values())
  .sort((a, b) => {
    const days = ['MO', 'TU', 'WE', 'TH', 'FR', 'SA', 'SU', 'DAILY'];
    const dayA = a.weekday || (a.recurrence.includes('BYDAY=') ? a.recurrence.split('BYDAY=')[1].slice(0, 2) : 'DAILY');
    const dayB = b.weekday || (b.recurrence.includes('BYDAY=') ? b.recurrence.split('BYDAY=')[1].slice(0, 2) : 'DAILY');
    return days.indexOf(dayA) - days.indexOf(dayB);
  });
---

<section class="upcoming-streams" id="comunidad" aria-label="Transmisiones en vivo de Autamedica">
  <div class="streams-inner">
    <div class="streams-header animate-on-scroll">
      <div class="live-indicator-wrapper">
        <span class="live-pulse"></span>
        <span class="live-badge">TWITCH LIVE</span>
      </div>
      <h2 class="streams-title">{texts.title}</h2>
      <p class="streams-subtitle">{texts.subtitle}</p>
      
      <a href="webcal://api.twitch.tv/helix/schedule/icalendar?broadcaster_id=1374917529" class="calendar-sub-link" title="Suscribirse al calendario en tu app (Google Calendar, Apple, Outlook)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>{texts.subscribeCalendar}</span>
      </a>
    </div>

    {displayEvents.length > 0 ? (
      <div class="streams-grid">
        {displayEvents.map((event) => {
          const dayName = getDayName(event.weekday, event.recurrence);
          const startTime = formatTime(event.start);
          const endTime = formatTime(event.end);
          
          return (
            <div class="stream-card animate-on-scroll">
              <div class="stream-card-glow"></div>
              <div class="stream-card-content">
                <div class="card-header-row">
                  <span class="stream-badge">{texts.weeklyBadge}</span>
                  <span class="day-badge"><strong>{dayName}</strong></span>
                </div>
                
                <h3 class="stream-topic">{event.title}</h3>
                <p class="stream-description">{event.description}</p>
                
                <div class="stream-meta">
                  <div class="meta-item">
                    <span class="meta-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                    </span>
                    <span class="meta-text">{texts.timeLabel}: <strong>{startTime} - {endTime} (ARG)</strong></span>
                  </div>
                  
                  <div class="meta-item">
                    <span class="meta-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                      </svg>
                    </span>
                    <span class="meta-text">{texts.categoryLabel}: <strong>{event.categories.join(', ')}</strong></span>
                  </div>
                </div>
                
                <a href="https://twitch.tv/autamedica" target="_blank" rel="noopener noreferrer" class="twitch-btn">
                  <span>{texts.viewOnTwitch}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="no-streams-card animate-on-scroll">
        <p>{texts.noStreams}</p>
        <a href="https://twitch.tv/autamedica" target="_blank" rel="noopener noreferrer" class="twitch-btn">
          <span>{texts.viewOnTwitch}</span>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .upcoming-streams {
    padding: var(--section-py, 5rem) var(--section-px, 2rem);
    background: var(--au-bg, #0b0c10);
    border-top: 1px solid var(--au-glass-border, rgba(255, 255, 255, 0.08));
    position: relative;
    overflow: hidden;
  }

  .upcoming-streams::before {
    content: '';
    position: absolute;
    top: -10%;
    left: 85%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(147, 51, 234, 0.12) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .streams-inner {
    max-width: 1120px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .streams-header {
    text-align: center;
    margin-bottom: var(--space-12, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .live-indicator-wrapper {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    background: rgba(147, 51, 234, 0.12);
    border: 1px solid rgba(147, 51, 234, 0.35);
    padding: 0.4rem 1.2rem;
    border-radius: 9999px;
    margin-bottom: var(--space-4, 1rem);
    box-shadow: 0 0 15px rgba(147, 51, 234, 0.1);
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    background-color: #a855f7;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.7);
    animation: pulse 1.8s infinite;
  }

  .live-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: #c084fc;
    letter-spacing: 0.18em;
  }

  .streams-title {
    font-size: var(--text-3xl, 2rem);
    font-weight: 800;
    color: var(--au-text-primary, #f5f5f7);
    margin: 0 0 var(--space-3, 0.75rem);
    letter-spacing: -0.03em;
    font-family: 'Outfit', sans-serif;
  }

  .streams-subtitle {
    font-size: var(--text-lg, 1.125rem);
    color: var(--au-text-secondary, #8e8e93);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .calendar-sub-link {
    margin-top: var(--space-4, 1rem);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--au-text-secondary, #8e8e93);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-lg, 0.5rem);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .calendar-sub-link:hover {
    background: rgba(168, 85, 247, 0.08);
    border-color: rgba(168, 85, 247, 0.35);
    color: #c084fc;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.06);
  }

  .calendar-sub-link svg {
    color: #a855f7;
    transition: transform 0.3s ease;
  }

  .calendar-sub-link:hover svg {
    transform: rotate(5deg) scale(1.05);
  }

  .streams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6, 1.5rem);
    justify-content: center;
  }

  .stream-card {
    position: relative;
    border-radius: var(--radius-xl, 1rem);
    background: var(--au-glass-bg, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--au-glass-border, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-card:hover {
    transform: translateY(-6px);
    border-color: rgba(168, 85, 247, 0.45);
    box-shadow: 0 20px 40px rgba(168, 85, 247, 0.08);
  }

  .stream-card-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(800px circle at var(--x, 0) var(--y, 0), rgba(168, 85, 247, 0.08), transparent 40%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .stream-card:hover .stream-card-glow {
    opacity: 1;
  }

  .stream-card-content {
    padding: var(--space-8, 2rem);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5, 1.25rem);
  }

  .stream-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: #c084fc;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.25);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .day-badge {
    font-size: 0.75rem;
    color: var(--au-text-primary, #f5f5f7);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 0.5rem;
  }

  .stream-topic {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--au-text-primary, #f5f5f7);
    margin-bottom: var(--space-2, 0.5rem);
    line-height: 1.4;
    font-family: 'Outfit', sans-serif;
  }

  .stream-description {
    font-size: 0.9rem;
    color: var(--au-text-secondary, #8e8e93);
    line-height: 1.6;
    margin-bottom: var(--space-6, 1.5rem);
  }

  .stream-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    margin-bottom: var(--space-8, 2rem);
    flex-grow: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: var(--space-4, 1rem);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    font-size: 0.85rem;
    color: var(--au-text-secondary, #8e8e93);
  }

  .meta-icon {
    display: flex;
    align-items: center;
    color: #a855f7;
    opacity: 0.85;
  }

  .meta-text {
    line-height: 1.2;
  }

  .twitch-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2, 0.5rem);
    width: 100%;
    background: linear-gradient(135deg, #6441a5, #7d5bbe);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-lg, 0.5rem);
    padding: var(--space-3.5, 0.85rem) var(--space-4, 1rem);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 15px rgba(100, 65, 165, 0.25);
  }

  .twitch-btn:hover {
    background: linear-gradient(135deg, #7d5bbe, #9674db);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(100, 65, 165, 0.4);
  }

  .twitch-btn:active {
    transform: translateY(0);
  }

  .no-streams-card {
    text-align: center;
    padding: var(--space-10, 2.5rem) var(--space-6, 1.5rem);
    background: var(--au-glass-bg, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--au-glass-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-xl, 1rem);
    max-width: 500px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6, 1.5rem);
  }

  .no-streams-card p {
    color: var(--au-text-secondary, #8e8e93);
    font-size: var(--text-md, 1rem);
    line-height: 1.6;
  }

  .no-streams-card .twitch-btn {
    width: auto;
    padding: 0.75rem 2rem;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.75);
    }
    70% {
      transform: scale(1.1);
      box-shadow: 0 0 0 10px rgba(168, 85, 247, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(168, 85, 247, 0);
    }
  }

  @media (max-width: 640px) {
    .stream-card-content {
      padding: var(--space-6, 1.5rem);
    }
  }
</style>

<script>
  // Dynamic glow effect following mouse
  const cards = document.querySelectorAll('.stream-card');
  cards.forEach((card) => {
    if (card instanceof HTMLElement) {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--x', `${x}px`);
        card.style.setProperty('--y', `${y}px`);
      });
    }
  });
</script>

