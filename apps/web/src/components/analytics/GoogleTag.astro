---
const GOOGLE_ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID?.trim() || 'AW-18168503394';
// A GA4 web measurement ID (G-...) is distinct from the Firebase/Android stream.
const candidate = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim() || '';
const GA4_ID = /^G-[A-Z0-9]+$/.test(candidate) ? candidate : '';
---

<!-- Marketing analytics only: never initialize Google tags in clinical areas. -->
<script is:inline define:vars={{ GOOGLE_ADS_ID, GA4_ID }}>
  (() => {
    const STORAGE_KEY = 'au-cookie-consent';
    const CONTROLLER_KEY = '__autamedicaGoogleTagControllerReady';
    const LOAD_KEY = '__autamedicaLoadGoogleTag';
    const LOADED_KEY = '__autamedicaGoogleTagLoaded';
    const CONSENT_EVENT = 'au:cookie-consent:changed';
    // Positive allowlist. Never forward arbitrary URLs, query strings, UIDs or clinical paths.
    const MARKETING = /^\/(?:|descargar\/?|farmacia\/?|empresas\/?|precios\/?|contacto\/?|faq\/?|servicios\/?)$/;
    const REGISTER = /^\/auth\/register\/?$/;

    if (window[CONTROLLER_KEY]) {
      window[LOAD_KEY]?.();
      return;
    }

    function consented() {
      try { return localStorage.getItem(STORAGE_KEY) === 'accepted'; }
      catch { return false; }
    }

    function isMarketing() {
      return MARKETING.test(location.pathname) &&
        (location.hostname === 'autamedica.com' || location.hostname === 'www.autamedica.com');
    }

    function isAllowed() {
      return isMarketing() ||
        (REGISTER.test(location.pathname) &&
          (location.hostname === 'autamedica.com' || location.hostname === 'www.autamedica.com'));
    }

    function initializeGtag() {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied', ad_storage: 'denied',
        ad_user_data: 'denied', ad_personalization: 'denied',
      });
      window.gtag('js', new Date());

      if (GA4_ID) {
        window.gtag('config', GA4_ID, {
          send_page_view: false,
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });
      }
      if (GOOGLE_ADS_ID && isMarketing()) {
        window.gtag('config', GOOGLE_ADS_ID);
      }

      const id = GA4_ID || (isMarketing() ? GOOGLE_ADS_ID : '');
      if (!id) return;
      const script = document.createElement('script');
      script.id = 'autamedica-google-tag';
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
      document.head.appendChild(script);
      window[LOADED_KEY] = true;
    }

    let lastPagePath = '';
    function refresh() {
      if (!isAllowed() || !consented()) {
        if (window.gtag) {
          window.gtag('consent', 'update', {
            analytics_storage: 'denied', ad_storage: 'denied',
            ad_user_data: 'denied', ad_personalization: 'denied',
          });
        }
        lastPagePath = '';
        return;
      }
      if (!window[LOADED_KEY]) initializeGtag();
      if (!window[LOADED_KEY]) return;
      window.gtag('consent', 'update', {
        analytics_storage: GA4_ID ? 'granted' : 'denied',
        ad_storage: isMarketing() ? 'granted' : 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });

      if (GA4_ID && isMarketing() && lastPagePath !== location.pathname) {
        // No query strings, referrer, email, diagnosis, clinical context or record IDs.
        window.gtag('event', 'page_view', {
          send_to: GA4_ID,
          page_location: location.origin + location.pathname,
          page_referrer: '',
          page_title: 'AutaMedica',
        });
        lastPagePath = location.pathname;
      }
    }

    window.AutaAnalytics = {
      track(name) {
        // Non-conversion event. Successful submission is not confirmed account creation.
        if (name !== 'registration_requested' || !GA4_ID || !REGISTER.test(location.pathname)) return;
        if (!consented() || !window[LOADED_KEY] || !isAllowed()) return;
        window.gtag('event', 'registration_requested', {
          send_to: GA4_ID, method: 'email',
          page_location: location.origin + '/auth/register',
        });
      },
    };

    window[CONTROLLER_KEY] = true;
    window[LOAD_KEY] = refresh;
    refresh();
    document.addEventListener(CONSENT_EVENT, refresh);
    document.addEventListener('astro:before-swap', () => {
      // Disable tracking before the client-side router enters a new document.
      window.gtag?.('consent', 'update', {
        analytics_storage: 'denied', ad_storage: 'denied',
        ad_user_data: 'denied', ad_personalization: 'denied',
      });
    });
    document.addEventListener('astro:after-swap', refresh);
  })();
</script>
