---
type Vertical = 'patients' | 'doctors' | 'companies';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  vertical: Vertical;
  pathname: string;
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  vertical,
  pathname,
  title,
  description,
  breadcrumbs,
} = Astro.props;

const baseOrigin = 'https://www.autamedica.com';
const canonicalUrl = new URL(pathname, `${baseOrigin}/`).toString();

const verticalConfig: Record<Vertical, {
  name: string;
  medicalEntityType: 'MedicalOrganization' | 'MedicalBusiness';
  serviceType: string;
  audienceType: string;
  specialties: string[];
  imagePath: string;
  summary: string;
}> = {
  patients: {
    name: 'Portal de Pacientes',
    medicalEntityType: 'MedicalOrganization',
    serviceType: 'Atención médica virtual para pacientes',
    audienceType: 'Pacientes y familias',
    specialties: ['PrimaryCare', 'PreventiveMedicine', 'Telemedicine'],
    imagePath: '/images/seo/og-patients.png',
    summary: 'Seguimiento clínico, turnos y continuidad de atención en una sola experiencia digital.',
  },
  doctors: {
    name: 'Portal para Médicos',
    medicalEntityType: 'MedicalOrganization',
    serviceType: 'Herramientas clínicas y teleconsulta para profesionales',
    audienceType: 'Profesionales de la salud',
    specialties: ['Telemedicine', 'MedicalClinic'],
    imagePath: '/images/seo/og-doctors.png',
    summary: 'Flujo médico optimizado para agenda, teleconsulta y gestión de pacientes.',
  },
  companies: {
    name: 'Portal de Empresas',
    medicalEntityType: 'MedicalBusiness',
    serviceType: 'Salud ocupacional y continuidad operativa empresarial',
    audienceType: 'Empresas y equipos de RRHH',
    specialties: ['OccupationalMedicine', 'PreventiveMedicine'],
    imagePath: '/images/seo/og-companies.png',
    summary: 'Cobertura de salud corporativa para operación continua y prevención de riesgos.',
  },
};

const config = verticalConfig[vertical];
const medicalEntityId = `${canonicalUrl}#medical-entity`;
const serviceId = `${canonicalUrl}#service`;

const defaultBreadcrumbs: BreadcrumbItem[] = [
  { name: 'Inicio', path: '/' },
  { name: config.name, path: pathname },
];

const breadcrumbTrail = breadcrumbs && breadcrumbs.length > 0 ? breadcrumbs : defaultBreadcrumbs;

const breadcrumbList = {
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: breadcrumbTrail.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.path, `${baseOrigin}/`).toString(),
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${baseOrigin}/#organization`,
      name: 'AutaMedica',
      url: `${baseOrigin}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${baseOrigin}/images/brand/logo_neon.png`,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Argentina',
      },
    },
    {
      '@type': ['MedicalBusiness', config.medicalEntityType],
      '@id': medicalEntityId,
      name: `${config.name} | AutaMedica`,
      url: canonicalUrl,
      description,
      image: `${baseOrigin}${config.imagePath}`,
      medicalSpecialty: config.specialties,
      availableService: {
        '@id': serviceId,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Argentina',
      },
      isPartOf: {
        '@id': `${baseOrigin}/#website`,
      },
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: `${config.name} - Servicio principal`,
      serviceType: config.serviceType,
      description: config.summary,
      provider: {
        '@id': medicalEntityId,
      },
      audience: {
        '@type': 'Audience',
        audienceType: config.audienceType,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Argentina',
      },
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: canonicalUrl,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'es-AR',
      breadcrumb: {
        '@id': `${canonicalUrl}#breadcrumb`,
      },
      about: [
        {
          '@id': medicalEntityId,
        },
        {
          '@id': serviceId,
        },
      ],
      mainEntity: {
        '@id': serviceId,
      },
    },
    breadcrumbList,
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
