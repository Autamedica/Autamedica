---
type Vertical = 'patients' | 'doctors' | 'companies';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  vertical: Vertical;
  pathname: string;
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  vertical,
  pathname,
  title,
  description,
  breadcrumbs,
} = Astro.props;

const baseOrigin = 'https://www.autamedica.com';
const canonicalUrl = new URL(pathname, `${baseOrigin}/`).toString();

const verticalConfig: Record<Vertical, {
  name: string;
  serviceType: string;
  specialties: string[];
}> = {
  patients: {
    name: 'Portal de Pacientes',
    serviceType: 'Atencion medica virtual para pacientes',
    specialties: ['PrimaryCare', 'PreventiveMedicine', 'Telemedicine'],
  },
  doctors: {
    name: 'Portal para Medicos',
    serviceType: 'Herramientas clinicas y teleconsulta para profesionales',
    specialties: ['Telemedicine', 'MedicalClinic'],
  },
  companies: {
    name: 'Portal de Empresas',
    serviceType: 'Salud ocupacional y continuidad operativa empresarial',
    specialties: ['OccupationalMedicine', 'PreventiveMedicine'],
  },
};

const config = verticalConfig[vertical];

const defaultBreadcrumbs: BreadcrumbItem[] = [
  { name: 'Inicio', path: '/' },
  { name: config.name, path: pathname },
];

const breadcrumbTrail = breadcrumbs && breadcrumbs.length > 0 ? breadcrumbs : defaultBreadcrumbs;

const breadcrumbList = {
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: breadcrumbTrail.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.path, `${baseOrigin}/`).toString(),
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${baseOrigin}/#organization`,
      name: 'AutaMedica',
      url: `${baseOrigin}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${baseOrigin}/logo.png`,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Argentina',
      },
    },
    {
      '@type': 'MedicalBusiness',
      '@id': `${canonicalUrl}#medical-business`,
      name: `${config.name} | AutaMedica`,
      url: canonicalUrl,
      description,
      image: `${baseOrigin}/og-image.jpg`,
      medicalSpecialty: config.specialties,
      serviceType: config.serviceType,
      areaServed: {
        '@type': 'Country',
        name: 'Argentina',
      },
      isPartOf: {
        '@id': `${baseOrigin}/#website`,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      breadcrumb: {
        '@id': `${canonicalUrl}#breadcrumb`,
      },
      about: {
        '@id': `${canonicalUrl}#medical-business`,
      },
    },
    breadcrumbList,
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
