---
type Vertical = 'patients' | 'doctors' | 'companies';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  vertical: Vertical;
  pathname: string;
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { vertical, pathname, title, description, breadcrumbs } = Astro.props;
const baseOrigin = 'https://www.autamedica.com';
const locale = Astro.locals.locale === 'pt' ? 'pt-BR' : 'es-AR';
const canonicalUrl = new URL(pathname, `${baseOrigin}/`).toString();

const verticalConfig: Record<Vertical, {
  name: string;
  serviceType: string;
  audienceType: string;
  imagePath: string;
  summary: string;
}> = {
  patients: {
    name: 'Portal de Pacientes',
    serviceType: 'Atención médica virtual para pacientes',
    audienceType: 'Pacientes y familias',
    imagePath: '/images/seo/og-patients.png',
    summary: 'Seguimiento clínico, turnos y continuidad de atención en una sola experiencia digital.',
  },
  doctors: {
    name: 'Portal para Médicos',
    serviceType: 'Herramientas clínicas y teleconsulta para profesionales',
    audienceType: 'Profesionales de la salud',
    imagePath: '/images/seo/og-doctors.png',
    summary: 'Flujo médico optimizado para agenda, teleconsulta y gestión de pacientes.',
  },
  companies: {
    name: 'Portal de Empresas',
    serviceType: 'Salud ocupacional y continuidad operativa empresarial',
    audienceType: 'Empresas y equipos de RRHH',
    imagePath: '/images/seo/og-companies.png',
    summary: 'Cobertura de salud corporativa para operación continua y prevención de riesgos.',
  },
};

const config = verticalConfig[vertical];
const organizationId = `${baseOrigin}/#organization`;
const serviceId = `${canonicalUrl}#service`;
const defaultBreadcrumbs: BreadcrumbItem[] = [
  { name: 'Inicio', path: '/' },
  { name: config.name, path: pathname },
];
const breadcrumbTrail = breadcrumbs?.length ? breadcrumbs : defaultBreadcrumbs;

const breadcrumbList = {
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: breadcrumbTrail.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.path, `${baseOrigin}/`).toString(),
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'AutaMedica',
      url: `${baseOrigin}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${baseOrigin}/images/brand/logo_bioceramic.jpg`,
      },
      areaServed: [
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'Brasil' },
      ],
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: config.name,
      serviceType: config.serviceType,
      description: config.summary,
      image: new URL(config.imagePath, `${baseOrigin}/`).toString(),
      provider: { '@id': organizationId },
      audience: {
        '@type': 'Audience',
        audienceType: config.audienceType,
      },
      areaServed: [
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'Brasil' },
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: canonicalUrl,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: locale,
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      about: { '@id': serviceId },
      mainEntity: { '@id': serviceId },
    },
    breadcrumbList,
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
