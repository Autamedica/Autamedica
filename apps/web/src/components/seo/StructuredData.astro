---
const baseUrl = 'https://www.autamedica.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${baseUrl}/#organization`,
      name: 'AutaMedica',
      alternateName: 'AutaMedica Telemedicina',
      url: `${baseUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${baseUrl}/images/brand/logo_bioceramic.jpg`,
        encodingFormat: 'image/jpeg'
      },
      description: 'Plataforma de telemedicina y coordinación clínica en LATAM con Inteligencia Artificial médica integrada.',
      knowsAbout: ['Telemedicine', 'Digital Health', 'Medical AI', 'Electronic Prescriptions'],
      contactPoint: [
        {
          '@type': 'ContactPoint',
          'contactType': 'customer support',
          'email': 'soporte@autamedica.com',
          'availableLanguage': ['Spanish', 'Portuguese']
        }
      ],
      sameAs: [
        'https://twitter.com/autamedica',
        'https://www.youtube.com/@AUTAMEDICA',
        'https://www.tiktok.com/@auta_medica',
        'https://www.instagram.com/autamedica',
        'https://www.linkedin.com/company/autamedica',
        'https://chat.whatsapp.com/DvgpQ3A4y3P5uoU52LoSzO?mode=gi_t'
      ]
    },
    {
      '@type': 'Person',
      '@id': `${baseUrl}/#founder`,
      name: 'Eduardo Marques',
      url: 'https://www.linkedin.com/in/eduardo-marques-b00739249/',
      sameAs: ['https://www.linkedin.com/in/eduardo-marques-b00739249/'],
      worksFor: {
        '@id': `${baseUrl}/#organization`
      }
    },
    {
      '@type': 'WebSite',
      '@id': `${baseUrl}/#website`,
      url: `${baseUrl}/`,
      name: 'AutaMedica',
      description: 'Telemedicina sin fricciones y salud digital accesible en toda Latinoamérica.',
      publisher: {
        '@id': `${baseUrl}/#organization`
      },
      inLanguage: ['es-AR', 'pt-BR']
    },
    {
      '@type': 'Service',
      '@id': `${baseUrl}/#telemedicine-service`,
      name: 'Plataforma de telemedicina AutaMedica',
      serviceType: 'Plataforma digital para telemedicina y coordinación clínica',
      url: `${baseUrl}/platform`,
      image: `${baseUrl}/images/seo/og-main.png`,
      provider: {
        '@id': `${baseUrl}/#organization`
      },
      areaServed: [
        { '@type': 'Country', 'name': 'Argentina' },
        { '@type': 'Country', 'name': 'Brasil' }
      ],
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: `${baseUrl}/platform`
      },
      isPartOf: {
        '@id': `${baseUrl}/#website`
      }
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${baseUrl}/#application`,
      name: 'AutaMedica',
      operatingSystem: 'Web, Android',
      applicationCategory: 'HealthApplication',
      url: `${baseUrl}/`,
      author: {
        '@id': `${baseUrl}/#organization`
      },
      brand: {
        '@id': `${baseUrl}/#organization`
      },
      applicationSubCategory: 'Telemedicine and digital health',
      availableLanguage: ['es-AR', 'pt-BR']
    }
  ]
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
