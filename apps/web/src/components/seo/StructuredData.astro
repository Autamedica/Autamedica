---
const baseUrl = 'https://www.autamedica.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${baseUrl}/#organization`,
      name: 'AutaMedica',
      alternateName: 'AutaMedica Telemedicina',
      url: `${baseUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${baseUrl}/images/brand/logo_bioceramic.png`,
        width: 1024,
        height: 1024
      },
      description: 'Plataforma de telemedicina y coordinación clínica en LATAM con Inteligencia Artificial médica integrada.',
      knowsAbout: ['Telemedicine', 'Digital Health', 'Medical AI', 'Electronic Prescriptions'],
      contactPoint: [
        {
          '@type': 'ContactPoint',
          'contactType': 'customer support',
          'email': 'soporte@autamedica.com',
          'availableLanguage': ['Spanish', 'Portuguese']
        }
      ],
      sameAs: [
        'https://twitter.com/autamedica',
        'https://www.youtube.com/@AUTAMEDICA',
        'https://www.tiktok.com/@auta_medica',
        'https://www.instagram.com/autamedica',
        'https://www.linkedin.com/company/autamedica',
        'https://chat.whatsapp.com/DvgpQ3A4y3P5uoU52LoSzO?mode=gi_t'
      ]
    },
    {
      '@type': 'Person',
      '@id': `${baseUrl}/#founder`,
      name: 'Eduardo Marques',
      url: 'https://www.linkedin.com/in/eduardo-marques-b00739249/',
      sameAs: ['https://www.linkedin.com/in/eduardo-marques-b00739249/'],
      worksFor: {
        '@id': `${baseUrl}/#organization`
      }
    },
    {
      '@type': 'WebSite',
      '@id': `${baseUrl}/#website`,
      url: `${baseUrl}/`,
      name: 'AutaMedica',
      description: 'Telemedicina sin fricciones y salud digital accesible en toda Latinoamérica.',
      publisher: {
        '@id': `${baseUrl}/#organization`
      },
      inLanguage: ['es-AR', 'pt-BR']
    },
    {
      '@type': 'MedicalOrganization',
      '@id': `${baseUrl}/#medical-organization`,
      name: 'AutaMedica',
      url: `${baseUrl}/`,
      image: `${baseUrl}/images/seo/og-main.webp`,
      medicalSpecialty: ['Telemedicine', 'PrimaryCare', 'PreventiveMedicine', 'MentalHealth', 'Cardiology', 'Dermatology'],
      areaServed: [
        { '@type': 'Country', 'name': 'Argentina' },
        { '@type': 'Country', 'name': 'Brasil' },
        { '@type': 'Country', 'name': 'Colombia' },
        { '@type': 'Country', 'name': 'Peru' },
        { '@type': 'Country', 'name': 'Mexico' },
        { '@type': 'Country', 'name': 'Ecuador' },
        { '@type': 'Country', 'name': 'Chile' }
      ],
      availableService: {
        '@type': 'Service',
        name: 'Telemedicina sin fricciones',
        serviceType: 'Atención médica virtual 24/7',
        url: `${baseUrl}/platform`,
        provider: {
          '@id': `${baseUrl}/#organization`
        }
      },
      isPartOf: {
        '@id': `${baseUrl}/#website`,
      },
      founder: {
        '@id': `${baseUrl}/#founder`,
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${baseUrl}/#application`,
      name: 'AutaMedica',
      operatingSystem: 'Web, iOS, Android',
      applicationCategory: 'HealthApplication',
      url: `${baseUrl}/`,
      author: {
        '@id': `${baseUrl}/#organization`
      },
      brand: {
        '@id': `${baseUrl}/#organization`
      },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'ARS',
        availability: 'https://schema.org/InStock'
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.8',
        ratingCount: '250'
      }
    }
  ]
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
