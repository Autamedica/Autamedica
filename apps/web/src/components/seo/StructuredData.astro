---
const baseUrl = 'https://www.autamedica.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${baseUrl}/#organization`,
      name: 'AutaMedica',
      url: `${baseUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${baseUrl}/images/brand/logo_bioceramic.png`,
        width: 1024,
        height: 1024
      },
      description: 'Plataforma de telemedicina sin fricciones con IA médica',
      sameAs: [
        'https://twitter.com/autamedica',
        'https://www.youtube.com/@AUTAMEDICA',
        'https://www.tiktok.com/@auta_medica'
      ]
    },
    {
      '@type': 'Person',
      '@id': `${baseUrl}/#founder`,
      name: 'Eduardo Marques',
      url: 'https://www.linkedin.com/in/eduardo-marques-b00739249/',
      sameAs: ['https://www.linkedin.com/in/eduardo-marques-b00739249/'],
      worksFor: {
        '@id': `${baseUrl}/#organization`
      }
    },
    {
      '@type': 'WebSite',
      '@id': `${baseUrl}/#website`,
      url: `${baseUrl}/`,
      name: 'AutaMedica',
      description: 'Telemedicina sin fricciones',
      publisher: {
        '@id': `${baseUrl}/#organization`
      },
      inLanguage: 'es-AR'
    },
    {
      '@type': 'MedicalOrganization',
      '@id': `${baseUrl}/#medical-organization`,
      name: 'AutaMedica',
      url: `${baseUrl}/`,
      image: `${baseUrl}/images/seo/og-main.webp`,
      medicalSpecialty: ['Telemedicine', 'PrimaryCare', 'PreventiveMedicine'],
      areaServed: {
        '@type': 'Country',
        name: 'Argentina',
      },
      availableService: {
        '@type': 'Service',
        name: 'Telemedicina sin fricciones',
        serviceType: 'Atención médica virtual',
        url: `${baseUrl}/platform`,
      },
      isPartOf: {
        '@id': `${baseUrl}/#website`,
      },
      founder: {
        '@id': `${baseUrl}/#founder`,
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${baseUrl}/#application`,
      name: 'AutaMedica',
      operatingSystem: 'Web, iOS, Android',
      applicationCategory: 'HealthApplication',
      url: `${baseUrl}/`,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'ARS'
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.8',
        ratingCount: '250'
      }
    }
  ]
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
