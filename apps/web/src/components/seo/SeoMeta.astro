---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  siteName?: string;
  locale?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  twitterSite?: string;
  twitterCreator?: string;
  keywords?: string;
  hreflangAlternates?: Array<{ lang: string; href: string }>;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1',
  ogImage,
  ogType = 'website',
  publishedTime,
  siteName = 'AutaMedica',
  locale = 'es_AR',
  twitterCard = 'summary_large_image',
  twitterSite,
  twitterCreator,
  keywords,
  hreflangAlternates = [],
} = Astro.props;

const validHreflangAlternates = hreflangAlternates.filter(({ lang, href }) => {
  if (!/^(?:[a-z]{2,3}(?:-[A-Z]{2})?|x-default)$/.test(lang)) return false;
  try {
    const url = new URL(href);
    return url.protocol === 'https:' && url.hostname === 'www.autamedica.com';
  } catch {
    return false;
  }
});

const requestOrigin = new URL(Astro.url.origin);
const siteUrl = Astro.site ?? new URL('https://www.autamedica.com');
const canonicalBase = requestOrigin.hostname !== 'localhost' ? requestOrigin : siteUrl;
const canonicalUrl = canonical
  ? new URL(canonical, canonicalBase).toString()
  : new URL(Astro.url.pathname, canonicalBase).toString();
const resolvedOgImage = ogImage?.replace(/^\/images\/seo\/(.+)\.webp$/, '/images/seo/$1.png');
const socialImageUrl = resolvedOgImage
  ? (resolvedOgImage.startsWith('http') ? resolvedOgImage : new URL(resolvedOgImage, siteUrl).toString())
  : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots} />

<meta property="og:type" content={ogType} />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{ogType === 'article' && publishedTime && <meta property="article:modified_time" content={publishedTime} />}
<meta property="og:locale" content={locale} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{socialImageUrl && <meta property="og:image:secure_url" content={socialImageUrl} />}
{socialImageUrl && <meta property="og:image:width" content="1200" />}
{socialImageUrl && <meta property="og:image:height" content="630" />}
{socialImageUrl && <meta property="og:image:alt" content={title} />}

<meta name="twitter:card" content={twitterCard} />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:url" content={canonicalUrl} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}

{keywords && <meta name="keywords" content={keywords} />}

{validHreflangAlternates.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
