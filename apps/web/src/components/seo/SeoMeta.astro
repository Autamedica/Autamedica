---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  siteName?: string;
  locale?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  twitterSite?: string;
  twitterCreator?: string;
  keywords?: string;
  includeHreflang?: boolean;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1',
  ogImage,
  siteName = 'AutaMedica',
  locale = 'es_AR',
  twitterCard = 'summary_large_image',
  twitterSite,
  twitterCreator,
  keywords,
  includeHreflang = true,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.autamedica.com');
const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString())
  : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots} />

<meta property="og:type" content="website" />
<meta property="og:locale" content={locale} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
{socialImageUrl && <meta property="og:image:secure_url" content={socialImageUrl} />}
{socialImageUrl && <meta property="og:image:width" content="1200" />}
{socialImageUrl && <meta property="og:image:height" content="630" />}
{socialImageUrl && <meta property="og:image:alt" content={title} />}

<meta name="twitter:card" content={twitterCard} />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:url" content={canonicalUrl} />
{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}

{keywords && <meta name="keywords" content={keywords} />}

{includeHreflang && <link rel="alternate" hreflang="es-AR" href={canonicalUrl} />}
{includeHreflang && <link rel="alternate" hreflang="es" href={canonicalUrl} />}
{includeHreflang && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}
