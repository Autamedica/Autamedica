---
interface Props {
  title: string;
  url: string;
  description?: string;
  author?: string;
  category?: string;
}

const { title, url, description = '', author = 'AutaMedica', category = '' } = Astro.props;

// Each network gets a professionally crafted share message
const siteName = 'AutaMedica';

// X/Twitter: concise, punchy — max ~250 chars. No hashtag spam.
const xText = description
  ? `${title} — ${description.slice(0, 120)}${description.length > 120 ? '...' : ''}`
  : title;

// WhatsApp: conversational, direct. People share WA messages to friends/family.
const waText = `${title}\n\n${description || 'Un artículo de ' + siteName + ' que puede interesarte.'}\n\nLeer: ${url}`;

// LinkedIn: professional framing. Source attribution matters.
const liUrl = url;

// Facebook: relies entirely on og: meta tags for the preview card.
// The sharer URL just needs the link — FB crawls og:title, og:description, og:image.
const fbUrl = url;

// Email: subject + body with full context
const emailSubject = `${title} | ${siteName}`;
const emailBody = `${description || title}\n\nLeer el artículo completo:\n${url}\n\n— ${siteName}`;

// Telegram: supports rich preview from og: tags
const tgText = `${title}\n${url}`;
---

<div class="share-buttons">
  <span class="share-label">Compartir</span>
  <div class="share-icons">
    {/* Facebook — og: tags drive the preview */}
    <a
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(fbUrl)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-facebook"
      aria-label="Compartir en Facebook"
      title="Facebook"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
    </a>

    {/* X (Twitter) — custom text + url */}
    <a
      href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(xText)}&url=${encodeURIComponent(url)}&via=autamedica`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-x"
      aria-label="Compartir en X"
      title="X (Twitter)"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>

    {/* LinkedIn — professional network, og: tags for preview */}
    <a
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(liUrl)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-linkedin"
      aria-label="Compartir en LinkedIn"
      title="LinkedIn"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
    </a>

    {/* WhatsApp — conversational message with context */}
    <a
      href={`https://wa.me/?text=${encodeURIComponent(waText)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-whatsapp"
      aria-label="Compartir en WhatsApp"
      title="WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>

    {/* Telegram — rich preview from og: tags */}
    <a
      href={`https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(tgText)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-telegram"
      aria-label="Compartir en Telegram"
      title="Telegram"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
    </a>

    {/* Email — subject + body with full article context */}
    <a
      href={`mailto:?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`}
      class="share-btn share-email"
      aria-label="Compartir por email"
      title="Email"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22,6 12,13 2,6"/></svg>
    </a>

    {/* Native share (mobile — includes Instagram Stories, etc.) */}
    <button
      class="share-btn share-native"
      aria-label="Compartir"
      title="Mas opciones"
      data-title={title}
      data-text={description || title}
      data-url={url}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
    </button>

    {/* Copy link */}
    <button
      class="share-btn share-copy"
      aria-label="Copiar enlace"
      title="Copiar enlace"
      data-url={url}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
      <span class="copy-feedback" aria-hidden="true"></span>
    </button>
  </div>
</div>

<script>
  // Native Web Share API (mobile — opens system share sheet with Instagram, etc.)
  document.querySelectorAll('.share-native').forEach((btn) => {
    if (!navigator.share) {
      (btn as HTMLElement).style.display = 'none';
      return;
    }
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      try {
        await navigator.share({
          title: el.dataset.title ?? '',
          text: el.dataset.text ?? '',
          url: el.dataset.url ?? '',
        });
      } catch { /* user cancelled */ }
    });
  });

  // Copy to clipboard with feedback
  document.querySelectorAll('.share-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      const feedback = el.querySelector('.copy-feedback') as HTMLElement;
      try {
        await navigator.clipboard.writeText(el.dataset.url ?? '');
        feedback.textContent = 'Copiado';
        feedback.classList.add('visible');
        setTimeout(() => {
          feedback.classList.remove('visible');
          feedback.textContent = '';
        }, 2000);
      } catch { /* clipboard denied */ }
    });
  });
</script>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    gap: var(--space-4, 1rem);
    padding: var(--space-6, 1.5rem) 0;
    border-top: 1px solid var(--au-border, #e5e5e5);
    border-bottom: 1px solid var(--au-border, #e5e5e5);
    margin: var(--space-8, 2rem) 0;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    flex-wrap: wrap;
  }
  .share-label {
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--font-semibold, 600);
    color: var(--au-text-tertiary, #737373);
    white-space: nowrap;
  }
  .share-icons {
    display: flex;
    gap: var(--space-2, 0.5rem);
    flex-wrap: wrap;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--au-border, #e5e5e5);
    background: transparent;
    color: var(--au-text-secondary, #525252);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
    font-size: inherit;
    position: relative;
  }
  .share-btn:hover {
    border-color: var(--au-text-tertiary, #737373);
    color: var(--au-text-primary, #171717);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .share-facebook:hover { color: #1877F2; border-color: #1877F2; }
  .share-x:hover { color: #000; border-color: #000; }
  .share-linkedin:hover { color: #0A66C2; border-color: #0A66C2; }
  .share-whatsapp:hover { color: #25D366; border-color: #25D366; }
  .share-telegram:hover { color: #0088cc; border-color: #0088cc; }
  .share-email:hover { color: #EA4335; border-color: #EA4335; }
  .share-native:hover { color: var(--au-accent, #059669); border-color: var(--au-accent, #059669); }

  .copy-feedback {
    position: absolute;
    top: -28px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    color: var(--au-accent, #059669);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .copy-feedback.visible { opacity: 1; }

  /* Hide native share on desktop (no navigator.share) */
  @media (min-width: 768px) {
    .share-native { display: none; }
  }
</style>
