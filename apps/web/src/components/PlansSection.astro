---
import { getI18n } from '../i18n';
const locale = Astro.locals.locale ?? 'es';
const { dict } = getI18n(locale);
const plans = dict.landing.plansSection;
---

<section id="planos" class="plans-section" aria-label="Planos e Preços">
  <div class="plans-inner">
    <!-- Header -->
    <div class="plans-header animate-on-scroll">
      <span class="plans-kicker">{plans.kicker}</span>
      <h2 class="plans-title">{plans.title}</h2>
      <p class="plans-subtitle">{plans.subtitle}</p>
    </div>

    <!-- Cards Grid -->
    <div class="plans-grid">
      <!-- FREE PLAN -->
      <div class="plan-card plan-card--free animate-on-scroll">
        <div class="plan-card-header">
          <h3 class="plan-name">{plans.freeTitle}</h3>
          <div class="plan-price-wrap">
            <span class="plan-price">{plans.freePrice}</span>
            <span class="plan-period">{plans.freePeriod}</span>
          </div>
          <p class="plan-description">{plans.freeDescription}</p>
        </div>

        <ul class="plan-features" role="list">
          {plans.freeFeatures.map((feat) => (
            <li class="plan-feature-item">
              <svg class="plan-check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{feat}</span>
            </li>
          ))}
        </ul>

        <div class="plan-card-footer">
          <a href="/auth/register?role=patient" class="btn-plan btn-plan--free">
            {plans.freeCta}
          </a>
        </div>
      </div>

      <!-- PLANO CUIDADO (RESERVA DE SAÚDE) -->
      <div class="plan-card plan-card--cuidado animate-on-scroll">
        <div class="plan-badge-highlight">
          <svg class="w-3.5 h-3.5 text-cyan-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
          <span>{plans.cuidadoBadge}</span>
        </div>

        <div class="plan-card-header">
          <div class="flex items-center justify-between">
            <h3 class="plan-name plan-name--cuidado">{plans.cuidadoTitle}</h3>
            <span class="plan-reserve-tag">+22 AUTA Créditos/mês</span>
          </div>
          <div class="plan-price-wrap">
            <span class="plan-price plan-price--cuidado">{plans.cuidadoPrice}</span>
            <span class="plan-period plan-period--cuidado">{plans.cuidadoPeriod}</span>
          </div>
          <p class="plan-description plan-description--cuidado">{plans.cuidadoDescription}</p>
        </div>

        <ul class="plan-features" role="list">
          {plans.cuidadoFeatures.map((feat) => (
            <li class="plan-feature-item plan-feature-item--cuidado">
              <svg class="plan-check-icon plan-check-icon--cuidado" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{feat}</span>
            </li>
          ))}
        </ul>

        <div class="plan-card-footer">
          <a href="/reserva-saude" class="btn-plan btn-plan--cuidado">
            {plans.cuidadoCta}
          </a>
          <a href="/reserva-saude" class="plan-learn-more">
            {plans.learnMore}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .plans-section {
    padding: 7rem 1.5rem;
    background: #09090b;
    position: relative;
    overflow: hidden;
  }

  .plans-section::before {
    content: '';
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .plans-inner {
    max-width: 1160px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .plans-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 4.5rem;
  }

  .plans-kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }

  .plans-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .plans-subtitle {
    font-size: 1.125rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    align-items: stretch;
    max-width: 960px;
    margin: 0 auto;
  }

  .plan-card {
    border-radius: 28px;
    padding: 2.75rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .plan-card--free {
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .plan-card--free:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .plan-card--cuidado {
    background: linear-gradient(180deg, #0f172a 0%, #09090b 100%);
    border: 1.5px solid rgba(56, 189, 248, 0.4);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 35px rgba(14, 165, 233, 0.15);
    position: relative;
  }

  .plan-card--cuidado:hover {
    transform: translateY(-6px);
    box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.8), 0 0 45px rgba(14, 165, 233, 0.25);
    border-color: rgba(56, 189, 248, 0.7);
  }

  .plan-badge-highlight {
    position: absolute;
    top: -14px;
    right: 28px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4);
  }

  .plan-name {
    font-size: 1.375rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .plan-reserve-tag {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-family: monospace;
  }

  .plan-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .plan-price {
    font-size: 2.75rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .plan-price--cuidado {
    color: #38bdf8;
  }

  .plan-period {
    font-size: 0.875rem;
    color: #64748b;
    font-weight: 500;
  }

  .plan-period--cuidado {
    color: #94a3b8;
  }

  .plan-description {
    font-size: 0.875rem;
    color: #94a3b8;
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .plan-description--cuidado {
    color: #cbd5e1;
  }

  .plan-features {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .plan-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #cbd5e1;
    line-height: 1.45;
  }

  .plan-check-icon {
    color: #64748b;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .plan-check-icon--cuidado {
    color: #38bdf8;
  }

  .plan-card-footer {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .btn-plan {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.9375rem 1.5rem;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-plan--free {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .btn-plan--free:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
  }

  .btn-plan--cuidado {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(14, 165, 233, 0.35);
  }

  .btn-plan--cuidado:hover {
    background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
    box-shadow: 0 6px 25px rgba(14, 165, 233, 0.5);
  }

  .plan-learn-more {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .plan-learn-more:hover {
    color: #38bdf8;
  }

  @media (max-width: 768px) {
    .plans-section {
      padding: 5rem 1.25rem;
    }

    .plans-grid {
      grid-template-columns: 1fr;
    }

    .plan-card {
      padding: 2.25rem 1.5rem;
    }
  }
</style>
