---
import AccountMenu from './ui/AccountMenu';
import { LanguageSwitcher } from './LanguageSwitcher';
import { getI18n } from '../i18n/index';

const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);

const navLinks = [
  { href: '/consulta-medica-online', label: 'Consulta online' },
  { href: '/telemedicina-argentina', label: 'Telemedicina' },
  { href: '/especialidades', label: t('navbar.specialties') },
  { href: '/blog', label: 'Blog' },
  { href: '/doctors', label: t('navbar.professionals') },
];
---

<nav class="navbar" aria-label="Navegacion principal">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo" aria-label="AutaMedica - Inicio">
      <img src="/logo_bioceramic.png" alt="AutaMedica" width="45" height="45" loading="eager" class="brand-logo" />
      <span class="sr-only">AutaMedica</span>
    </a>

    <ul class="navbar-links" role="list">
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>

    <div class="navbar-actions">
      <LanguageSwitcher currentLocale={locale} client:load />
      <AccountMenu locale={locale} client:load />
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    backdrop-filter: var(--blur-md);
    -webkit-backdrop-filter: var(--blur-md);
    background: rgba(0, 0, 0, 0.86);
    border-bottom: 1px solid rgba(56, 212, 255, 0.18);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
  }

  .navbar-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--section-px);
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .navbar-logo img {
    border-radius: var(--radius-sm);
  }

  .navbar-links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-8);
  }

  .navbar-links a {
    font-size: var(--text-sm);
    color: #ffffff;
    transition:
      color var(--transition-base),
      text-shadow var(--transition-base);
    letter-spacing: 0.01em;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.08);
  }

  .navbar-links a:hover {
    color: #38d4ff;
    text-shadow: 0 0 18px rgba(56, 212, 255, 0.42);
  }

  .navbar-actions {
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .navbar-links {
      display: flex;
    }

    .navbar-inner {
      height: 4.5rem;
    }
  }
</style>
