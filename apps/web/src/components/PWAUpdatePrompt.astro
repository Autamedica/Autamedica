---
---

<div
  id="pwa-update-prompt"
  class="fixed bottom-6 right-6 z-50 max-w-sm translate-y-12 opacity-0 pointer-events-none transition-all duration-500 ease-out"
  role="alert"
  aria-live="polite"
>
  <div class="bg-neutral-950/90 border border-neutral-800/80 backdrop-blur-xl p-5 rounded-2xl shadow-2xl flex flex-col gap-4">
    <div class="flex items-start gap-3.5">
      <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400">
        <svg
          class="w-5 h-5 text-sky-400"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
          <path d="M16 21h5v-5" />
        </svg>
      </div>
      <div class="flex-1">
        <h3 class="text-sm font-bold text-neutral-100 tracking-tight">Nueva versión disponible</h3>
        <p class="text-xs text-neutral-400 leading-relaxed mt-1">
          Actualizamos AutaMedica con mejoras críticas de rendimiento clínico. Actualizá para aplicarlas de inmediato.
        </p>
      </div>
    </div>
    
    <div class="flex items-center justify-end gap-2.5">
      <button
        id="pwa-update-dismiss"
        class="px-3.5 py-2 text-xs font-semibold text-neutral-400 hover:text-neutral-200 transition-colors rounded-xl hover:bg-neutral-900/50"
      >
        Más tarde
      </button>
      <button
        id="pwa-update-btn"
        class="px-4 py-2 text-xs font-bold text-white bg-sky-600 hover:bg-sky-500 transition-colors rounded-xl shadow-md shadow-sky-600/10 hover:shadow-sky-500/20 active:scale-[0.98]"
      >
        Actualizar Ahora
      </button>
    </div>
  </div>
</div>

<script>
  let newWorkerRegistration = null;

  function initPWAUpdatePrompt() {
    const prompt = document.getElementById('pwa-update-prompt');
    const updateBtn = document.getElementById('pwa-update-btn');
    const dismissBtn = document.getElementById('pwa-update-dismiss');

    if (!prompt || !updateBtn || !dismissBtn) return;

    // Escuchar el evento de actualización lanzado desde Layout.astro
    window.addEventListener('pwa:update-available', (event: any) => {
      console.log('[PWA] UI de actualización capturó evento.');
      newWorkerRegistration = event.detail;

      // Mostrar el prompt con una animación suave
      prompt.classList.remove('opacity-0', 'translate-y-12', 'pointer-events-none');
      prompt.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
    });

    // Acción de Actualizar Ahora
    updateBtn.addEventListener('click', () => {
      console.log('[PWA] Gatillando SKIP_WAITING...');
      if (newWorkerRegistration && newWorkerRegistration.waiting) {
        newWorkerRegistration.waiting.postMessage({ type: 'SKIP_WAITING' });
      } else {
        // Fallback si por alguna razón la referencia ya no está disponible
        navigator.serviceWorker.getRegistration().then((reg) => {
          if (reg && reg.waiting) {
            reg.waiting.postMessage({ type: 'SKIP_WAITING' });
          } else {
            window.location.reload();
          }
        });
      }
    });

    // Cerrar el prompt
    dismissBtn.addEventListener('click', () => {
      prompt.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      prompt.classList.add('opacity-0', 'translate-y-12', 'pointer-events-none');
    });
  }

  // Inicializar en carga y tras View Transitions de Astro
  initPWAUpdatePrompt();
  document.addEventListener('astro:after-swap', initPWAUpdatePrompt);
</script>
