---

<div id="au-cookie-banner" class="fixed bottom-0 inset-x-0 z-50 hidden" role="alert">
  <div class="bg-gray-900 border-t border-gray-700 px-4 py-3 sm:px-6 sm:py-4">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-3 sm:flex-row sm:justify-between">
      <p class="text-sm text-white text-center sm:text-left">
        Este sitio usa cookies para mejorar tu experiencia.
        <a href="/privacidad" class="underline underline-offset-2 hover:text-emerald-300 ml-1">
          Más información
        </a>
      </p>
      <button
        id="au-cookie-accept"
        class="shrink-0 rounded-lg bg-emerald-600 px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-500 active:scale-95"
      >
        Aceptar
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'au-cookie-consent';

  function initCookieBanner() {
    if (localStorage.getItem(STORAGE_KEY)) return;

    const banner = document.getElementById('au-cookie-banner');
    if (!banner) return;

    banner.classList.remove('hidden');

    document.getElementById('au-cookie-accept')?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'accepted');
      banner.classList.add('hidden');
    });
  }

  // Run on initial load and on Astro view transitions
  initCookieBanner();
  document.addEventListener('astro:after-swap', initCookieBanner);
</script>
