---
---

<div id="au-cookie-banner" class="fixed bottom-0 inset-x-0 z-50 hidden" role="alert">
  <div class="bg-white border-t border-[var(--au-border)] px-4 py-3 shadow-[0_-2px_10px_rgba(0,0,0,0.06)] sm:px-6 sm:py-4">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-3 sm:flex-row sm:justify-between">
      <p class="text-sm text-[var(--au-text-secondary)] text-center sm:text-left">
        Usamos cookies propias y de terceros para ofrecerte una mejor experiencia, analizar el uso del sitio y personalizar contenido.
        Al hacer clic en "Aceptar", consentís el uso de todas las cookies conforme a nuestra
        <a href="/privacidad" class="text-[var(--am-primary-600,#0284C7)] underline underline-offset-2 hover:text-[var(--am-primary-700,#0369A1)] ml-1">
          Política de Privacidad</a>.
      </p>
      <button
        id="au-cookie-accept"
        class="shrink-0 rounded-lg bg-[var(--am-primary-600,#0284C7)] px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--am-primary-700,#0369A1)] active:scale-95"
      >
        Aceptar
      </button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'au-cookie-consent';

  function initCookieBanner() {
    if (localStorage.getItem(STORAGE_KEY)) return;

    const banner = document.getElementById('au-cookie-banner');
    if (!banner) return;

    banner.classList.remove('hidden');

    document.getElementById('au-cookie-accept')?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, 'accepted');
      banner.classList.add('hidden');
    });
  }

  // Run on initial load and on Astro view transitions
  initCookieBanner();
  document.addEventListener('astro:after-swap', initCookieBanner);
</script>
