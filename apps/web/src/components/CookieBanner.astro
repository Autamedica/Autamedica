---
---

<div
  id="au-cookie-banner"
  class="fixed inset-x-0 bottom-[calc(env(safe-area-inset-bottom)+4rem)] z-50 hidden px-3 sm:bottom-0 sm:px-4 sm:pb-4"
  role="alert"
>
  <div class="mx-auto max-w-5xl overflow-hidden rounded-t-2xl border border-[var(--au-border)] bg-white shadow-[0_-12px_30px_rgba(0,0,0,0.08)] sm:rounded-2xl">
    <div class="flex max-h-[70dvh] flex-col gap-3 overflow-y-auto px-4 py-3 sm:max-h-none sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-4">
      <p class="flex-1 text-xs leading-5 text-[var(--au-text-secondary)] text-center sm:text-left sm:text-sm sm:leading-6">
        Usamos cookies propias y de terceros para ofrecerte una mejor experiencia, analizar el uso del sitio y personalizar contenido.
        Al hacer clic en "Aceptar", consentís el uso de todas las cookies conforme a nuestra
        <a href="/privacidad" class="text-[var(--am-primary-600,#0284C7)] underline underline-offset-2 hover:text-[var(--am-primary-700,#0369A1)] ml-1">
          Política de Privacidad</a>.
      </p>
      <div class="flex w-full shrink-0 gap-2 sm:w-auto">
        <button
          id="au-cookie-reject"
          type="button"
          class="min-h-11 flex-1 rounded-lg border border-[var(--au-border)] px-4 py-2.5 text-sm font-semibold text-[var(--au-text-primary)] transition-colors hover:bg-[var(--au-hover)] sm:flex-none"
        >
          Rechazar
        </button>
        <button
          id="au-cookie-accept"
          type="button"
          class="min-h-11 flex-1 rounded-lg bg-[var(--am-primary-600,#0284C7)] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--am-primary-700,#0369A1)] sm:flex-none"
        >
          Aceptar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'au-cookie-consent';
  const CONSENT_EVENT = 'au:cookie-consent:changed';

  const readPreference = () => {
    try { return localStorage.getItem(STORAGE_KEY); }
    catch { return null; }
  };

  const savePreference = (value: 'accepted' | 'rejected') => {
    try { localStorage.setItem(STORAGE_KEY, value); }
    catch { /* Storage may be blocked; GA4 remains denied by default. */ }
    document.dispatchEvent(new CustomEvent(CONSENT_EVENT));
    document.getElementById('au-cookie-banner')?.classList.add('hidden');
  };

  function initCookieBanner(force = false) {
    const banner = document.getElementById('au-cookie-banner');
    if (!banner) return;
    if (!force && ['accepted', 'rejected'].includes(readPreference() || '')) {
      banner.classList.add('hidden');
      return;
    }
    banner.classList.remove('hidden');

    const accept = document.getElementById('au-cookie-accept');
    const reject = document.getElementById('au-cookie-reject');
    if (accept && !accept.dataset.consentBound) {
      accept.addEventListener('click', () => savePreference('accepted'));
      accept.dataset.consentBound = 'true';
    }
    if (reject && !reject.dataset.consentBound) {
      reject.addEventListener('click', () => savePreference('rejected'));
      reject.dataset.consentBound = 'true';
    }
  }

  initCookieBanner();
  document.addEventListener('astro:after-swap', () => initCookieBanner());
  document.addEventListener('au:cookie-consent:manage', () => initCookieBanner(true));
</script>
