---

<script>
  const ATTRIBUTION_KEY = 'au-growth-attribution';
  const ANONYMOUS_ID_KEY = 'au-anonymous-id';
  const SESSION_ID_KEY = 'au-session-id';
  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];

  const safeUuid = () => {
    if (typeof crypto !== 'undefined' && crypto.randomUUID) return crypto.randomUUID();
    return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
  };

  const safeGet = (key: string): string | null => {
    try { return localStorage.getItem(key); } catch { return null; }
  };
  const safeSet = (key: string, value: string) => {
    try { localStorage.setItem(key, value); } catch { /* private browser / blocked storage */ }
  };
  const safeUtm = (value: unknown): string | null =>
    typeof value === 'string' && /^[a-z0-9][a-z0-9_-]{0,63}$/i.test(value) ? value : null;

  // Exclude identifiers, private paths and all URL parameters from attribution.
  const safePage = (raw: string): string => {
    try {
      const url = new URL(raw, window.location.origin);
      if (url.origin !== window.location.origin) return '/external';
      const allowed = /^\/(?:|descargar\/?|farmacia\/?|empresas\/?|precios\/?|contacto\/?|faq\/?|servicios\/?)$/;
      return allowed.test(url.pathname) ? url.pathname : '/private';
    } catch { return '/private'; }
  };

  const safeReferrer = (raw: string | null): string | null => {
    if (!raw) return null;
    try {
      const url = new URL(raw);
      return /^https?:$/.test(url.protocol) ? url.origin : null;
    } catch { return null; }
  };

  const readJson = (key: string): Record<string, unknown> => {
    try {
      const raw = safeGet(key);
      const parsed = raw ? JSON.parse(raw) : {};
      return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
    } catch { return {}; }
  };

  const ensureAnonymousId = () => {
    const existing = safeGet(ANONYMOUS_ID_KEY);
    if (existing) return existing;
    const created = safeUuid();
    safeSet(ANONYMOUS_ID_KEY, created);
    return created;
  };

  const ensureSessionId = () => {
    let existing: string | null = null;
    try { existing = sessionStorage.getItem(SESSION_ID_KEY); } catch { /* blocked */ }
    if (existing) return existing;
    const created = safeUuid();
    try { sessionStorage.setItem(SESSION_ID_KEY, created); } catch { /* blocked */ }
    return created;
  };

  const captureAttribution = () => {
    const params = new URLSearchParams(window.location.search);
    const existing = readJson(ATTRIBUTION_KEY);
    const current: Record<string, string> = {};
    const previous: Record<string, string> = {};
    UTM_KEYS.forEach((key) => {
      const next = safeUtm(params.get(key));
      const prev = safeUtm(existing[key]);
      if (next) current[key] = next;
      else if (prev) previous[key] = prev;
    });
    const now = new Date().toISOString();
    const firstPage = existing.first_landing_page
      ? safePage(String(existing.first_landing_page))
      : safePage(window.location.href);
    const firstReferrer = existing.first_referrer
      ? safeReferrer(String(existing.first_referrer))
      : safeReferrer(document.referrer);
    const next: Record<string, unknown> = {
      ...previous, ...current,
      first_landing_page: firstPage,
      first_referrer: firstReferrer,
      first_captured_at: existing.first_captured_at || now,
      last_landing_page: safePage(window.location.href),
      last_referrer: safeReferrer(document.referrer),
      last_captured_at: now,
    };
    UTM_KEYS.forEach((key) => {
      const value = safeUtm(params.get(key)) || safeUtm(existing['last_' + key]);
      if (value) next['last_' + key] = value;
    });
    safeSet(ATTRIBUTION_KEY, JSON.stringify(next));
    return next;
  };

  captureAttribution();
  ensureAnonymousId();
  ensureSessionId();

  window.AutaGrowth = {
    getAttribution: () => captureAttribution(),
    getAnonymousId: ensureAnonymousId,
    getSessionId: ensureSessionId,
  };
</script>
