---
const articles = [
  {
    tagIcon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
    tag: "Prevención",
    title: "5 señales de alerta cardíaca que no hay que ignorar",
    excerpt: "El dolor de pecho no es la única señal. Hay síntomas sutiles que pueden indicar un problema cardiovascular y que muchas veces se confunden con estrés o cansancio.",
    author: "Dra. Carolina Vega",
    authorRole: "Cardiología",
    date: "Feb 2026",
    image: "/images/article_cardio.png",
    authorAvatar: "/images/doctors/carolina-vega.png",
  },
  {
    tagIcon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><circle cx="12" cy="10" r="2"/></svg>`,
    tag: "Telemedicina",
    title: "Consulta virtual o presencial: cuándo conviene cada una",
    excerpt: "No toda consulta requiere ir al consultorio. Esta guía explica cuándo una videoconsulta es igual de efectiva, y cuándo es mejor ir en persona.",
    author: "Dr. Martín Álvarez",
    authorRole: "Medicina General",
    date: "Feb 2026",
    image: "/images/article_telemed.png",
    authorAvatar: "/images/doctors/martin-alvarez.png",
  },
  {
    tagIcon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`,
    tag: "Salud Mental",
    title: "Ansiedad crónica: herramientas que funcionan sin medicación",
    excerpt: "Estrategias basadas en evidencia para gestionar la ansiedad del día a día. Técnicas que podés aplicar ahora mismo, respaldadas por la ciencia.",
    author: "Dr. Pablo Gutiérrez",
    authorRole: "Psiquiatría",
    date: "Ene 2026",
    image: "/images/article_mental.png",
    authorAvatar: "/images/doctors/nicolas-herrera.png",
  },
];
---

<section class="health-content" aria-label="Recursos de salud">
  <div class="content-inner">
    <div class="content-header animate-on-scroll">
      <h2 class="content-title">Para entender tu salud</h2>
      <p class="content-subtitle">Artículos escritos y revisados por médicos de nuestra plataforma</p>
    </div>

    <div class="content-grid">
      {articles.map((a) => (
        <article class="content-card animate-on-scroll">
          <div class="content-image-wrapper">
             <img src={a.image} alt={a.title} class="content-card-image" loading="lazy" />
             <span class="content-tag">
               <span class="content-tag-icon" set:html={a.tagIcon} />
               {a.tag}
             </span>
          </div>
          <div class="content-card-body">
            <h3 class="content-card-title">{a.title}</h3>
            <p class="content-excerpt">{a.excerpt}</p>
            <div class="content-author">
              <img src={a.authorAvatar} alt="" class="content-author-avatar" loading="lazy" />
              <span class="content-author-name">{a.author}</span>
              <span class="content-author-dot" aria-hidden="true" />
              <span class="content-date">{a.date}</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="content-coming animate-on-scroll">
      <p>Más artículos cada semana, escritos por los médicos de la plataforma.</p>
    </div>
  </div>
</section>

<style>
  .health-content {
    padding: var(--section-py) var(--section-px);
    background: var(--au-surface);
  }

  .content-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .content-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .content-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-medium);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }

  .content-subtitle {
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
    margin: 0;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .content-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .content-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.03);
    transform: translateY(-6px);
  }

  .content-image-wrapper {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .content-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .content-card:hover .content-card-image {
    transform: scale(1.08);
  }

  .content-card-body {
    padding: var(--space-6);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .content-tag {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: white;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .content-tag-icon {
    display: flex;
    align-items: center;
    opacity: 0.7;
  }

  .content-card-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    line-height: 1.35;
  }

  .content-excerpt {
    font-size: var(--text-sm);
    color: var(--au-text-secondary);
    line-height: 1.7;
    margin: 0 0 var(--space-6);
    flex-grow: 1;
  }

  .content-author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--au-text-tertiary);
  }

  .content-author-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .content-coming {
    text-align: center;
    margin-top: var(--space-8);
  }

  .content-coming p {
    font-size: var(--text-sm);
    color: var(--au-text-tertiary);
    margin: 0;
  }

  @media (max-width: 768px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
