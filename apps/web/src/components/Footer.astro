---
import { getI18n } from '../i18n/index';

const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);
const currentYear = new Date().getFullYear();
const socialLinks = [
  { text: 'WhatsApp', href: 'https://chat.whatsapp.com/DvgpQ3A4y3P5uoU52LoSzO?mode=gi_t' },
  { text: 'YouTube', href: 'https://www.youtube.com/@AUTAMEDICA' },
  { text: 'TikTok', href: 'https://www.tiktok.com/@auta_medica' },
  { text: 'LinkedIn', href: 'https://www.linkedin.com/in/eduardo-marques-b00739249/' },
];

const columns = [
  {
    title: t('landing.footer.platformTitle'),
    links: [
      { text: t('landing.footer.patients'), href: '/patients' },
      { text: t('landing.footer.doctors'), href: '/doctors' },
      { text: t('landing.footer.companies'), href: '/companies' },
      { text: 'Especialidades', href: '/especialidades' },
    ]
  },
  {
    title: t('landing.footer.resourcesTitle'),
    links: [
      { text: 'Nosotros', href: '/nosotros' },
      { text: t('landing.footer.howItWorks'), href: '/consulta-medica-online' },
      { text: 'Telemedicina', href: '/telemedicina-argentina' },
      { text: 'Médico online', href: '/medico-online' },
      { text: 'Turno médico online', href: '/turno-medico-online' },
      { text: 'Blog', href: '/blog' },
      { text: t('landing.footer.support'), href: 'mailto:soporte@autamedica.com' },
    ]
  },
  {
    title: 'Especialidades',
    links: [
      { text: 'Psicólogo online', href: '/psicologo-online' },
      { text: 'Cardiólogo online', href: '/cardiologo-online' },
      { text: 'Dermatólogo online', href: '/dermatologo-online' },
      { text: 'Receta electrónica', href: '/receta-electronica' },
    ]
  },
  {
    title: t('landing.footer.legalTitle'),
    links: [
      { text: t('landing.footer.privacy'), href: '/privacidad' },
      { text: t('landing.footer.terms'), href: '/terms' },
      { text: 'Ley 26529', href: '/blog/que-dice-la-ley-26529' },
      { text: 'Ley 27553', href: '/ley-27553-telemedicina' },
    ]
  }
];
---

<footer class="footer-premium" aria-label="Pie de pagina">
  <div class="footer-wrap">
    
    <div class="footer-top-grid">
      <div class="brand-col">
        <a href="/" class="brand-logo group">
          <div class="logo-box overflow-hidden relative w-10 h-10 rounded-lg flex items-center justify-center bg-[var(--au-surface)] border border-[var(--au-border)] group-hover:border-[var(--au-border-hover)] transition-colors">
            <span class="text-[var(--au-text-primary)] font-bold text-lg">A</span>
          </div>
          <span class="text-2xl font-medium tracking-tight mt-6 block text-[var(--au-text-primary)]">AutaMedica</span>
        </a>
        <p class="brand-desc mt-4 text-[var(--au-text-secondary)] text-lg max-w-sm font-normal" set:html={t('landing.footer.tagline').replace('\n', '<br/>')} />
        <ul class="social-links mt-8" role="list">
          {socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="me noopener noreferrer" class="social-link">
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="nav-cols">
        {columns.map((col) => (
          <div class="nav-group">
            <h4 class="nav-header text-[10px] tracking-widest mb-8">{col.title}</h4>
            <ul class="nav-list space-y-4">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="nav-link transition-colors duration-300 text-lg relative inline-block group">
                    {link.text}
                    <span class="absolute -bottom-1 left-0 w-0 h-[1px] transition-all duration-300 group-hover:w-full" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {/* Massive Footer Typography */}
    <div class="footer-massive-type overflow-hidden flex items-center justify-center mt-32 mb-16 select-none">
      <h2 class="footer-massive-word text-[14vw] sm:text-[13.5vw] font-bold tracking-tighter leading-none whitespace-nowrap">AUTAMEDICA</h2>
    </div>

    <div class="footer-bottom-bar flex flex-col md:flex-row justify-between items-center py-8 border-t border-[var(--au-border)] mt-16">
      <p class="text-[var(--au-text-primary)] text-sm">&copy; {currentYear} AutaMedica. {t('landing.footer.allRights')}</p>

      <div class="cert-badges flex gap-4 mt-6 md:mt-0">
        {['DNPDP EX-2026-36544262', 'HIPAA', 'TLS 1.3', 'AES-256'].map(cert => (
          <span class="px-4 py-1.5 rounded-full border border-[var(--au-hover-border)] text-[10px] tracking-[0.18em] text-[var(--au-text-primary)] uppercase bg-white backdrop-blur-sm">
            {cert}
          </span>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-premium {
    background: var(--au-bg);
    color: var(--au-text-primary);
    padding-top: clamp(8rem, 15vh, 12rem);
    position: relative;
    z-index: 10;
  }

  .footer-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 max(2rem, 5vw);
  }

  .footer-top-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  @media (min-width: 1024px) {
    .footer-top-grid {
      flex-direction: row;
      justify-content: space-between;
    }

    .nav-cols {
      display: flex;
      gap: var(--space-24);
    }
  }

  .nav-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
  }

  .nav-group {
    min-width: 180px;
  }

  .nav-header {
    color: var(--au-text-secondary);
    font-weight: 800;
    letter-spacing: 0.22em;
    opacity: 0.96;
  }

  .nav-link {
    color: var(--au-text-primary);
    font-weight: 500;
  }

  .nav-link:hover {
    color: var(--au-accent);
  }

  .nav-link span {
    background: var(--au-accent);
  }

  .footer-massive-word {
    color: rgba(5, 5, 5, 0.11);
    text-shadow: none;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--au-hover-border);
    border-radius: 999px;
    background: white;
    color: var(--au-text-primary);
    font-weight: 500;
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      background var(--transition-base);
  }

  .social-link:hover {
    color: var(--au-accent);
    border-color: var(--au-accent);
    background: white;
    box-shadow: 0 10px 24px rgba(14, 165, 233, 0.14);
  }
  
  @media (max-width: 640px) {
    .nav-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
