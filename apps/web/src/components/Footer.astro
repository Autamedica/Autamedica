---
const currentYear = new Date().getFullYear();

const columns = [
  {
    title: "PLATAFORMA",
    links: [
      { text: "Pacientes", href: "/auth/select-role" },
      { text: "Médicos", href: "/auth/select-role" },
      { text: "Empresas", href: "/auth/select-role" },
    ]
  },
  {
    title: "RECURSOS",
    links: [
      { text: "Cómo funciona", href: "#proceso" },
      { text: "Seguridad", href: "#" },
      { text: "Soporte", href: "#" },
    ]
  },
  {
    title: "LEGAL",
    links: [
      { text: "Privacidad", href: "/privacy" },
      { text: "Términos", href: "/terms" },
      { text: "HIPAA Compliance", href: "#" },
    ]
  }
];
---

<footer class="footer-premium" aria-label="Pie de pagina">
  <div class="footer-wrap">
    
    <div class="footer-top-grid">
      <div class="brand-col">
        <a href="/" class="brand-logo group">
          <div class="logo-box overflow-hidden relative w-10 h-10 rounded-lg flex items-center justify-center bg-white/5 border border-white/10 group-hover:border-white/30 transition-colors">
            <span class="text-white font-bold text-lg">A</span>
          </div>
          <span class="text-2xl font-medium tracking-tight mt-6 block text-white/90">AutaMedica</span>
        </a>
        <p class="brand-desc mt-4 text-[var(--au-text-tertiary)] text-lg max-w-sm font-light">
          Telemedicina sin fricciones.<br/>Desarrollado por profesionales de salud - UBA.
        </p>
      </div>

      <div class="nav-cols">
        {columns.map((col) => (
          <div class="nav-group">
            <h4 class="nav-header text-[10px] tracking-widest text-white/40 mb-8">{col.title}</h4>
            <ul class="nav-list space-y-4">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="nav-link text-white/60 hover:text-white transition-colors duration-300 text-lg relative inline-block group">
                    {link.text}
                    <span class="absolute -bottom-1 left-0 w-0 h-[1px] bg-white transition-all duration-300 group-hover:w-full" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {/* Massive Footer Typography */}
    <div class="footer-massive-type overflow-hidden flex items-center justify-center mt-32 mb-16 select-none">
      <h2 class="footer-massive-word text-[14vw] sm:text-[13.5vw] font-bold tracking-tighter leading-none whitespace-nowrap">AUTAMEDICA</h2>
    </div>

    <div class="footer-bottom-bar flex flex-col md:flex-row justify-between items-center py-8 border-t border-white/5 mt-16">
      <p class="text-white/40 text-sm">&copy; {currentYear} AutaMedica. Todos los derechos reservados.</p>
      
      <div class="cert-badges flex gap-4 mt-6 md:mt-0">
        {['HIPAA', 'TLS 1.3', 'AES-256'].map(cert => (
          <span class="px-4 py-1.5 rounded-full border border-white/10 text-[10px] tracking-widest text-white/40 uppercase bg-white/5 backdrop-blur-sm">
            {cert}
          </span>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-premium {
    background: #000000;
    color: white;
    padding-top: clamp(8rem, 15vh, 12rem);
    position: relative;
    z-index: 10;
  }

  .footer-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 max(2rem, 5vw);
  }

  .footer-top-grid {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  @media (min-width: 1024px) {
    .footer-top-grid {
      flex-direction: row;
      justify-content: space-between;
    }

    .nav-cols {
      display: flex;
      gap: 6rem;
    }
  }

  .nav-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem;
  }

  .footer-massive-word {
    color: rgba(255, 255, 255, 0.14);
    text-shadow: 0 0 24px rgba(255, 255, 255, 0.06);
  }
  
  @media (max-width: 640px) {
    .nav-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
