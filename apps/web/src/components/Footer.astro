---
const currentYear = new Date().getFullYear();

const columns = [
  {
    title: "Plataforma",
    links: [
      { text: "Pacientes", href: "/auth/select-role" },
      { text: "Medicos", href: "/auth/select-role" },
      { text: "Empresas", href: "/auth/select-role" },
    ]
  },
  {
    title: "Recursos",
    links: [
      { text: "Como funciona", href: "#proceso" },
      { text: "Seguridad", href: "#" },
      { text: "Soporte", href: "#" },
    ]
  },
  {
    title: "Legal",
    links: [
      { text: "Privacidad", href: "/privacy" },
      { text: "Terminos", href: "/terms" },
      { text: "HIPAA Compliance", href: "#" },
    ]
  }
];
---

<footer class="footer" aria-label="Pie de pagina">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/logo.png" alt="AutaMedica" width="28" height="28" loading="lazy" />
          <span>AutaMedica</span>
        </a>
        <p class="footer-tagline">Telemedicina sin fricciones.<br/>Desarrollado por E.M Medicina - UBA.</p>
      </div>

      <div class="footer-columns">
        {columns.map((col) => (
          <div class="footer-column">
            <h4 class="footer-column-title">{col.title}</h4>
            <ul class="footer-column-links">
              {col.links.map((link) => (
                <li><a href={link.href}>{link.text}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {currentYear} AutaMedica. Todos los derechos reservados.</p>
      <div class="footer-badges">
        <span class="badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          HIPAA
        </span>
        <span class="badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          TLS 1.3
        </span>
        <span class="badge">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
          AES-256
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-12) var(--section-px) var(--space-6);
    background: var(--au-bg);
    border-top: 1px solid var(--au-border);
  }

  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
    margin-bottom: var(--space-3);
  }

  .footer-logo img {
    border-radius: 4px;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--au-text-tertiary);
    line-height: 1.6;
    margin: 0;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .footer-column-title {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--au-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-4);
  }

  .footer-column-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-column-links a {
    font-size: var(--text-sm);
    color: var(--au-text-tertiary);
    transition: color var(--transition-base);
  }

  .footer-column-links a:hover {
    color: var(--au-text-primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-6);
    border-top: 1px solid var(--au-border);
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--au-text-tertiary);
    margin: 0;
  }

  .footer-badges {
    display: flex;
    gap: var(--space-3);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.65rem;
    font-weight: var(--font-semibold);
    color: var(--au-text-tertiary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .footer-columns {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--space-4);
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-columns {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
