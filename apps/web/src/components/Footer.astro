---
import { getI18n } from '../i18n/index';

const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);
const currentYear = new Date().getFullYear();

const columns = [
  {
    title: t('landing.footer.platformTitle'),
    links: [
      { text: t('landing.footer.patients'), href: "/auth/select-role" },
      { text: t('landing.footer.doctors'), href: "/auth/select-role" },
      { text: t('landing.footer.companies'), href: "/auth/select-role" },
    ]
  },
  {
    title: t('landing.footer.resourcesTitle'),
    links: [
      { text: t('landing.footer.howItWorks'), href: "#proceso" },
      { text: t('landing.footer.security'), href: "/privacidad" },
      { text: t('landing.footer.support'), href: "mailto:soporte@autamedica.com" },
    ]
  },
  {
    title: t('landing.footer.legalTitle'),
    links: [
      { text: t('landing.footer.privacy'), href: "/privacidad" },
      { text: t('landing.footer.terms'), href: "/terms" },
      { text: t('landing.footer.hipaaCompliance'), href: "/privacidad" },
    ]
  }
];
---

<footer class="footer-premium" aria-label="Pie de pagina">
  <div class="footer-wrap">
    
    <div class="footer-top-grid">
      <div class="brand-col">
        <a href="/" class="brand-logo group">
          <div class="logo-box overflow-hidden relative w-10 h-10 rounded-lg flex items-center justify-center bg-[var(--au-surface)] border border-[var(--au-border)] group-hover:border-[var(--au-border-hover)] transition-colors">
            <span class="text-[var(--au-text-primary)] font-bold text-lg">A</span>
          </div>
          <span class="text-2xl font-medium tracking-tight mt-6 block text-[var(--au-text-primary)]">AutaMedica</span>
        </a>
        <p class="brand-desc mt-4 text-[var(--au-text-tertiary)] text-lg max-w-sm font-light" set:html={t('landing.footer.tagline').replace('\n', '<br/>')} />
      </div>

      <div class="nav-cols">
        {columns.map((col) => (
          <div class="nav-group">
            <h4 class="nav-header text-[10px] tracking-widest text-[var(--au-text-tertiary)] mb-8">{col.title}</h4>
            <ul class="nav-list space-y-4">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="nav-link text-[var(--au-text-secondary)] hover:text-[var(--au-text-primary)] transition-colors duration-300 text-lg relative inline-block group">
                    {link.text}
                    <span class="absolute -bottom-1 left-0 w-0 h-[1px] bg-[var(--au-text-primary)] transition-all duration-300 group-hover:w-full" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {/* Massive Footer Typography */}
    <div class="footer-massive-type overflow-hidden flex items-center justify-center mt-32 mb-16 select-none">
      <h2 class="footer-massive-word text-[14vw] sm:text-[13.5vw] font-bold tracking-tighter leading-none whitespace-nowrap">AUTAMEDICA</h2>
    </div>

    <div class="footer-bottom-bar flex flex-col md:flex-row justify-between items-center py-8 border-t border-[var(--au-border)] mt-16">
      <p class="text-[var(--au-text-tertiary)] text-sm">&copy; {currentYear} AutaMedica. {t('landing.footer.allRights')}</p>

      <div class="cert-badges flex gap-4 mt-6 md:mt-0">
        {['HIPAA', 'TLS 1.3', 'AES-256'].map(cert => (
          <span class="px-4 py-1.5 rounded-full border border-[var(--au-border)] text-[10px] tracking-widest text-[var(--au-text-tertiary)] uppercase bg-[var(--au-surface)] backdrop-blur-sm">
            {cert}
          </span>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-premium {
    background: var(--au-bg);
    color: var(--au-text-primary);
    padding-top: clamp(8rem, 15vh, 12rem);
    position: relative;
    z-index: 10;
  }

  .footer-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 max(2rem, 5vw);
  }

  .footer-top-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  @media (min-width: 1024px) {
    .footer-top-grid {
      flex-direction: row;
      justify-content: space-between;
    }

    .nav-cols {
      display: flex;
      gap: var(--space-24);
    }
  }

  .nav-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-16);
  }

  .footer-massive-word {
    color: rgba(255, 255, 255, 0.14);
    text-shadow: 0 0 24px rgba(255, 255, 255, 0.06);
  }
  
  @media (max-width: 640px) {
    .nav-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
