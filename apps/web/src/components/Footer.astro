---
import { getI18n } from '../i18n/index';

const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);
const currentYear = new Date().getFullYear();
const socialLinks = [
  {
    id: 'whatsapp',
    text: 'WhatsApp',
    href: 'https://chat.whatsapp.com/DvgpQ3A4y3P5uoU52LoSzO?mode=gi_t',
    ariaLabel: 'Comunidad de WhatsApp de AutaMedica',
  },
  {
    id: 'youtube',
    text: 'YouTube',
    href: 'https://www.youtube.com/@AUTAMEDICA',
    ariaLabel: 'Canal oficial de YouTube de AutaMedica',
  },
  {
    id: 'tiktok',
    text: 'TikTok',
    href: 'https://www.tiktok.com/@auta_medica',
    ariaLabel: 'Canal de TikTok de AutaMedica',
  },
  {
    id: 'linkedin',
    text: 'LinkedIn',
    href: 'https://www.linkedin.com/in/eduardo-marques-b00739249/',
    ariaLabel: 'Perfil oficial de LinkedIn de AutaMedica',
  },
];

const columns = [
  {
    title: t('landing.footer.platformTitle'),
    links: [
      { text: t('landing.footer.patients'), href: '/patients' },
      { text: t('landing.footer.doctors'), href: '/doctors' },
      { text: t('landing.footer.companies'), href: '/companies' },
      { text: 'Especialidades', href: '/especialidades' },
      { text: 'Nosotros', href: '/nosotros' },
      { text: 'Blog', href: '/blog' },
    ]
  },
  {
    title: 'Atención Médica',
    links: [
      { text: 'Consulta médica online', href: '/consulta-medica-online' },
      { text: 'Guardia médica 24hs', href: '/guardia-medica-online' },
      { text: 'Videoconsulta médica', href: '/videoconsulta-medica' },
      { text: 'Consulta en farmacia', href: '/consulta-medica-en-farmacia' },
      { text: 'Médico online', href: '/medico-online' },
      { text: 'Turno médico online', href: '/turno-medico-online' },
    ]
  },
  {
    title: 'Trámites y Recetas',
    links: [
      { text: 'Certificados médicos', href: '/certificados-medicos' },
      { text: 'Certificado médico online', href: '/certificado-medico-online' },
      { text: 'Justificativo médico', href: '/justificativo-medico' },
      { text: 'Certificado laboral', href: '/certificado-medico-laboral' },
      { text: 'Aptitud física', href: '/certificado-aptitud-fisica' },
      { text: 'Receta electrónica', href: '/receta-electronica' },
    ]
  },
  {
    title: 'Especialidades',
    links: [
      { text: 'Médico clínico online', href: '/medico-clinico-online' },
      { text: 'Pediatra online', href: '/pediatra-online' },
      { text: 'Gastroenterólogo online', href: '/gastroenterologo-online' },
      { text: 'Neurólogo online', href: '/neurologo-online' },
      { text: 'Psiquiatra online', href: '/psiquiatra-online' },
      { text: 'Todas las especialidades', href: '/especialidades' },
    ]
  },
  {
    title: t('landing.footer.legalTitle'),
    links: [
      { text: t('landing.footer.privacy'), href: '/privacidad' },
      { text: t('landing.footer.terms'), href: '/terms' },
      { text: 'Ley 26529', href: '/blog/que-dice-la-ley-26529' },
      { text: 'Ley 27553', href: '/ley-27553-telemedicina' },
      { text: 'Ministerio de Salud — ID 0268', href: '/receta-electronica' },
    ]
  }
];
---

<footer class="footer-premium" aria-label="Pie de pagina">
  <div class="footer-wrap">
    
    <div class="footer-top-grid">
      <div class="brand-col">
        <a href="/" class="brand-logo group" aria-label="AutaMedica - Inicio">
          <img
            src="/logo_bioceramic.png"
            alt="AutaMedica"
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
            class="brand-logo-img w-11 h-11 rounded-xl shadow-sm border border-[var(--au-border)] object-cover bg-white transition-all duration-300 group-hover:scale-105 group-hover:border-[var(--au-border-hover)] group-hover:shadow-md"
          />
          <span class="text-2xl font-medium tracking-tight mt-6 block text-[var(--au-text-primary)]">AutaMedica</span>
        </a>
        <p class="brand-desc mt-4 text-[var(--au-text-secondary)] text-lg max-w-sm font-normal" set:html={t('landing.footer.tagline').replace('\n', '<br/>')} />
        <ul class="social-links mt-8" role="list">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="me noopener noreferrer"
                class={`social-link social-link--${link.id}`}
                aria-label={link.ariaLabel}
              >
                {link.id === 'whatsapp' && (
                  <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
                  </svg>
                )}
                {link.id === 'youtube' && (
                  <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                )}
                {link.id === 'tiktok' && (
                  <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.88 3.48 2.74 1.34-.05 2.58-.93 2.96-2.22.14-.49.19-1 .19-1.51.02-4.92.01-9.84.01-14.76z" />
                  </svg>
                )}
                {link.id === 'linkedin' && (
                  <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.979 0 1.778-.773 1.778-1.729V1.73C24 .774 23.205 0 22.225 0z" />
                  </svg>
                )}
                <span>{link.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="nav-cols">
        {columns.map((col) => (
          <div class="nav-group">
            <h4 class="nav-header text-[10px] tracking-widest mb-8">{col.title}</h4>
            <ul class="nav-list space-y-4">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="nav-link transition-colors duration-300 text-lg relative inline-block group">
                    {link.text}
                    <span class="absolute -bottom-1 left-0 w-0 h-[1px] transition-all duration-300 group-hover:w-full" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {/* Massive Footer Typography */}
    <div class="footer-massive-type overflow-hidden flex items-center justify-center mt-32 mb-16 select-none">
      <h2 class="footer-massive-word text-[14vw] sm:text-[13.5vw] font-bold tracking-tighter leading-none whitespace-nowrap">AUTAMEDICA</h2>
    </div>

    <div class="footer-bottom-bar flex flex-col md:flex-row justify-between items-center py-8 border-t border-[var(--au-border)] mt-16">
      <p class="text-[var(--au-text-primary)] text-sm">&copy; {currentYear} AutaMedica. {t('landing.footer.allRights')}</p>

      <button
        type="button"
        id="au-cookie-preferences"
        class="min-h-11 rounded-lg px-3 text-sm text-[var(--au-text-primary)] underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-[var(--au-accent)]"
      >
        Preferencias de cookies
      </button>

      <div class="cert-badges flex gap-4 mt-6 md:mt-0">
        {['DNPDP EX-2026-36544262', 'HIPAA', 'TLS 1.3', 'AES-256'].map(cert => (
          <span class="px-4 py-1.5 rounded-full border border-[var(--au-hover-border)] text-[10px] tracking-[0.18em] text-[var(--au-text-primary)] uppercase bg-white backdrop-blur-sm">
            {cert}
          </span>
        ))}
      </div>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest('#au-cookie-preferences')) {
      document.dispatchEvent(new CustomEvent('au:cookie-consent:manage'));
    }
  });
</script>

<style>
  .footer-premium {
    background: var(--au-bg);
    color: var(--au-text-primary);
    padding-top: clamp(8rem, 15vh, 12rem);
    position: relative;
    z-index: 10;
  }

  .footer-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 max(2rem, 5vw);
  }

  .footer-top-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  @media (min-width: 1024px) {
    .footer-top-grid {
      flex-direction: row;
      justify-content: space-between;
    }

    .nav-cols {
      display: flex;
      gap: var(--space-24);
    }
  }

  .nav-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16);
  }

  .nav-group {
    min-width: 180px;
  }

  .nav-header {
    color: var(--au-text-secondary);
    font-weight: 800;
    letter-spacing: 0.22em;
    opacity: 0.96;
  }

  .nav-link {
    color: var(--au-text-primary);
    font-weight: 500;
  }

  .nav-link:hover {
    color: var(--au-accent);
  }

  .nav-link span {
    background: var(--au-accent);
  }

  .footer-massive-word {
    color: rgba(5, 5, 5, 0.11);
    text-shadow: none;
  }

  .brand-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
  }

  .brand-logo-img {
    border-radius: 0.75rem;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--au-hover-border);
    border-radius: 9999px;
    background: white;
    color: var(--au-text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition:
      color var(--transition-base, 0.2s cubic-bezier(0.16, 1, 0.3, 1)),
      border-color var(--transition-base, 0.2s cubic-bezier(0.16, 1, 0.3, 1)),
      box-shadow var(--transition-base, 0.2s cubic-bezier(0.16, 1, 0.3, 1)),
      background-color var(--transition-base, 0.2s cubic-bezier(0.16, 1, 0.3, 1)),
      transform var(--transition-base, 0.2s cubic-bezier(0.16, 1, 0.3, 1));
    outline: none;
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform var(--transition-base, 0.2s cubic-bezier(0.16, 1, 0.3, 1));
  }

  .social-link:hover {
    transform: translateY(-2px);
    background: white;
  }

  .social-link:hover .social-icon {
    transform: scale(1.12);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--au-accent);
    outline-offset: 2px;
  }

  /* WhatsApp */
  .social-link--whatsapp .social-icon {
    color: #25D366;
  }
  .social-link--whatsapp:hover {
    color: #075E54;
    border-color: #25D366;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.18);
  }

  /* YouTube */
  .social-link--youtube .social-icon {
    color: #FF0000;
  }
  .social-link--youtube:hover {
    color: #CC0000;
    border-color: #FF0000;
    box-shadow: 0 6px 20px rgba(255, 0, 0, 0.16);
  }

  /* TikTok */
  .social-link--tiktok .social-icon {
    color: var(--au-text-primary);
  }
  .social-link--tiktok:hover {
    color: var(--au-text-primary);
    border-color: var(--au-text-primary);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }

  /* LinkedIn */
  .social-link--linkedin .social-icon {
    color: #0A66C2;
  }
  .social-link--linkedin:hover {
    color: #0A66C2;
    border-color: #0A66C2;
    box-shadow: 0 6px 20px rgba(10, 102, 194, 0.18);
  }
  
  @media (max-width: 640px) {
    .nav-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
