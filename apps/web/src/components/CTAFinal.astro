---
import { TextReveal } from './ui/TextReveal';
import { MagneticButton } from './ui/MagneticButton';

interface Props {
  title: string;
  subtitle: string;
  buttonLabel: string;
  buttonHref: string;
}

const {
  title,
  subtitle,
  buttonLabel,
  buttonHref,
} = Astro.props as Partial<Props>;

const safeTitle = title ?? '';
const safeSubtitle = subtitle ?? '';
const safeButtonLabel = buttonLabel ?? '';
const safeButtonHref = buttonHref ?? '';
---

<section class="cta-final" aria-label="Llamada a la accion">
  <div class="cta-background-wrapper">
    <img src="/images/cta_background.png" alt="" class="cta-background-image" aria-hidden="true" />
    <div class="cta-overlay"></div>
  </div>
  <div class="cta-inner">
    <div class="cta-text-wrapper min-h-[60vh] flex flex-col items-center justify-center relative z-10">
      <TextReveal 
        text={safeTitle} 
        className="cta-huge-title text-[12vw] leading-[0.85] tracking-tighter sm:text-[10vw] md:text-[8vw] font-bold text-center text-white mix-blend-difference" 
        client:visible 
        delay={0.1}
      />
      
      <p class="cta-subtitle mt-12 mb-16 text-xl md:text-2xl text-[var(--au-text-secondary)] font-light max-w-2xl text-center">
        {safeSubtitle}
      </p>

      <MagneticButton client:visible stiffness={200} damping={10}>
        <a href={safeButtonHref} class="cta-btn-premium group">
          <span class="relative z-10 flex items-center gap-3">
            {safeButtonLabel}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
          <div class="absolute inset-0 bg-white scale-y-[0.01] origin-bottom group-hover:scale-y-100 transition-transform duration-500 ease-[cubic-bezier(0.19,1,0.22,1)]" />
        </a>
      </MagneticButton>
    </div>
  </div>
</section>

<style>
  .cta-final {
    position: relative;
    padding: clamp(4rem, 10vh, 8rem) var(--section-px);
    background: #000;
    overflow: hidden;
  }

  .cta-background-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    filter: saturate(0.5) brightness(0.8);
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, #0A0A0A, transparent 20%, transparent 80%, #000);
  }

  .cta-inner {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 1;
  }

  .cta-btn-premium {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 2.5rem;
    font-size: 1.125rem;
    font-weight: 500;
    color: #0A0A0A;
    background: #FFFFFF;
    border-radius: 9999px;
    overflow: hidden;
    transition: color 0.4s ease;
  }

  .cta-btn-premium:hover {
    color: #000000;
  }
</style>
