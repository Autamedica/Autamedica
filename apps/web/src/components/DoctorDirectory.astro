---
const doctors = [
  {
    name: "Dr. Martín Álvarez",
    specialty: "Medicina General",
    experience: 12,
    languages: ["Español"],
    available: true,
    photo: "/images/doctors/martin-alvarez.png",
  },
  {
    name: "Dra. Carolina Vega",
    specialty: "Cardiología",
    experience: 8,
    languages: ["Español", "Inglés"],
    available: true,
    photo: "/images/doctors/carolina-vega.png",
  },
  {
    name: "Dr. Lucas Fernández",
    specialty: "Dermatología",
    experience: 15,
    languages: ["Español"],
    available: false,
    photo: "/images/doctors/lucas-fernandez.png",
  },
  {
    name: "Dra. Sofía Ramírez",
    specialty: "Pediatría",
    experience: 10,
    languages: ["Español", "Portugués"],
    available: true,
    photo: "/images/doctors/sofia-ramirez.png",
  },
  {
    name: "Dr. Nicolás Herrera",
    specialty: "Neurología",
    experience: 20,
    languages: ["Español", "Inglés"],
    available: false,
    photo: "/images/doctors/nicolas-herrera.png",
  },
  {
    name: "Dra. Valentina López",
    specialty: "Ginecología y Obstetricia",
    experience: 7,
    languages: ["Español"],
    available: true,
    photo: "/images/doctors/valentina-lopez.png",
  },
];
---

<section id="profesionales" class="directory" aria-label="Nuestros profesionales">
  <div class="directory-inner">
    <div class="directory-header animate-on-scroll">
      <h2 class="directory-title">Nuestros profesionales</h2>
      <p class="directory-subtitle">Médicos verificados, disponibles para tu consulta</p>
    </div>

    <div class="directory-marquee-wrapper">
      <div class="doctor-marquee">
        {doctors.map((d) => (
          <article class="doctor-card">
            <img class="doctor-avatar" src={d.photo} alt={d.name} loading="lazy" width="48" height="48" />
            <div class="doctor-info">
              <h3 class="doctor-name">{d.name}</h3>
              <p class="doctor-specialty">{d.specialty}</p>
              <div class="doctor-meta">
                <span>{d.experience} años exp.</span>
                <span class="doctor-meta-dot" aria-hidden="true" />
                <span>{d.languages.join(', ')}</span>
              </div>
              <div class="doctor-availability">
                <span class={`status-dot ${d.available ? 'available' : ''}`} aria-hidden="true" />
                <span>{d.available ? 'Disponible hoy' : 'Disponible mañana'}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="directory-cta animate-on-scroll">
      <p class="directory-cta-text">Más de 150 profesionales en la plataforma</p>
      <a href="#sintomas" class="directory-cta-link">
        Ver todas las especialidades
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .directory {
    padding: var(--section-py) var(--section-px);
    background: var(--au-surface);
  }

  .directory-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .directory-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .directory-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-medium);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }

  .directory-subtitle {
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
    margin: 0;
  }

  .directory-marquee-wrapper {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: var(--space-8) 0;
    overflow: hidden;
  }

  .doctor-marquee {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-6);
    padding: 0 var(--space-8);
    width: max-content;
  }

  .doctor-card {
    width: 360px;
    flex-shrink: 0;
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid rgba(255, 255, 255, 0.08); /* Premium subtle border */
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02); /* Glass background */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05); /* Inner light */
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); /* Smooth Apple-like easing */
  }

  .doctor-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.5), inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
  }

  .doctor-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid rgba(255, 255, 255, 0.1);
  }

  .doctor-info {
    min-width: 0;
  }

  .doctor-name {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-1);
  }

  .doctor-specialty {
    font-size: var(--text-sm);
    color: var(--au-text-secondary);
    margin: 0 0 var(--space-2);
  }

  .doctor-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--au-text-tertiary);
    margin-bottom: var(--space-3);
  }

  .doctor-meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--au-text-tertiary);
    flex-shrink: 0;
  }

  .doctor-availability {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--au-text-tertiary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--au-text-tertiary);
    flex-shrink: 0;
  }

  .status-dot.available {
    background: var(--portal-patients);
  }

  .directory-cta {
    text-align: center;
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--au-border);
  }

  .directory-cta-text {
    font-size: var(--text-sm);
    color: var(--au-text-tertiary);
    margin: 0 0 var(--space-4);
  }

  .directory-cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--au-text-primary);
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-6);
    transition: border-color var(--transition-base);
  }

  .directory-cta-link:hover {
    border-color: var(--au-border-hover);
  }

  @media (max-width: 640px) {
    .doctor-card {
      width: 300px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/dist/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── GSAP Mobile Best Practices ──
  ScrollTrigger.config({ ignoreMobileResize: true });

  if ('ontouchstart' in window) {
    ScrollTrigger.normalizeScroll({ allowNestedScroll: true });
  }

  const initMarquee = () => {
    const marquee = document.querySelector('.doctor-marquee') as HTMLElement;
    const wrapper = document.querySelector('.directory-marquee-wrapper') as HTMLElement;
    
    if (marquee && wrapper) {
      // GPU-accelerate the animated element
      marquee.style.willChange = 'transform';

      const containerWidth = marquee.offsetWidth;
      const windowWidth = window.innerWidth;
      
      if (containerWidth > windowWidth) {
        const scrollDistance = containerWidth - windowWidth + 64; 
        
        gsap.to(marquee, {
          x: -scrollDistance,
          ease: 'none',
          scrollTrigger: {
            trigger: wrapper,
            start: 'center center',
            end: () => `+=${scrollDistance}`,
            scrub: 1,
            pin: true,
            anticipatePin: 1
          }
        });
      }
    }
  };

  // Setup after render
  initMarquee();
</script>
