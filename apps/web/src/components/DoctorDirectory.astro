---
import { getI18n } from '../i18n';
const locale = Astro.locals.locale ?? 'es';
const { t, dict } = getI18n(locale);
const PHOTOS = [
  "/images/doctors/martin-alvarez.webp",
  "/images/doctors/carolina-vega.webp",
  "/images/doctors/lucas-fernandez.webp",
  "/images/doctors/sofia-ramirez.webp",
  "/images/doctors/nicolas-herrera.webp",
  "/images/doctors/valentina-lopez.webp",
];
const EXPERIENCE = [12, 8, 15, 10, 20, 7];
const AVAILABLE = [true, true, false, true, false, true];
const doctors = dict.landing.doctorDirectory.doctors.map((d, i) => ({
  ...d,
  experience: EXPERIENCE[i],
  available: AVAILABLE[i],
  photo: PHOTOS[i],
}));
---

<section id="profesionales" class="directory" aria-label="Nuestros profesionales">
  <div class="directory-inner">
    <div class="directory-header animate-on-scroll">
      <h2 class="directory-title">{t('landing.doctorDirectory.title')}</h2>
      <p class="directory-subtitle">{t('landing.doctorDirectory.subtitle')}</p>
    </div>

    <div class="directory-marquee-wrapper">
      <div class="doctor-marquee">
        {doctors.map((d) => (
          <article class="doctor-card">
            <img class="doctor-avatar" src={d.photo} alt={d.name} loading="lazy" width="56" height="56" />
            <div class="doctor-info">
              <h3 class="doctor-name">{d.name}</h3>
              <p class="doctor-specialty">{d.specialty}</p>
              <div class="doctor-meta">
                <span>{d.experience} {t('landing.doctorDirectory.yearsExp')}</span>
                <span class="doctor-meta-dot" aria-hidden="true" />
                <span>{d.languages.join(', ')}</span>
              </div>
              <div class="doctor-availability">
                <span class={`status-dot ${d.available ? 'available' : ''}`} aria-hidden="true" />
                <span>{d.available ? `${t('landing.doctorDirectory.available')} ${t('landing.doctorDirectory.today')}` : `${t('landing.doctorDirectory.available')} ${t('landing.doctorDirectory.tomorrow')}`}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="directory-cta animate-on-scroll">
      <p class="directory-cta-text">{t('landing.doctorDirectory.ctaText')}</p>
      <a href="#sintomas" class="directory-cta-link">
        {t('landing.doctorDirectory.ctaLink')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .directory {
    padding: var(--section-py) var(--section-px);
    background: var(--au-surface);
  }

  .directory-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .directory-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .directory-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.03em;
  }

  .directory-subtitle {
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
    margin: 0;
  }

  .directory-marquee-wrapper {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: var(--space-8) 0;
    overflow: hidden;
  }

  .doctor-marquee {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-6);
    padding: 0 var(--space-8);
    width: max-content;
  }

  .doctor-card {
    width: clamp(300px, 80vw, 360px);
    flex-shrink: 0;
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--au-glass-border);
    border-radius: var(--radius-md);
    background: var(--au-glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--au-glass-highlight);
    transition: all var(--au-transition-smooth);
  }

  .doctor-card:hover {
    border-color: var(--au-glass-border-hover);
    background: var(--au-glass-bg-hover);
    transform: translateY(-4px);
    box-shadow: var(--au-glass-shadow-hover);
  }

  .doctor-avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--au-glass-border-hover);
    box-shadow: 0 0 15px var(--au-glass-bg-hover);
    transition: transform var(--transition-base);
  }

  .doctor-card:hover .doctor-avatar {
    transform: scale(1.05);
    border-color: var(--au-border-hover);
  }

  .doctor-info {
    min-width: 0;
  }

  .doctor-name {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-1);
  }

  .doctor-specialty {
    font-size: var(--text-sm);
    color: var(--au-text-secondary);
    margin: 0 0 var(--space-2);
  }

  .doctor-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--au-text-tertiary);
    margin-bottom: var(--space-3);
  }

  .doctor-meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--au-text-tertiary);
    flex-shrink: 0;
  }

  .doctor-availability {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--au-text-tertiary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--au-text-tertiary);
    flex-shrink: 0;
  }

  .status-dot.available {
    background: var(--au-success);
  }

  .directory-cta {
    text-align: center;
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--au-border);
  }

  .directory-cta-text {
    font-size: var(--text-sm);
    color: var(--au-text-tertiary);
    margin: 0 0 var(--space-4);
  }

  .directory-cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--au-text-primary);
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-6);
    transition: border-color var(--transition-base);
  }

  .directory-cta-link:hover {
    border-color: var(--au-border-hover);
  }

  /* doctor-card uses clamp() for responsive width */
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/dist/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── GSAP Mobile Best Practices ──
  ScrollTrigger.config({ ignoreMobileResize: true });

  if ('ontouchstart' in window) {
    ScrollTrigger.normalizeScroll({ allowNestedScroll: true });
  }

  const initMarquee = () => {
    const marqueeEl = document.querySelector('.doctor-marquee');
    const wrapperEl = document.querySelector('.directory-marquee-wrapper');

    if (marqueeEl instanceof HTMLElement && wrapperEl instanceof HTMLElement) {
      // GPU-accelerate the animated element
      marqueeEl.style.willChange = 'transform';

      const containerWidth = marqueeEl.offsetWidth;
      const windowWidth = window.innerWidth;
      
      if (containerWidth > windowWidth) {
        const scrollDistance = containerWidth - windowWidth + 64; 
        
        gsap.to(marqueeEl, {
          x: -scrollDistance,
          ease: 'none',
          scrollTrigger: {
            trigger: wrapperEl,
            start: 'center center',
            end: () => `+=${scrollDistance}`,
            scrub: 1,
            pin: true,
            anticipatePin: 1
          }
        });
      }
    }
  };

  // Setup after render
  initMarquee();
</script>
