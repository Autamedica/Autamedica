---
const intents = [
  {
    title: 'Me siento mal y quiero hablar con un médico hoy',
    copy: 'Encontrá turno con un médico ahora mismo, sin guardia y sin traslado. La receta digital llega al celular.',
    href: '/platform',
    cta: 'Buscar médico disponible',
  },
  {
    title: 'Atiendo pacientes y quiero organizar mi agenda',
    copy: 'Agenda digital, videoconsulta y historia clínica en un solo lugar. Sin administración de más.',
    href: '/doctors',
    cta: 'Ver portal para médicos',
  },
  {
    title: 'Gestiono salud en una empresa',
    copy: 'Menos ausentismo, más salud. Tus empleados consultan desde el trabajo o su casa, sin perder medio día.',
    href: '/companies',
    cta: 'Ver solución para empresas',
  },
  {
    title: 'Quiero ver mis recetas y mi historial',
    copy: 'Todo tu historial clínico en un solo lugar. Recetas digitales, resultados y seguimiento desde el celular.',
    href: '/patients',
    cta: 'Entrar a mi perfil',
  },
];
---

<section id="necesidades" class="intent-links" aria-label="Explorar por necesidad">
  <div class="intent-inner">
    <div class="intent-header animate-on-scroll">
      <h2 class="intent-title">¿Qué necesitás hacer hoy?</h2>
      <p class="intent-subtitle">
        Elegí tu caso y empezá sin formularios largos ni llamadas telefónicas.
      </p>
    </div>

    <div class="intent-grid">
      {intents.map((intent) => (
        <article class="intent-card animate-on-scroll">
          <h3>{intent.title}</h3>
          <p>{intent.copy}</p>
          <a href={intent.href}>{intent.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .intent-links {
    padding: var(--section-py) var(--section-px);
    background: var(--au-surface);
  }

  .intent-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .intent-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .intent-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    color: var(--au-text-primary);
  }

  .intent-subtitle {
    margin: 0;
    color: var(--au-text-secondary);
    font-size: var(--text-lg);
  }

  .intent-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .intent-card {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(140deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.01)),
      var(--au-bg);
    padding: var(--space-6);
    display: grid;
    gap: var(--space-3);
    min-height: 230px;
  }

  .intent-card h3 {
    margin: 0;
    font-size: var(--text-xl);
    color: var(--au-text-primary);
    line-height: 1.25;
  }

  .intent-card p {
    margin: 0;
    color: var(--au-text-secondary);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .intent-card a {
    margin-top: auto;
    color: var(--au-text-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    width: fit-content;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .intent-card a:hover {
    color: white;
    border-color: white;
  }

  @media (max-width: 820px) {
    .intent-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
