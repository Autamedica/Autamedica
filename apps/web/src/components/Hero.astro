---
import { MagneticButton } from './ui/MagneticButton';

interface Metric {
  value: string;
  label: string;
}

interface RoleShortcut {
  label: string;
  href: string;
  accent: string;
}

interface Props {
  badge: string;
  title: string;
  titleAccent?: string;
  subtitle: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  metrics: Metric[];
  roleQuickAccess: RoleShortcut[];
}

const {
  badge,
  title,
  titleAccent,
  subtitle,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  metrics,
  roleQuickAccess,
} = Astro.props as Partial<Props>;

const safeBadge = badge ?? '';
const safeTitle = title ?? '';
const safeTitleAccent = titleAccent ?? '';
const safeSubtitle = subtitle ?? '';
const safePrimaryCtaLabel = primaryCtaLabel ?? '';
const safePrimaryCtaHref = primaryCtaHref ?? '';
const safeSecondaryCtaLabel = secondaryCtaLabel ?? '';
const safeSecondaryCtaHref = secondaryCtaHref ?? '';
const metricItems = Array.isArray(metrics) ? metrics : [];
const shortcutItems = Array.isArray(roleQuickAccess) ? roleQuickAccess : [];

const titleWords = safeTitle.split('\n').map(line => line.split(' ').filter(w => w.trim() !== ''));
---

<section class="hero" aria-label="Presentacion principal">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/hero_fallback.webp"
    aria-hidden="true"
  >
    <source src="/videos/hero_background.mp4" type="video/mp4" />
  </video>

  <div class="hero-overlay"></div>

  <div class="hero-content">
    <p class="hero-badge">{safeBadge}</p>
    <h1 id="hero-title" class="hero-title">
      {titleWords.map((line, li) => (
        <>
          {line.map((word) => (
            <span class="hero-word"><span class="hero-word-inner">{word}</span></span>
          ))}
          {li < titleWords.length - 1 && <br />}
        </>
      ))}
    </h1>
    {safeTitleAccent && <span class="hero-title-accent">{safeTitleAccent}</span>}
    <p class="hero-subtitle">{safeSubtitle}</p>
    <div class="hero-actions">
      <MagneticButton client:idle>
        <a href={safePrimaryCtaHref} class="btn-primary">
          {safePrimaryCtaLabel}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M19 12l-7 7-7-7" />
          </svg>
        </a>
      </MagneticButton>
      <MagneticButton client:idle>
        <a href={safeSecondaryCtaHref} class="btn-secondary">
          {safeSecondaryCtaLabel}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </MagneticButton>
    </div>
    {shortcutItems.length > 0 && (
      <div class="hero-role-shortcuts" aria-label="Acceso rápido por perfil">
        {shortcutItems.map((item) => (
          <a href={item.href} class="role-shortcut" style={`--shortcut-accent: ${item.accent};`}>
            {item.label}
          </a>
        ))}
      </div>
    )}

    {metricItems.length > 0 && (
      <div class="hero-metrics" aria-label="Metricas de la plataforma">
        {metricItems.map((m) => (
          <div class="hero-metric">
            <strong>{m.value}</strong>
            <span>{m.label}</span>
          </div>
        ))}
      </div>
    )}
  </div>

  <div class="hero-scroll-hint" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M19 12l-7 7-7-7" />
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh; /* Fallback for older browsers */
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: var(--au-bg);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    filter: brightness(1) saturate(1.1);
    pointer-events: none;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(255, 255, 255, 0.81) 0%,
        rgba(255, 255, 255, 0.72) 26%,
        rgba(255, 255, 255, 0.55) 42%,
        rgba(255, 255, 255, 0.24) 58%,
        rgba(255, 255, 255, 0.06) 74%,
        rgba(255, 255, 255, 0) 100%
      ),
      linear-gradient(to bottom, rgba(5, 5, 5, 0.06), rgba(5, 5, 5, 0.18));
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    padding: clamp(6rem, 15vh, 10rem) var(--section-px) var(--space-16);
  }

  .hero-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--au-accent);
    border: 1px solid rgba(34, 211, 238, 0.25);
    background: rgba(34, 211, 238, 0.06);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-title {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: var(--font-extrabold);
    line-height: 1.03;
    letter-spacing: -0.05em;
    color: var(--au-text-primary);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
  }

  .hero-word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }

  .hero-word-inner {
    display: inline-block;
    animation: hero-word-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-word:nth-child(1) .hero-word-inner { animation-delay: 0.1s; }
  .hero-word:nth-child(2) .hero-word-inner { animation-delay: 0.15s; }
  .hero-word:nth-child(3) .hero-word-inner { animation-delay: 0.2s; }
  .hero-word:nth-child(4) .hero-word-inner { animation-delay: 0.25s; }
  .hero-word:nth-child(5) .hero-word-inner { animation-delay: 0.3s; }
  .hero-word:nth-child(6) .hero-word-inner { animation-delay: 0.35s; }
  .hero-word:nth-child(7) .hero-word-inner { animation-delay: 0.4s; }
  .hero-word:nth-child(8) .hero-word-inner { animation-delay: 0.45s; }

  @keyframes hero-word-reveal {
    from {
      opacity: 0;
      transform: translateY(100%) rotate(3deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }
  }

  .hero-title-accent {
    display: block;
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: var(--font-extrabold);
    line-height: 1.03;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, var(--au-accent), #67e8f9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0 0 var(--space-6);
    opacity: 0;
    animation: accent-reveal 0.8s ease-out 1.2s forwards;
  }

  @keyframes accent-reveal {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    line-height: 1.6;
    font-weight: var(--font-medium);
    color: color-mix(in srgb, var(--au-text-primary) 88%, black);
    margin: 0 0 var(--space-8);
    max-width: 34ch;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-role-shortcuts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--au-bg);
    background: var(--au-accent);
    border-radius: var(--radius-sm);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--au-text-primary);
    border: 1px solid rgba(5, 5, 5, 0.12);
    background: rgba(255, 255, 255, 0.68);
    backdrop-filter: blur(10px);
    box-shadow: 0 14px 34px rgba(5, 5, 5, 0.08);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-base), background var(--transition-base), transform var(--transition-base);
  }

  .btn-secondary:hover {
    border-color: rgba(14, 165, 233, 0.28);
    background: rgba(255, 255, 255, 0.82);
    transform: translateY(-1px);
  }

  .role-shortcut {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    border-radius: var(--radius-full);
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--shortcut-accent) 58%, var(--au-border-hover));
    background: color-mix(in srgb, var(--shortcut-accent) 12%, transparent);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: color-mix(in srgb, var(--shortcut-accent) 82%, #fff);
    transition: transform var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
  }

  .role-shortcut:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--shortcut-accent) 78%, white);
    background: color-mix(in srgb, var(--shortcut-accent) 19%, transparent);
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid rgba(5, 5, 5, 0.12);
  }

  .hero-metric {
    font-size: var(--text-xs);
    color: var(--au-text-secondary);
    line-height: 1.4;
  }

  .hero-metric strong {
    display: block;
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--au-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-1);
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(5, 5, 5, 0.46);
    animation: float 3s ease-in-out infinite;
    z-index: 2;
  }

  @keyframes float {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-6px); }
  }

  /* Center on mobile */
  @media (max-width: 768px) {
    .hero {
      justify-content: center;
    }

    .hero-content {
      text-align: center;
      padding: clamp(5rem, 12vh, 8rem) var(--section-px) var(--space-12);
    }

    .hero-title {
      justify-content: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-metrics {
      justify-items: center;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      justify-content: center;
    }

    .hero-metrics {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      text-align: center;
    }

    .hero-role-shortcuts {
      justify-content: center;
    }
  }
</style>
