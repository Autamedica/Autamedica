---
import { buildAuthPath, buildRoleAuthPath } from '../lib/auth-flow';
import { TextReveal } from './ui/TextReveal';
import { MagneticButton } from './ui/MagneticButton';

const title = "Atención médica,\nsin salas de espera.";
const subtitle = "Una consulta de guardia puede tomar 3 horas entre traslados. Una videoconsulta, 15 minutos.";
const metrics = [
  { value: '15 min', label: 'tiempo promedio' },
  { value: '0', label: 'salas de espera' },
  { value: '94%', label: 'casos resueltos' },
];

const roleQuickAccess = [
  { label: 'Paciente', href: buildRoleAuthPath('login', 'patient'), accent: 'var(--portal-patients)' },
  { label: 'Médico', href: buildRoleAuthPath('login', 'doctor'), accent: 'var(--portal-doctors)' },
  { label: 'Empresa', href: buildRoleAuthPath('login', 'company_admin'), accent: 'var(--portal-companies)' },
];
---

<section class="hero" aria-label="Presentacion principal">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src="/videos/video1.mp4" type="video/mp4" />
  </video>

  <div class="hero-overlay"></div>

  <div class="hero-content">
    <p class="hero-badge">Plataforma HIPAA-compliant</p>
    <TextReveal text={title} className="hero-title" client:load delay={0.4} />
    <p class="hero-subtitle">{subtitle}</p>
    <div class="hero-actions">
      <MagneticButton client:load>
        <a href="#portales" class="btn-primary">
          Descubrir la plataforma
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M19 12l-7 7-7-7" />
          </svg>
        </a>
      </MagneticButton>
      <MagneticButton client:load>
        <a href={buildAuthPath('select-role', { returnTo: '/platform' })} class="btn-secondary">
          Acceder a mi perfil
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </MagneticButton>
    </div>
    <div class="hero-role-shortcuts" aria-label="Acceso rápido por perfil">
      {roleQuickAccess.map((item) => (
        <a href={item.href} class="role-shortcut" style={`--shortcut-accent: ${item.accent};`}>
          {item.label}
        </a>
      ))}
    </div>

    <div class="hero-metrics" aria-label="Metricas de la plataforma">
      {metrics.map((m, i) => (
        <>
          {i > 0 && <span class="hero-metrics-dot" aria-hidden="true" />}
          <span class="hero-metric">
            <strong>{m.value}</strong> {m.label}
          </span>
        </>
      ))}
    </div>
  </div>

  <div class="hero-scroll-hint" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M19 12l-7 7-7-7" />
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh; /* Fallback for older browsers */
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: var(--au-bg);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.42;
    filter: brightness(1.08) saturate(1.06);
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(9, 9, 11, 0.22) 0%,
      rgba(9, 9, 11, 0.1) 40%,
      rgba(9, 9, 11, 0.75) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    padding: clamp(6rem, 15vh, 10rem) var(--section-px) var(--space-16);
  }

  .hero-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--au-text-tertiary);
    border: 1px solid var(--au-border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-title {
    font-size: var(--text-5xl);
    font-weight: var(--font-medium);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--au-text-primary);
    margin: 0 0 var(--space-6);
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    line-height: 1.6;
    font-weight: var(--font-normal);
    color: var(--au-text-secondary);
    margin: 0 0 var(--space-8);
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-role-shortcuts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--au-bg);
    background: var(--au-accent);
    border-radius: var(--radius-sm);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--au-text-primary);
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-base);
  }

  .btn-secondary:hover {
    border-color: var(--au-border-hover);
  }

  .role-shortcut {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    border-radius: var(--radius-full);
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--shortcut-accent) 58%, var(--au-border-hover));
    background: color-mix(in srgb, var(--shortcut-accent) 12%, transparent);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: color-mix(in srgb, var(--shortcut-accent) 82%, #fff);
    transition: transform var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
  }

  .role-shortcut:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--shortcut-accent) 78%, white);
    background: color-mix(in srgb, var(--shortcut-accent) 19%, transparent);
  }

  .hero-metrics {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--au-border);
  }

  .hero-metric {
    font-size: var(--text-sm);
    color: var(--au-text-tertiary);
  }

  .hero-metric strong {
    color: var(--au-text-primary);
    font-weight: var(--font-semibold);
  }

  .hero-metrics-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--au-text-tertiary);
    flex-shrink: 0;
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    color: var(--au-text-tertiary);
    animation: float 3s ease-in-out infinite;
    z-index: 2;
  }

  @keyframes float {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-6px); }
  }

  /* Center on mobile */
  @media (max-width: 768px) {
    .hero {
      justify-content: center;
    }

    .hero-content {
      text-align: center;
      padding: clamp(5rem, 12vh, 8rem) var(--section-px) var(--space-12);
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-metrics {
      justify-content: center;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      justify-content: center;
    }

    .hero-metrics {
      flex-direction: column;
      gap: var(--space-2);
    }

    .hero-metrics-dot {
      display: none;
    }

    .hero-role-shortcuts {
      justify-content: center;
    }
  }
</style>
