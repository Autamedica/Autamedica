---
import { MagneticButton } from './ui/MagneticButton';

interface Metric {
  value: string;
  label: string;
}

interface RoleShortcut {
  label: string;
  href: string;
  accent: string;
}

interface Props {
  badge: string;
  title: string;
  titleAccent?: string;
  subtitle: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  metrics: Metric[];
  roleQuickAccess: RoleShortcut[];
}

const {
  badge,
  title,
  titleAccent,
  subtitle,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  metrics,
  roleQuickAccess,
} = Astro.props as Partial<Props>;

const safeBadge = badge ?? '';
const safeTitle = title ?? '';
const safeTitleAccent = titleAccent ?? '';
const safeSubtitle = subtitle ?? '';
const safePrimaryCtaLabel = primaryCtaLabel ?? '';
const safePrimaryCtaHref = primaryCtaHref ?? '';
const safeSecondaryCtaLabel = secondaryCtaLabel ?? '';
const safeSecondaryCtaHref = secondaryCtaHref ?? '';
const metricItems = Array.isArray(metrics) ? metrics : [];
const shortcutItems = Array.isArray(roleQuickAccess) ? roleQuickAccess : [];

const titleWords = safeTitle.split('\n').map(line => line.split(' ').filter(w => w.trim() !== ''));
---

<section class="hero" aria-label="Presentacion principal">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/hero_fallback.webp"
    aria-hidden="true"
  >
    <source src="/videos/hero_background.mp4" type="video/mp4" />
  </video>

  <div class="hero-overlay"></div>

  <div class="hero-content">
    <p class="hero-badge">{safeBadge}</p>
    <h1 id="hero-title" class="hero-title">
      {titleWords.map((line, li) => (
        <>
          {line.map((word) => (
            <span class="hero-word"><span class="hero-word-inner">{word}</span></span>
          ))}
          {li < titleWords.length - 1 && <br />}
        </>
      ))}
    </h1>
    {safeTitleAccent && <span class="hero-title-accent">{safeTitleAccent}</span>}
    <p class="hero-subtitle">{safeSubtitle}</p>
    <div class="hero-actions">
      <MagneticButton client:idle>
        <a href={safePrimaryCtaHref} class="btn-primary">
          {safePrimaryCtaLabel}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </MagneticButton>
      {safeSecondaryCtaLabel && (
        <a href={safeSecondaryCtaHref} class="hero-secondary-link">
          {safeSecondaryCtaLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
    {shortcutItems.length > 0 && (
      <div class="hero-role-shortcuts" aria-label="Acceso rapido por perfil">
        {shortcutItems.map((item) => (
          <a href={item.href} class="role-shortcut">
            {item.label}
          </a>
        ))}
      </div>
    )}

    {metricItems.length > 0 && (
      <div class="hero-metrics" aria-label="Metricas de la plataforma">
        {metricItems.map((m) => (
          <div class="hero-metric">
            <strong>{m.value}</strong>
            <span>{m.label}</span>
          </div>
        ))}
      </div>
    )}
  </div>

  <div class="hero-scroll-hint" aria-hidden="true">
    <div class="scroll-mouse">
      <div class="scroll-dot"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    overflow: hidden;
    background: #0a0a0a;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    pointer-events: none;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(10,10,10,0.3) 0%, rgba(10,10,10,0.1) 40%, rgba(10,10,10,0.7) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  @media (min-width: 1024px) {
    .hero-content {
      padding: 0 3rem 6rem;
    }
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.6s ease-out 0.3s forwards;
  }

  .hero-title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25em;
  }

  .hero-word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }

  .hero-word-inner {
    display: inline-block;
    animation: hero-word-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-word:nth-child(1) .hero-word-inner { animation-delay: 0.4s; }
  .hero-word:nth-child(2) .hero-word-inner { animation-delay: 0.5s; }
  .hero-word:nth-child(3) .hero-word-inner { animation-delay: 0.6s; }
  .hero-word:nth-child(4) .hero-word-inner { animation-delay: 0.7s; }
  .hero-word:nth-child(5) .hero-word-inner { animation-delay: 0.8s; }
  .hero-word:nth-child(6) .hero-word-inner { animation-delay: 0.9s; }

  @keyframes hero-word-reveal {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-title-accent {
    display: block;
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #0ea5e9;
    margin: 0 0 1.5rem;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1s forwards;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.1rem + 0.2vw, 1.25rem);
    line-height: 1.6;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.6);
    margin: 1.5rem 0 2.5rem;
    max-width: 520px;
    opacity: 0;
    animation: fadeUp 0.6s ease-out 0.8s forwards;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    opacity: 0;
    animation: fadeUp 0.6s ease-out 1s forwards;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 500;
    color: #0a0a0a;
    background: #ffffff;
    border-radius: 9999px;
    transition: background 0.2s ease, transform 0.2s ease;
    text-decoration: none;
  }

  .btn-primary:hover {
    background: #f5f5f5;
    transform: translateY(-1px);
  }

  .hero-secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .hero-secondary-link:hover {
    color: #ffffff;
  }

  .hero-role-shortcuts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    opacity: 0;
    animation: fadeUp 0.6s ease-out 1.2s forwards;
  }

  .role-shortcut {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 9999px;
    padding: 0 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .role-shortcut:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .hero-metrics {
    display: flex;
    gap: 2.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    opacity: 0;
    animation: fadeUp 0.6s ease-out 1.4s forwards;
  }

  .hero-metric {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-metric strong {
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
  }

  .hero-metric span {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.02em;
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0;
    animation: fadeUp 0.6s ease-out 1.6s forwards;
  }

  .scroll-mouse {
    width: 24px;
    height: 40px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .scroll-dot {
    width: 3px;
    height: 8px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 2px;
    animation: scrollDot 2s ease-in-out infinite;
  }

  @keyframes scrollDot {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(12px); opacity: 0; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
