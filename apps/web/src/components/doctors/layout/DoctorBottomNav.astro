---
import { Calendar, FileText, LayoutDashboard, User, Users } from 'lucide-react';

interface Props {
  activeTab?: 'inicio' | 'agenda' | 'pacientes' | 'recetas' | 'perfil';
}

const { activeTab } = Astro.props;

const TABS = [
  { key: 'inicio', label: 'Inicio', href: '/doctors/dashboard', icon: LayoutDashboard },
  { key: 'agenda', label: 'Agenda', href: '/doctors/agenda', icon: Calendar },
  { key: 'pacientes', label: 'Pacientes', href: '/doctors/patients', icon: Users },
  { key: 'recetas', label: 'Recetas', href: '/doctors/prescriptions', icon: FileText },
  { key: 'perfil', label: 'Perfil', href: '/doctors/perfil', icon: User },
];
---

<nav aria-label="Navegación médica" class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-200 bg-white/95 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] backdrop-blur-xl md:hidden">
  <div class="mx-auto flex max-w-lg items-center justify-around px-1 pb-[env(safe-area-inset-bottom)]">
    {TABS.map(({ key, label, href, icon: Icon }) => {
      const isActive = activeTab === key;

      return (
        <a
          href={href}
          aria-current={isActive ? 'page' : undefined}
          class={`flex min-w-0 flex-1 flex-col items-center gap-1 px-1 py-3 transition-colors ${
            isActive ? 'text-sky-700' : 'text-slate-500 hover:text-slate-900'
          }`}
        >
          <Icon class={`h-5 w-5 transition-transform ${isActive ? 'scale-110' : ''}`} />
          <span class={`text-[10px] font-medium ${isActive ? 'font-bold' : ''}`}>
            {label}
          </span>
        </a>
      );
    })}
  </div>
</nav>
