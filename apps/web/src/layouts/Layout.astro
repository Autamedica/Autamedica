---
import '../styles/globals.css';
import StructuredData from '../components/seo/StructuredData.astro';
import SeoMeta from '../components/seo/SeoMeta.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';
import { getI18n } from '../i18n/index';
import { resolvePublicClientEnv } from '../lib/runtime-env';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  robots?: string;
}

const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);

const {
  title = t('layout.defaultTitle'),
  description = t('layout.defaultDescription'),
  canonical,
  ogImage = '/images/seo/og-main.webp',
  ogType = 'website',
  publishedTime,
  robots = 'index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1',
} = Astro.props;

const fullTitle = title.includes('AutaMedica') ? title : `${title} | AutaMedica`;
const { publicSupabaseUrl, publicSupabaseAnonKey } = resolvePublicClientEnv(
  Astro.locals.runtime?.env,
);
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#09090b" />
    <meta name="format-detection" content="telephone=no" />
    <SeoMeta
      title={fullTitle}
      description={description}
      canonical={canonical}
      robots={robots}
      ogImage={ogImage}
      ogType={ogType}
      publishedTime={publishedTime}
      locale={locale === 'pt' ? 'pt_BR' : 'es_AR'}
      twitterSite="@autamedica"
      twitterCreator="@autamedica"
      keywords="telemedicina, consulta virtual, médico online, salud digital, consultas online, HIPAA, AutaMedica, receta digital, historia clínica digital, inteligencia artificial médica, telemedicina Argentina, consulta médica virtual"
    />

    <!-- Typography: Source Serif 4 (headlines) + Plus Jakarta Sans (body/UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Source+Serif+4:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Env vars for pre-compiled packages (@autamedica/auth) that can't use import.meta.env -->
    <script is:inline define:vars={{
      PUBLIC_SUPABASE_URL: publicSupabaseUrl,
      PUBLIC_SUPABASE_ANON_KEY: publicSupabaseAnonKey,
    }}>
      window.__ENV = { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY };
    </script>

    {import.meta.env.DEV && (
      <script type="module" is:inline>
        import RefreshRuntime from '/@react-refresh';
        RefreshRuntime.injectIntoGlobalHook(window);
        window.$RefreshReg$ = () => {};
        window.$RefreshSig$ = () => (type) => type;
        window.__vite_plugin_react_preamble_installed__ = true;
      </script>
    )}

    <!-- Fonts loaded via Google Fonts CDN (preconnect in <head>) -->

    <!-- Performance hints -->
    <link rel="preconnect" href="https://qxjjrpksmwwrmubhvjew.supabase.co" />
    <link rel="dns-prefetch" href="https://qxjjrpksmwwrmubhvjew.supabase.co" />

    <!-- Autores -->
    <meta name="author" content="E.M Medicina - UBA" />
    <meta name="creator" content="E.M Medicina - UBA" />
    <meta name="publisher" content="AutaMedica" />

    <!-- Favicon -->
    <link rel="icon" href="/images/brand/app_icon_glass.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/brand/app_icon_glass.png" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AutaMedica" />

    <!-- Structured Data -->
    <StructuredData />

    <!-- View Transitions API: transiciones cinematicas entre páginas -->
    <meta name="view-transition" content="same-origin" />

    <!-- Speculation Rules API: pre-renderiza páginas probables antes del click -->
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          {
            "where": {
              "href_matches": ["/patients", "/doctors", "/companies", "/auth/login", "/auth/register"]
            },
            "eagerness": "moderate"
          }
        ],
        "prefetch": [
          {
            "where": { "href_matches": "/*" },
            "eagerness": "conservative"
          }
        ]
      }
    </script>
  </head>
  <body class="antialiased">
    <a href="#main-content" class="skip-nav">Saltar al contenido</a>
    <ScrollProgress />
    <slot />
  </body>
</html>
