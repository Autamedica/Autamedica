---
import '../styles/globals.css';
import StructuredData from '../components/seo/StructuredData.astro';
import SeoMeta from '../components/seo/SeoMeta.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title = 'AutaMedica - Telemedicina sin fricciones',
  description = 'Plataforma de telemedicina innovadora. Conecta con profesionales de la salud, agenda consultas inmediatas y recibe atencion medica de calidad. Tecnologia segura HIPAA-compliant.',
  canonical,
  ogImage = '/og-image.jpg',
  robots = 'index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1',
} = Astro.props;

const fullTitle = title.includes('AutaMedica') ? title : `${title} | AutaMedica`;
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#09090b" />
    <meta name="format-detection" content="telephone=no" />
    <SeoMeta
      title={fullTitle}
      description={description}
      canonical={canonical}
      robots={robots}
      ogImage={ogImage}
      twitterSite="@autamedica"
      twitterCreator="@autamedica"
      keywords="telemedicina, consulta virtual, medico online, salud digital, consultas online, HIPAA, AutaMedica, receta digital, historia clinica digital, inteligencia artificial medica, telemedicina Argentina, consulta medica virtual"
    />

    <!-- Autores -->
    <meta name="author" content="E.M Medicina - UBA" />
    <meta name="creator" content="E.M Medicina - UBA" />
    <meta name="publisher" content="AutaMedica" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="AutaMedica" />

    <!-- Structured Data -->
    <StructuredData />
  </head>
  <body class="antialiased">
    <ScrollProgress />
    <slot />
  </body>
</html>
