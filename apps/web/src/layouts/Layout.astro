---
import '../styles/globals.css';
import StructuredData from '../components/seo/StructuredData.astro';
import SeoMeta from '../components/seo/SeoMeta.astro';
import GoogleTag from '../components/analytics/GoogleTag.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';
import CookieBanner from '../components/CookieBanner.astro';
import OfflineBanner from '../components/OfflineBanner.astro';
import FadeInObserver from '../components/FadeInObserver.astro';
import GrowthAttribution from '../components/GrowthAttribution.astro';
import DoctorBottomNav from '../components/doctors/layout/DoctorBottomNav.astro';
import { SentryInit } from '../components/SentryInit';
import { getI18n } from '../i18n/index';
import { resolvePublicClientEnv } from '../lib/runtime-env';
import { SessionSync as PatientSessionSync } from '../components/patients/SessionSync';
import { resolvePatientContext } from '../lib/patients/api/patient-context';
import CareCountrySelection from '../components/patients/CareCountrySelection.astro';
import PWAUpdatePrompt from '../components/PWAUpdatePrompt.astro';


interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  robots?: string;
}

const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);

const {
  title = t('layout.defaultTitle'),
  description = t('layout.defaultDescription'),
  canonical,
  ogImage = '/images/seo/og-main.webp',
  ogType = 'website',
  publishedTime,
  robots = 'index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1',
} = Astro.props;

const fullTitle = title.includes('AutaMedica') ? title : `${title} | AutaMedica`;
const { publicSupabaseUrl, publicSupabaseAnonKey, publicSentryDsn } = resolvePublicClientEnv(
  Astro.locals.runtime?.env,
);

const devPortal = import.meta.env.DEV ? Astro.url.searchParams.get('portal') : null;
const isPatientHost =
  Astro.url.hostname === 'paciente.autamedica.com' ||
  Astro.url.hostname === 'patients.autamedica.com' ||
  Astro.url.pathname.startsWith('/patients') ||
  devPortal === 'patient';
const isDoctorHost =
  Astro.url.hostname === 'doctor.autamedica.com' ||
  Astro.url.hostname === 'doctors.autamedica.com' ||
  Astro.url.pathname.startsWith('/doctors') ||
  devPortal === 'doctor';

// Prioridad: Query Params > Pathname
const section = Astro.url.searchParams.get('section');
const activeTabDoctor = 
  section === 'ranking' ? 'ranking' :
  section === 'telemedicina' ? 'telemedicina' :
  Astro.url.pathname.includes('/agenda') ? 'agenda' :
  Astro.url.pathname.includes('/dashboard') ? 'ranking' :
  Astro.url.pathname.includes('/call') ? 'telemedicina' :
  Astro.url.pathname.includes('/community') ? 'comunidad' :
  Astro.url.pathname.includes('/perfil') ? 'perfil' : 'agenda';
if (isPatientHost || isDoctorHost || Astro.locals.session) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.append('Vary', 'Cookie, Authorization');
}
const careContext = isPatientHost && Astro.locals.session
  ? await resolvePatientContext(Astro.request, Astro.locals) : null;
const needsCareCountry = Boolean(careContext && !careContext.careCountry);

---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="tiktok-developers-site-verification" content="OOlJfYZogPyxefjNgCZFlWd9scpoH3S5" />
    <meta name="format-detection" content="telephone=no" />
    <SeoMeta
      title={fullTitle}
      description={description}
      canonical={canonical}
      robots={robots}
      ogImage={ogImage}
      ogType={ogType}
      publishedTime={publishedTime}
      locale={locale === 'pt' ? 'pt_BR' : 'es_AR'}
      twitterSite="@autamedica"
      twitterCreator="@autamedica"
      keywords="telemedicina, consulta virtual, médico online, salud digital, consultas online, HIPAA, AutaMedica, receta digital, historia clínica digital, inteligencia artificial médica, telemedicina Argentina, consulta médica virtual"
    />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Source+Serif+4:wght@400;600;700&display=swap" rel="stylesheet" />

    <script is:inline define:vars={{
      PUBLIC_SUPABASE_URL: publicSupabaseUrl,
      PUBLIC_SUPABASE_ANON_KEY: publicSupabaseAnonKey,
      PUBLIC_SENTRY_DSN: publicSentryDsn,
    }}>
      window.__ENV = { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SENTRY_DSN };
    </script>

    {import.meta.env.DEV && (
      <script type="module" is:inline>
        import RefreshRuntime from '/@react-refresh';
        RefreshRuntime.injectIntoGlobalHook(window);
        window.$RefreshReg$ = () => {};
        window.$RefreshSig$ = () => (type) => type;
        window.__vite_plugin_react_preamble_installed__ = true;
      </script>
    )}

    <link rel="preconnect" href="https://qxjjrpksmwwrmubhvjew.supabase.co" />
    <link rel="icon" href="/images/brand/logo_bioceramic.png" type="image/png" />
    <link rel="manifest" href="/manifest.json" />
    <StructuredData />
    <GoogleTag />
    <script is:inline>
      function registerServiceWorker() {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('[PWA] Service Worker registrado exitosamente:', registration.scope);

              // Escuchar actualizaciones del Service Worker
              registration.addEventListener('updatefound', () => {
                const newWorker = registration.installing;
                if (newWorker) {
                  newWorker.addEventListener('statechange', () => {
                    if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                      console.log('[PWA] Nueva versión disponible, notificando a la UI');
                      window.dispatchEvent(new CustomEvent('pwa:update-available', { detail: registration }));
                    }
                  });
                }
              });
            })
            .catch((error) => {
              console.error('[PWA] Error registrando el Service Worker:', error);
            });

          // Detectar si el Service Worker tomó el control
          let refreshing = false;
          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (!refreshing) {
              refreshing = true;
              console.log('[PWA] Service Worker actualizado, recargando ventana');
              window.location.reload();
            }
          });
        }
      }

      // Registrar inmediatamente
      if (document.readyState === 'complete') {
        registerServiceWorker();
      } else {
        window.addEventListener('load', registerServiceWorker);
      }

      document.addEventListener('astro:after-swap', registerServiceWorker);
    </script>
  </head>
  <body class="antialiased">
    <SentryInit client:load />
    <GrowthAttribution />
    <ScrollProgress />
    {needsCareCountry ? <CareCountrySelection /> : <slot />}
    <OfflineBanner />
    <PWAUpdatePrompt />
    <CookieBanner />

    <FadeInObserver />

    {isPatientHost && <PatientSessionSync client:load />}
    {isDoctorHost && <DoctorBottomNav activeTab={activeTabDoctor} />}
  </body>
</html>

