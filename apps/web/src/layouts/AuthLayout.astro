---
import '../styles/globals.css';
import '../styles/auth.css';
import { SentryInit } from '../components/SentryInit';
import GoogleTag from '../components/analytics/GoogleTag.astro';
import SeoMeta from '../components/seo/SeoMeta.astro';
import { LanguageSwitcher } from '../components/LanguageSwitcher';
import { getI18n } from '../i18n/index';
import { resolvePublicClientEnv } from '../lib/runtime-env';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Acceso seguro a la plataforma AutaMedica',
  canonical,
} = Astro.props;

const locale = Astro.locals.locale ?? 'es';
const { t, dict } = getI18n(locale);
const testimonials = dict.landing.authLayout.testimonials;

const fullTitle = title.includes('AutaMedica') ? title : `${title} | AutaMedica`;
const currentPath = Astro.url.pathname;
const currentSearch = Astro.url.search;
const role = Astro.url.searchParams.get('role') || 'patient';

const themeClass = `theme-${role}`;

const authFlowLinks = [
  { href: '/auth/login', label: 'Iniciar sesión' },
  { href: '/auth/register', label: 'Crear cuenta' },
];
const { publicSupabaseUrl, publicSupabaseAnonKey, publicSentryDsn } = resolvePublicClientEnv(
  Astro.locals.runtime?.env,
);
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="no-referrer" />
    <SeoMeta
      title={fullTitle}
      description={description}
      canonical={canonical}
      robots="noindex, nofollow, noarchive"
      twitterCard="summary"
      includeHreflang={false}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Source+Serif+4:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Env vars for pre-compiled packages (@autamedica/auth) that can't use import.meta.env -->
    <script is:inline define:vars={{
      PUBLIC_SUPABASE_URL: publicSupabaseUrl,
      PUBLIC_SUPABASE_ANON_KEY: publicSupabaseAnonKey,
      PUBLIC_SENTRY_DSN: publicSentryDsn,
    }}>
      window.__ENV = { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SENTRY_DSN };
    </script>
    {import.meta.env.DEV && (
      <script type="module" is:inline>
        import RefreshRuntime from '/@react-refresh';
        RefreshRuntime.injectIntoGlobalHook(window);
        window.$RefreshReg$ = () => {};
        window.$RefreshSig$ = () => (type) => type;
        window.__vite_plugin_react_preamble_installed__ = true;
      </script>
    )}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <style>
      .auth-mobile-branding {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 0;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--au-border);
      }
      .auth-mobile-branding img {
        width: 40px;
        height: 40px;
        border-radius: 10px;
      }
      .auth-mobile-branding p {
        font-size: 0.875rem;
        color: var(--au-text-secondary);
        font-weight: 500;
      }
      @media (min-width: 1024px) {
        .auth-mobile-branding {
          display: none;
        }
      }
    </style>
    <GoogleTag />
  </head>
  <body class="antialiased">
    <SentryInit client:load />
    <div class:list={["auth-layout", themeClass]}>
      <!-- Left Panel: Branding + Experience -->
      <aside class="auth-panel-left">
        <div class="auth-panel-bg"></div>
        <div class="auth-panel-ambient"></div>
        
        <div class="auth-branding">
          <img src="/logo_bioceramic.png" alt="AutaMedica Logo" width="72" height="72" class="auth-logo-img" />
          <p class="auth-branding-tagline">{t('layout.tagline')}</p>
        </div>

        <div class="auth-testimonials">
          {testimonials.map((testimonial) => (
            <div class="auth-testimonial-card">
              <p class="auth-testimonial-quote">{testimonial.quote}</p>
              <div class="auth-testimonial-author">
                <div class="auth-testimonial-avatar">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <div>
                  <p class="auth-testimonial-name">{testimonial.name}</p>
                  <p class="auth-testimonial-role">{testimonial.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="auth-security-legend">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {t('common.hipaaLegend')}
        </div>
      </aside>

      <!-- Right Panel: Form Area -->
      <main class="auth-panel-right">
        <div class="auth-form-container">
          <a href="/" class="auth-back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            {t('common.backToHome')}
          </a>

          <nav class="auth-flow-nav" aria-label="Navegación de acceso">
            {authFlowLinks.map((link) => {
              const isCurrent = currentPath === link.href;
              const hrefWithSearch = `${link.href}${currentSearch}`;
              return (
                <a 
                  href={hrefWithSearch} 
                  class:list={{ 'is-current': isCurrent }} 
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </nav>

          <!-- Mobile branding: visible only below lg breakpoint -->
          <div class="auth-mobile-branding">
            <img src="/logo_bioceramic.png" alt="AutaMedica" width="40" height="40" />
            <p>{t('layout.tagline')}</p>
          </div>

          <slot />
        </div>

        <footer class="auth-footer">
          <div class="auth-footer-content">
            <div class="auth-footer-branding">
              <span class="auth-footer-logo-dot"></span>
              <span class="auth-footer-tagline">AutaMedica Precision Systems • {new Date().getFullYear()}</span>
            </div>
            <div class="auth-footer-links">
              <a href="/privacidad">{t('common.privacy')}</a>
              <span class="auth-footer-sep">•</span>
              <a href="/terms">{t('common.terms')}</a>
              <span class="auth-footer-sep">•</span>
              <a href="/privacidad">{t('common.accessibility')}</a>
            </div>
            <LanguageSwitcher currentLocale={locale} client:load />
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>
