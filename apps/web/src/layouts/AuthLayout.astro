---
import '../styles/globals.css';
import '../styles/auth.css';
import SeoMeta from '../components/seo/SeoMeta.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Acceso seguro a la plataforma AutaMedica',
  canonical,
} = Astro.props;

const fullTitle = title.includes('AutaMedica') ? title : `${title} | AutaMedica`;
const currentPath = Astro.url.pathname;
const currentSearch = Astro.url.search;
const role = Astro.url.searchParams.get('role') || 'patient';

const themeClass = `theme-${role}`;

const authFlowLinks = [
  { href: '/auth/select-role', label: 'Perfil' },
  { href: '/auth/login', label: 'Login' },
  { href: '/auth/register', label: 'Registro' },
];
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#09090b" />
    <meta name="format-detection" content="telephone=no" />
    <SeoMeta
      title={fullTitle}
      description={description}
      canonical={canonical}
      robots="noindex, nofollow, noarchive"
      twitterCard="summary"
      includeHreflang={false}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class="antialiased">
    <div class:list={["auth-layout", themeClass]}>
      <!-- Left Panel: Branding + Experience -->
      <aside class="auth-panel-left">
        <div class="auth-panel-bg"></div>
        <div class="auth-panel-ambient"></div>
        
        <div class="auth-branding">
          <img src="/logo_bioceramic.png" alt="AutaMedica Logo" width="72" height="72" class="auth-logo-img" />
          <p class="auth-branding-tagline">Infraestructura digital para la medicina moderna.</p>
        </div>

        <div class="auth-testimonials">
          <div class="auth-testimonial-card">
            <p class="auth-testimonial-quote">"Gestión de turnos y recetas en minutos. AutaMedica transformó mi práctica clínica por completo."</p>
            <div class="auth-testimonial-author">
              <div class="auth-testimonial-avatar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <div>
                <p class="auth-testimonial-name">Dra. Elena Rossi</p>
                <p class="auth-testimonial-role">Cardióloga</p>
              </div>
            </div>
          </div>

          <div class="auth-testimonial-card">
            <p class="auth-testimonial-quote">"La mejor experiencia de telemedicina que he tenido. Simple, rápida y con doctores de primer nivel."</p>
            <div class="auth-testimonial-author">
              <div class="auth-testimonial-avatar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              </div>
              <div>
                <p class="auth-testimonial-name">Marcos Viale</p>
                <p class="auth-testimonial-role">Paciente Platinum</p>
              </div>
            </div>
          </div>

          <div class="auth-testimonial-card">
            <p class="auth-testimonial-quote">"Implementamos AutaMedica en nuestra empresa y el bienestar de los empleados subió un 40%."</p>
            <div class="auth-testimonial-author">
              <div class="auth-testimonial-avatar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <p class="auth-testimonial-name">Sofía Méndez</p>
                <p class="auth-testimonial-role">HR Manager</p>
              </div>
            </div>
          </div>
        </div>

        <div class="auth-security-legend">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Infraestructura Segura HIPAA Compliant
        </div>
      </aside>

      <!-- Right Panel: Form Area -->
      <main class="auth-panel-right">
        <div class="auth-form-container">
          <a href="/" class="auth-back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Volver al inicio
          </a>

          <nav class="auth-flow-nav" aria-label="Navegación de acceso">
            {authFlowLinks.map((link) => {
              const isCurrent = currentPath === link.href;
              const hrefWithSearch = `${link.href}${currentSearch}`;
              return (
                <a 
                  href={hrefWithSearch} 
                  class:list={{ 'is-current': isCurrent }} 
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </nav>

          <slot />
        </div>

        <footer class="auth-footer">
          <div class="auth-footer-content">
            <div class="auth-footer-branding">
              <span class="auth-footer-logo-dot"></span>
              <span class="auth-footer-tagline">AutaMedica Precision Systems • {new Date().getFullYear()}</span>
            </div>
            <div class="auth-footer-links">
              <a href="#">Privacidad</a>
              <span class="auth-footer-sep">•</span>
              <a href="#">Términos</a>
              <span class="auth-footer-sep">•</span>
              <a href="#">Accesibilidad</a>
            </div>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>
