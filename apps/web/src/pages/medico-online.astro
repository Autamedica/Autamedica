---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.autamedica.com/medico-online';

const faqItems = [
  {
    question: '¿Cuándo conviene consultar con un médico online?',
    answer:
      'Cuando necesitás una evaluación inicial, seguimiento, renovación de receta o segunda opinión sin una urgencia vital.',
  },
  {
    question: '¿Un médico online puede indicar estudios o medicación?',
    answer:
      'Sí. Puede orientar, indicar estudios, ajustar tratamientos y emitir recetas digitales cuando el caso lo permite.',
  },
  {
    question: '¿Qué casos no son para una consulta virtual?',
    answer:
      'Dolor de pecho intenso, dificultad respiratoria severa, traumatismos, signos neurológicos agudos o cualquier emergencia que requiera atención presencial inmediata.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      name: 'Médico Online',
      url: canonicalUrl,
      description:
        'Landing para consultas con médico online en Argentina, con evaluación inicial, seguimiento y derivación cuando corresponde.',
      inLanguage: 'es-AR',
      about: [
        { '@type': 'MedicalSpecialty', name: 'PrimaryCare' },
        { '@type': 'Thing', name: 'Consulta médica online' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<Layout
  title="Médico Online en Argentina | AutaMedica"
  description="Consultá con un médico online para orientación clínica, seguimiento, recetas digitales y derivación cuando haga falta."
  canonical={canonicalUrl}
  ogImage="/images/seo/og-main.webp"
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />
  <Navbar />
  <main class="editorial-page">
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow">Acceso clínico</span>
        <h1>Médico online para cuando necesitás una respuesta clara, no una cadena de esperas.</h1>
        <p class="lede">
          Una consulta virtual no reemplaza todo. Pero resuelve mucho: síntomas iniciales, seguimiento,
          recetas, interpretación de estudios y la decisión más importante de todas, si podés continuar
          a distancia o si tenés que verte en persona.
        </p>
        <div class="actions">
          <a href="/auth/register" class="primary">Empezar consulta</a>
          <a href="/consulta-medica-online" class="secondary">Cómo funciona</a>
        </div>
      </div>
    </section>

    <section class="content">
      <div class="wrap grid">
        <article class="main">
          <section>
            <h2>Qué puede resolver un médico online</h2>
            <p>
              La mayoría de las consultas de baja y mediana complejidad empiezan con una buena historia clínica.
              Eso incluye fiebre, dolor de garganta, cuadros respiratorios, molestias digestivas, cefaleas,
              seguimiento de presión arterial, control de medicación y revisión de resultados.
            </p>
            <p>
              En la práctica, un médico online ordena el panorama: hace preguntas correctas, identifica señales
              de alarma y evita dos errores frecuentes, minimizar un cuadro serio o sobreactuar un problema que
              podía resolverse sin salir de casa.
            </p>
          </section>

          <section>
            <h2>Qué no debería pasar por una videollamada</h2>
            <p>
              Hay síntomas que cambian la conversación de inmediato: dolor de pecho intenso, falta de aire severa,
              pérdida de fuerza, convulsiones, traumatismos importantes, sangrado activo. En esos casos, la función
              de la telemedicina no es “resolver online”; es derivar rápido y con criterio.
            </p>
          </section>

          <section>
            <h2>Por qué una consulta general sigue siendo el mejor punto de entrada</h2>
            <p>
              Mucha gente busca directo un especialista. A veces hace falta. Muchas otras, no. Un médico general
              bien entrenado puede definir si el problema requiere cardiología, dermatología, salud mental u otra
              especialidad, y eso ahorra tiempo, dinero y vueltas innecesarias.
            </p>
          </section>

          <section aria-labelledby="faq-title">
            <h2 id="faq-title">Preguntas frecuentes</h2>
            <div class="faq-list">
              {faqItems.map((item) => (
                <details class="faq-item">
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        </article>

        <aside class="rail">
          <div class="rail-card">
            <p class="rail-title">Ideal para</p>
            <ul>
              <li>Síntomas nuevos no urgentes</li>
              <li>Seguimiento de tratamientos</li>
              <li>Resultados de estudios</li>
              <li>Recetas y ajustes de medicación</li>
            </ul>
          </div>
          <div class="rail-card">
            <p class="rail-title">Siguientes lecturas</p>
            <a href="/turno-medico-online">Turno médico online</a>
            <a href="/blog/cuales-son-los-3-tipos-de-telemedicina">Tipos de telemedicina</a>
            <a href="/especialidades">Especialidades médicas online</a>
          </div>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .editorial-page { min-height: 100vh; background: var(--au-bg); color: var(--au-text-primary); }
  .wrap { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; }
  .hero { padding: 5rem 0 3rem; border-bottom: 1px solid var(--au-border); background: linear-gradient(180deg, rgba(255,255,255,0.03), transparent); }
  .eyebrow { display: inline-block; margin-bottom: 1rem; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; }
  h1 { max-width: 900px; margin: 0; color: white; font-size: clamp(2.4rem, 6vw, 4.8rem); line-height: 1; font-weight: 600; letter-spacing: -0.04em; }
  .lede { max-width: 760px; margin: 1.5rem 0 0; color: #d1d5db; font-size: 1.15rem; line-height: 1.8; }
  .actions { display: flex; gap: 0.75rem; margin-top: 2rem; flex-wrap: wrap; }
  .primary, .secondary { text-decoration: none; border-radius: 999px; padding: 0.9rem 1.4rem; font-weight: 600; }
  .primary { background: #f3f4f6; color: #111827; }
  .secondary { border: 1px solid rgba(255,255,255,0.12); color: #e5e7eb; }
  .content { padding: 3rem 0 5rem; }
  .grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(280px, 0.9fr); gap: 2rem; align-items: start; }
  .main section { margin-bottom: 2.5rem; }
  h2 { color: white; font-size: 1.8rem; line-height: 1.2; margin: 0 0 1rem; font-weight: 500; }
  p { color: #cbd5e1; line-height: 1.85; font-size: 1.04rem; margin: 0 0 1rem; }
  .faq-list { display: grid; gap: 0.75rem; }
  .faq-item { border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; background: rgba(255,255,255,0.03); padding: 1rem 1.1rem; }
  .faq-item summary { cursor: pointer; color: white; font-weight: 600; }
  .faq-item p { margin-top: 0.75rem; }
  .rail { position: sticky; top: 1rem; display: grid; gap: 1rem; }
  .rail-card { border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; background: rgba(255,255,255,0.03); padding: 1rem; }
  .rail-title { color: white; font-weight: 600; margin-bottom: 0.75rem; }
  .rail-card ul { margin: 0; padding-left: 1.1rem; color: #cbd5e1; }
  .rail-card li { margin-bottom: 0.6rem; }
  .rail-card a { display: block; color: #93c5fd; text-decoration: none; margin-bottom: 0.75rem; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .rail { position: static; } }
</style>
