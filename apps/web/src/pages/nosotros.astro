---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = "Sobre AutaMedica | Institucional";
const description = "Conoce el propósito de AutaMedica: una infraestructura tecnológica diseñada para conectar pacientes y profesionales de la salud en Latinoamérica.";
---

<Layout title={title} description={description}>
  <Navbar />
  
  <main class="nosotros-page">
    <section class="section-institutional">
      <div class="container">
        <h1 class="brand-title">Infraestructura para la <span class="text-accent">salud digital</span>.</h1>
        
        <div class="content-grid">
          <div class="text-block">
            <h2>Nuestra Visión</h2>
            <p>
              AutaMedica es una plataforma de telemedicina y gestión clínica que busca reducir las barreras de acceso a la salud en mercados clave como Argentina, Ecuador, Colombia y el resto de Latinoamérica. Creemos que la tecnología debe servir como un puente eficiente entre el profesional médico y el paciente, garantizando agilidad en la consulta y seguridad en el manejo de la información.
            </p>
            
            <h2>Compromiso con la Calidad</h2>
            <p>
              Nuestro ecosistema integra herramientas de receta electrónica, historia clínica y soporte de inteligencia artificial clínica, diseñadas para optimizar la toma de decisiones médicas y mejorar la experiencia del paciente.
            </p>
          </div>

          <div class="sidebar-block">
            <div class="info-card">
              <h3>Pilares Técnicos</h3>
              <ul>
                <li>Seguridad de datos según estándares internacionales.</li>
                <li>Interoperabilidad clínica.</li>
                <li>Interfaces diseñadas para la simplicidad.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .nosotros-page {
    padding-top: 8rem;
    background: var(--au-bg);
    color: var(--au-text-primary);
    min-height: 80vh;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--section-px);
  }

  .section-institutional {
    padding: 4rem 0 8rem;
  }

  .brand-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    margin-bottom: 4rem;
    letter-spacing: -0.02em;
  }

  .text-accent {
    color: var(--au-accent);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
    color: #ffffff;
  }

  .text-block p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--au-text-secondary);
    margin-bottom: 1.5rem;
  }

  .info-card {
    background: var(--au-surface);
    border: 1px solid var(--au-border);
    padding: 2rem;
    border-radius: var(--radius-lg);
  }

  .info-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--au-accent);
  }

  .info-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .info-card li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--au-border);
    font-size: 0.9rem;
    color: var(--au-text-secondary);
  }

  .info-card li:last-child {
    border-bottom: none;
  }
</style>
