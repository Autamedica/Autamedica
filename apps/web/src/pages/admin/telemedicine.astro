---
import Layout from '@/layouts/Layout.astro';
import TelemedicineDashboard from '@/components/admin/TelemedicineDashboard';
import { resolveAdminRole } from '@/lib/admin/auth';

const title = 'Telemedicina — Admin | AutaMedica';
const description = 'Dashboard de observabilidad de telemedicina';

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/auth/login?returnTo=/admin/telemedicine&portal=admin');
}

const role = await resolveAdminRole(session, Astro.locals.supabase);
if (!role) {
  return Astro.redirect('/admin/unauthorized');
}
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gray-50">
    <header class="bg-white shadow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center gap-4">
            <a href="/admin" class="text-sm text-gray-500 hover:text-gray-700">&larr; Admin</a>
            <h1 class="text-xl font-semibold text-gray-900">
              Telemedicina
            </h1>
          </div>
        </div>
      </div>
    </header>
    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <TelemedicineDashboard client:load />
    </main>
  </div>
</Layout>
