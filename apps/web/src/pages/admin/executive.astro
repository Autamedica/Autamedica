---
import Layout from '@/layouts/Layout.astro';
import { ExecutiveKpiDashboard } from '@/components/admin/ExecutiveKpiDashboard';
import { resolveAdminRole } from '@/lib/admin/auth';

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/auth/login?returnTo=/admin/executive&portal=admin');
}
const role = await resolveAdminRole(session, Astro.locals.supabase);
if (role !== 'platform_admin' && role !== 'admin') {
  return Astro.redirect('/admin/unauthorized');
}
---

<Layout title="Dirección y rentabilidad | AutaMedica Admin" description="Indicadores ejecutivos verificados, por jurisdicción y período.">
  <div class="min-h-screen bg-slate-50">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-4 sm:px-6 lg:px-8">
        <div>
          <p class="text-xs font-semibold uppercase text-sky-700">AutaMedica Admin</p>
          <h1 class="text-xl font-semibold text-slate-950">Dirección y rentabilidad</h1>
          <p class="text-xs text-slate-500">Acceso autorizado: {role}</p>
        </div>
        <a href="/admin" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          Volver a Admin
        </a>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <ExecutiveKpiDashboard client:load />
    </main>
  </div>
</Layout>
