---
import Layout from '@/layouts/Layout.astro';
import { InvestorWorkspace } from '@/components/admin/InvestorWorkspace';
import { resolveAdminRole } from '@/lib/admin/auth';

const title = 'Inversores | AutaMedica Social Agents';
const description = 'Descubrimiento, CRM y conexiones para el pipeline de inversores de AutaMedica.';

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/auth/login?returnTo=/admin/investors&portal=admin');
}

const role = await resolveAdminRole(session, Astro.locals.supabase);
if (!role) {
  return Astro.redirect('/admin/unauthorized');
}
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-slate-50">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3">
          <a href="/admin" class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">← Admin</a>
          <div>
            <h1 class="text-lg font-semibold text-slate-950">Social Agents / Inversores</h1>
            <p class="text-xs text-slate-500">Rol activo: {role}</p>
          </div>
        </div>
        <a href="/admin/crm" class="text-sm font-semibold text-slate-600 hover:text-slate-950">CRM comercial</a>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <InvestorWorkspace client:load />
    </main>
  </div>
</Layout>
