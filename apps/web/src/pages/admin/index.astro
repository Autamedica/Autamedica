---
import Layout from '@/layouts/Layout.astro';
import { EmailRealtimeDashboard } from '@/components/admin/EmailRealtimeDashboard';
import { resolveAdminRole } from '@/lib/admin/auth';

const title = 'Panel de Administración | AutaMedica';
const description = 'Centro operativo de administración, growth, CRM y telemedicina de AutaMedica.';

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/auth/login?returnTo=/admin&portal=admin');
}

const role = await resolveAdminRole(session, Astro.locals.supabase);
if (!role) {
  return Astro.redirect('/admin/unauthorized');
}

const canViewExecutive = role === 'platform_admin' || role === 'admin';
const modules = [
  ...(canViewExecutive ? [{
    href: '/admin/executive',
    label: 'Dirección y rentabilidad',
    eyebrow: 'Indicadores ejecutivos',
    description: 'Consultas, cobros, documentos, tiempos de espera y referidos, con separación Argentina / Brasil y alertas de calidad.',
    metric: 'KPI reales',
    accent: 'border-blue-300',
  }] : []),
  {
    href: '/admin/doctors',
    label: 'Médicos & Staff',
    eyebrow: 'Operaciones',
    description: 'Control de matrículas, validación oficial SISA / REFEPS, tarifas y biografía profesional.',
    metric: 'Médicos',
    accent: 'border-sky-300',
  },
  {
    href: '/admin/growth',
    label: 'Growth OS',
    eyebrow: 'Adquisicion',
    description: 'Leads, newsletters, CAC, revenue atribuido y salud de sincronizacion Supabase.',
    metric: 'Embudo',
    accent: 'border-slate-300',
  },
  {
    href: '/admin/crm',
    label: 'CRM Outbound',
    eyebrow: 'Comercial',
    description: 'Pipeline B2B, cuentas, llamadas, WhatsApp y registro rapido de resultados.',
    metric: 'Cuentas',
    accent: 'border-emerald-300',
  },
  {
    href: '/admin/telemedicine',
    label: 'Telemedicina',
    eyebrow: 'Runtime',
    description: 'Observabilidad de llamadas, sesiones recientes, eventos y calidad operativa.',
    metric: 'Llamadas',
    accent: 'border-indigo-300',
  },
  {
    href: '/admin/patients',
    label: 'Pacientes',
    eyebrow: 'Demografia',
    description: 'Analisis etario, geografico y de coberturas de salud en tiempo real para growth.',
    metric: 'Poblacion',
    accent: 'border-amber-300',
  },
  {
    href: '/admin/clinical',
    label: 'Inteligencia Clínica',
    eyebrow: 'Data Science',
    description: 'Motor de alertas epidemiológicas tempranas, anomalías semanales de síntomas y datos SNOMED/CIE-11.',
    metric: 'Alertas',
    accent: 'border-rose-300',
  },
  {
    href: '/admin/finance',
    label: 'Finance Hub',
    eyebrow: 'Finanzas',
    description: 'Reconciliacion de pagos, liquidaciones bancarias a medicos y gestion de reembolsos/disputas.',
    metric: 'Billetera',
    accent: 'border-stone-400',
  },
];
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-slate-50">
    <header class="border-b border-slate-200 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex min-h-16 flex-col gap-1 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 class="text-xl font-semibold text-gray-900">
              AutaMedica Admin
            </h1>
            <p class="text-sm text-slate-500">Rol activo: {role}</p>
          </div>
          <nav class="flex flex-wrap gap-2 text-sm">
            {canViewExecutive && (
              <a href="/admin/executive" class="rounded-md border border-slate-300 bg-white px-3 py-2 font-medium text-slate-700 hover:border-blue-400 hover:text-blue-700">Dirección</a>
            )}
            <a href="/admin/doctors" class="rounded-md border border-slate-300 bg-white px-3 py-2 font-medium text-slate-700 hover:border-sky-400 hover:text-sky-700">Médicos</a>
            <a href="/admin/growth" class="rounded-md border border-slate-300 bg-white px-3 py-2 font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">Growth</a>
            <a href="/admin/crm" class="rounded-md border border-slate-300 bg-white px-3 py-2 font-medium text-slate-700 hover:border-emerald-400 hover:text-emerald-700">CRM</a>
            <a href="/admin/telemedicine" class="rounded-md border border-slate-300 bg-white px-3 py-2 font-medium text-slate-700 hover:border-indigo-400 hover:text-indigo-700">Telemedicina</a>
            <a href="/admin/patients" class="rounded-md border border-slate-300 bg-white px-3 py-2 font-medium text-slate-700 hover:border-amber-400 hover:text-amber-700">Pacientes</a>
            <a href="/admin/clinical" class="rounded-md border border-slate-300 bg-white px-3 py-2 font-medium text-slate-700 hover:border-rose-400 hover:text-rose-700">Clínica</a>
            <a href="/admin/finance" class="rounded-md border border-slate-300 bg-white px-3 py-2 font-medium text-slate-700 hover:border-stone-400 hover:text-stone-900">Finanzas</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto space-y-8 px-4 py-8 sm:px-6 lg:px-8">
      <section class="grid gap-6 lg:grid-cols-[1.3fr_0.7fr]">
        <div>
          <p class="text-xs font-bold uppercase tracking-wide text-sky-700">Centro operativo</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-normal text-slate-950">
            Panel de administracion
          </h2>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">
            Acceso directo a los tableros ya implementados: adquisicion, CRM, emails en tiempo real y observabilidad de telemedicina.
          </p>
        </div>
        <div class="rounded-md border border-slate-200 bg-white p-4">
          <p class="text-xs font-semibold uppercase text-slate-500">Estado de superficie</p>
          <div class="mt-3 space-y-2 text-sm">
            <div class="flex items-center justify-between">
              <span class="text-slate-600">Autenticacion admin</span>
              <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">activa</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-600">Modulos visibles</span>
              <span class="font-semibold text-slate-950">{modules.length}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-600">Email realtime</span>
              <span class="rounded-full bg-sky-50 px-2 py-1 text-xs font-semibold text-sky-700">embebido</span>
            </div>
          </div>
        </div>
      </section>

      <section class="grid gap-4 md:grid-cols-3">
        {modules.map((module) => (
          <a
            href={module.href}
            class={`group block rounded-md border ${module.accent} bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md`}
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">{module.eyebrow}</p>
                <h3 class="mt-2 text-lg font-semibold text-slate-950">{module.label}</h3>
              </div>
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">{module.metric}</span>
            </div>
            <p class="mt-4 min-h-16 text-sm leading-6 text-slate-600">{module.description}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-sky-700 group-hover:text-sky-900">
              Abrir modulo
            </span>
          </a>
        ))}
      </section>

      <section>
        <EmailRealtimeDashboard client:load />
      </section>
    </main>
  </div>
</Layout>
