---
import Layout from '@/layouts/Layout.astro';
import { EmailRealtimeDashboard } from '@/components/admin/EmailRealtimeDashboard';


const title = 'Panel de Administración | AutaMedica';
const description = 'Panel de administración de AutaMedica';

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/auth/login?returnTo=/admin&portal=admin');
}

const role = (session.user.user_metadata as Record<string, unknown>)?.role;
if (typeof role !== 'string' || !['admin', 'organization_admin', 'platform_admin'].includes(role)) {
  return Astro.redirect('/admin/unauthorized');
}
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gray-50">
    <header class="bg-white shadow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <h1 class="text-xl font-semibold text-gray-900">
              AutaMedica Admin
            </h1>
          </div>
        </div>
      </div>
    </header>
    <main>
      <div class="max-w-3xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">
            Panel de Administración
          </h2>
          <p class="text-gray-500 text-sm">
            Este panel está en desarrollo. Las secciones disponibles se listan a continuación.
          </p>
        </div>

        <div class="space-y-4">
          <a
            href="/admin/telemedicine"
            class="block bg-white p-6 rounded-lg shadow-sm border border-gray-200 hover:border-blue-300 hover:shadow transition-all"
          >
            <h3 class="text-lg font-medium text-gray-900 mb-1">
              Telemedicina
            </h3>
            <p class="text-gray-500 text-sm">
              Observabilidad de llamadas, estado de sesiones y métricas de calidad.
            </p>
          </a>

          <a
            href="/admin/growth"
            class="block bg-white p-6 rounded-lg shadow-sm border border-gray-200 hover:border-blue-300 hover:shadow transition-all"
          >
            <div class="flex justify-between items-start">
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-1">
                  Growth & Marketing
                </h3>
                <p class="text-gray-500 text-sm">
                  Métricas de adquisición, leads, embudo de conversión y atribución de revenue.
                </p>
              </div>
              <span class="text-xs font-medium bg-green-50 text-green-700 px-2 py-0.5 rounded-full">Growth OS</span>
            </div>
          </a>

          
          <div class="mb-8">
            <EmailRealtimeDashboard client:load />
          </div>

          <div class="bg-gray-50 p-6 rounded-lg border border-dashed border-gray-300">
            <p class="text-sm font-medium text-gray-500 mb-3">
              Secciones en desarrollo
            </p>
            <ul class="text-sm text-gray-400 space-y-1">
              <li>Gestión de usuarios (médicos, pacientes, empresas)</li>
              <li>Configuración y monitoreo del sistema</li>
            </ul>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
