---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';

const specialties = [
  {
    id: 'general',
    name: 'Medicina General',
    tagline: 'Atención primaria integral.',
    description: 'Nuestra primera línea de atención para diagnósticos iniciales, triaje clínico y seguimiento de salud preventiva 24/7.',
    href: '/medico-online',
    icon: 'Stethoscope'
  },
  {
    id: 'psychiatry',
    name: 'Psiquiatría',
    tagline: 'Salud mental y medicina farmacológica.',
    description: 'Evaluación diagnóstica médica, abordaje de ansiedad, depresión, insomnio y TDAH en adultos, y seguimiento farmacológico con recetas oficiales.',
    href: '/psiquiatra-online',
    icon: 'BrainCircuit'
  },
  {
    id: 'psy',
    name: 'Psicología',
    tagline: 'Salud mental y bienestar.',
    description: 'Sesiones privadas con especialistas en manejo de ansiedad, depresión, estrés y acompañamiento terapéutico continuo.',
    href: '/psicologo-online',
    icon: 'Brain'
  },
  {
    id: 'derma',
    name: 'Dermatología',
    tagline: 'Excelencia en salud cutánea.',
    description: 'Evaluación profesional de lesiones, acné, afecciones crónicas y consultas de prevención oncológica de la piel.',
    href: '/dermatologo-online',
    icon: 'Sparkles'
  },
  {
    id: 'cardio',
    name: 'Cardiología',
    tagline: 'Cuidado cardiovascular avanzado.',
    description: 'Control de hipertensión, evaluación de riesgo coronario y seguimiento de patologías cardíacas crónicas.',
    href: '/cardiologo-online',
    icon: 'Heart'
  },
  {
    id: 'pedia',
    name: 'Pediatría',
    tagline: 'Atención especializada infantil.',
    description: 'Consultas de desarrollo, pediatría de urgencia y seguimiento integral para la salud de los más pequeños.',
    href: '/patients?specialty=pediatrics',
    icon: 'Baby'
  },
  {
    id: 'gastro',
    name: 'Gastroenterología',
    tagline: 'Especialistas en salud digestiva.',
    description: 'Tratamiento de trastornos digestivos, reflujo, gastritis y patologías del tracto gastrointestinal.',
    href: '/patients?specialty=gastroenterology',
    icon: 'Activity'
  },
  {
    id: 'neuro',
    name: 'Neurología',
    tagline: 'Diagnóstico neurológico preciso.',
    description: 'Atención especializada en migrañas, trastornos del sistema nervioso y afecciones neurológicas complejas.',
    href: '/patients?specialty=neurology',
    icon: 'Zap'
  }
];
---

<Layout title="AutaMedica | Especialidades Médicas y Cuerpo Profesional" description="Directorio institucional de especialidades médicas. Médicos certificados en Medicina General, Psicología, Dermatología y más especialidades de alta complejidad.">
  <Navbar />
  
  <main class="bg-white text-neutral-900 pt-32 pb-20">
    <!-- Institutional Header -->
    <header class="container mx-auto px-6 py-20 text-left border-b border-neutral-100">
      <div class="max-w-4xl">
        <span class="text-[var(--au-accent)] font-bold text-xs uppercase tracking-widest mb-6 block">Directorio Médico Oficial</span>
        <h1 class="text-5xl md:text-7xl font-serif font-medium leading-tight tracking-tight text-neutral-950 mb-8">
          Excelencia clínica en <br/> 
          <span class="text-neutral-500 italic">múltiples disciplinas.</span>
        </h1>
        <p class="text-xl text-neutral-600 max-w-2xl font-light leading-relaxed">
          Cada departamento de AutaMedica está liderado por profesionales certificados, garantizando un estándar uniforme de calidad asistencial en toda nuestra red.
        </p>
      </div>
    </header>

    <!-- Professional Directory List -->
    <section class="container mx-auto px-6 py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-20">
        {specialties.map((s) => (
          <div class="specialty-entry group">
            <div class="flex flex-col md:flex-row gap-8 items-start">
              <div class="flex-shrink-0 w-16 h-16 rounded-full bg-neutral-50 border border-neutral-100 flex items-center justify-center text-[var(--au-accent)] transition-colors group-hover:bg-neutral-950 group-hover:text-white group-hover:border-neutral-950">
                {s.id === 'general' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h1a.3.3 0 1 0 .2-.3M7 2h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM12 11v10m-4-2h8"/></svg>}
                {s.id === 'psychiatry' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.04z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.04z"/></svg>}
                {s.id === 'psy' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
                {s.id === 'derma' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12h8m-4-4v8"/></svg>}
                {(!['general', 'psychiatry', 'psy', 'derma'].includes(s.id)) && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              </div>
              
              <div class="space-y-4">
                <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-neutral-400">{s.tagline}</h3>
                <h2 class="text-3xl font-serif font-bold text-neutral-900 group-hover:text-[var(--au-accent)] transition-colors">
                  {s.name}
                </h2>
                <p class="text-neutral-600 leading-relaxed max-w-md">
                  {s.description}
                </p>
                <div class="pt-4">
                  <a href={s.href} class="text-sm font-bold border-b-2 border-neutral-100 group-hover:border-[var(--au-accent)] pb-1 transition-all">
                    Consultar Especialista
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Institutional Quality Section -->
    <section class="py-32 bg-neutral-50 border-y border-neutral-100">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-4xl font-serif font-bold mb-12">Calidad médica sin compromisos.</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div>
              <div class="text-3xl font-serif font-bold text-neutral-900 mb-2">100%</div>
              <p class="text-xs uppercase tracking-widest text-neutral-400 font-bold">Médicos Matriculados</p>
            </div>
            <div>
              <div class="text-3xl font-serif font-bold text-neutral-900 mb-2">Auditado</div>
              <p class="text-xs uppercase tracking-widest text-neutral-400 font-bold">Protocolos Clínicos</p>
            </div>
            <div>
              <div class="text-3xl font-serif font-bold text-neutral-900 mb-2">Encriptado</div>
              <p class="text-xs uppercase tracking-widest text-neutral-400 font-bold">Historial Médico</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTAFinal
      title="Atención profesional a su alcance."
      subtitle="Elija la especialidad que necesita y conecte con un profesional certificado ahora."
      buttonLabel="Ver todos los Médicos"
      buttonHref="/patients"
    />
  </main>

  <Footer />
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap');

  main {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  h1, h2, h3, .font-serif {
    font-family: 'Source Serif 4', serif;
  }

  .specialty-entry {
    animation: reveal linear forwards;
    animation-timeline: view();
    animation-range: entry 5% cover 25%;
  }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
