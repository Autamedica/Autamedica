---
import CallLayout from '@/layouts/CallLayout.astro';
import PharmacyCareAccess from '@/components/pharmacy/PharmacyCareAccess.astro';

export const prerender = false;

const pharmacyId = Astro.url.searchParams.get('pharmacyId');
const title = 'Consulta Exprés en Farmacia • Red AutaMedica';
const description = 'Punto de atención médica digital AutaMedica en farmacia con videoconsulta de guardia inmediata y evaluación médica según tu país de atención.';
---

<CallLayout title={title} description={description}>
  <PharmacyCareAccess
    pharmacyId={pharmacyId}
  />
</CallLayout>

