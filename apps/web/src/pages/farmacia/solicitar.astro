---
import CallLayout from '@/layouts/CallLayout.astro';
import { PharmacyExpressConsultation } from '@/components/pharmacy/PharmacyExpressConsultation';
import { createAstroAdminClient } from '@/lib/supabase';
import type { SupabaseClient } from '@supabase/supabase-js';
import { hasSecureGuestPaymentSecret } from '@/lib/pharmacy/payments/guest-payment-access';
import { getOperationalPaymentSwitches } from '@/lib/payments/operational-switches';

export const prerender = false;

const pharmacyId = Astro.url.searchParams.get('pharmacyId');
const requestedReferral = Astro.url.searchParams.get('ref')?.trim().toUpperCase() ?? null;
let referralCode: string | null = null;
let referralPartnerName: string | null = null;
if (requestedReferral && /^[A-Z0-9_-]{3,32}$/.test(requestedReferral)) {
  try {
    const admin = createAstroAdminClient(Astro.locals.runtime?.env) as any;
    const { data: partner } = await (admin as unknown as SupabaseClient)
      .from('commercial_referral_partners').select('code, display_name')
      .eq('code', requestedReferral).eq('active', true).maybeSingle();
    if (partner) { referralCode = partner.code; referralPartnerName = partner.display_name; }
  } catch { /* No unverified attribution if partner registry is unavailable. */ }
}
let pharmacyName = 'Punto de Farmacia';
if (pharmacyId) {
  try {
    const admin = createAstroAdminClient(Astro.locals.runtime?.env);
    const { data } = await admin.from('pharmacies').select('name').eq('id', pharmacyId).maybeSingle();
    if (data?.name) pharmacyName = data.name;
  } catch { /* Keep the default pharmacy label. */ }
}

let jordanPaymentsEnabled = false;
let pharmacyPaymentsEnabled = false;
try {
  const switches = await getOperationalPaymentSwitches(createAstroAdminClient(Astro.locals.runtime?.env) as any);
  pharmacyPaymentsEnabled = switches.pharmacy_express_payments_enabled;
  jordanPaymentsEnabled = switches.jordan_qr_payments_enabled && switches.pharmacy_express_payments_enabled
    && hasSecureGuestPaymentSecret(Astro.locals.runtime?.env);
} catch {
  // Fail closed when platform controls cannot be read.
}

// The local Playwright fixture exercises intake dispatch independently of the
// production payment switch. This override is impossible in production builds.
if (import.meta.env.DEV && Astro.locals.runtime?.env?.AUTAMEDICA_E2E_PHARMACY_DISPATCH === 'true') {
  pharmacyPaymentsEnabled = true;
}

const title = 'Consulta Exprés en Farmacia • Red AutaMedica';
const description = 'Punto de atención de telemedicina de AutaMedica. Los documentos médicos dependen del profesional y de la habilitación correspondiente al país de atención.';
---

<CallLayout title={title} description={description}>
  <PharmacyExpressConsultation
    client:load
    pharmacyId={pharmacyId}
    pharmacyName={pharmacyName}
    referralCode={referralCode}
    referralPartnerName={referralPartnerName}
    jordanPaymentsEnabled={jordanPaymentsEnabled}
    pharmacyPaymentsEnabled={pharmacyPaymentsEnabled}
  />
</CallLayout>
