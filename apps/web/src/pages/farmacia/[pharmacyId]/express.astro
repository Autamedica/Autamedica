---
import CallLayout from '@/layouts/CallLayout.astro';
import { PharmacyExpressConsultation } from '@/components/pharmacy/PharmacyExpressConsultation';
import { createAstroAdminClient } from '@/lib/supabase';
import { getOperationalPaymentSwitches } from '@/lib/payments/operational-switches';

export const prerender = false;

const { pharmacyId } = Astro.params;
let pharmacyName = 'Farmacia Adherida';

if (pharmacyId) {
  try {
    const admin = createAstroAdminClient(Astro.locals.runtime?.env);
    const { data } = await admin
      .from('pharmacies')
      .select('name')
      .eq('id', pharmacyId)
      .maybeSingle();

    if (data?.name) {
      pharmacyName = data.name;
    }
  } catch {
    // Si falla o el id no es uuid, mantiene default
  }
}

let pharmacyPaymentsEnabled = false;
try {
  const switches = await getOperationalPaymentSwitches(createAstroAdminClient(Astro.locals.runtime?.env));
  pharmacyPaymentsEnabled = switches.pharmacy_express_payments_enabled;
} catch {
  // Fail closed when platform controls cannot be read.
}


let pricingByCountry: Partial<Record<'AR' | 'BR', {
  currency: 'ARS' | 'BRL';
  consultation_price_minor: number;
  doctor_fee_minor: number;
  partner_commission_minor: number;
  require_payment_before_dispatch: boolean;
}>> = {};
try {
  const pricingAdmin = createAstroAdminClient(Astro.locals.runtime?.env) as any;
  const { data } = await pricingAdmin.from('pharmacy_dispatch_pricing_configs')
    .select('country_code,currency,consultation_price_minor,doctor_fee_minor,partner_commission_minor,require_payment_before_dispatch');
  for (const row of data ?? []) {
    if (row.country_code === 'AR' || row.country_code === 'BR') pricingByCountry[row.country_code] = row;
  }
} catch {
  // The form reports an explicit pricing configuration error when a tariff is absent.
}

const title = `Consulta Exprés • ${pharmacyName} • AutaMedica`;
const description = `Punto de atención por videollamada AutaMedica en ${pharmacyName}. La emisión documental depende del profesional y de la habilitación correspondiente.`;
---

<CallLayout title={title} description={description}>
  <PharmacyExpressConsultation
    client:load
    pharmacyId={pharmacyId}
    pharmacyName={pharmacyName}
    pharmacyPaymentsEnabled={pharmacyPaymentsEnabled}
    pricingByCountry={pricingByCountry}
  />
</CallLayout>
