---
export const prerender = false;

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.autamedica.android';

// 302 redirect directly to Google Play Store
return Astro.redirect(playStoreUrl, 302);
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="refresh" content={`0;url=${playStoreUrl}`} />
  <title>Descargar AutaMedica en Google Play</title>
  <script is:inline define:vars={{ playStoreUrl }}>
    window.location.href = playStoreUrl;
  </script>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: center; padding: 48px 24px; background: #f8fafc; color: #0f172a;">
  <div style="max-width: 420px; margin: 0 auto; background: #ffffff; border-radius: 16px; padding: 32px 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;">
    <h1 style="font-size: 20px; font-weight: 700; margin-bottom: 12px; color: #0f172a;">AutaMedica Guardia</h1>
    <p style="font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 24px;">
      Redirigiendo a Google Play Store para descargar la app oficial...
    </p>
    <a href={playStoreUrl} style="display: inline-block; background: #2563eb; color: #ffffff; padding: 12px 24px; border-radius: 12px; font-weight: 600; text-decoration: none; font-size: 14px;">
      Descargar en Google Play
    </a>
  </div>
</body>
</html>
