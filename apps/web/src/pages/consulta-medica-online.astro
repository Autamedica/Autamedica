---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import NewsletterCapture from '../components/NewsletterCapture.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';

const title = "AutaMedica | Consulta Médica Online Certificada";
const description = "Atención médica profesional inmediata. Conecta con médicos especialistas certificados mediante videoconsulta segura. Receta digital y seguimiento clínico integral.";

const faqs = [
  { q: "¿Cómo se garantiza la calidad de la atención?", a: "Todos los profesionales de AutaMedica son médicos matriculados con especialidades validadas ante los organismos de salud correspondientes. Realizamos auditorías periódicas de los protocolos clínicos aplicados." },
  { q: "¿La receta digital es aceptada en todas las farmacias?", a: "Sí, nuestras recetas cumplen con la normativa vigente de firma digital y electrónica, siendo válidas en redes de farmacias nacionales e independientes." },
  { q: "¿Cómo accedo a mi historial médico?", a: "Tu historial está disponible de forma permanente en tu perfil personal, protegido bajo estrictas normas de privacidad y encriptación de datos médicos." }
];
---

<Layout title={title} description={description}>
  <Navbar />
  
  <main class="bg-white text-neutral-900 overflow-hidden pt-20">
    <!-- HERO: INSTITUTIONAL TRUST -->
    <section class="relative py-24 md:py-32 border-b border-neutral-100">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl">
          <span class="inline-block text-[var(--au-accent)] font-bold text-xs uppercase tracking-widest mb-6">
            Institución de Salud Digital
          </span>
          <h1 class="text-5xl md:text-7xl font-serif font-medium leading-[1.1] tracking-tight text-neutral-950 mb-8">
            Atención médica profesional, <br/> 
            <span class="text-neutral-500 italic">donde usted se encuentre.</span>
          </h1>
          <p class="text-xl md:text-2xl text-neutral-600 max-w-2xl font-light leading-relaxed mb-12">
            AutaMedica conecta la excelencia clínica con la agilidad de la tecnología digital. Obtenga su consulta, diagnóstico y receta en minutos.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/auth/register" class="btn-institutional">
              Agendar Consulta
            </a>
            <a href="/especialidades" class="btn-outline">
              Ver Especialidades
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- PROPOSITIONS: STRUCTURED & CLEAN -->
    <section class="py-24 bg-neutral-50">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div class="space-y-6">
            <div class="text-[var(--au-accent)]">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="text-xl font-serif font-bold">Inmediatez Clínica</h3>
            <p class="text-neutral-600 leading-relaxed">Reducimos los tiempos de espera a menos de 15 minutos, permitiendo una resolución rápida de cuadros ambulatorios sin necesidad de traslados.</p>
          </div>
          
          <div class="space-y-6">
            <div class="text-[var(--au-accent)]">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M22 11l-3 3 3 3"/></svg>
            </div>
            <h3 class="text-xl font-serif font-bold">Médicos Matriculados</h3>
            <p class="text-neutral-600 leading-relaxed">Nuestro cuerpo médico está compuesto exclusivamente por profesionales con matrícula vigente y especialidad certificada en su área de atención.</p>
          </div>

          <div class="space-y-6">
            <div class="text-[var(--au-accent)]">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h3 class="text-xl font-serif font-bold">Privacidad Garantizada</h3>
            <p class="text-neutral-600 leading-relaxed">Cumplimos con la Ley 25.326 de Protección de Datos Personales e infraestructura bajo estándares internacionales de seguridad médica.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTENT SECTION: THE PROCESS -->
    <section class="py-32">
      <div class="container mx-auto px-6">
        <div class="flex flex-col lg:flex-row items-center gap-20">
          <div class="lg:w-1/2">
            <h2 class="text-4xl font-serif font-bold mb-8">Un proceso diseñado para su <span class="italic text-neutral-500">tranquilidad.</span></h2>
            <div class="space-y-10">
              <div class="flex gap-6">
                <div class="flex-shrink-0 w-8 h-8 rounded-full border border-neutral-200 flex items-center justify-center text-sm font-bold text-neutral-400">01</div>
                <div>
                  <h4 class="font-bold mb-2">Registro y Triaje</h4>
                  <p class="text-neutral-600 text-sm">Complete sus datos y describa brevemente sus síntomas para ser asignado al profesional más adecuado.</p>
                </div>
              </div>
              <div class="flex gap-6">
                <div class="flex-shrink-0 w-8 h-8 rounded-full border border-neutral-200 flex items-center justify-center text-sm font-bold text-neutral-400">02</div>
                <div>
                  <h4 class="font-bold mb-2">Videoconsulta Médica</h4>
                  <p class="text-neutral-600 text-sm">Conéctese mediante nuestra plataforma segura en alta definición para una evaluación exhaustiva.</p>
                </div>
              </div>
              <div class="flex gap-6">
                <div class="flex-shrink-0 w-8 h-8 rounded-full border border-neutral-200 flex items-center justify-center text-sm font-bold text-neutral-400">03</div>
                <div>
                  <h4 class="font-bold mb-2">Receta y Seguimiento</h4>
                  <p class="text-neutral-600 text-sm">Reciba sus indicaciones médicas y prescripciones digitales de forma inmediata en su perfil.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:w-1/2">
            <div class="bg-neutral-50 border border-neutral-100 rounded-3xl p-8 md:p-16">
              <div class="space-y-12">
                <div class="text-center">
                  <div class="text-5xl font-serif font-bold text-neutral-900 mb-2">94%</div>
                  <div class="text-xs font-bold uppercase tracking-widest text-neutral-400">Casos resueltos online</div>
                </div>
                <div class="text-center">
                  <div class="text-5xl font-serif font-bold text-neutral-900 mb-2">24/7</div>
                  <div class="text-xs font-bold uppercase tracking-widest text-neutral-400">Disponibilidad absoluta</div>
                </div>
                <div class="text-center">
                  <div class="text-5xl font-serif font-bold text-neutral-900 mb-2">Seguridad</div>
                  <div class="text-xs font-bold uppercase tracking-widest text-neutral-400">Estándares Internacionales</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQS: SOBRE & CLEAR -->
    <section class="py-32 bg-neutral-50 border-t border-neutral-100">
      <div class="container mx-auto px-6 max-w-4xl">
        <h2 class="text-4xl font-serif font-bold mb-16 text-center text-neutral-900">Preguntas Frecuentes</h2>
        
        <div class="space-y-4">
          {faqs.map(faq => (
            <details class="group bg-white border border-neutral-200 rounded-2xl overflow-hidden transition-all">
              <summary class="p-8 flex justify-between items-center cursor-pointer list-none">
                <span class="text-xl font-medium text-neutral-900">{faq.q}</span>
                <div class="transition-transform group-open:rotate-180">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </div>
              </summary>
              <div class="px-8 pb-8 text-neutral-600 leading-relaxed">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <NewsletterCapture 
      vertical="telemedicina" 
      intent="evaluation" 
      formId="online_consultation_interest"
      title="¿Todavía tenés dudas?"
      subtitle="Recibí información sobre cómo funcionan nuestras videoconsultas, el marco legal de la receta digital y cómo preparamos tu historial clínico."
      buttonLabel="Recibir información"
    />

    <CTAFinal
      title="Su salud es nuestra prioridad principal."
      subtitle="Acceda hoy mismo a la red de atención médica digital más confiable de la región."
      buttonLabel="Iniciar mi Consulta"
      buttonHref="/auth/register"
    />
  </main>

  <Footer />
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap');

  main {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  h1, h2, h3, .font-serif {
    font-family: 'Source Serif 4', serif;
  }

  .btn-institutional {
    @apply px-10 py-4 bg-neutral-950 text-white font-bold rounded-lg transition-all border border-neutral-950;
  }
  .btn-institutional:hover {
    @apply bg-neutral-800 -translate-y-0.5 shadow-lg;
  }

  .btn-outline {
    @apply px-10 py-4 border border-neutral-200 text-neutral-900 font-bold rounded-lg transition-all;
  }
  .btn-outline:hover {
    @apply border-neutral-950 bg-neutral-50;
  }

  /* Reveal Animation */
  section {
    animation: reveal linear forwards;
    animation-timeline: view();
    animation-range: entry 5% cover 20%;
  }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  details summary::-webkit-details-marker {
    display: none;
  }
</style>
