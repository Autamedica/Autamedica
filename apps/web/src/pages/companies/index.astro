---
import Layout from '../../layouts/Layout.astro';
import PortalLanding from '../../components/portal/PortalLanding.astro';
import VerticalStructuredData from '../../components/seo/VerticalStructuredData.astro';
import { buildRoleAuthPath } from '../../lib/auth-flow';

const pageTitle = 'Portal para Empresas';
const pageDescription = 'Centro de control de crisis sanitarias, gestión de personal médico y marketplace de profesionales para empresas en AutaMedica.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://www.autamedica.com/companies"
  ogImage="/images/seo/og-companies.png"
>
  <VerticalStructuredData
    vertical="companies"
    pathname="/companies"
    title={pageTitle}
    description={pageDescription}
  />

  <PortalLanding
    badge="Companies Slice"
    title="Portal de Empresas en Astro"
    subtitle="Centro de control de crisis sanitarias y marketplace médico integrado para gestión empresarial de salud."
    accent="var(--portal-companies)"
    stats={[
      { value: '24/7', label: 'Monitoreo en tiempo real' },
      { value: '1-2', label: 'Clics para acciones clave' },
      { value: '<200ms', label: 'Meta de INP p75' },
    ]}
    pillars={[
      {
        title: 'Control de Crisis',
        description: 'Monitoreo en tiempo real de incidentes sanitarios, estado de instalaciones y personal disponible.',
      },
      {
        title: 'Marketplace Médico',
        description: 'Gestión integral de contratación de profesionales médicos con seguimiento de aplicaciones y conversión.',
      },
      {
        title: 'Rendimiento optimizado',
        description: 'Islands React solo en componentes interactivos; servidor renderiza el resto para reducir carga de JS.',
      },
    ]}
    primaryCta={{
      href: buildRoleAuthPath('login', 'company'),
      label: 'Entrar como empresa',
    }}
    secondaryCta={{
      href: buildRoleAuthPath('register', 'company'),
      label: 'Registrar empresa',
    }}
  />

  <section class="quick-links" aria-label="Accesos rapidos companies">
    <div class="quick-links-inner">
      <h2>Accesos rapidos del portal</h2>
      <div class="quick-links-grid">
        <a href="/companies/crisis">Centro de Control de Crisis</a>
        <a href="/companies/marketplace">Marketplace Médico</a>
        <a href="/companies/reports">Métricas y Reportes</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .quick-links {
    padding: 0 var(--section-px) var(--space-16);
    background: var(--au-bg);
  }

  .quick-links-inner {
    max-width: 1120px;
    margin: 0 auto;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    padding: var(--space-6);
  }

  .quick-links h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .quick-links-grid a {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    color: var(--au-text-secondary);
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }

  .quick-links-grid a:hover {
    border-color: var(--portal-companies);
    color: var(--au-text-primary);
    background: rgba(255, 102, 0, 0.08);
  }
</style>
