---
import Layout from '../../layouts/Layout.astro';
import PortalLanding from '../../components/portal/PortalLanding.astro';
import VerticalStructuredData from '../../components/seo/VerticalStructuredData.astro';
import NewsletterCapture from '../../components/NewsletterCapture.astro';
import Footer from '../../components/Footer.astro';
import { buildRoleAuthPath } from '../../lib/auth-flow';
import { getI18n } from '../../i18n/index';
const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);

const pageTitle = t('portals.companies.title');
const pageDescription = t('portals.companies.description');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://www.autamedica.com/companies"
  ogImage="/images/seo/og-companies.webp"
>
  <VerticalStructuredData
    vertical="companies"
    pathname="/companies"
    title={pageTitle}
    description={pageDescription}
  />

  <PortalLanding
    badge={t('portals.companies.badge')}
    title={t('portals.companies.title')}
    subtitle={t('portals.companies.description')}
    accent="var(--portal-companies)"
    stats={[
      { value: '24/7', label: 'Monitoreo en tiempo real' },
      { value: '1-2', label: 'Clics para acciones clave' },
      { value: '<200ms', label: 'Meta de INP p75' },
    ]}
    pillars={[
      {
        title: 'Control de Crisis',
        description: 'Monitoreo en tiempo real de incidentes sanitarios, estado de instalaciones y personal disponible.',
      },
      {
        title: 'Marketplace Médico',
        description: 'Gestión integral de contratación de profesionales médicos con seguimiento de aplicaciones y conversión.',
      },
      {
        title: 'Rendimiento optimizado',
        description: 'Islands React solo en componentes interactivos; servidor renderiza el resto para reducir carga de JS.',
      },
    ]}
    primaryCta={{
      href: buildRoleAuthPath('register', 'company_admin'),
      label: t('auth.createAccount'),
    }}
    secondaryCta={{
      href: buildRoleAuthPath('login', 'company_admin'),
      label: t('auth.signIn'),
    }}
  />

  <NewsletterCapture 
    vertical="companies" 
    intent="company_demo" 
    formId="company_interest"
    title="AutaMedica para Empresas"
    subtitle="Solicitá una demo personalizada para ver cómo podemos ayudar a optimizar la salud laboral y el marketplace médico de tu organización."
    buttonLabel="Solicitar Demo"
    placeholder="email@empresa.com"
  />

  <Footer />
</Layout>
