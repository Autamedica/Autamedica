---
import Layout from '../../layouts/Layout.astro';
import { getAppBaseUrl } from '../../lib/env';

const externalBase = getAppBaseUrl('companies').replace(/\/$/, '');
const externalCrisisUrl = `${externalBase}/crisis`;

const metrics = [
  { label: 'Incidentes activos', value: '3', tone: 'critical' },
  { label: 'Equipos en campo', value: '14', tone: 'warning' },
  { label: 'SLA respuesta', value: '92%', tone: 'ok' },
  { label: 'Sedes afectadas', value: '2/12', tone: 'warning' },
];

const incidents = [
  {
    title: 'Brote respiratorio',
    location: 'Edificio Norte - Piso 3',
    impact: '12 colaboradores en seguimiento',
    status: 'Activo',
  },
  {
    title: 'Accidente laboral leve',
    location: 'Centro logistico',
    impact: '1 colaborador derivado',
    status: 'Contenido',
  },
  {
    title: 'Emergencia cardiovascular',
    location: 'Oficinas ejecutivas',
    impact: 'Paciente estabilizado',
    status: 'Resuelto',
  },
];

const facilities = [
  { name: 'Edificio Norte', status: 'Operativo', load: '95%' },
  { name: 'Edificio Sur', status: 'Operativo', load: '87%' },
  { name: 'Centro médico', status: 'Operativo', load: '100%' },
  { name: 'Almacen principal', status: 'Capacidad limitada', load: '45%' },
];
---

<Layout
  title="Control de crisis empresarial"
  description="Tablero operativo para incidentes, respuesta y estado de instalaciones en el portal de empresas."
  canonical="https://www.autamedica.com/companies/crisis"
  robots="noindex, nofollow, noarchive"
>
  <main class="ops-shell">
    <section class="ops-card">
      <p class="ops-badge">Companies Operations</p>
      <h1>Control de crisis</h1>
      <p class="ops-lead">
        Vista priorizada para respuesta sanitaria corporativa con foco en decisiones rápidas y trazables.
      </p>

      <div class="ops-metrics" role="list" aria-label="Metricas operativas">
        {metrics.map((metric) => (
          <article class={`metric-card ${metric.tone}`} role="listitem">
            <p class="metric-value">{metric.value}</p>
            <p class="metric-label">{metric.label}</p>
          </article>
        ))}
      </div>

      <div class="ops-grid">
        <section class="panel">
          <h2>Incidentes recientes</h2>
          <ul>
            {incidents.map((incident) => (
              <li>
                <h3>{incident.title}</h3>
                <p>{incident.location}</p>
                <p>{incident.impact}</p>
                <span>{incident.status}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="panel">
          <h2>Estado de instalaciones</h2>
          <ul>
            {facilities.map((facility) => (
              <li>
                <h3>{facility.name}</h3>
                <p>{facility.status}</p>
                <span>Carga: {facility.load}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <div class="ops-actions">
        <a class="primary" href="/companies">Volver al portal empresas</a>
        <a class="secondary" href={externalCrisisUrl}>Abrir modulo legacy completo</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .ops-shell {
    min-height: 100vh;
    padding: clamp(4.5rem, 9vh, 6.5rem) var(--section-px) var(--space-16);
    background:
      radial-gradient(circle at 12% -10%, rgba(239, 68, 68, 0.18), transparent 42%),
      radial-gradient(circle at 90% 0%, rgba(245, 158, 11, 0.14), transparent 38%),
      var(--au-bg);
  }

  .ops-card {
    max-width: 1100px;
    margin: 0 auto;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-lg);
    background: rgba(20, 20, 22, 0.94);
    box-shadow: var(--shadow-glow);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .ops-badge {
    display: inline-flex;
    margin: 0 0 var(--space-4);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--au-border-hover);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--au-text-secondary);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    letter-spacing: -0.02em;
  }

  .ops-lead {
    margin: var(--space-3) 0 var(--space-8);
    color: var(--au-text-secondary);
    max-width: 72ch;
  }

  .ops-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .metric-card {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    padding: var(--space-4);
  }

  .metric-card.ok { border-color: rgba(34, 197, 94, 0.35); }
  .metric-card.warning { border-color: rgba(245, 158, 11, 0.35); }
  .metric-card.critical { border-color: rgba(239, 68, 68, 0.4); }

  .metric-value {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: var(--font-semibold);
  }

  .metric-label {
    margin: var(--space-2) 0 0;
    color: var(--au-text-secondary);
    font-size: var(--text-sm);
  }

  .ops-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .panel {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    padding: var(--space-4);
  }

  .panel h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .panel li {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    background: rgba(255, 255, 255, 0.01);
  }

  .panel h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
  }

  .panel p {
    margin: 0;
    color: var(--au-text-secondary);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .panel span {
    display: inline-flex;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--au-text-primary);
  }

  .ops-actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .ops-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .ops-actions a:hover {
    transform: translateY(-1px);
  }

  .ops-actions .primary {
    background: var(--au-accent);
    color: #111;
    border: 1px solid transparent;
  }

  .ops-actions .secondary {
    border: 1px solid var(--au-border-hover);
    color: var(--au-text-primary);
    background: transparent;
  }
</style>
