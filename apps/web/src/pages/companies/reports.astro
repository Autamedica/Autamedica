---
import Layout from '../../layouts/Layout.astro';
import { getAppBaseUrl } from '../../lib/env';

const externalBase = getAppBaseUrl('companies').replace(/\/$/, '');
const externalReportsUrl = `${externalBase}/reports`;

const kpis = [
  { label: 'Ausentismo mensual', value: '-18%', detail: 'vs trimestre anterior' },
  { label: 'Consultas resueltas', value: '1,284', detail: 'ultimos 30 dias' },
  { label: 'Tiempo medio respuesta', value: '11 min', detail: 'SLA objetivo 15 min' },
  { label: 'Cobertura preventiva', value: '74%', detail: 'plantilla activa' },
];

const reports = [
  {
    title: 'Salud ocupacional - Enero',
    statusLabel: 'Listo',
    statusTone: 'listo',
    updatedAt: '22 Feb 2026',
  },
  {
    title: 'Indicadores de emergencias Q1',
    statusLabel: 'En revision',
    statusTone: 'en-revision',
    updatedAt: '20 Feb 2026',
  },
  {
    title: 'Eficiencia de teleconsulta',
    statusLabel: 'Listo',
    statusTone: 'listo',
    updatedAt: '18 Feb 2026',
  },
  {
    title: 'Riesgo psicosocial - area comercial',
    statusLabel: 'Borrador',
    statusTone: 'borrador',
    updatedAt: '16 Feb 2026',
  },
];
---

<Layout
  title="Reportes corporativos de salud"
  description="Panel de reportes e indicadores para seguimiento de salud corporativa y eficiencia operativa."
  canonical="https://www.autamedica.com/companies/reports"
  robots="noindex, nofollow, noarchive"
>
  <main class="reports-shell">
    <section class="reports-card">
      <p class="reports-badge">Companies Analytics</p>
      <h1>Reportes y metricas</h1>
      <p class="reports-lead">
        Seguimiento de tendencias de salud corporativa y desempeno operativo para decisiones de RRHH y liderazgo.
      </p>

      <div class="kpi-grid" role="list" aria-label="Indicadores corporativos">
        {kpis.map((kpi) => (
          <article class="kpi-item" role="listitem">
            <p class="kpi-value">{kpi.value}</p>
            <p class="kpi-label">{kpi.label}</p>
            <p class="kpi-detail">{kpi.detail}</p>
          </article>
        ))}
      </div>

      <section class="reports-list">
        <h2>Reportes recientes</h2>
        <ul>
          {reports.map((report) => (
            <li>
              <div>
                <h3>{report.title}</h3>
                <p>Actualizado: {report.updatedAt}</p>
              </div>
              <span class={report.statusTone}>{report.statusLabel}</span>
            </li>
          ))}
        </ul>
      </section>

      <div class="reports-actions">
        <a class="primary" href="/companies">Volver al portal empresas</a>
        <a class="secondary" href={externalReportsUrl}>Abrir analitica legacy completa</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .reports-shell {
    min-height: 100vh;
    padding: clamp(4.5rem, 9vh, 6.5rem) var(--section-px) var(--space-16);
    background:
      radial-gradient(circle at 15% -10%, rgba(16, 185, 129, 0.18), transparent 42%),
      radial-gradient(circle at 90% 0%, rgba(59, 130, 246, 0.14), transparent 40%),
      var(--au-bg);
  }

  .reports-card {
    max-width: 1100px;
    margin: 0 auto;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-lg);
    background: rgba(20, 20, 22, 0.94);
    box-shadow: var(--shadow-glow);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .reports-badge {
    display: inline-flex;
    margin: 0 0 var(--space-4);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--au-border-hover);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--au-text-secondary);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    letter-spacing: -0.02em;
  }

  .reports-lead {
    margin: var(--space-3) 0 var(--space-8);
    color: var(--au-text-secondary);
    max-width: 72ch;
  }

  .kpi-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    margin-bottom: var(--space-8);
  }

  .kpi-item {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    padding: var(--space-4);
  }

  .kpi-value {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    font-weight: var(--font-semibold);
  }

  .kpi-label {
    margin: var(--space-2) 0 0;
    color: var(--au-text-secondary);
    font-size: var(--text-sm);
  }

  .kpi-detail {
    margin: var(--space-1) 0 0;
    color: var(--au-text-tertiary);
    font-size: var(--text-xs);
  }

  .reports-list {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    padding: var(--space-4);
  }

  .reports-list h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  .reports-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .reports-list li {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.01);
    padding: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .reports-list h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
  }

  .reports-list p {
    margin: 0;
    color: var(--au-text-secondary);
    font-size: var(--text-xs);
  }

  .reports-list span {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--au-border-hover);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.55rem;
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .reports-list span.listo { border-color: rgba(34, 197, 94, 0.5); }
  .reports-list span.en-revision { border-color: rgba(245, 158, 11, 0.5); }
  .reports-list span.borrador { border-color: rgba(59, 130, 246, 0.5); }

  .reports-actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .reports-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .reports-actions a:hover {
    transform: translateY(-1px);
  }

  .reports-actions .primary {
    background: var(--au-accent);
    color: #111;
    border: 1px solid transparent;
  }

  .reports-actions .secondary {
    border: 1px solid var(--au-border-hover);
    color: var(--au-text-primary);
    background: transparent;
  }
</style>
