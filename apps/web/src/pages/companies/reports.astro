---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Reportes corporativos de salud"
  description="Panel de reportes e indicadores para seguimiento de salud corporativa y eficiencia operativa."
  canonical="https://www.autamedica.com/companies/reports"
  robots="noindex, nofollow, noarchive"
>
  <main class="reports-shell">
    <section class="reports-card">
      <p class="reports-badge">Companies Analytics</p>
      <h1>Reportes y métricas</h1>
      <p class="reports-lead">
        Seguimiento de tendencias de salud corporativa y desempeño operativo para decisiones de RRHH y liderazgo.
      </p>

      <div class="empty-state">
        <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
        <p class="empty-title">Sin reportes disponibles</p>
        <p class="empty-detail">Los reportes se generarán automáticamente cuando haya actividad corporativa registrada.</p>
      </div>

      <div class="reports-actions">
        <a class="primary" href="/companies">Volver al portal empresas</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .reports-shell {
    min-height: 100vh;
    padding: clamp(4.5rem, 9vh, 6.5rem) var(--section-px) var(--space-16);
    background:
      radial-gradient(circle at 15% -10%, rgba(16, 185, 129, 0.18), transparent 42%),
      radial-gradient(circle at 90% 0%, rgba(59, 130, 246, 0.14), transparent 40%),
      var(--au-bg);
  }

  .reports-card {
    max-width: 1100px;
    margin: 0 auto;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-lg);
    background: rgba(20, 20, 22, 0.94);
    box-shadow: var(--shadow-glow);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .reports-badge {
    display: inline-flex;
    margin: 0 0 var(--space-4);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--au-border-hover);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--au-text-secondary);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    letter-spacing: -0.02em;
  }

  .reports-lead {
    margin: var(--space-3) 0 var(--space-8);
    color: var(--au-text-secondary);
    max-width: 72ch;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-12) var(--space-4);
    border: 1px dashed var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
  }

  .empty-icon {
    color: var(--au-text-tertiary);
    margin: 0 auto var(--space-4);
  }

  .empty-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
  }

  .empty-detail {
    margin: 0;
    color: var(--au-text-tertiary);
    font-size: var(--text-sm);
  }

  .reports-actions {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .reports-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .reports-actions a:hover {
    transform: translateY(-1px);
  }

  .reports-actions .primary {
    background: var(--au-accent);
    color: #111;
    border: 1px solid transparent;
  }
</style>
