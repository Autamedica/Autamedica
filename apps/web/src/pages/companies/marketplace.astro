---
import Layout from '../../layouts/Layout.astro';
import MarketplaceDashboard from '../../components/companies/marketplace/MarketplaceDashboard';
---

<Layout
  title="Marketplace médico corporativo"
  description="Gestión de proveedores y especialidades para empresas con foco en cobertura, SLA y continuidad operativa."
  canonical="https://www.autamedica.com/companies/marketplace"
  robots="noindex, nofollow, noarchive"
>
  <main class="marketplace-shell">
    <MarketplaceDashboard client:load />
  </main>
</Layout>

<style>
  .marketplace-shell {
    min-height: 100vh;
    padding: clamp(2rem, 4vh, 3rem) var(--section-px) var(--space-16);
    background: var(--au-bg);
  }
</style>
