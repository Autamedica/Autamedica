---
export const prerender = false;
const reference = Astro.params.reference ?? '';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Verificación documental | AutaMedica</title>
  </head>
  <body>
    <main>
      <h1>AUTAMEDICA · VERIFICACIÓN DOCUMENTAL</h1>
      <section id="selection">
        <p>Referencia: <code>{reference}</code></p>
        <p>Seleccioná el archivo PDF original para comprobar su autenticidad.</p>
        <label class="select-button">Seleccionar PDF
          <input id="document-file" type="file" accept="application/pdf,.pdf" />
        </label>
      </section>
      <section id="result" aria-live="polite" aria-atomic="true" hidden>
        <p id="seal" class="seal"></p>
        <p id="professional" hidden></p>
        <p id="issued-at" hidden></p>
      </section>
    </main>
    <script>
      const reference = document.querySelector('code')?.textContent?.trim() ?? '';
      const input = document.querySelector<HTMLInputElement>('#document-file');
      const selection = document.querySelector<HTMLElement>('#selection');
      const result = document.querySelector<HTMLElement>('#result');
      const seal = document.querySelector<HTMLElement>('#seal');
      const professional = document.querySelector<HTMLElement>('#professional');
      const issuedAt = document.querySelector<HTMLElement>('#issued-at');
      let revision = 0;

      const showMismatch = () => {
        if (!selection || !result || !seal || !professional || !issuedAt) return;
        selection.hidden = true;
        result.hidden = false;
        result.className = 'result invalid';
        seal.textContent = '✕ El archivo seleccionado no coincide con el registro oficial.';
        professional.hidden = true;
        issuedAt.hidden = true;
      };

      input?.addEventListener('change', async () => {
        const current = ++revision;
        const file = input.files?.[0];
        if (!file) return;
        if (!selection || !result || !seal || !professional || !issuedAt) return;

        try {
          if (file.size < 8 || file.size > 25 * 1024 * 1024) {
            showMismatch();
            return;
          }

          const header = new Uint8Array(await file.slice(0, 5).arrayBuffer());
          if (current !== revision) return;
          if (String.fromCharCode(...header) !== '%PDF-') {
            showMismatch();
            return;
          }

          const digest = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());
          if (current !== revision) return;
          const sha256 = Array.from(new Uint8Array(digest))
            .map(byte => byte.toString(16).padStart(2, '0'))
            .join('');
          const response = await fetch(
            `/api/verify/documentos/${encodeURIComponent(reference)}?sha256=${sha256}`,
            { headers: { Accept: 'application/json' }, cache: 'no-store' },
          );
          if (!response.ok) throw new Error('verification_unavailable');
          const payload: {
            registered?: boolean;
            verified?: boolean;
            issuedAt?: string;
            professional?: string;
            license?: string;
          } = await response.json();
          if (current !== revision) return;

          if (payload.verified !== true) {
            showMismatch();
            return;
          }

          selection.hidden = true;
          result.hidden = false;
          result.className = 'result valid';
          seal.textContent = '✓ DOCUMENTO AUTÉNTICO Y VERIFICADO';
          professional.textContent = `Profesional: ${payload.professional ?? ''} (${payload.license ?? ''})`;
          issuedAt.textContent = `Fecha de emisión: ${payload.issuedAt ?? ''}`;
          professional.hidden = false;
          issuedAt.hidden = false;
        } catch {
          if (current !== revision) return;
          selection.hidden = true;
          result.hidden = false;
          result.className = 'result unavailable';
          seal.textContent = 'No se pudo completar la verificación. Intentá nuevamente.';
          professional.hidden = true;
          issuedAt.hidden = true;
        }
      });
    </script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;min-height:100vh;background:#f8fafc;color:#0f172a;font-family:system-ui,sans-serif;line-height:1.55}
  main{width:min(100% - 32px,680px);margin:0 auto;padding:64px 0}
  h1{font-size:clamp(20px,4vw,28px);letter-spacing:.025em;line-height:1.25;margin:0 0 28px}
  p{margin:0 0 16px;overflow-wrap:anywhere}
  code{font-family:ui-monospace,monospace;overflow-wrap:anywhere}
  .select-button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;border-radius:8px;background:#0f766e;color:#fff;font-weight:750;cursor:pointer}
  .select-button:focus-within,.select-button:focus-visible{outline:3px solid #99f6e4;outline-offset:3px}
  input[type=file]{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .result{margin-top:28px}
  .seal{font-weight:850}
  .valid .seal{color:#15803d}
  .invalid .seal{color:#b91c1c}
  .unavailable .seal{color:#475569}
</style>
