---
import Layout from '@/layouts/Layout.astro';
import { createAstroAdminClient } from '@/lib/supabase';
import {
  dedupeCertificationsAgainstFocus,
  formatDisplayName,
  formatSpecialtyLabel,
  getPublicProfileCredentials,
  getVisibleProfileSections,
  shouldShowConsultationCta,
  shouldShowTestimonials,
  toEditorialEntries,
  toStringEntries,
  toVerifiedTestimonials,
} from '@/lib/doctors/public-profile-view';
import { logger } from '@autamedica/shared';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

type PublicProfile = {
  id: string;
  care_country: 'AR' | 'BR';
  first_name?: string | null;
  last_name?: string | null;
  avatar_url?: string | null;
  specialty?: string | null;
  subspecialty?: string | null;
  bio?: string | null;
  years_experience?: number | null;
  public_profile_accepts_consultations?: boolean | null;
  public_profile_headline?: string | null;
  education?: unknown;
  certifications?: unknown;
  clinical_focus_areas?: unknown;
  professional_experience?: unknown;
  academic_activity?: unknown;
  languages?: unknown;
  license_type?: string | null;
  rqe_number?: string | null;
  uf_brazil?: string | null;
  enrollment_jurisdiction?: string | null;
  licenses?: unknown;
  testimonials?: unknown;
};

function stringValue(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function slugify(value: string): string {
  return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

function publicAvatarUrl(value: unknown): string {
  const candidate = stringValue(value);
  if (!candidate) return '';
  try {
    const url = new URL(candidate);
    const supabaseAvatar = url.hostname.endsWith('.supabase.co')
      && url.pathname.startsWith('/storage/v1/object/public/avatars/');
    const googleAvatar = url.hostname === 'lh3.googleusercontent.com';
    return url.protocol === 'https:' && (supabaseAvatar || googleAvatar) ? url.toString() : '';
  } catch {
    return '';
  }
}

function computeInitials(name: string): string {
  const parts = name.split(/\s+/).filter(Boolean);
  if (!parts.length) return 'AM';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

const country = String(Astro.params.country ?? '').toUpperCase();
const slug = String(Astro.params.doctorSlug ?? '');
const idMatch = slug.match(/([0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$/i);
const doctorId = idMatch?.[1] ?? null;
const locale = Astro.locals.locale ?? 'es';
const isPortuguese = locale === 'pt';
let profile: PublicProfile | null = null;

if ((country === 'AR' || country === 'BR') && doctorId) {
  try {
    const admin = createAstroAdminClient(Astro.locals.runtime?.env) as unknown as {
      rpc: (name: string, args: Record<string, unknown>) => Promise<{ data: unknown; error: unknown }>;
    };
    const { data, error } = await admin.rpc('get_public_doctor_profile', { p_doctor_id: doctorId });
    if (error) {
      logger.error('[medicos/doctorSlug] get_public_doctor_profile RPC failed', { doctorId, country, error });
    } else if (data && typeof data === 'object' && !Array.isArray(data)) {
      const candidate = data as PublicProfile;
      if (candidate.id === doctorId && candidate.care_country === country) profile = candidate;
    }
  } catch (err) {
    logger.error('[medicos/doctorSlug] get_public_doctor_profile threw', { doctorId, country, error: err });
    // Fail closed if the safe read model or database is unavailable.
  }
}

const name = profile ? formatDisplayName(profile.first_name, profile.last_name) : '';
const canonicalSlug = profile && doctorId ? (slugify(name) || 'medico') + '-' + doctorId : '';
if (profile && canonicalSlug && slug !== canonicalSlug) {
  return Astro.redirect('/' + country.toLowerCase() + '/medicos/' + canonicalSlug, 301);
}

const avatarUrl = publicAvatarUrl(profile?.avatar_url);
let testimonialsEnabled = false;
if (profile) {
  try {
    const admin = createAstroAdminClient(Astro.locals.runtime?.env) as unknown as {
      from: (table: string) => {
        select: (columns: string) => { eq: (column: string, value: string) => { maybeSingle: () => Promise<{ data: { public_doctor_testimonials_enabled?: boolean } | null; error: unknown }> } };
      };
    };
    const { data: flag } = await admin.from('platform_operational_domains')
      .select('public_doctor_testimonials_enabled').eq('scope_key', country).maybeSingle();
    testimonialsEnabled = flag?.public_doctor_testimonials_enabled === true;
  } catch {
    testimonialsEnabled = false;
  }
}

const testimonials = toVerifiedTestimonials(profile?.testimonials);
const testimonialFlags: Partial<Record<'AR' | 'BR', boolean>> = country === 'AR'
  ? { AR: testimonialsEnabled }
  : country === 'BR'
    ? { BR: testimonialsEnabled }
    : {};
const showTestimonials = Boolean(profile && shouldShowTestimonials(profile, testimonialFlags));
const acceptsConsultations = profile ? shouldShowConsultationCta(profile) : false;
const consultationHref = '/consulta-medica-online?doctor_id=' + encodeURIComponent(doctorId ?? '') + '&care_country=' + country;

if (!profile) Astro.response.status = 404;

const specialty = formatSpecialtyLabel(profile?.specialty, isPortuguese);
const subspecialty = stringValue(profile?.subspecialty);
const headline = stringValue(profile?.public_profile_headline);
const bio = stringValue(profile?.bio);
const clinicalFocusAreas = toStringEntries(profile?.clinical_focus_areas);
const education = toEditorialEntries(profile?.education);
const rawCertifications = toEditorialEntries(profile?.certifications);
const certifications = dedupeCertificationsAgainstFocus(rawCertifications, clinicalFocusAreas);
const experience = toEditorialEntries(profile?.professional_experience);
const academicActivity = toEditorialEntries(profile?.academic_activity);
const credentials = profile
  ? getPublicProfileCredentials(profile)
  : { licenses: [], rqe: '', verified: false };
const licenses = credentials.licenses;
const rqeNumber = credentials.rqe;
const yearsExperience = Number.isFinite(profile?.years_experience) ? Number(profile?.years_experience) : 0;
const sections = profile
  ? getVisibleProfileSections({
      ...profile,
      certifications,
    })
  : { practice: false, education: false, experience: false, academic: false, verification: false };
const initials = computeInitials(name);
const countryLabel = country === 'BR' ? 'Brasil' : 'Argentina';
const authorityLabel = country === 'BR'
  ? (isPortuguese ? 'CFM · Conselho Federal de Medicina' : 'CFM · Consejo Federal de Medicina')
  : (isPortuguese ? 'SISA · Ministério da Saúde' : 'SISA · Ministerio de Salud');

const title = profile
  ? `${name} · ${headline || specialty} | AutaMedica`
  : (isPortuguese ? 'Perfil profissional não disponível' : 'Perfil profesional no disponible');
const description = profile
  ? (bio || headline || (isPortuguese
      ? `${specialty} · Credencial profissional verificada em AutaMedica.`
      : `${specialty} · Matrícula profesional verificada en AutaMedica.`)).slice(0, 160)
  : (isPortuguese ? 'Este perfil profissional não está disponível.' : 'Este perfil profesional no está disponível.');
const canonical = profile && canonicalSlug ? 'https://www.autamedica.com/' + country.toLowerCase() + '/medicos/' + canonicalSlug : undefined;

const physicianJsonLd = profile && canonical ? {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name,
  medicalSpecialty: specialty,
  url: canonical,
  description,
  address: { '@type': 'PostalAddress', addressCountry: country },
  identifier: [
    ...licenses.map((license) => ({ '@type': 'PropertyValue', name: license.split(' ')[0], value: license })),
    ...(rqeNumber ? [{ '@type': 'PropertyValue', name: 'RQE', value: rqeNumber }] : []),
  ],
} : null;

const copyLabels = {
  default: isPortuguese ? 'Copiar link do perfil' : 'Copiar enlace del perfil',
  copied: isPortuguese ? 'Link copiado' : 'Enlace copiado',
  topbarShare: isPortuguese ? 'Compartilhar' : 'Compartir',
};
---

<Layout
  title={title}
  description={description}
  canonical={profile ? canonical : undefined}
  robots={profile ? 'index, follow' : 'noindex, nofollow'}
>
  {physicianJsonLd && <script type="application/ld+json" set:html={JSON.stringify(physicianJsonLd).replace(/</g, '\\u003c')} />}
  {profile ? (
    <div class="profile-page">
      <nav class="topbar" aria-label="AutaMedica">
        <div class="topbar-inner">
          <a class="topbar-brand" href="/">
            <span class="brand-dot" aria-hidden="true"></span>
            <span>AutaMedica</span>
          </a>
          <div class="topbar-actions">
            {licenses[0] && (
              <span class="topbar-license">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
                {licenses[0]} · {countryLabel}
              </span>
            )}
            <button
              type="button"
              class="topbar-share"
              data-copy-profile-url={canonical}
              data-label-default={copyLabels.topbarShare}
              data-label-copied={copyLabels.copied}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
              <span>{copyLabels.topbarShare}</span>
            </button>
          </div>
        </div>
      </nav>

      <header class="hero-band">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-inner">
          <div class="hero-identity">
            {avatarUrl ? (
              <img
                class="hero-avatar"
                src={avatarUrl}
                alt={isPortuguese ? `Foto profissional de ${name}` : `Foto profesional de ${name}`}
                loading="eager"
              />
            ) : (
              <div class="hero-monogram" aria-hidden="true">{initials}</div>
            )}

            <div class="hero-copy">
              <div class="status-pill">
                <span class="status-dot" aria-hidden="true"></span>
                <span>
                  {acceptsConsultations
                    ? (isPortuguese ? 'PERFIL CLÍNICO VERIFICADO · AUTAMEDICA' : 'PERFIL CLÍNICO VERIFICADO · AUTAMEDICA')
                    : (isPortuguese ? 'PERFIL INSTITUCIONAL VERIFICADO · AUTAMEDICA' : 'PERFIL INSTITUCIONAL VERIFICADO · AUTAMEDICA')}
                </span>
              </div>

              <h1>{name}</h1>

              {headline ? (
                <>
                  <p class="hero-headline">{headline}</p>
                  <p class="hero-specialty-muted">
                    {specialty}{subspecialty ? ` · ${subspecialty}` : ''}
                  </p>
                </>
              ) : (
                <>
                  <p class="hero-headline">{specialty}</p>
                  {subspecialty && <p class="hero-specialty-muted">{subspecialty}</p>}
                </>
              )}

              <div class="hero-badges">
                {licenses.map((license) => (
                  <span class="hero-badge badge-verified">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m9 12 2 2 4-4" />
                      <circle cx="12" cy="12" r="10" />
                    </svg>
                    {license}
                  </span>
                ))}
                {rqeNumber && (
                  <span class="hero-badge">RQE {rqeNumber}</span>
                )}
                <span class="hero-badge">{countryLabel}</span>
                {yearsExperience > 0 && (
                  <span class="hero-badge">
                    {isPortuguese ? `${yearsExperience}+ anos de atuação` : `${yearsExperience}+ años de trayectoria`}
                  </span>
                )}
              </div>

              <div class="hero-actions">
                {acceptsConsultations && (
                  <a class="btn-primary" href={consultationHref}>
                    {isPortuguese ? 'Iniciar atendimento' : 'Solicitar consulta'}
                  </a>
                )}
                <button
                  type="button"
                  class="btn-ghost"
                  data-copy-profile-url={canonical}
                  data-label-default={copyLabels.default}
                  data-label-copied={copyLabels.copied}
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                  </svg>
                  <span>{copyLabels.default}</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <main class="editorial-shell">
        <div class="editorial-grid">
          <div class="editorial-main">
            {sections.practice && (
              <section class="editorial-card" aria-labelledby="practice-heading">
                <div class="card-header">
                  <span class="card-kicker">{isPortuguese ? 'ESPECIALIZAÇÃO & FOCO' : 'ESPECIALIZACIÓN & ENFOQUE'}</span>
                  <h2 id="practice-heading">
                    {acceptsConsultations
                      ? (isPortuguese ? 'Prática clínica' : 'Práctica clínica')
                      : (isPortuguese ? 'Áreas de atuação' : 'Áreas de enfoque')}
                  </h2>
                </div>
                {bio && <p class="editorial-prose">{bio}</p>}
                {clinicalFocusAreas.length > 0 && (
                  <ul class="focus-chips">
                    {clinicalFocusAreas.map((area) => (
                      <li class="focus-chip">{area}</li>
                    ))}
                  </ul>
                )}
              </section>
            )}

            {sections.experience && (
              <section class="editorial-card" aria-labelledby="experience-heading">
                <div class="card-header card-header-split">
                  <div>
                    <span class="card-kicker">{isPortuguese ? 'HISTÓRICO PROFISSIONAL' : 'HISTORIAL PROFESIONAL'}</span>
                    <h2 id="experience-heading">{isPortuguese ? 'Trajetória' : 'Trayectoria'}</h2>
                  </div>
                  {yearsExperience > 0 && (
                    <span class="years-pill">
                      {isPortuguese ? `${yearsExperience} anos` : `${yearsExperience} años`}
                    </span>
                  )}
                </div>
                <ol class="timeline-list">
                  {experience.map((entry) => (
                    <li class="timeline-item">
                      <span class="timeline-marker" aria-hidden="true"></span>
                      <div class="timeline-body">
                        <h3>{entry.title}</h3>
                        {entry.institution && <p class="entry-org">{entry.institution}</p>}
                        {entry.period && <span class="entry-period">{entry.period}</span>}
                        {entry.detail && <p class="entry-detail">{entry.detail}</p>}
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            )}

            {sections.education && (
              <section class="editorial-card" aria-labelledby="education-heading">
                <div class="card-header">
                  <span class="card-kicker">{isPortuguese ? 'CREDENCIAIS ACADÊMICAS' : 'CREDENCIALES ACADÉMICAS'}</span>
                  <h2 id="education-heading">{isPortuguese ? 'Formação' : 'Formación'}</h2>
                </div>
                <div class="stack-list">
                  {education.map((entry) => (
                    <article class="stack-item">
                      <h3>{entry.title}</h3>
                      {entry.institution && <p class="entry-org">{entry.institution}</p>}
                      {entry.period && <span class="entry-period">{entry.period}</span>}
                      {entry.detail && <p class="entry-detail">{entry.detail}</p>}
                    </article>
                  ))}
                </div>

                {certifications.length > 0 && (
                  <div class="sub-block">
                    <h3>{isPortuguese ? 'Especializações e certificações' : 'Especializaciones y certificaciones'}</h3>
                    <div class="stack-list compact">
                      {certifications.map((entry) => (
                        <article class="stack-item compact">
                          <p class="stack-title">{entry.title}</p>
                          {entry.institution && <p class="entry-org">{entry.institution}</p>}
                          {entry.period && <span class="entry-period">{entry.period}</span>}
                        </article>
                      ))}
                    </div>
                  </div>
                )}
              </section>
            )}

            {sections.academic && (
              <section class="editorial-card" aria-labelledby="academic-heading">
                <div class="card-header">
                  <span class="card-kicker">{isPortuguese ? 'PESQUISA & PRODUÇÃO' : 'INVESTIGACIÓN & PRODUCCIÓN'}</span>
                  <h2 id="academic-heading">{isPortuguese ? 'Atuação acadêmica' : 'Actividad académica'}</h2>
                </div>
                <div class="academic-list">
                  {academicActivity.map((entry) => (
                    <article class="academic-item">
                      <h3>{entry.title}</h3>
                      {entry.institution && <p class="entry-org">{entry.institution}</p>}
                      {entry.period && <span class="entry-period">{entry.period}</span>}
                      {entry.detail && <p class="entry-detail">{entry.detail}</p>}
                    </article>
                  ))}
                </div>
              </section>
            )}

            {showTestimonials && testimonials.length > 0 && (
              <section class="editorial-card" aria-labelledby="testimonials-heading">
                <div class="card-header">
                  <span class="card-kicker">{isPortuguese ? 'AVALIAÇÕES VERIFICADAS' : 'RESEÑAS VERIFICADAS'}</span>
                  <h2 id="testimonials-heading">{isPortuguese ? 'Experiência de atendimento' : 'Experiencia de atención'}</h2>
                </div>
                <div class="testimonial-list">
                  {testimonials.map((testimonial) => (
                    <article class="testimonial-item">
                      <p>“{testimonial.comment}”</p>
                      <span>{isPortuguese ? 'Atendimento concluído na AutaMedica' : 'Consulta completada en AutaMedica'}</span>
                    </article>
                  ))}
                </div>
              </section>
            )}
          </div>

          <aside class="editorial-sidebar" aria-label={isPortuguese ? 'Verificação profissional' : 'Verificación profesional'}>
            {sections.verification && (
              <section class="sidebar-card credential-card" aria-labelledby="verification-heading">
                <div class="credential-card-head">
                  <div class="shield-badge" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                  </div>
                  <div>
                    <span class="sidebar-kicker">{isPortuguese ? 'CREDENCIAL DIGITAL' : 'CREDENCIAL DIGITAL'}</span>
                    <h2 id="verification-heading">{isPortuguese ? 'Registro validado' : 'Matrícula validada'}</h2>
                  </div>
                </div>

                <dl class="credential-meta">
                  <div>
                    <dt>{isPortuguese ? 'Inscrição ativa' : 'Matrícula activa'}</dt>
                    <dd class="mono">{licenses.join(' · ')}</dd>
                  </div>
                  {rqeNumber && (
                    <div>
                      <dt>RQE</dt>
                      <dd class="mono">{rqeNumber}</dd>
                    </div>
                  )}
                  <div>
                    <dt>{isPortuguese ? 'Órgão regulador' : 'Organismo regulador'}</dt>
                    <dd>{authorityLabel}</dd>
                  </div>
                  <div>
                    <dt>{isPortuguese ? 'Jurisdição' : 'Jurisdicción'}</dt>
                    <dd>{countryLabel}</dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd>
                      <span class="active-pill">
                        {isPortuguese ? 'Ativo e verificado' : 'Activo y verificado'}
                      </span>
                    </dd>
                  </div>
                </dl>

                <p class="credential-note">
                  {isPortuguese
                    ? 'A AutaMedica verificou a habilitação profissional vigente para a jurisdição de exercício declarada.'
                    : 'AutaMedica verificó la habilitación profesional vigente para la jurisdicción de ejercicio declarada.'}
                </p>
              </section>
            )}

            <section class="sidebar-card share-card">
              <h3>{isPortuguese ? 'Link verificável do perfil' : 'Enlace verificable del perfil'}</h3>
              <p>
                {isPortuguese
                  ? 'Credencial pública estruturada para LinkedIn, currículo institucional e assinatura profissional.'
                  : 'Credencial pública estructurada para LinkedIn, currículum institucional y firma profesional.'}
              </p>
              <button
                type="button"
                class="btn-secondary"
                data-copy-profile-url={canonical}
                data-label-default={copyLabels.default}
                data-label-copied={copyLabels.copied}
              >
                {copyLabels.default}
              </button>
            </section>

            {acceptsConsultations && (
              <section class="sidebar-card consult-card">
                <span class="sidebar-kicker-dark">{isPortuguese ? 'TELEMEDICINA AUTAMEDICA' : 'TELEMEDICINA AUTAMEDICA'}</span>
                <h3>{isPortuguese ? 'Atendimento médico online' : 'Atención médica online'}</h3>
                <p>
                  {isPortuguese
                    ? 'Solicite consulta por vídeo com emissão de receita e documentação clínica digital.'
                    : 'Solicitá consulta por videollamada con emisión de receta y documentación clínica digital.'}
                </p>
                <a class="btn-primary btn-block" href={consultationHref}>
                  {isPortuguese ? 'Iniciar atendimento' : 'Solicitar consulta'}
                </a>
              </section>
            )}
          </aside>
        </div>

        <footer class="profile-footer">
          <div class="footer-meta">
            <a class="footer-brand" href="/">AutaMedica</a>
            <span>·</span>
            <p>{isPortuguese ? 'Diretório de Profissionais Verificados.' : 'Directorio de Profesionales Verificados.'}</p>
          </div>
          {acceptsConsultations && (
            <a class="footer-cta" href={consultationHref}>
              {isPortuguese ? 'Iniciar atendimento com este médico' : 'Iniciar consulta con este médico'}
            </a>
          )}
        </footer>
      </main>
    </div>
  ) : (
    <main class="profile-unavailable">
      <a class="brand-fallback" href="/">AutaMedica</a>
      <h1>{isPortuguese ? 'Perfil profissional não disponível' : 'Perfil profesional no disponible'}</h1>
      <p>{isPortuguese ? 'O perfil pode estar desativado ou o registro ainda não estar confirmado.' : 'El perfil puede estar desactivado o la matrícula todavía no estar confirmada.'}</p>
      <a href="/">{isPortuguese ? 'Voltar ao início' : 'Volver al inicio'}</a>
    </main>
  )}
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-profile-url]').forEach((button) => {
    button.addEventListener('click', async () => {
      const targetUrl = button.dataset.copyProfileUrl || window.location.href;
      const defaultLabel = button.dataset.labelDefault || '';
      const copiedLabel = button.dataset.labelCopied || defaultLabel;
      const span = button.querySelector('span') || button;

      try {
        await navigator.clipboard.writeText(targetUrl);
        span.textContent = copiedLabel;
        button.dataset.copied = 'true';
        window.setTimeout(() => {
          span.textContent = defaultLabel;
          delete button.dataset.copied;
        }, 2000);
      } catch {
        span.textContent = copiedLabel;
      }
    });
  });
</script>

<style>
  .profile-page {
    min-height: 100vh;
    background: #F8FAFC;
    color: #0F172A;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(9, 9, 11, 0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .topbar-inner {
    width: min(100% - 48px, 1120px);
    margin: 0 auto;
    height: 60px;
    display: flex;
