---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ReservaSaudePublicPage from '@/components/public/ReservaSaudePublicPage';

const title = 'Reserva de Saúde & Planos | AutaMedica';
const description = 'Você cuida da sua saúde hoje. E o que você não usa vira crédito na sua Reserva de Saúde para especialistas, exames e farmácia.';
---

<Layout title={title} description={description}>
  <Navbar />
  <main class="min-h-screen bg-neutral-50">
    <ReservaSaudePublicPage client:load />
  </main>
  <Footer />
</Layout>
