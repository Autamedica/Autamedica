---
import Layout from '../layouts/Layout.astro';
import { DoctorsDashboardPage } from '../components/doctors/DoctorsDashboardPage';
import PatientsHomePage from '../components/patients/PatientsHomePage';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PremiumNarrative from '../components/PremiumNarrative.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import DoctorDirectory from '../components/DoctorDirectory.astro';
import SymptomChecker from '../components/SymptomChecker';
import HorizontalScroll from '../components/HorizontalScroll';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import HealthContent from '../components/HealthContent.astro';
import IntentLinks from '../components/IntentLinks.astro';
import FAQSection from '../components/FAQSection.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';
import ValueProps from '../components/ValueProps.astro';
import PortalLanding from '../components/portal/PortalLanding.astro';
import { resolveLandingCopy } from '../lib/landing-copy';
import { buildRoleAuthPath } from '../lib/auth-flow';
import { getI18n } from '../i18n';
const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);
const devPortal = import.meta.env.DEV ? Astro.url.searchParams.get('portal') : null;
const isDoctorHost =
  Astro.url.hostname === 'doctor.autamedica.com' ||
  Astro.url.hostname === 'doctors.autamedica.com' ||
  devPortal === 'doctor';
const isPatientHost =
  Astro.url.hostname === 'paciente.autamedica.com' ||
  Astro.url.hostname === 'patients.autamedica.com' ||
  devPortal === 'patient';
const isCompanyHost =
  Astro.url.hostname === 'empresa.autamedica.com' ||
  Astro.url.hostname === 'companies.autamedica.com' ||
  devPortal === 'company';

const {
  variant: copyVariant,
  hero: heroCopy,
  cta: ctaCopy,
  seo: seoCopy,
} = resolveLandingCopy(Astro.url, import.meta.env.PUBLIC_LANDING_COPY_VARIANT, locale);
---

{isDoctorHost ? (
  <Layout
    title="Portal Médico | AutaMedica"
    description="Portal de videoconsultas para profesionales médicos"
    canonical="https://doctors.autamedica.com/"
    ogImage="/images/seo/og-doctors.webp"
  >
    <DoctorsDashboardPage client:load locale={locale} />
  </Layout>
) : isPatientHost ? (
  <Layout
    title="Mi Portal de Salud | AutaMedica"
    description="Tu espacio personal de salud: consultas, historial médico y seguimiento"
    canonical="https://patients.autamedica.com/"
    ogImage="/images/seo/og-patients.webp"
  >
    <PatientsHomePage client:load locale={locale} />
  </Layout>
) : isCompanyHost ? (
  <Layout
    title={t('portals.companies.title')}
    description={t('portals.companies.description')}
    canonical="https://companies.autamedica.com/"
    ogImage="/images/seo/og-companies.webp"
  >
    <PortalLanding
      badge={t('portals.companies.badge')}
      title={t('portals.companies.title')}
      subtitle={t('portals.companies.description')}
      accent="var(--portal-companies)"
      stats={[
        { value: '24/7', label: 'Monitoreo en tiempo real' },
        { value: '1-2', label: 'Clics para acciones clave' },
        { value: '<200ms', label: 'Meta de INP p75' },
      ]}
      pillars={[
        {
          title: 'Control operativo',
          description: 'Visibilidad centralizada sobre incidentes, equipos y continuidad asistencial.',
        },
        {
          title: 'Gestión de profesionales',
          description: 'Marketplace y coordinación de cobertura con el mismo lenguaje visual del resto de la red.',
        },
        {
          title: 'Superficie clara',
          description: 'Fondo blanco, texto negro y un único acento celeste para evitar ruido entre portales.',
        },
      ]}
      primaryCta={{
        href: buildRoleAuthPath('login', 'company_admin'),
        label: t('roles.company_admin.buttonLabel'),
      }}
      secondaryCta={{
        href: buildRoleAuthPath('register', 'company_admin'),
        label: t('auth.createAccount'),
      }}
    />
    <section class="quick-links" aria-label="Accesos rapidos companies">
      <div class="quick-links-inner">
        <h2>Accesos rápidos del portal</h2>
        <div class="quick-links-grid">
          <a href="/companies/crisis">Centro de Control de Crisis</a>
          <a href="/companies/marketplace">Marketplace Médico</a>
          <a href="/companies/reports">Métricas y Reportes</a>
        </div>
      </div>
    </section>
  </Layout>
) : (
  <Layout
    title={seoCopy.title}
    description={seoCopy.description}
    ogImage="/images/seo/og-main.webp"
  >
    <Navbar />
    <main id="main-content" data-copy-variant={copyVariant}>
      <Hero {...heroCopy} />
      <PremiumNarrative />
      <ValueProps />
      <ProductShowcase />
      <DoctorDirectory />
      <IntentLinks />

      <!-- Symptom Checker: herramienta interactiva sin login -->
      <section id="sintomas" class="symptom-section">
        <div class="symptom-inner">
          <div class="symptom-header animate-on-scroll">
            <h2 class="symptom-title">{t('landing.symptomTitle')}</h2>
            <p class="symptom-subtitle">{t('landing.symptomSubtitle')}</p>
          </div>
          <SymptomChecker locale={locale} client:visible />
        </div>
      </section>

      <HorizontalScroll locale={locale} client:visible />

      <Process />
      <Testimonials />
      <HealthContent />
      <FAQSection />
      <CTAFinal {...ctaCopy} />
    </main>
    <Footer />
  </Layout>
)}

<style>
  .symptom-section {
    padding: var(--section-py) var(--section-px);
    background: var(--au-bg);
  }

  .quick-links {
    padding: 0 var(--section-px) var(--space-16);
    background: var(--au-bg);
  }

  .quick-links-inner {
    max-width: 1120px;
    margin: 0 auto;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    padding: var(--space-6);
  }

  .quick-links h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .quick-links-grid a {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    color: var(--au-text-secondary);
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }

  .quick-links-grid a:hover {
    border-color: var(--portal-companies);
    color: var(--au-text-primary);
    background: var(--au-accent-soft);
  }

  .symptom-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .symptom-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .symptom-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-medium);
    color: var(--au-text-primary);
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }

  .symptom-subtitle {
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
    margin: 0;
  }
</style>

<script>
  const revealWithoutMotion = () => {
    document.querySelectorAll('.animate-on-scroll').forEach((el) => {
      if (el instanceof HTMLElement) {
        el.style.opacity = '1';
      }
    });
  };

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced) {
    revealWithoutMotion();
  } else {
    const initAnimations = async () => {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);

      gsap.registerPlugin(ScrollTrigger);
      ScrollTrigger.config({ ignoreMobileResize: true });

      if ('ontouchstart' in window) {
        ScrollTrigger.normalizeScroll({ allowNestedScroll: true });
      }

      const heroContent = document.querySelector('.hero-content');
      if (heroContent) {
        const tl = gsap.timeline({ delay: 0.2 });
        tl.from('.hero-badge', { opacity: 0, y: 20, duration: 0.6, ease: 'power2.out' })
          .from('.hero-subtitle', { opacity: 0, y: 20, duration: 0.6, ease: 'power2.out' }, '-=0.4')
          .from('.hero-metrics', { opacity: 0, y: 15, duration: 0.5, ease: 'power2.out' }, '-=0.2')
          .from('.hero-scroll-hint', { opacity: 0, duration: 0.4 }, '-=0.1');
      }

      const valuePropsInner = document.querySelector('.value-props-inner');
      if (valuePropsInner) {
        gsap.fromTo(
          valuePropsInner.querySelectorAll('.value-card'),
          { opacity: 0, y: 30, scale: 0.97 },
          {
            opacity: 1, y: 0, scale: 1,
            duration: 0.6,
            stagger: 0.12,
            ease: 'power2.out',
            scrollTrigger: { trigger: valuePropsInner, start: 'top 85%', toggleActions: 'play none none none' },
          }
        );
      }

      document.querySelectorAll('.showcase-header, .directory-header, .process-header, .testimonials-header').forEach((el) => {
        gsap.fromTo(el,
          { opacity: 0, y: 30 },
          {
            opacity: 1, y: 0,
            duration: 0.8,
            ease: 'power2.out',
            scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' },
          }
        );
      });

      document.querySelectorAll('.showcase-row').forEach((row) => {
        const fromX = row.classList.contains('reversed') ? 50 : -50;
        gsap.fromTo(row,
          { opacity: 0, x: fromX },
          {
            opacity: 1, x: 0,
            duration: 1,
            ease: 'power2.out',
            scrollTrigger: { trigger: row, start: 'top 80%', toggleActions: 'play none none none' },
          }
        );
      });

      const doctorGrid = document.querySelector('.doctor-grid');
      if (doctorGrid) {
        gsap.fromTo(
          doctorGrid.querySelectorAll('.doctor-card'),
          { opacity: 0, y: 30, scale: 0.96 },
          {
            opacity: 1, y: 0, scale: 1,
            duration: 0.6,
            stagger: 0.08,
            ease: 'power2.out',
            scrollTrigger: { trigger: doctorGrid, start: 'top 80%', toggleActions: 'play none none none' },
          }
        );
      }

      const symptomHeader = document.querySelector('.symptom-header');
      if (symptomHeader) {
        gsap.fromTo(symptomHeader,
          { opacity: 0, y: 30 },
          {
            opacity: 1, y: 0,
            duration: 0.8,
            ease: 'power2.out',
            scrollTrigger: { trigger: symptomHeader, start: 'top 85%', toggleActions: 'play none none none' },
          }
        );
      }

      const processTimeline = document.querySelector('.process-timeline');
      if (processTimeline) {
        gsap.fromTo(
          processTimeline.querySelectorAll('.step'),
          { opacity: 0, y: 30 },
          {
            opacity: 1, y: 0,
            duration: 0.6,
            stagger: 0.12,
            ease: 'power2.out',
            scrollTrigger: { trigger: processTimeline, start: 'top 80%', toggleActions: 'play none none none' },
          }
        );
      }

      const testimonialGrid = document.querySelector('.testimonials-grid');
      if (testimonialGrid) {
        gsap.fromTo(
          testimonialGrid.querySelectorAll('.testimonial-card'),
          { opacity: 0, y: 30, scale: 0.96 },
          {
            opacity: 1, y: 0, scale: 1,
            duration: 0.6,
            stagger: 0.1,
            ease: 'power2.out',
            scrollTrigger: { trigger: testimonialGrid, start: 'top 80%', toggleActions: 'play none none none' },
          }
        );
      }

      const ctaInner = document.querySelector('.cta-inner');
      if (ctaInner) {
        gsap.fromTo(ctaInner,
          { opacity: 0, y: 40, scale: 0.95 },
          {
            opacity: 1, y: 0, scale: 1,
            duration: 1,
            ease: 'power3.out',
            scrollTrigger: { trigger: ctaInner, start: 'top 85%', toggleActions: 'play none none none' },
          }
        );
      }

      // .animate-on-scroll genéricos manejados por CSS Scroll-Driven Animations
    };

    const boot = () => {
      void initAnimations().catch(() => revealWithoutMotion());
    };

    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(boot, { timeout: 1200 });
    } else {
      window.setTimeout(boot, 1);
    }
  }
</script>
