---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import NewsletterCapture from '../components/NewsletterCapture.astro';
import Footer from '../components/Footer.astro';

const title = "AutaMedica | Soluciones de Salud Digital para Profesionales";
const description = "Conectamos la excelencia médica con la tecnología. Evaluación estructurada, receta electrónica y seguimiento clínico integral.";
---

<Layout title={title} description={description}>
  <Navbar />
  
  <main class="pt-24 pb-12">
    <section class="max-w-4xl mx-auto px-6 text-center mb-16">
      <span class="inline-block px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-full mb-4 uppercase tracking-widest">
        LinkedIn Community
      </span>
      <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 tracking-tight">
        Llevamos la medicina al <span class="text-blue-600">entorno digital</span> con rigor clínico.
      </h1>
      <p class="text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto">
        Si venís desde LinkedIn, sabés que la eficiencia y la calidad van de la mano. En AutaMedica ayudamos a pacientes y profesionales a conectar de forma segura, legal y efectiva.
      </p>
    </section>

    <div class="max-w-2xl mx-auto px-6">
      <NewsletterCapture 
        vertical="linkedin" 
        intent="networking" 
        formId="linkedin_landing"
        title="Sumate a la red de AutaMedica"
        subtitle="Recibí actualizaciones sobre el futuro de la telemedicina, reportes de la industria y oportunidades para profesionales y empresas."
        buttonLabel="Suscribirme"
      />
    </div>

    <section class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8 mt-20">
      <div class="p-6 bg-gray-50 rounded-2xl border border-gray-100">
        <h3 class="font-bold text-gray-900 mb-2">Para Pacientes</h3>
        <p class="text-sm text-gray-600">Acceso inmediato a especialistas matriculados y recetas digitales legales.</p>
        <a href="/auth/register" class="text-blue-600 text-sm font-bold mt-4 inline-block hover:underline">Registrarme &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 rounded-2xl border border-gray-100">
        <h3 class="font-bold text-gray-900 mb-2">Para Médicos</h3>
        <p class="text-sm text-gray-600">Herramientas de IA para optimizar tu consulta y gestión de agenda integral.</p>
        <a href="/doctors" class="text-blue-600 text-sm font-bold mt-4 inline-block hover:underline">Ver portal &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 rounded-2xl border border-gray-100">
        <h3 class="font-bold text-gray-900 mb-2">Para Empresas</h3>
        <p class="text-sm text-gray-600">Planes de salud corporativa y marketplace médico a medida.</p>
        <a href="/companies" class="text-blue-600 text-sm font-bold mt-4 inline-block hover:underline">Solicitar demo &rarr;</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
