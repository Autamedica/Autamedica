---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CTAFinal from '../components/CTAFinal.astro';

const canonicalUrl = 'https://www.autamedica.com/brasileiro-na-argentina';

const faqItems = [
  {
    question: 'Como funciona a teleconsulta?',
    answer:
      'Você agenda um horário, recebe um link por e-mail e entra na sala virtual no horário marcado. A consulta é feita por videochamada, com privacidade e segurança. Não precisa baixar nenhum aplicativo.',
  },
  {
    question: 'O atendimento é em português?',
    answer:
      'Sim. O Dr. Eduardo Marques é brasileiro e toda a comunicação é feita em português. Você será atendido na sua língua, sem barreiras.',
  },
  {
    question: 'A receita emitida é válida na Argentina?',
    answer:
      'Sim. A receita digital emitida pela AutaMedica cumpre a normativa argentina vigente (Res. 2214/2025) com CUIR, QR verificável e assinatura digital PAdES. É aceita em farmácias de todo o país.',
  },
  {
    question: 'Quanto custa a consulta?',
    answer:
      'O valor da consulta é informado no momento do agendamento. Aceitamos pagamento por MercadoPago, cartão de crédito e débito. Você também pode solicitar reembolso junto ao seu plano de saúde, se aplicável.',
  },
  {
    question: 'Preciso ter DNI argentino para ser atendido?',
    answer:
      'Não. Atendemos brasileiros com qualquer documento de identidade (RG, CPF, passaporte). Basta se cadastrar com seu e-mail e documento.',
  },
  {
    question: 'Quais condições são atendidas?',
    answer:
      'Atendemos condições clínicas comuns: dores de cabeça, problemas respiratórios, gastrointestinais, saúde da mulher, saúde do homem, entre outras. Para emergências (dor no peito, falta de ar grave, acidentes), procure um pronto-socorro.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      name: 'Brasileiro na Argentina — Atendimento Médico em Português',
      url: canonicalUrl,
      description:
        'Teleconsulta médica em português para brasileiros que vivem ou estão na Argentina. Receita digital, pedidos de exames, atestados. Dr. Eduardo Marques, docente do Hospital de Clínicas.',
      inLanguage: 'pt-BR',
      about: [
        { '@type': 'MedicalSpecialty', name: 'PrimaryCare' },
        { '@type': 'Thing', name: 'Teleconsulta médica para brasileiros na Argentina' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<Layout
  title="Brasileiro na Argentina | Atendimento Médico em Português | AutaMedica"
  description="Teleconsulta médica em português para brasileiros na Argentina. Receita digital, exames, atestados. Dr. Eduardo Marques, docente de Semiologia no Hospital de Clínicas."
  canonical={canonicalUrl}
  ogImage="/images/seo/og-main.webp"
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageSchema)} />

  <Navbar />

  <main class="bg-white text-neutral-900 overflow-hidden pt-20">
    <!-- HERO -->
    <section class="relative py-20 md:py-28 border-b border-neutral-100 overflow-hidden">
      <!-- Background subtle gradient -->
      <div class="absolute inset-0 bg-gradient-to-br from-green-50/60 via-white to-yellow-50/40" aria-hidden="true"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-green-200/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-72 h-72 bg-yellow-200/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4" aria-hidden="true"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-3xl">
          <!-- Flags -->
          <div class="flex items-center gap-3 mb-6">
            <span class="text-2xl">🇧🇷</span>
            <svg class="w-5 h-5 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            <span class="text-2xl">🇦🇷</span>
          </div>

          <span class="inline-block text-green-700 font-bold text-xs uppercase tracking-widest mb-6 bg-green-50 px-3 py-1.5 rounded-full">
            Atendimento em Português
          </span>

          <h1 class="text-4xl md:text-6xl font-serif font-medium leading-[1.08] tracking-tight text-neutral-950 mb-6">
            Brasileiro na Argentina<br/>
            <span class="text-green-700">e precisa de atendimento</span><br/>
            <span class="text-neutral-500 italic">médico em português?</span>
          </h1>

          <p class="text-lg md:text-xl text-neutral-600 max-w-xl font-light leading-relaxed mb-10">
            Teleconsulta com médico brasileiro, no seu idioma, sem sair de casa.
            Receita digital válida na Argentina, pedidos de exames, atestados e acompanhamento clínico.
          </p>

          <div class="flex flex-wrap gap-4">
            <a href="/auth/register" class="inline-flex items-center gap-2 rounded-xl bg-green-700 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-green-200 transition-all hover:bg-green-800 active:scale-[0.97]">
              Agendar Consulta
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href="#servicos" class="inline-flex items-center gap-2 rounded-xl border border-neutral-300 bg-white px-6 py-3.5 text-base font-medium text-neutral-700 transition-all hover:bg-neutral-50">
              Ver Serviços
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT THE DOCTOR -->
    <section class="py-20 md:py-28 bg-neutral-50">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="flex flex-col md:flex-row gap-12 items-start">
            <!-- Avatar placeholder -->
            <div class="flex-shrink-0">
              <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl bg-gradient-to-br from-green-600 to-emerald-800 flex items-center justify-center shadow-lg shadow-green-200">
                <span class="text-4xl md:text-5xl font-serif font-bold text-white">EM</span>
              </div>
              <p class="mt-3 text-center text-sm font-semibold text-neutral-700">Dr. Eduardo<br/>Marques</p>
            </div>

            <div class="space-y-6">
              <span class="inline-block text-green-700 font-bold text-xs uppercase tracking-widest bg-green-50 px-3 py-1.5 rounded-full">
                Quem te atende
              </span>
              <h2 class="text-3xl md:text-4xl font-serif font-medium leading-tight tracking-tight text-neutral-950">
                Dr. Eduardo Marques da Rosa
              </h2>
              <p class="text-lg text-neutral-600 leading-relaxed">
                Médico, docente de <strong class="text-neutral-900">Semiologia Médica no Hospital de Clínicas</strong>, 
                com formação prática ao lado de grandes nomes da Clínica Médica. Atuo com foco em 
                <strong class="text-neutral-900">diagnóstico correto, raciocínio clínico e acompanhamento individualizado</strong>.
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-900 text-sm">Hospital de Clínicas</p>
                    <p class="text-neutral-500 text-sm">Docente de Semiologia Médica</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-900 text-sm">Foco Clínico</p>
                    <p class="text-neutral-500 text-sm">Diagnóstico, raciocínio e acompanhamento</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVIÇOS -->
    <section id="servicos" class="py-20 md:py-28">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <span class="inline-block text-green-700 font-bold text-xs uppercase tracking-widest mb-6 bg-green-50 px-3 py-1.5 rounded-full">
            Serviços
          </span>
          <h2 class="text-3xl md:text-4xl font-serif font-medium leading-tight tracking-tight text-neutral-950 mb-12">
            Atendimento médico completo<br/>
            <span class="text-neutral-500 italic">pensado para você.</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Card 1 -->
            <div class="rounded-2xl border border-neutral-200 bg-white p-8 transition-all hover:border-green-200 hover:shadow-lg hover:shadow-green-50">
              <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center mb-5">
                <svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4"/></svg>
              </div>
              <h3 class="text-xl font-serif font-bold text-neutral-900 mb-3">🩺 Teleconsulta Médica</h3>
              <p class="text-neutral-600 leading-relaxed">Consulta por videochamada com médico brasileiro, no conforto da sua casa. Avaliação clínica completa, escuta atenta e plano de cuidado individualizado.</p>
            </div>

            <!-- Card 2 -->
            <div class="rounded-2xl border border-neutral-200 bg-white p-8 transition-all hover:border-green-200 hover:shadow-lg hover:shadow-green-50">
              <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center mb-5">
                <svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <h3 class="text-xl font-serif font-bold text-neutral-900 mb-3">🔬 Exames Laboratoriais e de Imagem</h3>
              <p class="text-neutral-600 leading-relaxed">Solicitação e interpretação de exames laboratoriais, raio-X, ultrassonografia e outros. Explicação clara dos resultados para você entender sua saúde.</p>
            </div>

            <!-- Card 3 -->
            <div class="rounded-2xl border border-neutral-200 bg-white p-8 transition-all hover:border-green-200 hover:shadow-lg hover:shadow-green-50">
              <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center mb-5">
                <svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
              </div>
              <h3 class="text-xl font-serif font-bold text-neutral-900 mb-3">💊 Prescrição Médica</h3>
              <p class="text-neutral-600 leading-relaxed">Receita digital válida em toda a Argentina, com QR code verificável e assinatura digital. Retire seu medicamento em qualquer farmácia.</p>
            </div>

            <!-- Card 4 -->
            <div class="rounded-2xl border border-neutral-200 bg-white p-8 transition-all hover:border-green-200 hover:shadow-lg hover:shadow-green-50">
              <div class="w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center mb-5">
                <svg class="w-6 h-6 text-green-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
              </div>
              <h3 class="text-xl font-serif font-bold text-neutral-900 mb-3">📋 Atestados Médicos</h3>
              <p class="text-neutral-600 leading-relaxed">Atestados para trabalho, universidade e atividades físicas. Documentação completa e reconhecida, com assinatura e matrícula médica.</p>
            </div>

            <!-- Card 5: Full width -->
            <div class="md:col-span-2 rounded-2xl border border-green-200 bg-gradient-to-br from-green-50 to-white p-8 transition-all hover:shadow-lg hover:shadow-green-50">
              <div class="flex flex-col md:flex-row items-start gap-6">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-600 flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/></svg>
                </div>
                <div>
                  <h3 class="text-xl font-serif font-bold text-neutral-900 mb-3">🏅 Avaliação de Apto Físico</h3>
                  <p class="text-neutral-600 leading-relaxed">Avaliação médica completa para emissão de certificado de aptidão física (APTO FÍSICO) para atividades esportivas, academias, competições e programas de saúde.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONDIÇÕES ATENDIDAS -->
    <section class="py-20 md:py-28 bg-neutral-50">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <span class="inline-block text-green-700 font-bold text-xs uppercase tracking-widest mb-6 bg-green-50 px-3 py-1.5 rounded-full">
            Condições Clínicas
          </span>
          <h2 class="text-3xl md:text-4xl font-serif font-medium leading-tight tracking-tight text-neutral-950 mb-12">
            Atendimento das condições<br/>
            <span class="text-neutral-500 italic">clínicas mais comuns.</span>
          </h2>

          <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            <div class="rounded-xl bg-white border border-neutral-200 p-5 text-center transition-all hover:border-green-200 hover:shadow-md">
              <span class="text-3xl mb-2 block">🧠</span>
              <p class="font-semibold text-neutral-900 text-sm">Cefaleias</p>
              <p class="text-neutral-500 text-xs mt-1">Dores de cabeça</p>
            </div>
            <div class="rounded-xl bg-white border border-neutral-200 p-5 text-center transition-all hover:border-green-200 hover:shadow-md">
              <span class="text-3xl mb-2 block">🫁</span>
              <p class="font-semibold text-neutral-900 text-sm">VAS</p>
              <p class="text-neutral-500 text-xs mt-1">Vias aéreas superiores</p>
            </div>
            <div class="rounded-xl bg-white border border-neutral-200 p-5 text-center transition-all hover:border-green-200 hover:shadow-md">
              <span class="text-3xl mb-2 block">🍽️</span>
              <p class="font-semibold text-neutral-900 text-sm">Gastroenterites</p>
              <p class="text-neutral-500 text-xs mt-1">Problemas digestivos</p>
            </div>
            <div class="rounded-xl bg-white border border-neutral-200 p-5 text-center transition-all hover:border-green-200 hover:shadow-md">
              <span class="text-3xl mb-2 block">🌸</span>
              <p class="font-semibold text-neutral-900 text-sm">Saúde da Mulher</p>
              <p class="text-neutral-500 text-xs mt-1">Ginecologia clínica</p>
            </div>
            <div class="rounded-xl bg-white border border-neutral-200 p-5 text-center transition-all hover:border-green-200 hover:shadow-md">
              <span class="text-3xl mb-2 block">🚹</span>
              <p class="font-semibold text-neutral-900 text-sm">Saúde do Homem</p>
              <p class="text-neutral-500 text-xs mt-1">Urologia clínica</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMO FUNCIONA -->
    <section class="py-20 md:py-28">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <span class="inline-block text-green-700 font-bold text-xs uppercase tracking-widest mb-6 bg-green-50 px-3 py-1.5 rounded-full">
            Como Funciona
          </span>
          <h2 class="text-3xl md:text-4xl font-serif font-medium leading-tight tracking-tight text-neutral-950 mb-16">
            Três passos simples<br/>
            <span class="text-neutral-500 italic">para cuidar da sua saúde.</span>
          </h2>

          <div class="space-y-8">
            <div class="flex gap-6 items-start">
              <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-green-700 text-white flex items-center justify-center text-2xl font-bold shadow-lg shadow-green-200">1</div>
              <div class="pt-1">
                <h3 class="text-xl font-serif font-bold text-neutral-900 mb-2">Cadastre-se gratuitamente</h3>
                <p class="text-neutral-600 leading-relaxed">Crie sua conta com e-mail e documento (RG, CPF ou passaporte). Leva menos de 2 minutos.</p>
              </div>
            </div>

            <div class="flex gap-6 items-start">
              <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-green-700 text-white flex items-center justify-center text-2xl font-bold shadow-lg shadow-green-200">2</div>
              <div class="pt-1">
                <h3 class="text-xl font-serif font-bold text-neutral-900 mb-2">Agende sua teleconsulta</h3>
                <p class="text-neutral-600 leading-relaxed">Escolha o melhor dia e horário. Você receberá um link por e-mail para acessar a sala virtual.</p>
              </div>
            </div>

            <div class="flex gap-6 items-start">
              <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-green-700 text-white flex items-center justify-center text-2xl font-bold shadow-lg shadow-green-200">3</div>
              <div class="pt-1">
                <h3 class="text-xl font-serif font-bold text-neutral-900 mb-2">Converse com o médico em português</h3>
                <p class="text-neutral-600 leading-relaxed">No horário marcado, entre na videochamada. Você será atendido em português, com calma e atenção. Ao final, receba sua receita, pedido de exames ou atestado.</p>
              </div>
            </div>
          </div>

          <div class="mt-12 text-center">
            <a href="/auth/register" class="inline-flex items-center gap-2 rounded-xl bg-green-700 px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-green-200 transition-all hover:bg-green-800 active:scale-[0.97]">
              Começar Agora
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 md:py-28 bg-neutral-50">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto">
          <span class="inline-block text-green-700 font-bold text-xs uppercase tracking-widest mb-6 bg-green-50 px-3 py-1.5 rounded-full">
            Dúvidas Frequentes
          </span>
          <h2 class="text-3xl md:text-4xl font-serif font-medium leading-tight tracking-tight text-neutral-950 mb-12">
            Perguntas e respostas
          </h2>

          <div class="space-y-4">
            {faqItems.map((item) => (
              <details class="group rounded-xl border border-neutral-200 bg-white overflow-hidden transition-all hover:border-green-200">
                <summary class="flex items-center justify-between px-6 py-5 cursor-pointer font-semibold text-neutral-900 list-none marker:content-none">
                  {item.question}
                  <svg class="w-5 h-5 text-neutral-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </summary>
                <div class="px-6 pb-5 text-neutral-600 leading-relaxed">
                  {item.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <CTAFinal />
  </main>

  <Footer />
</Layout>
