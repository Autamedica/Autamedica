---
import Layout from '../../layouts/Layout.astro';
import PortalLanding from '../../components/portal/PortalLanding.astro';
import { ROLE_ENTRIES, buildRoleAuthPath } from '../../lib/auth-flow';
---

<Layout
  title="AutaMedica Platform"
  description="Experiencia transversal de producto con entrada unificada a pacientes, médicos y empresas."
  canonical="https://www.autamedica.com/platform"
  ogImage="/images/seo/og-platform.webp"
>
  <PortalLanding
    badge="Web-App Pilot"
    title="Experience Hub en Astro"
    subtitle="Migración incremental de la web-app legacy a una capa Astro con SEO fuerte y carga inicial más liviana."
    accent="var(--au-accent)"
    stats={[
      { value: '-40%', label: 'Meta JS inicial' },
      { value: 'SEO +15', label: 'Objetivo Lighthouse' },
      { value: 'SSR', label: 'Solo donde aporta valor' },
    ]}
    pillars={[
      {
        title: 'Entrada por rol',
        description: 'Selección de perfil y login centralizado sin duplicar flujos de autenticación.',
      },
      {
        title: 'Diseño unificado',
        description: 'Tokens, componentes base y patrones de feedback consistentes entre portales.',
      },
      {
        title: 'Monitoreo de calidad',
        description: 'Lighthouse y Web Vitals instrumentados para release por slices sin regresiones.',
      },
    ]}
    primaryCta={{
      href: '/auth/select-role',
      label: 'Elegir perfil e ingresar',
    }}
    secondaryCta={{
      href: '/',
      label: 'Volver a la home pública',
    }}
  />

  <section class="platform-fast-entry" aria-label="Ingreso rápido por perfil">
    <div class="platform-fast-entry-inner">
      <h2>Ingreso directo por perfil</h2>
      <p>Accede al flujo correcto desde el primer clic.</p>
      <div class="platform-fast-entry-grid">
        {ROLE_ENTRIES.map((entry) => (
          <a href={buildRoleAuthPath('login', entry.role)} style={`--entry-accent:${entry.accent};`}>
            <span>{entry.label}</span>
            <small>{entry.description}</small>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .platform-fast-entry {
    padding: 0 var(--section-px) var(--space-16);
    background: var(--au-bg);
  }

  .platform-fast-entry-inner {
    max-width: 1120px;
    margin: 0 auto;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    padding: var(--space-6);
  }

  .platform-fast-entry h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .platform-fast-entry p {
    margin: var(--space-2) 0 var(--space-4);
    color: var(--au-text-secondary);
  }

  .platform-fast-entry-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .platform-fast-entry-grid a {
    border: 1px solid color-mix(in srgb, var(--entry-accent) 45%, var(--au-border));
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    background: color-mix(in srgb, var(--entry-accent) 8%, transparent);
    transition: transform var(--transition-fast), background var(--transition-fast);
  }

  .platform-fast-entry-grid a:hover {
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--entry-accent) 15%, transparent);
  }

  .platform-fast-entry-grid span {
    display: block;
    font-weight: var(--font-semibold);
    color: var(--au-text-primary);
  }

  .platform-fast-entry-grid small {
    display: block;
    margin-top: var(--space-1);
    color: var(--au-text-secondary);
    font-size: var(--text-xs);
  }
</style>
