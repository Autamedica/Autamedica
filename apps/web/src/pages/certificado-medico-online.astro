---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const canonicalUrl = 'https://www.autamedica.com/certificado-medico-online';

const steps = [
  {
    num: '01',
    title: 'Registro y Triaje Inicial',
    desc: 'Ingresás a la plataforma, confirmás tus datos de identidad y describís brevemente tus síntomas para que el profesional cuente con el contexto previo.',
  },
  {
    num: '02',
    title: 'Videoconsulta Médica Sincrónica',
    desc: 'Te conectás en vivo con un médico matriculado en Argentina (MN o MP). Se realiza la anamnesis completa, evaluación clínica y constatación del cuadro de salud.',
  },
  {
    num: '03',
    title: 'Emisión con Firma Digital y CUIR',
    desc: 'Si el criterio clínico determina la necesidad de reposo o constancia, el profesional confecciona el certificado con Código CUIR y firma electrónica avanzada.',
  },
  {
    num: '04',
    title: 'Descarga en PDF y Envío Inmediato',
    desc: 'El certificado queda disponible al instante en tu perfil para descargar en PDF con código QR de verificación pública, listo para remitir a RRHH o a tu universidad.',
  },
];

const conditions = [
  {
    category: 'Infecciones Respiratorias Agudas',
    items: ['Faringitis aguda y amigdalitis', 'Síndrome gripal y resfrío común', 'Bronquitis aguda ambulatoria', 'Rinosinusitis y laringitis'],
    desc: 'Evaluación de fiebre, tos, congestión, dolor de garganta y necesidad de reposo o tratamiento antibiótico.',
  },
  {
    category: 'Trastornos Gastrointestinales',
    items: ['Gastroenteritis aguda febril', 'Náuseas, vómitos y diarrea', 'Intoxicación alimentaria leve', 'Dolor abdominal cólico sin signos de alarma'],
    desc: 'Determinación de reposo digestivo, pautas de hidratación oral y reposo laboral de 24 a 72 horas.',
  },
  {
    category: 'Afecciones Osteomusculares',
    items: ['Lumbalgia aguda con contractura', 'Cervicalgia y tortícolis', 'Traumatismo articular leve', 'Tendinopatías agudas'],
    desc: 'Indicación de reposo osteomuscular, analgésicos, pautas ergonómicas y derivación a kinesiología si aplica.',
  },
  {
    category: 'Cefaleas y Cuadros Neurológicos Leves',
    items: ['Cefalea tensional intensa', 'Crisis migrañosa recurrente', 'Agotamiento psicofísico agudo', 'Vértigo posicional leve'],
    desc: 'Constatación de sintomatología invalidante transitoria y prescripción médica de analgesia específica.',
  },
];

const faqs = [
  {
    q: '¿Cómo funciona el trámite de certificado médico online en AutaMedica?',
    a: 'El trámite se basa en una consulta médica real. Te registrás en la plataforma, ingresás a la sala de espera virtual y realizás una videoconsulta con un médico matriculado. Si tras la evaluación clínica el profesional determina que requerís reposo o que tu estado de salud amerita justificación, emite el certificado digital con código CUIR y código QR de forma instantánea.',
  },
  {
    q: '¿El certificado médico emitido online es válido para mi trabajo?',
    a: 'Sí. En la República Argentina la telemedicina está regulada por la Ley 27.553 y su Decreto Reglamentario 98/2023. Los certificados emitidos con firma electrónica o digital por médicos matriculados tienen plena validez legal para justificar inasistencias laborales según la Ley de Contrato de Trabajo (Ley 20.744).',
  },
  {
    q: '¿Cómo verifica mi empresa que el certificado es auténtico?',
    a: 'Cada documento cuenta con un código alfanumérico CUIR y un código QR institucional. El área de recursos humanos o medicina laboral solo debe escanear el QR o ingresar a autamedica.com/verify/[cuir] para constatar en tiempo real que el certificado fue emitido por un médico matriculado, en qué fecha y por cuántos días de reposo.',
  },
  {
    q: '¿Puedo solicitar días de reposo retroactivos?',
    a: 'No. Ningún médico matriculado puede emitir certificados con fechas retroactivas, ya que la ley y el código de ética médica exigen que el profesional certifique exclusivamente hechos constatados de manera coetánea durante el acto médico.',
  },
  {
    q: '¿Se incluye la receta electrónica si requiero medicación?',
    a: 'Sí. Si durante la consulta el médico determina que necesitás fármacos (antibióticos, analgésicos, antiespasmódicos, etc.), emitirá la receta electrónica oficial con firma digital, válida en farmacias de todo el país.',
  },
  {
    q: '¿Qué ocurre si el médico considera que mi cuadro requiere guardia presencial?',
    a: 'La seguridad del paciente es nuestra máxima prioridad. Si el profesional detecta signos de alarma (como dolor torácico opresivo, disnea aguda severa, abdomen en tabla o déficit neurológico agudo), suspenderá la teleasistencia, te orientará sobre la conducta inmediata y emitirá la orden de derivación a un centro de urgencias presencial.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Certificado Médico Online con Médicos Matriculados | AutaMedica',
      description:
        'Obtené tu certificado médico online en Argentina mediante videoconsulta con médicos matriculados. Validez legal Ley 27.553, código CUIR oficial y validación QR.',
      inLanguage: 'es-AR',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://www.autamedica.com/#website',
        name: 'AutaMedica',
        url: 'https://www.autamedica.com',
      },
      about: {
        '@type': 'MedicalProcedure',
        name: 'Consulta Médica Virtual y Emisión de Certificado Médico',
        procedureType: 'https://schema.org/NoninvasiveProcedure',
      },
      publisher: {
        '@type': 'MedicalOrganization',
        name: 'AutaMedica',
        url: 'https://www.autamedica.com',
        logo: 'https://www.autamedica.com/images/brand/logo_bioceramic.png',
      },
      audience: {
        '@type': 'PeopleAudience',
        geographicArea: {
          '@type': 'Country',
          name: 'Argentina',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.autamedica.com',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Certificados Médicos',
          item: 'https://www.autamedica.com/certificados-medicos',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Certificado Médico Online',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a,
        },
      })),
    },
  ],
};
---

<Layout
  title="Certificado Médico Online en Argentina | AutaMedica"
  description="Obtené tu certificado médico online con médicos matriculados por videoconsulta. Firma digital, código CUIR oficial, validación por QR y descarga inmediata en PDF."
  canonical={canonicalUrl}
  ogImage="/images/seo/og-main.webp"
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <Navbar />

  <main class="bg-white text-slate-900 pt-20">
    <!-- HERO SECTION -->
    <header class="relative bg-gradient-to-b from-sky-50/50 via-white to-slate-50/40 border-b border-slate-200/80 pt-16 pb-20 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-200 text-sky-800 text-xs font-semibold uppercase tracking-wider mb-6">
              <span class="w-2 h-2 rounded-full bg-sky-600"></span>
              <span>Telemedicina Oficial · Ley 27.553</span>
            </div>

            <h1 class="text-4xl md:text-6xl font-serif font-bold text-slate-950 tracking-tight leading-[1.12] mb-6">
              Certificado médico online con <span class="text-sky-700 italic">médicos matriculados.</span>
            </h1>

            <p class="text-lg md:text-xl text-slate-600 font-normal leading-relaxed mb-8">
              Atención médica profesional por videoconsulta desde tu casa. Evaluación clínica sincrónica, emisión de certificado digital con firma verificable, código CUIR y descarga inmediata en PDF para tu trabajo o universidad.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a
                href="/auth/register"
                class="inline-flex items-center justify-center px-8 py-4 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl shadow-lg shadow-sky-600/20 transition-all transform hover:-translate-y-0.5"
              >
                Solicitar Consulta Médica
              </a>
              <a
                href="/certificados-medicos"
                class="inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-slate-50 text-slate-800 font-semibold rounded-xl border border-slate-200 transition-colors"
              >
                Ver Tipos de Certificados
              </a>
            </div>

            <div class="flex flex-wrap items-center gap-6 text-xs text-slate-600">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Médicos con Matrícula Vigente</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Validez Laboral (Ley 20.744)</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span>QR de Verificación en autamedica.com/verify</span>
              </div>
            </div>
          </div>

          <!-- TARJETA VISUAL DE VALIDEZ -->
          <div class="lg:col-span-5">
            <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xl shadow-slate-200/50 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-32 h-32 bg-sky-50 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>

              <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
                <div>
                  <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Plataforma Certificada</p>
                  <p class="font-serif font-bold text-slate-900 text-lg">Certificado Oficial AutaMedica</p>
                </div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  Conforme Ley 27.553
                </span>
              </div>

              <div class="space-y-4 text-sm text-slate-700 mb-6">
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 rounded-md bg-sky-50 text-sky-700 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
                    ✓
                  </div>
                  <div>
                    <p class="font-semibold text-slate-900">Acto médico genuino</p>
                    <p class="text-xs text-slate-500">Videoconsulta sincrónica con médico clínico de guardia o especialista.</p>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 rounded-md bg-sky-50 text-sky-700 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
                    ✓
                  </div>
                  <div>
                    <p class="font-semibold text-slate-900">Trazabilidad con Código CUIR</p>
                    <p class="text-xs text-slate-500">Registro inmutable que garantiza que el certificado no fue adulterado.</p>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 rounded-md bg-sky-50 text-sky-700 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">
                    ✓
                  </div>
                  <div>
                    <p class="font-semibold text-slate-900">Descarga inmediata en PDF</p>
                    <p class="text-xs text-slate-500">Formato digital oficial con código QR listo para reenviar a RRHH.</p>
                  </div>
                </div>
              </div>

              <div class="p-4 bg-slate-50 rounded-xl border border-slate-200/80 text-xs text-slate-600">
                <p class="font-semibold text-slate-900 mb-1">Nota deontológica:</p>
                <p>La indicación de reposo laboral o escolar está sujeta al criterio médico clínico. No se comercializan certificados sin consulta.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- PROCESO PASO A PASO (4 PASOS) -->
    <section class="py-20 md:py-28 bg-white border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-sky-700 font-bold text-xs uppercase tracking-widest block mb-3">Circuito Clínico</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-950 mb-4">
            Cómo tramitar tu certificado médico online en 4 pasos.
          </h2>
          <p class="text-slate-600 text-base md:text-lg">
            Un flujo claro, seguro y pensado para resolver tu necesidad de salud y justificación documental sin moverte de tu domicilio.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {steps.map((st) => (
            <div class="bg-slate-50 rounded-2xl border border-slate-200 p-8 flex flex-col justify-between hover:border-sky-300 transition-all">
              <div>
                <span class="inline-block font-mono text-3xl font-bold text-sky-600 mb-4">{st.num}</span>
                <h3 class="text-lg font-serif font-bold text-slate-950 mb-3">{st.title}</h3>
                <p class="text-slate-600 text-sm leading-relaxed">{st.desc}</p>
              </div>
              <div class="pt-6 mt-6 border-t border-slate-200/60">
                <span class="text-xs font-semibold text-sky-700">Paso obligatorio</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CASOS FRECUENTES Y QUÉ SE EVALÚA -->
    <section class="py-20 md:py-28 bg-slate-50 border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-3xl mb-16">
          <span class="text-sky-700 font-bold text-xs uppercase tracking-widest block mb-3">Alcance Clínico Ambulatorio</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-950 mb-4">
            Cuadros frecuentes evaluados en consulta virtual.
          </h2>
          <p class="text-slate-600 text-base md:text-lg">
            La telemedicina resulta altamente resolutiva para patologías agudas de baja y mediana complejidad que requieren indicación de reposo y contención médica inmediata.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {conditions.map((cond) => (
            <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
              <h3 class="text-xl font-serif font-bold text-slate-950 mb-3">{cond.category}</h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">{cond.desc}</p>
              <ul class="space-y-2 pt-4 border-t border-slate-100 text-xs text-slate-700 font-medium">
                {cond.items.map((it) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-600"></span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ADVERTENCIA DE BANDERAS ROJAS Y URGENCIAS -->
    <section class="py-16 bg-white border-b border-slate-100">
      <div class="max-w-4xl mx-auto px-6">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 md:p-8 flex flex-col md:flex-row gap-6 items-start">
          <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center flex-shrink-0 font-bold text-xl border border-red-200">
            !
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-serif font-bold text-slate-950">
              ¿Cuándo NO corresponde solicitar un certificado online?
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Si presentás dolor de pecho con irradiación al brazo o mandíbula, dificultad para respirar en reposo, pérdida de fuerza o dificultad para hablar, sangrado profuso o traumatismos con dolor desmedido, no inicies una teleconsulta. Debes llamar de inmediato al 107 (SAME) o acudir a la guardia presencial más cercana.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQS ACCORDION -->
    <section class="py-20 md:py-28 bg-slate-50 border-b border-slate-200">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-sky-700 font-bold text-xs uppercase tracking-widest block mb-3">Preguntas Habituales</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-950">
            Todo lo que necesitás saber antes de tu consulta.
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-white rounded-2xl border border-slate-200 overflow-hidden transition-colors">
              <summary class="p-6 md:p-8 flex justify-between items-center cursor-pointer list-none select-none">
                <span class="text-base md:text-lg font-serif font-bold text-slate-900 pr-4">{faq.q}</span>
                <span class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-semibold group-open:rotate-180 group-open:bg-sky-50 group-open:text-sky-700 transition-transform flex-shrink-0">
                  &darr;
                </span>
              </summary>
              <div class="px-6 md:px-8 pb-6 md:pb-8 text-slate-600 text-sm leading-relaxed border-t border-slate-100 pt-4">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-20 md:py-28 bg-white text-center">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-slate-950 mb-6">
          Resolvé tu consulta médica y tu certificado hoy.
        </h2>
        <p class="text-slate-600 text-base md:text-lg mb-10 leading-relaxed">
          Ingresá a la guardia digital de AutaMedica, realizá tu videoconsulta con un médico matriculado y descargá tu certificado oficial con QR en minutos.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href="/auth/register"
            class="inline-flex items-center justify-center px-10 py-4 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl shadow-lg shadow-sky-600/20 transition-all transform hover:-translate-y-0.5 text-base"
          >
            Solicitar Consulta Médica
          </a>
          <a
            href="/certificados-medicos"
            class="inline-flex items-center justify-center px-10 py-4 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold rounded-xl transition-colors text-base"
          >
            Volver al Hub de Certificados
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>
