---
import CallLayout from '@/layouts/CallLayout.astro';
import DoctorCallPage from '@/components/doctors/calls/DoctorCallPage';

const { roomId } = Astro.params;

const title = 'Videollamada médica | AutaMedica';
const description = 'Sala de videollamada médica';
