---
import Layout from '../../layouts/Layout.astro';
import { AppointmentsPanel } from '../../components/doctors/appointments/AppointmentsPanel';
---

<Layout
  title="Agenda médica"
  description="Agenda diaria para médicos con foco en continuidad asistencial y respuesta rápida."
  canonical="https://www.autamedica.com/doctors/agenda"
  robots="noindex, nofollow, noarchive"
>
  <main class="page-shell">
    <AppointmentsPanel client:load />
  </main>
</Layout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: clamp(2rem, 4vh, 3rem) var(--section-px) var(--space-16);
    background: var(--au-bg);
  }
</style>
