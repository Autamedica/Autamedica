---
import Layout from '@/layouts/Layout.astro';
import { DoctorsConsultationsPage } from '@/components/doctors/DoctorsConsultationsPage';

const patientId = Astro.params.patientId ?? null;
const title = 'Ficha del paciente | Portal Médico | AutaMedica';
const description = 'Ficha personal del paciente dentro del portal médico';
const canonical = patientId
  ? `https://www.autamedica.com/doctors/patients/${encodeURIComponent(patientId)}`
  : 'https://www.autamedica.com/doctors/patients';
---

<Layout title={title} description={description} canonical={canonical} robots="noindex, nofollow, noarchive">
  <DoctorsConsultationsPage client:load initialPatientId={patientId} initialView="profile" />
</Layout>
