---
import Layout from '../../layouts/Layout.astro';
import PortalLanding from '../../components/portal/PortalLanding.astro';
import VerticalStructuredData from '../../components/seo/VerticalStructuredData.astro';
import { buildRoleAuthPath } from '../../lib/auth-flow';
import { getI18n } from '../../i18n/index';
const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);

const pageTitle = t('portals.doctors.title');
const pageDescription = t('portals.doctors.description');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://www.autamedica.com/doctors"
  ogImage="/images/seo/og-doctors.webp"
>
  <VerticalStructuredData
    vertical="doctors"
    pathname="/doctors"
    title={pageTitle}
    description={pageDescription}
  />

  <PortalLanding
    badge={t('portals.doctors.badge')}
    title={t('portals.doctors.title')}
    subtitle={t('portals.doctors.description')}
    accent="var(--portal-doctors)"
    stats={[
      { value: 'HD', label: 'Teleconsulta integrada' },
      { value: '1-2', label: 'Clics para acciones clave' },
      { value: '<200ms', label: 'Meta de INP p75' },
    ]}
    pillars={[
      {
        title: 'Flujo clinico principal',
        description: 'Acceso directo a agenda, videollamada y notas sin navegar multiples pantallas.',
      },
      {
        title: 'Contexto del paciente',
        description: 'Informacion relevante priorizada para reducir tiempos de decision durante la consulta.',
      },
      {
        title: 'Rendimiento controlado',
        description: 'Islands React solo en widgets interactivos; resto server-rendered para reducir JS inicial.',
      },
    ]}
    primaryCta={{
      href: buildRoleAuthPath('login', 'doctor'),
      label: t('roles.doctor.buttonLabel'),
    }}
    secondaryCta={{
      href: buildRoleAuthPath('register', 'doctor'),
      label: t('auth.createAccount'),
    }}
  />

  <section class="quick-links" aria-label="Accesos rapidos doctors">
    <div class="quick-links-inner">
      <h2>{t('portals.doctors.quickLinksTitle')}</h2>
      <div class="quick-links-grid">
        <a href="/doctors/agenda">{t('portals.doctors.links.agenda')}</a>
        <a href="/doctors/consultations">{t('portals.doctors.links.consultations')}</a>
        <a href="/doctors/patients">{t('portals.doctors.links.patients')}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .quick-links {
    padding: 0 var(--section-px) var(--space-16);
    background: var(--au-bg);
  }

  .quick-links-inner {
    max-width: 1120px;
    margin: 0 auto;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
    padding: var(--space-6);
  }

  .quick-links h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .quick-links-grid a {
    border: 1px solid var(--au-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    color: var(--au-text-secondary);
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }

  .quick-links-grid a:hover {
    border-color: var(--portal-doctors);
    color: var(--au-text-primary);
    background: var(--au-accent-soft);
  }
</style>
