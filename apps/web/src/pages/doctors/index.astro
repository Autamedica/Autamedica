---
import Layout from '../../layouts/Layout.astro';
import PortalLanding from '../../components/portal/PortalLanding.astro';
import VerticalStructuredData from '../../components/seo/VerticalStructuredData.astro';
import NewsletterCapture from '../../components/NewsletterCapture.astro';
import Footer from '../../components/Footer.astro';
import { buildRoleAuthPath } from '../../lib/auth-flow';
import { getI18n } from '../../i18n/index';
const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);

const pageTitle = t('portals.doctors.title');
const pageDescription = t('portals.doctors.description');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://www.autamedica.com/doctors"
  ogImage="/images/seo/og-doctors.webp"
>
  <VerticalStructuredData
    vertical="doctors"
    pathname="/doctors"
    title={pageTitle}
    description={pageDescription}
  />

  <PortalLanding
    badge={t('portals.doctors.badge')}
    title={t('portals.doctors.title')}
    subtitle={t('portals.doctors.description')}
    accent="var(--portal-doctors)"
    stats={[
      { value: 'HD', label: 'Teleconsulta integrada' },
      { value: '1-2', label: 'Clics para acciones clave' },
      { value: '<200ms', label: 'Meta de INP p75' },
    ]}
    pillars={[
      {
        title: 'Flujo clinico principal',
        description: 'Acceso directo a agenda, videollamada y notas sin navegar multiples pantallas.',
      },
      {
        title: 'Contexto del paciente',
        description: 'Informacion relevante priorizada para reducir tiempos de decision durante la consulta.',
      },
      {
        title: 'Rendimiento controlado',
        description: 'Islands React solo en widgets interactivos; resto server-rendered para reducir JS inicial.',
      },
    ]}
    primaryCta={{
      href: buildRoleAuthPath('register', 'doctor'),
      label: t('auth.createAccount'),
    }}
    secondaryCta={{
      href: buildRoleAuthPath('login', 'doctor'),
      label: t('auth.signIn'),
    }}
  />

  <NewsletterCapture 
    vertical="doctors" 
    intent="doctor_onboarding" 
    formId="doctor_interest"
    title="¿Sos profesional de la salud?"
    subtitle="Dejanos tu email para recibir información sobre cómo integrar AutaMedica en tu práctica privada y acceder a las herramientas de IA clínica."
    buttonLabel="Quiero saber más"
    placeholder="tu@email.com"
  />

  <Footer />
</Layout>
