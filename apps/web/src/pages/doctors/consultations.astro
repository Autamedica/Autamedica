---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Consultas en curso"
  description="Panel de consultas activas para médicos con prioridad clínica."
  canonical="https://www.autamedica.com/doctors/consultations"
  robots="noindex, nofollow, noarchive"
>
  <main class="page-shell">
    <section class="page-card">
      <p class="page-badge">Doctors Workflow</p>
      <h1>Consultas en curso</h1>
      <p class="page-lead">
        Panel de consultas activas con prioridad clínica y acceso rápido a herramientas médicas.
      </p>

      <div class="empty-state">
        <svg class="empty-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 12h4"/><path d="M10 16h4"/></svg>
        <p class="empty-title">Sin consultas activas</p>
        <p class="empty-detail">Las consultas aparecerán aquí cuando se inicie una sesión de atención.</p>
      </div>

      <div class="actions">
        <a class="primary" href="/doctors">Volver al portal médicos</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: clamp(4.5rem, 9vh, 6.5rem) var(--section-px) var(--space-16);
    background:
      radial-gradient(circle at 15% -10%, rgba(59, 130, 246, 0.2), transparent 40%),
      radial-gradient(circle at 88% 0%, rgba(16, 185, 129, 0.1), transparent 38%),
      var(--au-bg);
  }

  .page-card {
    max-width: 980px;
    margin: 0 auto;
    border: 1px solid var(--au-border);
    border-radius: var(--radius-lg);
    background: rgba(20, 20, 22, 0.94);
    box-shadow: var(--shadow-glow);
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }

  .page-badge {
    display: inline-flex;
    margin: 0 0 var(--space-4);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--au-border-hover);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--au-text-secondary);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  .page-lead {
    margin: var(--space-3) 0 var(--space-7);
    color: var(--au-text-secondary);
    max-width: 70ch;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-12) var(--space-4);
    border: 1px dashed var(--au-border);
    border-radius: var(--radius-md);
    background: var(--au-surface);
  }

  .empty-icon {
    color: var(--au-text-tertiary);
    margin: 0 auto var(--space-4);
  }

  .empty-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    color: var(--au-text-secondary);
  }

  .empty-detail {
    margin: 0;
    color: var(--au-text-tertiary);
    font-size: var(--text-sm);
  }

  .actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .actions a:hover { transform: translateY(-1px); }
  .actions .primary { background: var(--au-accent); color: #111; border: 1px solid transparent; }
</style>
