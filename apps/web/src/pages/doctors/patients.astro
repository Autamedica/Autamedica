---
import Layout from '../../layouts/Layout.astro';
import { PatientsPanel } from '../../components/doctors/patients/PatientsPanel';
---

<Layout
  title="Panel de pacientes"
  description="Seguimiento y gestión de pacientes asignados al médico."
  canonical="https://www.autamedica.com/doctors/patients"
  robots="noindex, nofollow, noarchive"
>
  <main class="page-shell">
    <PatientsPanel client:load />
  </main>
</Layout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: clamp(2rem, 4vh, 3rem) var(--section-px) var(--space-16);
    background: var(--au-bg);
  }
</style>
