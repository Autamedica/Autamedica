---
import Layout from '@/layouts/Layout.astro';
import { DoctorsDashboardPage } from '@/components/doctors/DoctorsDashboardPage';

const title = 'Portal Médico | AutaMedica';
const description = 'Portal de videoconsultas para profesionales médicos';
const locale = Astro.locals.locale ?? 'es';
---

<Layout title={title} description={description}>
  <DoctorsDashboardPage client:load locale={locale} />
</Layout>
