          <a href="/receta-medica-online" class="p-8 bg-white rounded-3xl border border-neutral-200/80 hover:border-sky-400 hover:shadow-md transition-all group block">
            <span class="text-xs font-semibold text-sky-700 uppercase tracking-wider block mb-2">Tratamientos Crónicos</span>
            <h4 class="text-2xl font-serif font-bold text-neutral-950 group-hover:text-sky-700 transition-colors mb-3">Renovación de Receta Digital</h4>
            <p class="text-sm text-neutral-600 leading-relaxed font-light mb-4">
              Renová tu prescripción de enalapril, losartán, amlodipina u otros antihipertensivos con código CUIR y firma electrónica oficial de médicos matriculados, válida en todas las farmacias del país.
            </p>
            <span class="text-sm font-semibold text-sky-700 inline-flex items-center gap-2">
              Renovar receta de hipertensión &rarr;
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="py-24 bg-white border-b border-neutral-100">
      <div class="container mx-auto px-6 max-w-4xl">
        <div class="text-center mb-16">
          <span class="text-xs font-bold uppercase tracking-widest text-sky-700 block mb-3">Dudas Habituales</span>
          <h2 class="text-3xl md:text-5xl font-serif font-bold text-neutral-950 mb-4">
