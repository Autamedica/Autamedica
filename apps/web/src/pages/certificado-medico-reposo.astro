---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CTAFinal from '../components/CTAFinal.astro';

const canonicalUrl = 'https://www.autamedica.com/certificado-medico-reposo';

const restTiers = [
  {
    hours: '24 Horas',
    indication: 'Reposo Sintomático Inicial',
    cases: 'Cefalea intensa o migraña aguda, reacciones adversas posvacunales leves, cuadros febriles incipientes en período de observación clínica o malestar post-procedimiento ambulatorio menor.',
    action: 'Reposo en domicilio, hidratación adecuada y reevaluación clínica en caso de progresión térmica o agravamiento de los síntomas.',
  },
  {
    hours: '48 Horas',
    indication: 'Convalecencia Digestiva y Musculoesquelética',
    cases: 'Gastroenteritis aguda sin deshidratación severa, contractura lumbar o cervical paravertebral aguda con limitación funcional, o síndrome vertiginoso posicional benigno en tratamiento.',
    action: 'Suspensión temporaria de la carga física y laboral, dieta astringente o analgésicos específicos según prescripción médica.',
  },
  {
    hours: '72 Horas',
    indication: 'Aislamiento y Recuperación Infecciosa Aguda',
    cases: 'Síndrome gripal o influenza con quebrantamiento del estado general, faringoamigdalitis bacteriana aguda bajo antibioticoterapia y bronquitis aguda.',
    action: 'Reposo absoluto en cama, control de curva térmica y prevención del contagio en ámbitos de trabajo comunitario o escolar.',
  },
  {
    hours: '5 a 7 Días',
    indication: 'Rehabilitación y Control Evolutivo',
    cases: 'Esguinces articulares que requieren inmovilización funcional relativa, neumopatías ambulatorias leves con antibioticoterapia oral de curso controlado o cuadros infecciosos respiratorios con evolución tórpida.',
    action: 'Seguimiento clínico obligatorio al quinto día, inmovilización funcional y control de signos vitales para otorgar el alta médica definitiva.',
  },
];

const clinicalDifferentiators = [
  {
    title: 'Reposo Ambulatorio Común (AutaMedica)',
    scope: 'Afecciones agudas cotidianas, autolimitadas o de resolución ambulatoria de corto plazo (1 a 7 días).',
    legal: 'Amparado por el Art. 208 de la Ley de Contrato de Trabajo (enfermedad inculpable) y la Ley 27.553 de Teleasistencia Médica.',
    channel: 'Videoconsulta inmediata con médicos matriculados, emisión instantánea de certificado digital con código CUIR.',
  },
  {
    title: 'Licencias Laborales Complejas / Prolongadas',
    scope: 'Tratamientos oncológicos, psiquiátricos mayores, cirugías mayores programadas o convalecencias superiores a 15-30 días.',
    legal: 'Requieren intervención de médicos especialistas tratantes, historia clínica prolongada, auditorías presenciales y juntas médicas.',
    channel: 'No son resueltas por atención ambulatoria rápida; se gestionan mediante seguimiento multidisciplinario.',
  },
  {
    title: 'Accidentes de Trabajo / Enfermedades Profesionales (ART)',
    scope: 'Traumatismos sufridos durante la jornada laboral o en el trayecto directo al trabajo (in itinere).',
    legal: 'Régimen exclusivo de la Ley de Riesgos del Trabajo 24.557; la cobertura y el reposo son fijados por la ART asignada.',
    channel: 'AutaMedica asiste la urgencia inicial y deriva formalmente a los centros asistenciales de la aseguradora del trabajador.',
  },
];

const faqs = [
  {
    question: '¿Qué es un certificado médico de reposo ambulatorio?',
    answer:
      'Es la constancia médica oficial mediante la cual un médico matriculado, tras examinar y entrevistar al paciente mediante videoconsulta sincrónica, determina que cursa un cuadro clínico que requiere reposo físico en su hogar para su recuperación biológica, indicando la cantidad de días necesarios de aislamiento o convalecencia.',
  },
  {
    question: '¿Cuántos días de reposo puede otorgar el médico por telemedicina?',
    answer:
      'La prescripción de reposo se gradúa estrictamente según el cuadro clínico y la evidencia médica disponible. En cuadros ambulatorios agudos (gastroenteritis, síndrome febril, virosis respiratorias), los períodos habituales varían entre 24, 48 o 72 horas. Si al cumplirse ese lapso los síntomas persisten o se complican, el paciente debe realizar una nueva consulta de reevaluación para extender la indicación de manera fundada.',
  },
  {
    question: '¿Mi empleador puede cuestionar los días de reposo indicados?',
    answer:
      'El empleador tiene la facultad legal (Art. 210 de la Ley de Contrato de Trabajo) de constatar el estado clínico del dependiente mediante su servicio de medicina laboral a domicilio. Sin embargo, el certificado emitido por AutaMedica bajo la Ley 27.553 tiene plena validez jurídica fehaciente; el empleador no puede desestimar arbitrariamente la justificación médica.',
  },
  {
    question: '¿Puedo solicitar que no figure mi diagnóstico en el certificado de reposo?',
    answer:
      'Sí. Conforme a la Ley 25.326 (Habeas Data) y la Ley 26.529 (Derechos del Paciente), el diagnóstico es un dato sensible confidencial. Podés solicitar al profesional que consigne la fórmula de diagnóstico reservado amparado en la ley. Tu empleador solo necesita conocer los días de reposo prescriptos y la matrícula del médico actuante.',
  },
  {
    question: '¿Qué información incluye el certificado emitido por AutaMedica?',
    answer:
      'El documento incluye nombre completo y DNI del paciente, cantidad de días de reposo en números y letras, fecha de inicio y fecha de reintegro estimada, nombre, matrícula profesional (MN/MP) y especialidad del médico, firma electrónica con sello de tiempo y el código CUIR con código QR para auditoría pública en autamedica.com/verify.',
  },
  {
    question: '¿Qué pasa si presento signos de gravedad o banderas rojas?',
    answer:
      'AutaMedica prioriza incondicionalmente la seguridad de tu vida. Si durante la consulta o el triaje se detectan banderas rojas (como dolor torácico opresivo, disnea progresiva, rigidez de nuca o abdomen agudo), no se emite certificado ambulatorio: se interrumpe la videoconsulta y se ordena la asistencia médica urgente llamando al 107 (SAME) o concurriendo al hospital de guardia más cercano.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Certificado Médico de Reposo Ambulatorio en Argentina | AutaMedica',
      description:
        'Certificado médico digital de reposo ambulatorio por 24hs, 48hs o 72hs. Indicación médica de convalecencia bajo Ley 27.553 y Ley 20.744. Validación inmediata por QR.',
      inLanguage: 'es-AR',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://www.autamedica.com/#website',
        name: 'AutaMedica',
        url: 'https://www.autamedica.com',
      },
      about: [
        { '@type': 'Thing', name: 'Certificado de reposo médico' },
        { '@type': 'Thing', name: 'Reposo ambulatorio' },
        { '@type': 'Thing', name: 'Licencia médica laboral' },
        { '@type': 'Thing', name: 'Ley 20744 Art 208' },
      ],
      publisher: {
        '@type': 'MedicalOrganization',
        name: 'AutaMedica',
        url: 'https://www.autamedica.com',
        logo: 'https://www.autamedica.com/images/brand/logo_bioceramic.png',
      },
      audience: {
        '@type': 'MedicalAudience',
        audienceType: 'Patient',
        geographicArea: {
          '@type': 'Country',
          name: 'Argentina',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.autamedica.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Certificados Médicos',
          item: 'https://www.autamedica.com/certificados-medicos',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Certificado Médico de Reposo',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title="Certificado Médico de Reposo Ambulatorio en Argentina | AutaMedica"
  description="Certificado médico digital de reposo ambulatorio para cuidados en el hogar y convalecencia. Criterios clínicos de graduación (24hs, 48hs, 72hs). Validación CUIR y QR."
  canonical={canonicalUrl}
  ogImage="/images/seo/og-main.webp"
  ogType="website"
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <Navbar />

  <main class="bg-white text-slate-900 pt-20">
    <!-- Migas de pan -->
    <nav class="border-b border-slate-100 bg-slate-50/70 py-3 text-xs text-slate-500" aria-label="Migas de pan">
      <div class="container mx-auto px-6 flex items-center gap-2">
        <a href="/" class="hover:text-sky-600 transition-colors">Inicio</a>
        <span class="text-slate-300">/</span>
        <a href="/certificados-medicos" class="hover:text-sky-600 transition-colors">Certificados Médicos</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-800 font-medium">Certificado Médico de Reposo</span>
      </div>
    </nav>

    <!-- HERO SECTION -->
    <header class="relative bg-gradient-to-b from-slate-50 via-white to-sky-50/30 border-b border-slate-200/80 pt-16 pb-20 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-200 text-sky-800 text-xs font-semibold uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Criterio Clínico Basado en Evidencia · Ley 27.553</span>
          </div>

          <h1 class="text-4xl md:text-6xl font-serif font-bold text-slate-950 tracking-tight leading-[1.12] mb-6">
            Certificado médico de reposo con <span class="text-sky-700 italic">criterio de graduación clínica.</span>
          </h1>

          <p class="text-lg md:text-xl text-slate-600 font-normal leading-relaxed mb-8">
            Indicación médica oficial de convalecencia ambulatoria y cuidados en el hogar para cuadros agudos infecciosos, digestivos o traumatológicos leves. Certificación fehaciente por médicos matriculados, código CUIR y firma digital.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a
              href="/auth/register"
              class="inline-flex items-center justify-center px-8 py-4 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl shadow-lg shadow-sky-600/20 transition-all transform hover:-translate-y-0.5 text-base"
            >
              Solicitar Evaluación para Reposo
            </a>
            <a
              href="#graduacion-clinica"
              class="inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-slate-50 text-slate-800 font-semibold rounded-xl border border-slate-200 transition-colors text-base"
            >
              Ver Criterios de Graduación
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-slate-200/70 text-xs text-slate-600">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-600"></span>
              <span>Graduación médica individualizada</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Opción de diagnóstico reservado (Ley 25.326)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-600"></span>
              <span>Auditoría instantánea por QR en /verify</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- CRITERIOS DE GRADUACIÓN CLÍNICA (TABLA DE HORAS) -->
    <section id="graduacion-clinica" class="py-20 md:py-28 bg-white border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-3xl mb-16">
          <span class="text-sky-700 font-bold text-xs uppercase tracking-widest block mb-3">Rigor Clínico Individualizado</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-950 mb-4">
            Graduación temporal del reposo médico ambulatorio
          </h2>
          <p class="text-slate-600 text-base md:text-lg">
            La duración del reposo no es arbitraria: responde al tiempo biológico requerido para el restablecimiento de las funciones orgánicas y la prevención del contagio epidemiológico.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {restTiers.map((tier) => (
            <div class="bg-slate-50/70 rounded-3xl border border-slate-200 p-8 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-4 mb-4">
                  <span class="px-4 py-1.5 rounded-full bg-sky-100 border border-sky-200 text-sky-800 text-sm font-bold">
                    {tier.hours}
                  </span>
                  <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                    {tier.indication}
                  </span>
                </div>
                <h3 class="text-xl font-serif font-bold text-slate-950 mb-3">Cuadros Frecuentes</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">{tier.cases}</p>
              </div>

              <div class="pt-5 border-t border-slate-200/80">
                <span class="text-xs font-bold text-slate-900 uppercase tracking-wider block mb-1">Conducta Médica:</span>
                <p class="text-xs text-slate-600 leading-relaxed">{tier.action}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- DIFERENCIACIÓN: REPOSO AMBULATORIO VS LICENCIAS COMPLEJAS / ART -->
    <section class="py-20 md:py-28 bg-slate-900 text-white">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-3xl mb-16">
          <span class="text-sky-400 font-bold text-xs uppercase tracking-widest block mb-3">Alcance y Delimitación Sanitaria</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-white mb-4">
            ¿En qué se diferencia el reposo ambulatorio de otras licencias?
          </h2>
          <p class="text-slate-300 text-base md:text-lg">
            Para garantizar una práctica médica transparente y ética, definimos con precisión qué situaciones resuelve el reposo ambulatorio de AutaMedica y cuáles requieren otros circuitos sanitarios.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {clinicalDifferentiators.map((diff) => (
            <div class="bg-slate-800/90 rounded-3xl border border-slate-700 p-8 shadow-xl flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-serif font-bold text-white mb-4">{diff.title}</h3>
                <div class="space-y-4 text-xs md:text-sm text-slate-300 mb-6">
                  <div>
                    <strong class="text-sky-300 block mb-1">Alcance Clínico:</strong>
                    <p class="leading-relaxed">{diff.scope}</p>
                  </div>
                  <div>
                    <strong class="text-sky-300 block mb-1">Marco Jurídico:</strong>
                    <p class="leading-relaxed">{diff.legal}</p>
                  </div>
                </div>
              </div>
              <div class="pt-4 border-t border-slate-700 text-xs text-slate-400">
                <strong class="text-white block mb-1">Procedimiento:</strong>
                {diff.channel}
              </div>
            </div>
          ))}
        </div>

        <!-- PROTOCOLO DE SEGURIDAD (RED FLAGS) -->
        <div class="mt-12 p-6 rounded-2xl bg-red-950/40 border border-red-800/60 flex flex-col md:flex-row items-start md:items-center gap-6">
          <div class="w-12 h-12 rounded-xl bg-red-900/60 border border-red-700 flex items-center justify-center text-red-300 font-bold text-xl flex-shrink-0">
            !
          </div>
          <div class="space-y-1">
            <h4 class="text-base font-serif font-bold text-red-200">Protocolo de Banderas Rojas y Derivación Inmediata</h4>
            <p class="text-xs text-red-300/90 leading-relaxed">
              El reposo médico ambulatorio nunca debe encubrir emergencias de riesgo biológico. Si presentás dolor en el pecho opresivo, disnea o dificultad severa para respirar, cefalea en estallido súbita, pérdida súbita de fuerza en un brazo o pierna, o hemorragias profusas, <strong class="text-white">llamá inmediatamente al 107 (SAME) o acudí a la guardia presencial más próxima.</strong>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- GUÍA DE PASOS PARA EL PACIENTE -->
    <section class="py-20 md:py-24 bg-white border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-sky-700 font-bold text-xs uppercase tracking-widest block mb-3">Flujo Operativo Simple</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-950">
            Cómo gestionar tu certificado de reposo médico
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <span class="text-2xl font-serif font-bold text-sky-700 block mb-3">01</span>
            <h3 class="text-base font-serif font-bold text-slate-950 mb-2">Ingreso y Triaje</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Completás tus datos filiatorios y detallás tus síntomas actuales en un formulario guiado de 90 segundos.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <span class="text-2xl font-serif font-bold text-sky-700 block mb-3">02</span>
            <h3 class="text-base font-serif font-bold text-slate-950 mb-2">Videoconsulta Médica</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Un médico clínico matriculado evalúa tu estado, revisa signos clínicos y constata el requerimiento de reposo.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <span class="text-2xl font-serif font-bold text-sky-700 block mb-3">03</span>
            <h3 class="text-base font-serif font-bold text-slate-950 mb-2">Emisión con Firma y CUIR</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              El profesional firma digitalmente el certificado con la graduación de días pertinentes y código QR inalterable.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <span class="text-2xl font-serif font-bold text-sky-700 block mb-3">04</span>
            <h3 class="text-base font-serif font-bold text-slate-950 mb-2">Descarga y Envío a RRHH</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Descargás el documento oficial en PDF y lo enviás directamente por correo electrónico o WhatsApp a tu empleador.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQS ACCORDION -->
    <section class="py-20 md:py-28 bg-slate-50 border-b border-slate-200">
      <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-sky-700 font-bold text-xs uppercase tracking-widest block mb-3">Preguntas Frecuentes</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-950">
            Dudas sobre el certificado de reposo ambulatorio
          </h2>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-white rounded-2xl border border-slate-200 overflow-hidden transition-colors shadow-sm">
              <summary class="p-6 md:p-8 flex justify-between items-center cursor-pointer list-none select-none">
                <span class="text-base md:text-lg font-serif font-bold text-slate-900 pr-4">{faq.question}</span>
                <span class="w-8 h-8 rounded-full bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-500 font-semibold group-open:rotate-180 group-open:bg-sky-50 group-open:text-sky-700 transition-transform flex-shrink-0">
                  &darr;
                </span>
              </summary>
              <div class="px-6 md:px-8 pb-6 md:pb-8 text-slate-600 text-sm leading-relaxed border-t border-slate-100 pt-4">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CROSS LINKS -->
    <section class="py-14 bg-white border-b border-slate-100">
      <div class="container mx-auto px-6 max-w-5xl">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-6 text-center">Explorar Otros Servicios Clínicos</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <a href="/constancia-atencion-medica" class="p-3 rounded-lg border border-slate-200 bg-slate-50 hover:border-sky-500 hover:text-sky-600 transition-colors text-sm font-medium text-slate-700">
            Constancia de Atención
          </a>
          <a href="/certificado-medico-laboral" class="p-3 rounded-lg border border-slate-200 bg-slate-50 hover:border-sky-500 hover:text-sky-600 transition-colors text-sm font-medium text-slate-700">
            Certificado Laboral LCT
          </a>
          <a href="/receta-medica-online" class="p-3 rounded-lg border border-slate-200 bg-slate-50 hover:border-sky-500 hover:text-sky-600 transition-colors text-sm font-medium text-slate-700">
            Receta Médica Oficial
          </a>
          <a href="/guardia-medica-online" class="p-3 rounded-lg border border-slate-200 bg-slate-50 hover:border-sky-500 hover:text-sky-600 transition-colors text-sm font-medium text-slate-700">
            Guardia Médica 24hs
          </a>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <CTAFinal
      title="Priorizá tu recuperación con respaldo médico oficial."
      subtitle="Conectate a una videoconsulta inmediata con médicos matriculados y obtené tu indicación de reposo con código CUIR y QR."
      buttonLabel="Solicitar Reposo Médico"
      buttonHref="/auth/register"
    />
  </main>

  <Footer />
</Layout>
