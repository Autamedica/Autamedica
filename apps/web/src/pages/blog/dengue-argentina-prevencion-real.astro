  title: 'Dengue en Argentina: Prevención Real, No Pánico',
  author: 'Equipo AutaMedica',
  role: 'Infectología',
  date: '6 de abril, 2026',
  readTime: '7 min',
  image: '/images/article_telemed.webp',
