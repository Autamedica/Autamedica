---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';

const article = {
  title: 'Por qué nunca debés dosificar paracetamol o ibuprofeno infantil por la edad: el cálculo exacto por peso',
  description: 'Dosificar antitérmicos por la edad o por cucharadas es una de las principales causas de toxicidad hepática y falla renal en pediatría. Conocé la fórmula médica exacta en mg/kg/dosis y las señales de alarma.',
  author: 'Equipo de Pediatría y Farmacología Clínica AutaMedica',
  role: 'Dirección Médica Pediátrica',
  date: '24 de septiembre, 2026',
  readTime: '11 min',
  image: '/images/hero_doctor.webp',
  category: 'Pediatría & Farmacología',
  slug: 'calculadora-dosis-pediatrica-paracetamol-ibuprofeno-peso',
};

const canonicalUrl = `https://www.autamedica.com/blog/${article.slug}`;
const publishedTime = '2026-09-24T00:00:00Z';

const faqItems = [
  {
    question: '¿Por qué no se debe dosificar paracetamol o ibuprofeno según la edad del prospecto?',
    answer: 'Porque el crecimiento infantil es biológicamente heterogéneo. Dos niños de 3 años pueden pesar 11 kg o 17 kg. Administrarles la misma dosis basada en la edad cronológica provoca que uno quede subdosificado (manteniendo la fiebre alta sin control) y el otro quede en sobredosis con riesgo de acumulación tóxica. La farmacocinética pediátrica se calcula estrictamente por kilogramo de peso corporal real.',
  },
  {
    question: '¿Cuál es la dosis médica exacta de paracetamol en pediatría?',
    answer: 'La dosis terapéutica pediátrica de paracetamol es de 10 a 15 mg por cada kilogramo de peso por toma, pudiendo repetirse cada 6 u 8 horas según indicación médica, sin exceder los 60 mg/kg/día. En gotas pediátricas de solución al 10% (100 mg/ml), la regla clínica estandarizada equivale aproximadamente a 2 gotas por cada kilogramo de peso real por toma.',
  },
  {
    question: '¿Cuál es la dosis médica exacta de ibuprofeno en pediatría y cuál es el mayor peligro?',
    answer: 'La dosis de ibuprofeno es de 5 a 10 mg por cada kilogramo de peso por toma, cada 8 horas (dosis máxima: 30 a 40 mg/kg/día). El mayor peligro radica en confundir la concentración del jarabe: existen presentaciones al 2% (20 mg/ml) y presentaciones al 4% o forte (40 mg/ml). Si se administra el volumen del jarabe al 2% utilizando el frasco al 4%, se duplica la dosis real, provocando toxicidad gástrica o renal.',
  },
  {
    question: '¿Es recomendable alternar paracetamol e ibuprofeno cada 4 horas?',
    answer: 'No. Tanto la Sociedad Argentina de Pediatría (SAP) como las guías internacionales desaconsejan la alternancia sistemática de antitérmicos en el hogar. Dicha práctica multiplica el riesgo de errores de cálculo, confusión de horarios e intoxicaciones combinadas, sin demostrar beneficios clínicos significativos en la evolución de la enfermedad.',
  },
  {
    question: '¿Cuándo la fiebre en un niño es una emergencia médica impostergable?',
    answer: 'En cualquier bebé menor de 3 meses con 38°C o más (debe ser evaluado de urgencia presencial para descartar infección bacteriana grave), o a cualquier edad si la fiebre se acompaña de manchas violáceas en la piel (petequias), rigidez de cuello, dificultad para respirar con hundimiento de costillas o somnolencia extrema donde el niño no reacciona al estímulo.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['BlogPosting', 'MedicalWebPage'],
      '@id': `${canonicalUrl}#article`,
      isPartOf: {
        '@type': 'Blog',
        name: 'Blog de Salud de AutaMedica',
        url: 'https://www.autamedica.com/blog',
      },
      headline: article.title,
      description: article.description,
      url: canonicalUrl,
      datePublished: publishedTime,
      dateModified: publishedTime,
      inLanguage: 'es-AR',
      mainEntityOfPage: canonicalUrl,
      image: {
        '@type': 'ImageObject',
        url: `https://www.autamedica.com${article.image}`,
      },
      author: {
        '@type': 'Organization',
        name: article.author,
        url: 'https://www.autamedica.com',
      },
      publisher: {
        '@type': 'Organization',
        name: 'AutaMedica',
        url: 'https://www.autamedica.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://www.autamedica.com/images/brand/logo_bioceramic.png',
        },
      },
      about: [
        { '@type': 'MedicalSpecialty', name: 'Pediatrics' },
        { '@type': 'MedicalSpecialty', name: 'Clinical Pharmacology' },
        { '@type': 'Drug', name: 'Paracetamol' },
        { '@type': 'Drug', name: 'Ibuprofen' },
      ],
      mentions: [
        {
          '@type': 'Legislation',
          name: 'Ley 26061',
          description: 'Ley de Protección Integral de los Derechos de las Niñas, Niños y Adolescentes',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.autamedica.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: 'https://www.autamedica.com/blog',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: article.title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
