---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const articles = [
  {
    slug: 'vacuna-antigripal-h3n2-2026',
    title: 'Vacunarse Contra la Gripe en 2026 No Puede Esperar a Junio',
    excerpt: 'La campaña antigripal arrancó tres semanas antes por la nueva variante H3N2. Quiénes tienen vacuna gratuita, cuándo aplicarla y por qué la cobertura importa más que nunca.',
    author: 'Equipo AutaMedica',
    date: '23 de marzo, 2026',
    readTime: '9 min',
    category: 'Infectología',
    image: '/images/article_telemed.webp',
  },
  {
    slug: 'telemedicina-cardiologia',
    title: 'Telemedicina en Cardiología: Consultas Online Seguras y Eficaces',
    excerpt: 'Cómo funciona la telemedicina cardíaca, qué se puede evaluar virtualmente, limitaciones, y seguridad de las consultas cardíacas online.',
    author: 'Equipo AutaMedica',
    date: '25 de marzo, 2026',
    readTime: '11 min',
    category: 'Cardiología',
    image: '/images/article_cardio.webp',
  },
  {
    slug: 'guia-consulta-medica-online',
    title: 'Guía Completa: Cómo Hacer una Consulta Médica Online Sin Complicaciones',
    excerpt: 'Paso a paso: cómo prepararse, qué necesitás, cómo funciona una consulta telemédica, y qué esperar. Guía práctica para tu primer consulta.',
    author: 'Equipo AutaMedica',
    date: '24 de marzo, 2026',
    readTime: '8 min',
    category: 'Guía Práctica',
    image: '/images/hero_doctor.webp',
  },
  {
    slug: 'acceso-especialistas-provincias',
    title: 'Acceso a Especialistas en Provincias: La Brecha Que la Telemedicina Cierra',
    excerpt: 'Datos sobre la brecha de especialistas en Argentina. En provincias, esperar un cardiólogo puede tomar meses. Cómo la telemedicina lo resuelve.',
    author: 'Equipo AutaMedica',
    date: '23 de marzo, 2026',
    readTime: '9 min',
    category: 'Telemedicina',
    image: '/images/article_telemed.webp',
  },
  {
    slug: 'telemedicina-revolucion-salud',
    title: '¿Por Qué la Telemedicina es la Revolución de la Salud en Argentina?',
    excerpt: 'Desde reducir esperas hasta acceso a especialistas de todo el país. Descubrí cómo la telemedicina está transformando la atención médica.',
    author: 'Equipo AutaMedica',
    date: '22 de marzo, 2026',
    readTime: '7 min',
    category: 'Telemedicina',
    image: '/images/article_telemed.webp',
  },
  {
    slug: '5-senales-alerta-cardiaca',
    title: '5 Señales de Alerta Cardíaca que No Hay que Ignorar',
    excerpt: 'El dolor de pecho no es la única señal. Hay síntomas sutiles que pueden indicar un problema cardiovascular.',
    author: 'Equipo AutaMedica',
    date: '20 de marzo, 2026',
    readTime: '8 min',
    category: 'Cardiología',
    image: '/images/article_cardio.webp',
  },
  {
    slug: 'ansiedad-cronica-herramientas',
    title: 'Ansiedad Crónica: Herramientas que Funcionan Sin Medicación',
    excerpt: 'Estrategias basadas en evidencia para gestionar la ansiedad del día a día. Técnicas que podés aplicar ahora mismo.',
    author: 'Equipo AutaMedica',
    date: '18 de marzo, 2026',
    readTime: '10 min',
    category: 'Salud Mental',
    image: '/images/article_mental.webp',
  },
  {
    slug: 'dermatologia-acne-adulto',
    title: 'Acné en Adultos: Causas, Tratamientos y Cuándo Consultar',
    excerpt: 'No es solo cosa de adolescentes. El acné adulto tiene causas diferentes y requiere abordaje especial.',
    author: 'Equipo AutaMedica',
    date: '16 de marzo, 2026',
    readTime: '6 min',
    category: 'Dermatología',
    image: '/images/testi_maria.webp',
  },
  {
    slug: 'historia-clinica-digital',
    title: 'Historia Clínica Digital: Por Qué es Crucial para tu Salud',
    excerpt: 'Acceso inmediato a tu historial médico, medicamentos previos y resultados de estudios. Sin papeles, sin pérdidas.',
    author: 'Equipo AutaMedica',
    date: '14 de marzo, 2026',
    readTime: '5 min',
    category: 'Tecnología Médica',
    image: '/images/hero_doctor.webp',
  },
];

const categoryColors = {
  'Infectología': '#f59e0b',
  'Telemedicina': '#3b82f6',
  'Cardiología': '#ef4444',
  'Salud Mental': '#8b5cf6',
  'Dermatología': '#ec4899',
  'Tecnología Médica': '#06b6d4',
  'Guía Práctica': '#10b981',
};
---

<Layout
  title="Blog de Salud - Artículos Médicos y Bienestar | AutaMedica"
  description="Artículos de salud escritos por médicos. Telemedicina, cardiología, salud mental, dermatología y más. Contenido confiable basado en evidencia científica."
  canonical="https://www.autamedica.com/blog"
  ogImage="/images/seo/og-main.webp"
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <Navbar />
  <main class="min-h-screen">
    <!-- Hero -->
    <section class="hero-section">
      <div class="container">
        <h1>Blog de Salud</h1>
        <p class="subtitle">
          Artículos confiables sobre telemedicina, bienestar y salud, escritos por profesionales médicos certificados.
        </p>
      </div>
    </section>

    <!-- Articles Grid -->
    <section class="blog-section">
      <div class="container">
        <div class="blog-grid">
          {articles.map((article) => (
            <article class="blog-card">
              <div class="blog-image">
                <img src={article.image} alt={article.title} loading="lazy" decoding="async" />
              </div>
              <div class="blog-content">
                <div class="blog-header">
                  <span
                    class="category"
                    style={`background-color: ${categoryColors[article.category] || '#3b82f6'}33; color: ${categoryColors[article.category] || '#3b82f6'};`}
                  >
                    {article.category}
                  </span>
                  <span class="read-time">{article.readTime}</span>
                </div>
                <h2 class="blog-title">{article.title}</h2>
                <p class="blog-excerpt">{article.excerpt}</p>
                <div class="blog-footer">
                  <div class="blog-meta">
                    <span class="author">{article.author}</span>
                    <span class="date">{article.date}</span>
                  </div>
                  <a href={`/blog/${article.slug}`} class="read-more">Leer artículo →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="newsletter-section">
      <div class="container">
        <div class="newsletter-content">
          <h2>Recibe Artículos de Salud Cada Semana</h2>
          <p>Suscríbete a nuestro newsletter para recibir contenido médico confiable, directamente en tu email.</p>
          <form class="newsletter-form">
            <input
              type="email"
              placeholder="Tu email"
              required
              aria-label="Email para suscripción"
            />
            <button type="submit">Suscribirse</button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero-section {
    padding: 6rem var(--section-px) 4rem;
    background: linear-gradient(135deg, rgba(0,0,0,0.8), rgba(6,78,140,0.3));
    border-bottom: 1px solid var(--au-border);
    text-align: center;
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: white;
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.125rem;
    color: #a1a1a1;
    max-width: 700px;
    margin: 0 auto;
  }

  .blog-section {
    padding: 4rem var(--section-px);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .blog-card {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.05), rgba(255,255,255,0.02));
    border: 1px solid var(--au-border);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .blog-card:hover {
    border-color: #3b82f6;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.1);
    transform: translateY(-4px);
  }

  .blog-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: rgba(255,255,255,0.05);
  }

  .blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-card:hover .blog-image img {
    transform: scale(1.05);
  }

  .blog-content {
    padding: 2rem;
  }

  .blog-header {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .category {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .read-time {
    font-size: 0.85rem;
    color: #888;
    margin-left: auto;
  }

  .blog-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: white;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .blog-excerpt {
    color: #a1a1a1;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .blog-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 1.5rem;
  }

  .blog-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author {
    font-size: 0.9rem;
    font-weight: 500;
    color: white;
  }

  .date {
    font-size: 0.8rem;
    color: #888;
  }

  .read-more {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .read-more:hover {
    color: #1f2937;
    gap: 0.5rem;
  }

  .newsletter-section {
    padding: 4rem var(--section-px);
    background: rgba(59, 130, 246, 0.05);
    border-top: 1px solid var(--au-border);
  }

  .newsletter-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .newsletter-content h2 {
    font-size: 2rem;
    font-weight: 300;
    color: white;
    margin-bottom: 1rem;
  }

  .newsletter-content p {
    color: #a1a1a1;
    margin-bottom: 2rem;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }

  .newsletter-form input {
    flex: 1;
    padding: 0.875rem 1.25rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 0.5rem;
    color: white;
    font-size: 1rem;
  }

  .newsletter-form input::placeholder {
    color: #888;
  }

  .newsletter-form input:focus {
    outline: none;
    border-color: #3b82f6;
    background: rgba(255,255,255,0.12);
  }

  .newsletter-form button {
    padding: 0.875rem 2rem;
    background: white;
    color: black;
    border: none;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .newsletter-form button:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
  }
</style>
