---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const articles = [
  {
    slug: 'cuando-ir-guardia-cuando-esperar',
    title: 'Cuándo Ir a la Guardia y Cuándo Puede Esperar: Guía de Triage Domiciliario',
    excerpt: 'Guía práctica para decidir si un síntoma requiere guardia inmediata o puede esperar a un turno programado. Señales de alarma, criterios de urgencia y qué hacer mientras esperás.',
    author: 'Dr. Andrés Portnoy',
    date: '6 de abril, 2026',
    readTime: '7 min',
    category: 'Guía Práctica',
    image: '/images/blog/triage-domiciliario.png',
  },
  {
    slug: 'como-leer-analisis-sangre',
    title: 'Cómo Leer Tus Análisis de Sangre Sin Entrar en Pánico',
    excerpt: 'Guía para entender los valores más comunes de un análisis de sangre: hemograma, glucemia, colesterol, función renal y hepática. Qué significan los asteriscos y cuándo preocuparse de verdad.',
    author: 'Staff Médico AutaMedica',
    date: '6 de abril, 2026',
    readTime: '8 min',
    category: 'Educación Médica',
    image: '/images/blog/analisis-sangre.png',
  },
  {
    slug: 'medicamentos-genericos-originales-argentina',
    title: 'Genéricos vs Originales: ¿Son Realmente Iguales?',
    excerpt: 'Qué son los medicamentos genéricos, cómo se regulan en Argentina, qué significa bioequivalencia y en qué casos importa la marca. Información basada en evidencia para decidir con tu médico.',
    author: 'Staff Médico AutaMedica',
    date: '6 de abril, 2026',
    readTime: '7 min',
    category: 'Farmacología',
    image: '/images/blog/medicamentos-genericos.png',
  },
  {
    slug: 'presion-arterial-normal-cuando-preocuparse',
    title: 'Presión Arterial: Qué Es Normal y Cuándo Preocuparse',
    excerpt: 'Qué significan los números de la presión arterial, cuáles son los rangos normales, cómo medirla correctamente en casa y cuándo consultar al médico.',
    author: 'Staff Médico AutaMedica',
    date: '6 de abril, 2026',
    readTime: '6 min',
    category: 'Cardiología',
    image: '/images/blog/presion-arterial.png',
  },
  {
    slug: 'ia-clinica-que-puede-hacer-hoy',
    title: 'IA Clínica: Qué Puede Hacer Hoy un Modelo de Lenguaje en Medicina',
    excerpt: 'Qué pueden y qué no pueden hacer los modelos de lenguaje (LLM) en la práctica clínica real: evidencia, limitaciones y el rol del médico.',
    author: 'Staff Médico AutaMedica',
    date: '6 de abril, 2026',
    readTime: '8 min',
    category: 'Innovación en Salud',
    image: '/images/blog/ia-clinica.png',
  },
];
---

<Layout
  title="Blog de Salud - Artículos Médicos y Bienestar | AutaMedica"
  description="Artículos de salud escritos por médicos. Telemedicina, cardiología, salud mental, dermatología y más."
  canonical="https://www.autamedica.com/blog"
>
  <Navbar />
  <main>
    <section class="seo-hero">
      <h1>Blog de Salud</h1>
      <p class="seo-subtitle">Contenido médico confiable basado en evidencia.</p>
    </section>

    <section class="seo-section">
      <div class="seo-container">
        <div class="seo-grid-3">
          {articles.map((article) => (
            <article class="seo-card blog-card">
              <div class="blog-card-image">
                <img src={article.image} alt={article.title} loading="lazy" />
              </div>
              <div class="blog-card-content">
                <span class="seo-badge">{article.category}</span>
                <h2 class="blog-card-title">{article.title}</h2>
                <p class="blog-card-excerpt">{article.excerpt}</p>
                <div class="blog-card-footer">
                  <span class="blog-card-author">{article.author}</span>
                  <a href={`/blog/${article.slug}`} class="blog-read-more">Leer artículo →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  @import '../../styles/seo-landing.css';
  .blog-card-image { height: 200px; overflow: hidden; background: #eee; }
  .blog-card-image img { width: 100%; height: 100%; object-fit: cover; }
  .blog-card-content { padding: 20px; }
  .blog-card-title { font-size: 1.25rem; margin: 10px 0; font-weight: bold; }
  .blog-card-excerpt { font-size: 0.9rem; color: #666; }
</style>
