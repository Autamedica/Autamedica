import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';

const article = {
  title: '¿Tu empleador te rechazó el certificado médico de telemedicina? Qué dice la Ley (Art. 210 LCT)',
  author: 'Equipo AutaMedica',
  role: 'Derecho Sanitario y Medicina Laboral',
  date: '24 de septiembre, 2026',
  readTime: '9 min',
  image: '/images/article_telemed.webp',
  category: 'Legislación Laboral',
};

const canonicalUrl = 'https://www.autamedica.com/blog/empleador-rechaza-certificado-medico-telemedicina-validez';
const publishedTime = '2026-09-24T00:00:00Z';

const faqItems = [
  {
    question: '¿La empresa puede rechazar mi certificado médico solo porque fue emitido por telemedicina?',
    answer:
      'No. En la República Argentina, la Ley 27.553 de Teleasistencia en Salud y Recetas Electrónicas y su Decreto Reglamentario 98/2023 otorgan plena validez legal a las consultas médicas y certificados emitidos a través de plataformas habilitadas por profesionales matriculados en REFEPS/SISA. El empleador no tiene potestad legal para desestimar de plano un certificado emitido por un facultativo.',
  },
  {
    question: '¿Qué debe hacer el empleador si duda del diagnóstico o de los días de reposo?',
    answer:
      'Conforme al Artículo 210 de la Ley de Contrato de Trabajo N° 20.744, el empleador tiene la facultad de ejercer el control médico domiciliario o laboral. Es decir, enviar un médico de control al domicilio del trabajador. Si el empleador no ejerce este control facultativo, el certificado del médico tratante conserva plena validez y la empresa debe abonar la jornada de conformidad con el Art. 208 de la LCT.',
  },
  {
    question: '¿Pueden descontarme el presentismo o el sueldo del día si la empresa rechazó el justificativo digital?',
    answer:
      'El descuento automático es improcedente y constituye una retención indebida de haberes si el trabajador cumplió con el deber de avisar (Art. 209 LCT) y aportó el certificado con firma y matrícula verificable. Si la empresa no envió médico de control, no existe controversia médica válida que habilite la sanción.',
  },
  {
    question: '¿Tengo obligación de revelar mi diagnóstico clínico exacto a Recursos Humanos?',
    answer:
      'No. La Ley 26.529 de Derechos del Paciente y la Ley 25.326 de Protección de Datos Personales protegen el secreto médico y califican a la patología como dato sensible. El certificado laboral debe acreditar la inaptitud laboral temporal y el plazo de reposo requerido, sin que sea exigible violar la confidencialidad clínica del paciente.',
  },
];

