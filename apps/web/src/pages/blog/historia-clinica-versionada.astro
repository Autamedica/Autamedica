              <h4>5 Señales que Tu Cuerpo Te Da</h4>
            </a>
          </div>
        </div>
      </div>
    <ShareButtons title={article.title} url={`https://www.autamedica.com/blog/historia-clinica-versionada`} description="Las enfermedades crónicas necesitan contexto temporal. Cómo las historias clínicas versionadas permiten ver tu evolución de salud y mejorar las decisiones médicas." author={article.author} category={article.category} />
    </article>
  </main>
  <Footer />
</Layout>

