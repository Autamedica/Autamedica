const article = {
  title: 'Te Avisamos Si Se Libera un Turno: Cómo Funciona la Lista de Espera Inteligente',
  author: 'Equipo AutaMedica',
  role: 'Gestión de Turnos',
  date: '6 de abril, 2026',
  readTime: '5 min',
  image: '/images/article_telemed.webp',
  category: 'Guía Práctica',
};
---

<Layout
  title="Lista de Espera Inteligente: Cómo Funciona | AutaMedica"
  description="¿No hay turnos disponibles? La lista de espera inteligente te avisa automáticamente cuando se libera un lugar. Entendé cómo funciona el modelo de oferta y expiración."
  canonical="https://www.autamedica.com/blog/lista-espera-inteligente"
  ogImage="/images/seo/og-main.webp"
  ogType="article"
  publishedTime="2026-04-06T00:00:00Z"
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <Navbar />
  <main>
    <!-- Article Header -->
    <div class="seo-hero" style="text-align:left">
      <div class="seo-container">
        <a href="/blog" class="blog-back">&larr; Volver al blog</a>
        <h1>{article.title}</h1>
        <div class="blog-meta">
          <span class="seo-badge">{article.category}</span>
          <span>{article.readTime} de lectura</span>
        </div>
      </div>
    </div>

