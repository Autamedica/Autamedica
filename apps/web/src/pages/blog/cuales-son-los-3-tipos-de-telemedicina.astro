---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const canonicalUrl = 'https://www.autamedica.com/blog/cuales-son-los-3-tipos-de-telemedicina';
const publishedTime = '2026-03-26T00:00:00Z';

const article = {
  title: '¿Cuáles son los 3 tipos de telemedicina?',
  author: 'Equipo AutaMedica',
  role: 'Telemedicina',
  date: '26 de marzo, 2026',
  readTime: '6 min',
  image: '/images/article_telemed.webp',
  category: 'Telemedicina',
};

const faqItems = [
  {
    question: '¿Cuáles son los 3 tipos de telemedicina?',
    answer:
      'Los 3 tipos principales son la teleconsulta en tiempo real, la modalidad asincrónica o store-and-forward, y el telemonitoreo remoto de signos vitales.',
  },
  {
    question: '¿Qué tipo de telemedicina se usa para seguimiento de enfermedades crónicas?',
    answer:
      'El telemonitoreo suele ser la modalidad más útil para el seguimiento crónico porque permite registrar parámetros como presión arterial, glucemia o frecuencia cardíaca a distancia.',
  },
  {
    question: '¿La telemedicina está regulada en Argentina?',
    answer:
      'Sí. La Ley 27553 habilita la teleasistencia en salud y exige que se respeten los derechos del paciente previstos por la Ley 26529.',
  },
];

const relatedArticles = [
  {
    href: '/blog/telemedicina-revolucion-salud',
    category: 'Telemedicina',
    title: '¿Por Qué la Telemedicina es la Revolución de la Salud en Argentina?',
  },
  {
    href: '/blog/acceso-especialistas-provincias',
    category: 'Acceso',
    title: 'Acceso a Especialistas en Provincias: La Brecha Que la Telemedicina Cierra',
  },
  {
    href: '/blog/que-dice-la-ley-26529',
    category: 'Marco legal',
    title: '¿Qué dice la ley 26529? Derechos del Paciente en Argentina',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: article.title,
      description:
        'Los 3 tipos de telemedicina son la teleconsulta en tiempo real, la modalidad asincrónica y el telemonitoreo remoto. Esta guía explica cuándo conviene cada una.',
      image: [`https://www.autamedica.com${article.image}`],
      datePublished: publishedTime,
      dateModified: publishedTime,
      inLanguage: 'es-AR',
      mainEntityOfPage: canonicalUrl,
      author: {
        '@type': 'Organization',
        name: article.author,
      },
      publisher: {
        '@type': 'Organization',
        name: 'AutaMedica',
        logo: {
          '@type': 'ImageObject',
          url: 'https://www.autamedica.com/images/brand/app_icon_glass.png',
        },
      },
      isPartOf: {
        '@type': 'Blog',
        name: 'Blog de Salud de AutaMedica',
        url: 'https://www.autamedica.com/blog',
      },
      about: [
        { '@type': 'MedicalSpecialty', name: 'Telemedicine' },
        { '@type': 'Thing', name: 'Teleconsulta' },
        { '@type': 'Thing', name: 'Store-and-forward' },
        { '@type': 'Thing', name: 'Telemonitoreo' },
      ],
      mentions: [
        {
          '@type': 'Legislation',
          name: 'Ley 27553',
          url: 'https://www.boletinoficial.gob.ar/detalleAviso/primera/233439/20200811.',
        },
        {
          '@type': 'Legislation',
          name: 'Ley 26529',
          url: 'https://servicios.infoleg.gob.ar/infolegInternet/anexos/160000-164999/160432/norma.htm',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.autamedica.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: 'https://www.autamedica.com/blog',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: article.title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title="¿Cuáles son los 3 tipos de telemedicina? Guía completa | AutaMedica"
  description="Los 3 tipos de telemedicina son: teleconsulta en tiempo real, store-and-forward (asincrónica) y telemonitoreo. Conocé cómo funciona cada una y para qué situaciones se usa."
  canonical={canonicalUrl}
  ogImage="/images/seo/og-main.webp"
  ogType="article"
  publishedTime={publishedTime}
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <Navbar />
  <main>

    <div class="seo-hero" style="text-align:left">
      <div class="seo-container">
        <a href="/blog" class="blog-back">&larr; Volver al blog</a>
        <h1>{article.title}</h1>
        <div class="blog-meta">
          <span class="seo-badge">{article.category}</span>
          <span>{article.readTime} de lectura</span>
        </div>
      </div>
    </div>

    <div class="blog-image">
      <img src={article.image} alt={article.title} loading="eager" />
    </div>

    <article class="seo-section">
      <div class="seo-container">
        <div class="blog-prose">

          <section>
            <h2>La respuesta directa</h2>
            <p>
              Los <strong>3 tipos principales de telemedicina</strong> son la teleconsulta sincrónica (en
              tiempo real), la telemedicina asincrónica o store-and-forward (en diferido), y el telemonitoreo
              (seguimiento remoto de signos vitales). Cada modalidad resuelve necesidades clínicas distintas.
            </p>
            <blockquote>
              Esta clasificación es adoptada por la OMS, la OPS y el Ministerio de Salud de Argentina en el
              marco regulatorio de la Ley 27553 de Telemedicina (2020).
            </blockquote>
          </section>

          <section>
            <h2>Los 3 tipos en detalle</h2>

            <div class="tipo-card tipo-1">
              <div class="tipo-numero">Tipo 1 -- Sincrónica -- En tiempo real</div>
              <h3>Teleconsulta</h3>
              <p>
                El médico y el paciente se comunican en tiempo real a través de videollamada, llamada de audio
                o chat en vivo. Es el equivalente digital de la consulta presencial.
              </p>
              <ul>
                <li>Consultas de baja y mediana complejidad</li>
                <li>Seguimiento de enfermedades crónicas</li>
                <li>Renovación de recetas digitales</li>
                <li>Consultas de salud mental</li>
              </ul>
            </div>

            <div class="tipo-card tipo-2">
              <div class="tipo-numero">Tipo 2 -- Asincrónica -- En diferido</div>
              <h3>Store-and-Forward</h3>
              <p>
                El paciente envía datos, imágenes o resultados, y el médico los evalúa y responde en un
                momento posterior. No se requiere coincidencia de horarios.
              </p>
              <ul>
                <li>Derivación de imágenes médicas (teleradiología, teledermatología)</li>
                <li>Interconsultas entre especialistas</li>
                <li>Evaluación de resultados de estudios</li>
                <li>Consultas no urgentes con envío de fotos o documentos</li>
              </ul>
            </div>

            <div class="tipo-card tipo-3">
              <div class="tipo-numero">Tipo 3 -- Continua -- Monitoreo remoto</div>
              <h3>Telemonitoreo</h3>
              <p>
                Dispositivos conectados registran y transmiten parámetros vitales del paciente (presión
                arterial, glucemia, frecuencia cardíaca) de forma continua. El equipo médico monitorea
                los datos de forma remota.
              </p>
              <ul>
                <li>Pacientes con hipertensión, diabetes o insuficiencia cardíaca</li>
                <li>Monitoreo post-quirúrgico domiciliario</li>
                <li>Adultos mayores con enfermedades crónicas</li>
                <li>Alertas automáticas ante valores fuera de rango</li>
              </ul>
            </div>
          </section>

          <section>
            <h2>¿Cuál usar según la situación?</h2>
            <div class="tabla-wrapper">
              <table class="tabla">
                <thead>
                  <tr><th>Situación</th><th>Teleconsulta</th><th>Store-and-Forward</th><th>Telemonitoreo</th></tr>
                </thead>
                <tbody>
                  <tr><td>Urgencia no grave (fiebre, dolor)</td><td class="tabla-si">Ideal</td><td class="tabla-no">--</td><td class="tabla-no">--</td></tr>
                  <tr><td>Diagnóstico por imagen</td><td class="tabla-parcial">Parcial</td><td class="tabla-si">Ideal</td><td class="tabla-no">--</td></tr>
                  <tr><td>Control de hipertensión crónica</td><td class="tabla-parcial">Parcial</td><td class="tabla-parcial">Parcial</td><td class="tabla-si">Ideal</td></tr>
                  <tr><td>Segunda opinión médica</td><td class="tabla-si">Sí</td><td class="tabla-si">Ideal</td><td class="tabla-no">--</td></tr>
                  <tr><td>Salud mental / psicología</td><td class="tabla-si">Ideal</td><td class="tabla-no">--</td><td class="tabla-no">--</td></tr>
                </tbody>
              </table>
            </div>
          </section>

          <section>
            <h2>Marco legal en Argentina</h2>
            <p>
              La <strong>Ley 27553</strong> (2020) reconoce oficialmente las tres modalidades. Establece que
              toda teleconsulta debe garantizar la identidad del profesional, la confidencialidad de los datos
              del paciente y la emisión de receta digital cuando corresponda.
            </p>
            <p>
              Podés revisar el texto oficial en el
              <a href="https://www.boletinoficial.gob.ar/detalleAviso/primera/233439/20200811." rel="noopener noreferrer" target="_blank">
                Boletín Oficial de la Ley 27553
              </a>
              y complementar con los derechos del paciente previstos por la
              <a href="https://servicios.infoleg.gob.ar/infolegInternet/anexos/160000-164999/160432/norma.htm" rel="noopener noreferrer" target="_blank">
                Ley 26529
              </a>.
            </p>
            <p class="italic-note">
              Argentina fue uno de los primeros países de Latinoamérica en regular la telemedicina por ley,
              dando mayor seguridad jurídica tanto al médico como al paciente.
            </p>
          </section>

          <section>
            <h2>El futuro: telemedicina con IA</h2>
            <p>
              Las plataformas de nueva generación como AutaMédica incorporan inteligencia artificial como capa
              transversal: triaje automático que sugiere la modalidad correcta según el motivo de consulta,
              análisis de historial clínico previo y alertas predictivas en el telemonitoreo.
            </p>
          </section>

          <section aria-labelledby="faq-title">
            <h2 id="faq-title">Preguntas frecuentes sobre telemedicina</h2>
            <div class="seo-faq">
              {faqItems.map((item) => (
                <details>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>

          <div class="blog-cta">
            <p class="blog-cta-title">AutaMédica integra los 3 tipos de telemedicina</p>
            <p class="blog-cta-desc">Teleconsulta en tiempo real, seguimiento asincrónico y monitoreo. Todo en una sola plataforma, con médicos verificados.</p>
            <a href="https://www.autamedica.com" class="seo-btn-primary">Consultar ahora</a>
          </div>

          <div class="blog-related">
            <h3>Artículos relacionados</h3>
            <div class="seo-grid-3">
              {relatedArticles.map((relatedArticle) => (
                <a href={relatedArticle.href} class="seo-card">
                  <span class="seo-badge">{relatedArticle.category}</span>
                  <h4>{relatedArticle.title}</h4>
                </a>
              ))}
            </div>
          </div>

        </div>
      </div>
    </article>

  </main>
  <Footer />
</Layout>

<style>
  @import '../../styles/seo-landing.css';
  .blog-prose { max-width: 720px; margin: 0 auto; }
  .blog-prose h2 { font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--au-text-primary); margin: var(--space-12) 0 var(--space-4); text-align: left; }
  .blog-prose h3 { font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--au-text-primary); margin: var(--space-8) 0 var(--space-3); }
  .blog-prose p { color: var(--au-text-secondary); line-height: 1.8; margin-bottom: var(--space-4); }
  .blog-prose ul, .blog-prose ol { padding-left: 1.5rem; margin-bottom: var(--space-4); }
  .blog-prose li { color: var(--au-text-secondary); line-height: 1.7; margin-bottom: var(--space-2); }
  .blog-prose strong { color: var(--au-text-primary); }
  .blog-prose blockquote { border-left: 3px solid var(--au-accent); padding-left: var(--space-4); margin: var(--space-6) 0; color: var(--au-text-tertiary); font-style: italic; }
  .blog-prose a { color: var(--au-accent); }
  .blog-prose a:hover { color: var(--au-text-primary); }
  .blog-back { display: inline-block; color: var(--au-accent); text-decoration: none; font-size: var(--text-sm); font-weight: var(--font-medium); margin-bottom: var(--space-6); }
  .blog-back:hover { text-decoration: underline; }
  .blog-meta { display: flex; gap: var(--space-4); align-items: center; margin-top: var(--space-4); }
  .blog-image { width: 100%; max-width: 720px; margin: 0 auto var(--space-12); border-radius: var(--radius-md); overflow: hidden; }
  .blog-image img { width: 100%; height: auto; display: block; }
  .italic-note { font-style: italic; color: var(--au-accent); font-size: var(--text-sm); }
  .tipo-card { border-radius: var(--radius-md); padding: var(--space-6); margin: var(--space-4) 0; }
  .tipo-1 { background: var(--au-glass-bg); border: 1px solid var(--au-accent); }
  .tipo-2 { background: var(--au-glass-bg); border: 1px solid var(--au-glass-border); }
  .tipo-3 { background: var(--au-accent-soft); border: 1px solid var(--au-border-hover); }
  .tipo-numero { font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--au-accent); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2); }
  .tipo-card h3 { font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--au-text-primary); margin-bottom: var(--space-3); margin-top: 0; }
  .tabla-wrapper { overflow-x: auto; margin: var(--space-6) 0; }
  .tabla { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .tabla th { background: var(--au-surface); color: var(--au-text-primary); padding: var(--space-3); text-align: left; font-size: var(--text-xs); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: 0.04em; }
  .tabla td { padding: var(--space-3); border-bottom: 1px solid var(--au-border); color: var(--au-text-secondary); }
  .tabla-si { color: var(--au-success); font-weight: var(--font-semibold); }
  .tabla-no { color: var(--au-text-tertiary); }
  .tabla-parcial { color: var(--au-warning, #eab308); }
  .blog-cta { background: var(--au-surface); border: 1px solid var(--au-border); border-radius: var(--radius-md); padding: var(--space-8); margin-top: var(--space-12); text-align: center; }
  .blog-cta-title { font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--au-text-primary); margin-bottom: var(--space-2); }
  .blog-cta-desc { color: var(--au-text-secondary); font-size: var(--text-sm); margin-bottom: var(--space-6); }
  .blog-related { max-width: 720px; margin: var(--space-16) auto; }
  .blog-related h3 { font-size: var(--text-xl); color: var(--au-text-primary); margin-bottom: var(--space-6); }
  .blog-related .seo-card { text-decoration: none; display: block; }
  .blog-related .seo-card h4 { color: var(--au-text-primary); font-size: var(--text-base); font-weight: var(--font-medium); line-height: 1.4; margin: var(--space-3) 0 0; }
</style>
