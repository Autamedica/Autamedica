  title: 'Guía Completa: Cómo Hacer una Consulta Médica Online Sin Complicaciones',
  author: 'Equipo AutaMedica',
  role: 'Medicina General',
  date: '24 de marzo, 2026',
  readTime: '8 min',
  image: '/images/hero_doctor.webp',
  category: 'Guía Práctica',
};
---

<Layout
