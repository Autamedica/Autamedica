---
import Layout from '../layouts/Layout.astro';
import { getI18n } from '../i18n/index';
const locale = Astro.locals.locale ?? 'es';
const { t } = getI18n(locale);
---

<Layout
  title="Página no encontrada - AutaMedica"
  description="La página que buscás no existe. Volvé al inicio de AutaMedica para acceder a la plataforma de telemedicina."
  canonical="https://www.autamedica.com/404"
  robots="noindex, follow"
  ogImage="/images/seo/og-main.webp"
>
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="max-w-lg mx-auto text-center">
      <p class="text-8xl font-light text-gray-600 mb-6 tracking-tight">404</p>
      <h1 class="text-3xl font-light text-white mb-4 tracking-wide">
        {t('pages.notFound.title')}
      </h1>
      <p class="text-gray-400 mb-10 leading-relaxed">
        {t('pages.notFound.message')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="px-6 py-3 bg-white text-black font-medium rounded-lg hover:bg-gray-100 transition-colors"
        >
          {t('pages.notFound.backHome')}
        </a>
        <a
          href="/patients"
          class="px-6 py-3 border border-gray-700 text-gray-300 font-medium rounded-lg hover:border-gray-500 hover:text-white transition-colors"
        >
          {t('roles.patient.label')}
        </a>
        <a
          href="/doctors"
          class="px-6 py-3 border border-gray-700 text-gray-300 font-medium rounded-lg hover:border-gray-500 hover:text-white transition-colors"
        >
          {t('roles.doctor.label')}
        </a>
      </div>
    </div>
  </main>
</Layout>
