---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Telemedicina en Argentina - Consultas Médicas Online | AutaMedica"
  description="Telemedicina en Argentina: consultas médicas virtuales seguras, rápidas y certificadas. Habla con doctores online desde tu hogar. ✓ HIPAA y Ley 25.326"
  canonical="https://www.autamedica.com/telemedicina-argentina"
  ogImage="/images/seo/og-main.webp"
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <Navbar />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-content">
          <span class="badge">Telemedicina Moderna</span>
          <h1>Telemedicina en Argentina Sin Fricciones</h1>
          <p class="subtitle">
            Consulta con médicos certificados desde tu hogar. Teleconsultas seguras, recetas digitales
            e historia clínica integral en una sola plataforma.
          </p>
          <div class="cta-buttons">
            <a href="/auth/register" class="btn-primary">Comenzar Consulta Médica</a>
            <a href="/doctors" class="btn-secondary">Ver Médicos Disponibles</a>
          </div>
        </div>
      </div>
    </section>

    <!-- What is Telemedicine -->
    <section class="content-section">
      <div class="container">
        <h2>¿Qué es la Telemedicina?</h2>
        <p>
          La telemedicina es la prestación de servicios médicos a través de tecnología digital.
          En Argentina, la telemedicina es legal, regulada y reconocida por el sistema de salud.
        </p>
        <div class="features-grid">
          <div class="feature">
            <h3>📱 Acceso 24/7</h3>
            <p>Consulta médica desde cualquier dispositivo, a cualquier hora del día</p>
          </div>
          <div class="feature">
            <h3>🔒 Seguridad HIPAA</h3>
            <p>Tus datos de salud están cifrados y protegidos según estándares internacionales</p>
          </div>
          <div class="feature">
            <h3>💻 Videollamada HD</h3>
            <p>Consultas por video de alta calidad con médicos certificados</p>
          </div>
          <div class="feature">
            <h3>📋 Recetas Digitales</h3>
            <p>Recibe recetas digitales directamente en tu farmacia</p>
          </div>
          <div class="feature">
            <h3>📊 Historia Clínica Digital</h3>
            <p>Acceso a tu historial completo de consultas y estudios</p>
          </div>
          <div class="feature">
            <h3>⚡ Sin Esperas</h3>
            <p>Consulta inmediata sin hacer fila en la sala de espera</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="benefits-section">
      <div class="container">
        <h2>Ventajas de la Consulta Médica Online</h2>

        <div class="benefit-card">
          <h3>🏥 Cobertura Médica Completa</h3>
          <p>
            Acceso a diferentes especialidades médicas: médicos generales, cardiólogos, dermatólogos,
            psicólogos, ginecólogos y más. Todos con matrícula verificada.
          </p>
        </div>

        <div class="benefit-card">
          <h3>⏰ Ahorro de Tiempo</h3>
          <p>
            Sin traslados, sin esperas. Una consulta médica online dura 15-30 minutos y podés hacerla
            desde tu casa, oficina o donde estés.
          </p>
        </div>

        <div class="benefit-card">
          <h3>💰 Más Económica</h3>
          <p>
            Consultas médicas online a menor costo que consultas presenciales. Sin gastos de traslado
            ni estacionamiento.
          </p>
        </div>

        <div class="benefit-card">
          <h3>🔒 Privacidad Garantizada</h3>
          <p>
            Conexión segura, cifrada, sin grabaciones sin consentimiento. Cumplimiento con Ley 25.326
            de Protección de Datos Personales de Argentina.
          </p>
        </div>

        <div class="benefit-card">
          <h3>👨‍⚕️ Profesionales Certificados</h3>
          <p>
            Todos nuestros médicos están registrados ante la Superintendencia de Servicios de Salud (SUSS)
            y poseen matrícula vigente en Argentina.
          </p>
        </div>

        <div class="benefit-card">
          <h3>📞 Continuidad de Atención</h3>
          <p>
            Seguimiento médico continuo. Acceso a registros previos, resultados de estudios y seguimiento
            de tratamientos.
          </p>
        </div>
      </div>
    </section>

    <!-- Legal Framework -->
    <section class="legal-section">
      <div class="container">
        <h2>Marco Legal en Argentina</h2>
        <p>
          La telemedicina en Argentina está respaldada por normativa nacional e internacional:
        </p>
        <ul class="legal-list">
          <li><strong>Ley 25.326:</strong> Protección de Datos Personales y medicina digital</li>
          <li><strong>Resolución 2301/2002:</strong> Marco legal para telemedicina en Argentina</li>
          <li><strong>Estándares HIPAA:</strong> Protección de datos de salud a nivel internacional</li>
          <li><strong>Colegio Médico de Argentina:</strong> Regulación de profesionales</li>
        </ul>
      </div>
    </section>

    <!-- Process Section -->
    <section class="process-section">
      <div class="container">
        <h2>Cómo Funciona una Consulta Médica Online</h2>
        <div class="steps">
          <div class="step">
            <span class="step-number">1</span>
            <h3>Registrate o Ingresa</h3>
            <p>Crea tu cuenta en AutaMedica en 2 minutos</p>
          </div>
          <div class="step">
            <span class="step-number">2</span>
            <h3>Busca un Médico</h3>
            <p>Elige entre cientos de profesionales certificados</p>
          </div>
          <div class="step">
            <span class="step-number">3</span>
            <h3>Reserva tu Turno</h3>
            <p>Selecciona fecha y hora disponible</p>
          </div>
          <div class="step">
            <span class="step-number">4</span>
            <h3>Videoconferencia</h3>
            <p>Consulta segura por video HD con el médico</p>
          </div>
          <div class="step">
            <span class="step-number">5</span>
            <h3>Receta y Seguimiento</h3>
            <p>Recibe receta digital e historial en tu perfil</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Specialties -->
    <section class="specialties-section">
      <div class="container">
        <h2>Especialidades Médicas Disponibles</h2>
        <div class="specialties-grid">
          <div class="specialty"><strong>Medicina General</strong></div>
          <div class="specialty"><strong>Cardiología</strong></div>
          <div class="specialty"><strong>Dermatología</strong></div>
          <div class="specialty"><strong>Psicología</strong></div>
          <div class="specialty"><strong>Ginecología</strong></div>
          <div class="specialty"><strong>Pediatría</strong></div>
          <div class="specialty"><strong>Neurology</strong></div>
          <div class="specialty"><strong>Nutrición</strong></div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">
        <h2>Preguntas Frecuentes sobre Telemedicina</h2>

        <div class="faq-item">
          <h3>¿Es segura una consulta médica online?</h3>
          <p>
            Sí. Las consultas en AutaMedica usan encriptación de nivel militar (TLS 1.3), cumplen
            con HIPAA y están reguladas por la legislación argentina. Tus datos están protegidos.
          </p>
        </div>

        <div class="faq-item">
          <h3>¿Cuál es el costo de una consulta médica virtual?</h3>
          <p>
            El precio varía según el especialista (típicamente entre $800 y $3000 ARS).
            No hay cargos adicionales ocultos.
          </p>
        </div>

        <div class="faq-item">
          <h3>¿Me atienden médicos de verdad?</h3>
          <p>
            Todos nuestros médicos son profesionales certificados con matrícula vigente en Argentina.
            Puedes verificar su cédula profesional antes de la consulta.
          </p>
        </div>

        <div class="faq-item">
          <h3>¿Qué necesito para una consulta online?</h3>
          <p>
            Solo necesitas: conexión a internet, un dispositivo con cámara (PC, tablet o smartphone),
            y un lugar privado para la consulta.
          </p>
        </div>

        <div class="faq-item">
          <h3>¿Puedo tener historia clínica digital?</h3>
          <p>
            Sí. En AutaMedica mantenemos tu historial completo: consultas, recetas, resultados de
            estudios y seguimiento de tratamientos.
          </p>
        </div>

        <div class="faq-item">
          <h3>¿Cómo funciona una receta digital?</h3>
          <p>
            El médico te envía la receta digital tras la consulta. Puedes enviarla a cualquier farmacia
            o descargarla en PDF para presentarla en persona.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Final -->
    <CTAFinal
      title="Comienza tu Consulta Médica Online Hoy"
      subtitle="Acceso a médicos certificados, recetas digitales e historia clínica en una plataforma segura."
      buttonLabel="Agendar Consulta"
      buttonHref="/auth/register"
    />
  </main>
  <Footer />
</Layout>

<style>
  .hero-section {
    padding: 6rem var(--section-px) 4rem;
    background: linear-gradient(135deg, rgba(0,0,0,0.8), rgba(6,78,140,0.3));
    border-bottom: 1px solid var(--au-border);
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
  }

  .hero-content {
    text-align: center;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 2rem;
    font-size: 0.875rem;
    color: #3b82f6;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: white;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .subtitle {
    font-size: 1.125rem;
    color: #a1a1a1;
    margin-bottom: 2rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-primary {
    background: white;
    color: black;
  }

  .btn-primary:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
  }

  .btn-secondary {
    border: 1px solid white;
    color: white;
  }

  .btn-secondary:hover {
    background: rgba(255,255,255,0.1);
  }

  .content-section,
  .benefits-section,
  .legal-section,
  .process-section,
  .specialties-section,
  .faq-section {
    padding: 4rem var(--section-px);
    border-bottom: 1px solid var(--au-border);
  }

  h2 {
    font-size: 2.25rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: white;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .feature {
    background: rgba(59, 130, 246, 0.05);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .feature h3 {
    font-size: 1.25rem;
    color: white;
    margin-bottom: 0.75rem;
  }

  .feature p {
    color: #a1a1a1;
    font-size: 0.95rem;
  }

  .benefit-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--au-border);
    border-radius: 0.75rem;
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .benefit-card h3 {
    font-size: 1.25rem;
    color: white;
    margin-bottom: 1rem;
  }

  .benefit-card p {
    color: #a1a1a1;
    line-height: 1.6;
  }

  .legal-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .legal-list li {
    padding: 1rem;
    background: rgba(59, 130, 246, 0.05);
    border-left: 3px solid #3b82f6;
    color: #a1a1a1;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .step {
    text-align: center;
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: #3b82f6;
    color: white;
    border-radius: 50%;
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    margin-left: auto;
    margin-right: auto;
  }

  .step h3 {
    font-size: 1.1rem;
    color: white;
    margin-bottom: 0.5rem;
  }

  .step p {
    color: #a1a1a1;
    font-size: 0.95rem;
  }

  .specialties-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .specialty {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    padding: 1.5rem;
    border-radius: 0.5rem;
    text-align: center;
    color: white;
    font-weight: 500;
  }

  .faq-item {
    margin-bottom: 2rem;
    background: rgba(255,255,255,0.02);
    padding: 1.5rem;
    border-radius: 0.5rem;
  }

  .faq-item h3 {
    font-size: 1.125rem;
    color: white;
    margin-bottom: 0.75rem;
  }

  .faq-item p {
    color: #a1a1a1;
    line-height: 1.6;
  }

  p {
    color: #a1a1a1;
    line-height: 1.6;
  }
</style>
