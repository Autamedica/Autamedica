---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';

const title = "AutaMedica | Telemedicina en Argentina: Calidad Médica Federal";
const description = "Plataforma de telemedicina líder en Argentina. Videoconsultas con médicos matriculados, receta digital ley 27.553 y cumplimiento estricto de protección de datos.";

const features = [
  {
    title: 'Cumplimiento Normativo',
    description: 'Nuestras recetas digitales y firmas electrónicas cumplen con la Ley 27.553 y son válidas en todo el territorio nacional.',
    icon: 'Shield'
  },
  {
    title: 'Cuerpo Médico Federal',
    description: 'Especialistas con matrículas nacionales y provinciales, garantizando atención de alta calidad en cada región.',
    icon: 'Users'
  },
  {
    title: 'Privacidad Garantizada',
    description: 'Protección estricta bajo la Ley 25.326 de Protección de Datos Personales e infraestructura bajo estándares internacionales de seguridad médica.',
    icon: 'Lock'
  }
];
---

<Layout title={title} description={description} canonical="https://www.autamedica.com/telemedicina-argentina">
  <Navbar />
  
  <main class="bg-white text-neutral-900 pt-32 pb-20">
    <!-- Institutional Header -->
    <header class="container mx-auto px-6 py-20 border-b border-neutral-100">
      <div class="max-w-4xl">
        <span class="text-[var(--au-accent)] font-bold text-[10px] tracking-[0.3em] uppercase mb-6 block">Cobertura Nacional Argentina</span>
        <h1 class="text-5xl md:text-7xl font-serif font-medium leading-tight tracking-tight text-neutral-950 mb-8">
          La nueva era de la <br/> 
          <span class="text-neutral-500 italic">salud federal.</span>
        </h1>
        <p class="text-xl text-neutral-600 max-w-2xl font-light leading-relaxed">
          AutaMedica redefine el acceso a la salud en Argentina, eliminando las distancias geográficas y garantizando una atención médica de excelencia mediante tecnología segura y validada.
        </p>
      </div>
    </header>

    <!-- Authority Grid -->
    <section class="container mx-auto px-6 py-24">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
        {features.map(f => (
          <div class="space-y-6 animate-reveal">
            <div class="w-12 h-12 rounded-xl bg-neutral-50 border border-neutral-100 flex items-center justify-center text-[var(--au-accent)]">
              {f.icon === 'Shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
              {f.icon === 'Users' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
              {f.icon === 'Lock' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>}
            </div>
            <h3 class="text-xl font-serif font-bold text-neutral-950">{f.title}</h3>
            <p class="text-neutral-600 leading-relaxed text-sm">{f.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Detailed Content: Law & Trust -->
    <section class="py-32 bg-neutral-50 border-y border-neutral-100">
      <div class="container mx-auto px-6">
        <div class="flex flex-col lg:flex-row gap-20 items-start">
          <div class="lg:w-1/2">
            <h2 class="text-4xl font-serif font-bold mb-10 leading-tight">Sustento Legal y <br/> <span class="text-neutral-500 italic">Transparencia.</span></h2>
            <div class="prose prose-neutral prose-lg text-neutral-600 space-y-6">
              <p>
                En cumplimiento con la <strong>Ley 27.553 de Recetas Electrónicas o Digitales</strong>, AutaMedica proporciona un entorno seguro donde el acto médico se documenta con integridad y validez jurídica. Nuestras prescripciones son emitidas con firmas electrónicas auditables, aceptadas por el sistema farmacéutico nacional.
              </p>
              <p>
                Asimismo, la plataforma opera bajo los lineamientos del <strong>Ministerio de Salud de la Nación</strong>, promoviendo la interoperabilidad de los datos y asegurando que la historia clínica del paciente sea tratada como un documento confidencial y sagrado.
              </p>
            </div>
          </div>
          
          <div class="lg:w-1/2 grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="p-10 bg-white border border-neutral-200 rounded-3xl">
              <div class="text-4xl font-serif font-bold text-neutral-950 mb-2">AR</div>
              <div class="text-[10px] uppercase tracking-widest text-neutral-400 font-bold">Protocolo Argentino</div>
            </div>
            <div class="p-10 bg-white border border-neutral-200 rounded-3xl">
              <div class="text-4xl font-serif font-bold text-neutral-950 mb-2">24/7</div>
              <div class="text-[10px] uppercase tracking-widest text-neutral-400 font-bold">Disponibilidad</div>
            </div>
            <div class="p-10 bg-white border border-neutral-200 rounded-3xl col-span-full">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-2 h-2 rounded-full bg-green-500"></div>
                <span class="text-xs font-bold uppercase tracking-widest text-neutral-400">Estado de la Red</span>
              </div>
              <div class="text-2xl font-serif text-neutral-950">Médicos de Guardia Activos en todas las Provincias</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Regional Coverage -->
    <section class="py-32">
      <div class="container mx-auto px-6 text-center">
        <h2 class="text-4xl font-serif font-bold mb-16">Salud accesible de Ushuaia a La Quiaca.</h2>
        <div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto">
          {['Buenos Aires', 'Córdoba', 'Santa Fe', 'Mendoza', 'Tucumán', 'Salta', 'Neuquén', 'Chubut', 'Entre Ríos', 'Misiones'].map(city => (
            <span class="px-6 py-3 rounded-full border border-neutral-100 bg-neutral-50 text-sm font-medium text-neutral-600">
              {city}
            </span>
          ))}
          <span class="px-6 py-3 rounded-full border border-neutral-950 bg-neutral-950 text-sm font-medium text-white">
            Cobertura Nacional Total
          </span>
        </div>
      </div>
    </section>

    <CTAFinal
      title="Inicie su consulta médica hoy."
      subtitle="Conecte con especialistas certificados en Argentina de forma inmediata y segura."
      buttonLabel="Acceder ahora"
      buttonHref="/auth/register"
    />
  </main>

  <Footer />
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap');

  main {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  h1, h2, h3, .font-serif {
    font-family: 'Source Serif 4', serif;
  }

  .animate-reveal {
    animation: reveal linear forwards;
    animation-timeline: view();
    animation-range: entry 5% cover 25%;
  }

  @keyframes reveal {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
