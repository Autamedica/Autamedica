---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CTAFinal from '../components/CTAFinal.astro';

const canonicalUrl = 'https://www.autamedica.com/videoconsulta-medica';

const faqItems = [
  {
    question: '¿Qué necesito para realizar una videoconsulta médica en AutaMedica?',
    answer:
      'Solo necesitás un dispositivo (celular, tablet o computadora) con cámara, micrófono y conexión a internet (4G, 5G o Wi-Fi). No es necesario descargar ni instalar aplicaciones adicionales: la videoconsulta se ejecuta de forma nativa y segura en tu navegador web mediante tecnología WebRTC.',
  },
  {
    question: '¿Por qué AutaMedica no utiliza WhatsApp o Zoom para las consultas?',
    answer:
      'Las aplicaciones comerciales de mensajería o videollamada no cumplen con los estándares de confidencialidad y trazabilidad clínica exigidos por la Ley 26.529 de Derechos del Paciente ni la Ley 25.326 de Protección de Datos Personales. AutaMedica utiliza una infraestructura WebRTC propietaria con cifrado DTLS-SRTP, consentimiento informado médico integrado y registro directo e inmutable en tu historia clínica digital.',
  },
  {
    question: '¿Las recetas digitales emitidas durante la videoconsulta son válidas en farmacias?',
    answer:
      'Sí. Todas las prescripciones emitidas en AutaMedica cumplen estrictamente con la Ley Nacional 27.553 de Recetas Electrónicas o Digitales y el Decreto Reglamentario 63. Cuentan con firma electrónica/digital auditable, código unívoco de identificación de receta (CUIR) y código de barras bidimensional, siendo reconocidas en farmacias de todo el territorio nacional.',
  },
  {
    question: '¿El médico puede indicarme estudios de laboratorio o imágenes?',
    answer:
      'Sí. Si durante la evaluación clínica el profesional determina la necesidad de análisis de sangre, orina, radiografías, ecografías u otros estudios complementarios, emitirá la orden médica digital correspondiente con firma digital, disponible en tu perfil de paciente en formato PDF descargable y verificable.',
  },
  {
    question: '¿Qué ocurre si la conexión a internet es inestable durante la llamada?',
    answer:
      'Nuestra plataforma WebRTC cuenta con codecs de compresión adaptativa de baja latencia (Opus y VP9/AV1) que priorizan la estabilidad del canal de audio clínico incluso ante fluctuaciones de ancho de banda o cobertura móvil en rutas y zonas periféricas.',
  },
  {
    question: '¿En qué casos NO debo utilizar una videoconsulta médica?',
    answer:
      'Ante situaciones de emergencia con riesgo de vida inminente —como dolor de pecho opresivo irradiado a cuello o brazo, dificultad respiratoria severa, parálisis o debilidad repentina en un lado del cuerpo, pérdida de conocimiento, traumatismos craneoencefálicos o hemorragias profusas—, debés comunicarte de inmediato con el 107 (SAME en CABA) o el servicio de emergencias médicas de tu localidad, o dirigirte a la guardia presencial más cercana.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Videoconsulta Médica en Vivo | Plataforma WebRTC Segura | AutaMedica',
      description:
        'Accedé a una videoconsulta médica en tiempo real con profesionales matriculados. Plataforma WebRTC encriptada sin descargas, historia clínica auditable y recetas digitales inmediatas.',
      inLanguage: 'es-AR',
      aspect: ['Diagnosis', 'Treatment', 'Overview'],
      medicalAudience: {
        '@type': 'MedicalAudience',
        audienceType: 'Patient',
      },
      about: [
        { '@type': 'MedicalSpecialty', name: 'PrimaryCare' },
        { '@type': 'MedicalSpecialty', name: 'Telemedicine' },
        { '@type': 'Thing', name: 'Videoconsulta médica' },
        { '@type': 'Thing', name: 'Receta digital oficial' },
      ],
      provider: {
        '@type': 'MedicalOrganization',
        name: 'AutaMedica',
        url: 'https://www.autamedica.com',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.autamedica.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Atención Médica',
          item: 'https://www.autamedica.com/consulta-medica-online',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Videoconsulta médica',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title="Videoconsulta Médica en Vivo | Plataforma WebRTC Segura | AutaMedica"
  description="Accedé a una videoconsulta médica en tiempo real con médicos matriculados. Plataforma WebRTC propietaria sin descargas, historia clínica unificada y recetas digitales con código CUIR."
  canonical={canonicalUrl}
  ogImage="/images/seo/og-main.webp"
  ogType="website"
  robots="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <Navbar />

  <main class="bg-white text-slate-900 pt-20">
    <!-- Breadcrumbs -->
    <nav class="border-b border-slate-100 bg-slate-50/60 py-3 text-xs text-slate-500" aria-label="Migas de pan">
      <div class="container mx-auto px-6 flex items-center gap-2">
        <a href="/" class="hover:text-sky-600 transition-colors">Inicio</a>
        <span class="text-slate-300">/</span>
        <a href="/consulta-medica-online" class="hover:text-sky-600 transition-colors">Atención Médica</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-800 font-medium">Videoconsulta médica</span>
      </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="relative py-16 md:py-24 border-b border-slate-100 overflow-hidden bg-gradient-to-b from-sky-50/40 via-white to-white">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-sky-100/70 border border-sky-200/80 text-sky-800 text-xs font-semibold tracking-wide uppercase">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Tecnología Clínica WebRTC Propietaria
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold text-slate-950 tracking-tight leading-[1.12]">
              Videoconsulta médica directa, segura y <span class="text-sky-600">sin instalaciones</span>.
            </h1>

            <p class="text-lg md:text-xl text-slate-600 font-normal leading-relaxed max-w-2xl">
              Conectate con médicos matriculados en vivo desde el navegador de tu teléfono o computadora. Sin demoras en salas de espera, con historia clínica digital versionada y recetas oficiales con código CUIR emitidas en el acto.
            </p>

            <!-- Key Proof Points -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
              <div class="flex items-center gap-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded-lg p-3 shadow-xs">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Cero descargas de apps</span>
              </div>
              <div class="flex items-center gap-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded-lg p-3 shadow-xs">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Cifrado DTLS-SRTP</span>
              </div>
              <div class="flex items-center gap-2 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded-lg p-3 shadow-xs">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Receta digital Ley 27.553</span>
              </div>
            </div>

            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 pt-4">
              <a href="/auth/register" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg bg-sky-600 text-white font-semibold text-base shadow-sm hover:bg-sky-700 transition-all transform hover:-translate-y-0.5">
                <span>Iniciar videoconsulta ahora</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
              <a href="/guardia-medica-online" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg border border-slate-300 bg-white text-slate-800 font-semibold text-base hover:bg-slate-50 hover:border-slate-400 transition-all">
                <span>Guardia médica 24hs</span>
              </a>
            </div>

            <p class="text-xs text-slate-500 pt-1">
              Atención médica clínica para adultos y pediatría ambulatoria. Matrículas validadas ante SISA y colegios médicos oficiales.
            </p>
          </div>

          <!-- Hero Graphic / UI Card -->
          <div class="lg:col-span-5">
            <div class="relative rounded-2xl border border-slate-200 bg-white p-6 shadow-xl space-y-5">
              <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-sky-100 text-sky-700 flex items-center justify-center font-bold text-sm">
                    AM
                  </div>
                  <div>
                    <h2 class="text-sm font-bold text-slate-900 leading-tight">Sala de Consulta WebRTC</h2>
                    <p class="text-xs text-emerald-600 flex items-center gap-1 font-medium">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Canal clínico cifrado activo
                    </p>
                  </div>
                </div>
                <span class="text-[11px] font-mono bg-slate-100 px-2 py-1 rounded text-slate-600">Latencia: 24ms</span>
              </div>

              <!-- Interactive Simulated Video Container -->
              <div class="relative rounded-xl overflow-hidden aspect-video bg-slate-950 flex flex-col justify-between p-4 border border-slate-800">
                <div class="flex justify-between items-start z-10">
                  <span class="bg-black/60 backdrop-blur-xs text-white text-[11px] px-2.5 py-1 rounded-md flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span> REC CLINICAL SESSION
                  </span>
                  <span class="bg-black/60 backdrop-blur-xs text-emerald-400 text-[11px] px-2.5 py-1 rounded-md font-mono">
                    DTLS 1.3 / SRTP
                  </span>
                </div>

                <div class="text-center my-auto">
                  <div class="w-14 h-14 mx-auto rounded-full bg-sky-900/60 border border-sky-400/40 flex items-center justify-center text-sky-200 mb-2">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <p class="text-xs text-slate-300 font-medium">Dra. M. Álvarez — Mat. Nac. 142.890</p>
                  <p class="text-[10px] text-slate-400">Especialista en Medicina Interna</p>
                </div>

                <div class="flex items-center justify-between z-10 pt-2 border-t border-white/10 text-white text-xs">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span class="text-[11px] text-slate-300">Historia Clínica Sincronizada</span>
                  </div>
                  <span class="text-[11px] text-sky-300 font-medium">AutaMedica Core v2.4</span>
                </div>
              </div>

              <!-- Output Pills -->
              <div class="grid grid-cols-2 gap-3 pt-1">
                <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
                  <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Receta Emitida</div>
                  <div class="text-xs font-bold text-slate-900 mt-0.5">CUIR: AR-2026-9812A</div>
                  <div class="text-[10px] text-emerald-600 mt-0.5 font-medium">Firma digital validada</div>
                </div>
                <div class="rounded-lg border border-slate-100 bg-slate-50 p-3">
                  <div class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Epicrisis</div>
                  <div class="text-xs font-bold text-slate-900 mt-0.5">Ficha digital encriptada</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">Acceso permanente</div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ETHICAL DIFFERENTIATION / EMERGENCY ALERT BOX -->
    <section class="py-8 bg-slate-50 border-b border-slate-200">
      <div class="container mx-auto px-6">
        <div class="rounded-xl border-2 border-red-200 bg-white p-6 md:p-8 shadow-xs flex flex-col md:flex-row items-start md:items-center gap-6">
          <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 text-red-600 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <div class="space-y-1.5 flex-1">
            <h2 class="text-lg font-bold text-slate-950 flex items-center gap-2">
              <span class="text-red-600 font-extrabold">Criterio Ético:</span> ¿Cuándo corresponde una videoconsulta y cuándo una guardia presencial?
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              La videoconsulta médica está indicada para cuadros ambulatorios leves y moderados, prescripción, orientación clínica y seguimiento. <strong>Si presentás dolor de pecho opresivo, falta de aire súbita, pérdida de conocimiento, parálisis facial o corporal, o traumatismos graves</strong>, no inicies una videollamada: comunicate de inmediato al <span class="font-bold text-slate-900">107 (SAME)</span> o concurrí a un centro de emergencias con shockroom.
            </p>
          </div>
          <div class="shrink-0">
            <a href="tel:107" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-red-300 bg-red-50 text-red-700 text-xs font-bold hover:bg-red-100 transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>Emergencias: 107</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- WEBRTC CLINICAL SUPERIORITY (COMPARISON TABLE) -->
    <section class="py-20 md:py-28 bg-white border-b border-slate-100">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
          <span class="text-sky-600 font-bold text-xs uppercase tracking-widest">Seguridad Informática y Rigor Clínico</span>
          <h2 class="text-3xl md:text-5xl font-serif font-bold text-slate-950 tracking-tight">
            Por qué una videoconsulta médica real <br class="hidden sm:inline"/> no puede hacerse por WhatsApp o Zoom.
          </h2>
          <p class="text-base md:text-lg text-slate-600 leading-relaxed">
            Una llamada convencional no es un acto médico formal. AutaMedica fue desarrollada desde cero para cumplir con la legislación sanitaria, la privacidad de datos de salud y la validez legal del diagnóstico.
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse border border-slate-200 rounded-xl overflow-hidden shadow-xs">
            <thead>
              <tr class="bg-slate-900 text-white text-sm">
                <th class="py-4 px-6 font-semibold w-1/3">Parámetro Clínico & Tecnológico</th>
                <th class="py-4 px-6 font-semibold w-1/3 bg-sky-900/80 border-x border-sky-800">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span>AutaMedica WebRTC Propietaria</span>
                  </div>
                </th>
                <th class="py-4 px-6 font-semibold w-1/3 text-slate-400">WhatsApp / Zoom / Genéricas</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-sm">
              <tr class="hover:bg-slate-50/50">
                <td class="py-4 px-6 font-medium text-slate-900">Instalación y acceso</td>
                <td class="py-4 px-6 text-sky-900 bg-sky-50/40 font-semibold border-x border-slate-200">
                  Cero descargas. Acceso seguro con un clic desde cualquier navegador web.
                </td>
                <td class="py-4 px-6 text-slate-600">Requiere descargar apps pesadas, registrar números personales y cuentas.</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="py-4 px-6 font-medium text-slate-900">Historia Clínica Digital (Ley 26.529)</td>
                <td class="py-4 px-6 text-sky-900 bg-sky-50/40 font-semibold border-x border-slate-200">
                  Integrada en tiempo real. Evolución médica inmutable y confidencial.
                </td>
                <td class="py-4 px-6 text-slate-600">Inexistente. Los datos quedan dispersos en chats informales no auditables.</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="py-4 px-6 font-medium text-slate-900">Receta Electrónica Oficial (Ley 27.553)</td>
                <td class="py-4 px-6 text-sky-900 bg-sky-50/40 font-semibold border-x border-slate-200">
                  Código CUIR oficial y firma electrónica registrada ante Ministerio de Salud.
                </td>
                <td class="py-4 px-6 text-slate-600">Envío de fotos o PDFs sueltos sin validez en mostrador farmacéutico.</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="py-4 px-6 font-medium text-slate-900">Consentimiento informado médico</td>
                <td class="py-4 px-6 text-sky-900 bg-sky-50/40 font-semibold border-x border-slate-200">
                  Protocolizado digitalmente antes de ingresar a la sesión con validez legal.
                </td>
                <td class="py-4 px-6 text-slate-600">No contemplado. Expone al paciente y al médico a vacío normativo.</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="py-4 px-6 font-medium text-slate-900">Cifrado de extremo a extremo</td>
                <td class="py-4 px-6 text-sky-900 bg-sky-50/40 font-semibold border-x border-slate-200">
                  DTLS-SRTP médico con destrucción de buffer temporal post-sesión.
                </td>
                <td class="py-4 px-6 text-slate-600">Servidores comerciales sujetos a políticas corporativas de retención de metadatos.</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="py-4 px-6 font-medium text-slate-900">Órdenes de estudios e interconsultas</td>
                <td class="py-4 px-6 text-sky-900 bg-sky-50/40 font-semibold border-x border-slate-200">
                  Emisión instantánea con código verificable para laboratorios y centros de diagnóstico.
                </td>
                <td class="py-4 px-6 text-slate-600">Improvisación en mensajes de texto frecuentemente rechazados.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- CLINICAL CAPABILITIES / CUADROS ATENDIBLES -->
    <section class="py-20 md:py-28 bg-slate-50 border-b border-slate-100">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
          <span class="text-sky-600 font-bold text-xs uppercase tracking-widest">Alcance Ambulatorio</span>
          <h2 class="text-3xl md:text-5xl font-serif font-bold text-slate-950 tracking-tight">
            ¿Qué motivos de consulta podés resolver por videoconsulta médica?
          </h2>
          <p class="text-base md:text-lg text-slate-600 leading-relaxed">
            Más del 85% de las inquietudes clínicas cotidianas pueden ser evaluadas, diagnosticadas y tratadas de forma remota por un profesional calificado.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
          
          <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-3 shadow-xs hover:border-sky-300 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold">
              01
            </div>
            <h3 class="text-lg font-bold text-slate-950">Medicina General & Familiar</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Fiebre, odinofagia (dolor de garganta), resfríos, rinitis, cuadros gripales, malestar digestivo leve y evaluación clínica integral.
            </p>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-3 shadow-xs hover:border-sky-300 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold">
              02
            </div>
            <h3 class="text-lg font-bold text-slate-950">Recetas Digitales y Renovaciones</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Continuidad de tratamientos crónicos (hipertensión, diabetes, hipotiroidismo) y prescripciones con firma digital oficial CUIR.
            </p>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-3 shadow-xs hover:border-sky-300 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold">
              03
            </div>
            <h3 class="text-lg font-bold text-slate-950">Dermatología & Lesiones de Piel</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Exantemas, urticarias, picaduras, dermatitis de contacto, acné y seguimiento visual de lesiones cutáneas en alta definición.
            </p>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-3 shadow-xs hover:border-sky-300 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold">
              04
            </div>
            <h3 class="text-lg font-bold text-slate-950">Salud Mental & Contención</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Trastornos de ansiedad, cuadros de estrés agudo, insomnio, ataques de pánico y derivación coordinada a psiquiatría o psicología.
            </p>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-3 shadow-xs hover:border-sky-300 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold">
              05
            </div>
            <h3 class="text-lg font-bold text-slate-950">Lectura e Interpretación de Estudios</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Análisis clínicos de laboratorio, radiografías, ecografías, tomografías y electrocardiogramas con orientación médica clara.
            </p>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-6 space-y-3 shadow-xs hover:border-sky-300 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center font-bold">
              06
            </div>
            <h3 class="text-lg font-bold text-slate-950">Certificados y Órdenes Médicas</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Emisión de órdenes para estudios complementarios, certificados de reposo laboral con criterio clínico y constancias de atención.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- STEP BY STEP PROCESS -->
    <section class="py-20 md:py-28 bg-white border-b border-slate-100">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
          <span class="text-sky-600 font-bold text-xs uppercase tracking-widest">Simplicidad de Acceso</span>
          <h2 class="text-3xl md:text-5xl font-serif font-bold text-slate-950 tracking-tight">
            Cómo acceder a tu videoconsulta médica en 4 pasos
          </h2>
          <p class="text-base md:text-lg text-slate-600 leading-relaxed">
            Sin barreras burocráticas ni salas de espera abarrotadas. Diseñado para darte una respuesta médica certera en minutos.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 max-w-6xl mx-auto">
          
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-lg">
              1
            </div>
            <h3 class="text-lg font-bold text-slate-950">Registro y Triaje</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Ingresás con tu correo o DNI y completás un breve cuestionario con tus síntomas y antecedentes relevantes.
            </p>
          </div>

          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-lg">
              2
            </div>
            <h3 class="text-lg font-bold text-slate-950">Sala de Espera Segura</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Verificás cámara y micrófono en nuestro Green Room. Nuestro sistema asigna al médico disponible con menor tiempo de espera.
            </p>
          </div>

          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-lg">
              3
            </div>
            <h3 class="text-lg font-bold text-slate-950">Videoconsulta WebRTC</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Conversás cara a cara con el médico matriculado en alta definición, quien examina tu cuadro y responde tus dudas.
            </p>
          </div>

          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-lg">
              4
            </div>
            <h3 class="text-lg font-bold text-slate-950">Receta y Documentos</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Al finalizar, recibís en tu portal la receta electrónica oficial, la orden de estudios y el informe de la consulta.
            </p>
          </div>

        </div>

        <div class="text-center mt-12">
          <a href="/auth/register" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg bg-sky-600 text-white font-semibold text-base shadow-sm hover:bg-sky-700 transition-all">
            <span>Iniciar mi consulta médica ahora</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-20 md:py-28 bg-slate-50 border-b border-slate-100" id="faq">
      <div class="container mx-auto px-6 max-w-4xl">
        <div class="text-center space-y-4 mb-14">
          <span class="text-sky-600 font-bold text-xs uppercase tracking-widest">Preguntas Frecuentes</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-950 tracking-tight">
            Dudas habituales sobre la videoconsulta médica
          </h2>
          <p class="text-slate-600 text-sm md:text-base">
            Información transparente sobre el funcionamiento técnico y legal de nuestras consultas online.
          </p>
        </div>

        <div class="space-y-4">
          {faqItems.map((item) => (
            <details class="group rounded-xl border border-slate-200 bg-white p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-bold text-slate-900 text-base">
                <span>{item.question}</span>
                <span class="shrink-0 rounded-full p-1.5 text-slate-400 group-open:rotate-180 transition-transform">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </span>
              </summary>
              <p class="mt-4 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- RELATED INTENT LINKS -->
    <section class="py-14 bg-white border-b border-slate-100">
      <div class="container mx-auto px-6 max-w-5xl">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-6 text-center">Servicios Clínicos Relacionados</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <a href="/guardia-medica-online" class="p-3 rounded-lg border border-slate-200 hover:border-sky-500 hover:text-sky-600 transition-colors text-sm font-medium text-slate-700">
            Guardia Médica 24hs
          </a>
          <a href="/consulta-medica-en-farmacia" class="p-3 rounded-lg border border-slate-200 hover:border-sky-500 hover:text-sky-600 transition-colors text-sm font-medium text-slate-700">
            Consulta en Farmacia
          </a>
          <a href="/receta-electronica" class="p-3 rounded-lg border border-slate-200 hover:border-sky-500 hover:text-sky-600 transition-colors text-sm font-medium text-slate-700">
            Receta Electrónica Ley 27.553
          </a>
          <a href="/especialidades" class="p-3 rounded-lg border border-slate-200 hover:border-sky-500 hover:text-sky-600 transition-colors text-sm font-medium text-slate-700">
            Especialidades Médicas
          </a>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <CTAFinal
      title="Tu salud, sin esperas ni burocracia."
      subtitle="Conectate con un médico matriculado en este instante y recibí tu diagnóstico y receta digital con validez nacional."
      buttonLabel="Comenzar videoconsulta médica"
      buttonHref="/auth/register"
    />
  </main>

  <Footer />
</Layout>
