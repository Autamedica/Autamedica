---
import Layout from '@/layouts/Layout.astro';
import { RealVideoCall } from '@/components/patients/telemedicine/RealVideoCall';

const { roomId } = Astro.params;
const title = `Videollamada | AutaMedica`;
const description = 'Videollamada con tu médico';
---

<Layout title={title} description={description} robots="noindex, nofollow, noarchive">
  <main class="page-shell">
    <RealVideoCall client:load roomId={roomId!} />
  </main>
</Layout>

<style>
  .page-shell {
    position: fixed;
    inset: 0;
    padding: 0;
    margin: 0;
    background: #0a0a0a;
  }
</style>
