---
import CallLayout from '@/layouts/CallLayout.astro';
import PatientCallPage from '@/components/patients/calls/PatientCallPage';

const { roomId } = Astro.params;
const title = 'Videollamada | AutaMedica';
const description = 'Videollamada con tu médico';
---

<CallLayout title={title} description={description}>
  <PatientCallPage client:load roomId={roomId!} />
</CallLayout>
