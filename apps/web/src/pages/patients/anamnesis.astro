---
import Layout from '@/layouts/Layout.astro';

const title = 'Anamnesis | AutaMedica';
const description = 'Completa tu historia clínica';
---

<Layout title={title} description={description} robots="noindex, nofollow, noarchive">
  <main class="page-shell">
    <section class="empty-state">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      <h1>Anamnesis</h1>
      <p>Sin datos disponibles. Tu formulario de anamnesis estará disponible cuando completes el proceso de onboarding.</p>
      <a href="/patients/dashboard" class="back-link">Volver al panel</a>
    </section>
  </main>
</Layout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: clamp(2rem, 4vh, 3rem) var(--section-px) var(--space-16);
    background: var(--au-bg);
  }

  .empty-state {
    max-width: 520px;
    margin: clamp(3rem, 8vh, 6rem) auto 0;
    text-align: center;
    color: var(--au-text-secondary);
  }

  .empty-icon {
    color: var(--au-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .empty-state h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    color: var(--au-text-primary);
  }

  .empty-state p {
    margin: 0 0 var(--space-6);
    line-height: 1.6;
    font-size: var(--text-sm);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--au-border-hover);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--au-text-primary);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .back-link:hover {
    border-color: var(--au-accent);
    background: rgba(16, 185, 129, 0.08);
  }
</style>
