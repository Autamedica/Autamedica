---
import Layout from '../../layouts/Layout.astro';
import MedicalHistoryPage from '../../components/patients/MedicalHistoryPage';
---

<Layout
  title="Historial médico | AutaMedica"
  description="Resumen de eventos clínicos y continuidad de atención en el portal de pacientes."
  canonical="https://www.autamedica.com/patients/history"
  robots="noindex, nofollow, noarchive"
>
  <main class="page-shell">
    <MedicalHistoryPage client:load />
  </main>
</Layout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: clamp(2rem, 4vh, 3rem) var(--section-px) var(--space-16);
    background: var(--au-bg);
  }
</style>
