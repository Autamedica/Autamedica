---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Salud Reproductiva | AutaMedica"
  description="Información y recursos sobre salud reproductiva."
  robots="noindex, nofollow, noarchive"
>
  <main class="page-shell">
    <section class="empty-state">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-icon"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <h1>Salud Reproductiva</h1>
      <p>Sin datos disponibles. Los recursos de salud reproductiva estarán disponibles próximamente.</p>
      <a href="/patients/dashboard" class="back-link">Volver al panel</a>
    </section>
  </main>
</Layout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: clamp(2rem, 4vh, 3rem) var(--section-px) var(--space-16);
    background: var(--au-bg);
  }

  .empty-state {
    max-width: 520px;
    margin: clamp(3rem, 8vh, 6rem) auto 0;
    text-align: center;
    color: var(--au-text-secondary);
  }

  .empty-icon {
    color: var(--au-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .empty-state h1 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    color: var(--au-text-primary);
  }

  .empty-state p {
    margin: 0 0 var(--space-6);
    line-height: 1.6;
    font-size: var(--text-sm);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--au-border-hover);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--au-text-primary);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .back-link:hover {
    border-color: var(--au-accent);
    background: rgba(16, 185, 129, 0.08);
  }
</style>
