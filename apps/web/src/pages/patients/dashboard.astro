---
import Layout from '@/layouts/Layout.astro';
import PatientsHomePage from '@/components/patients/PatientsHomePage';

const title = 'Panel de Paciente | AutaMedica';
const description = 'Portal de videoconsultas y gestión de salud para pacientes';
const locale = Astro.locals.locale ?? 'es';
---

<Layout title={title} description={description}>
  <PatientsHomePage client:load locale={locale} />
</Layout>
