{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.astro",
    ".astro/types.d.ts",
    ".storybook/*.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../packages/types" },
    { "path": "../../packages/shared" },
    { "path": "../../packages/auth" },
    { "path": "../../packages/telemedicine" },
    { "path": "../../packages/hooks" }
  ]
}
