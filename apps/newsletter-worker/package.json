{
  "name": "@autamedica/newsletter-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test-send": "wrangler dev --test-scheduled",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit && node --check scripts/sync-newsletter-audience.mjs && node --test scripts/sync-newsletter-audience.test.mjs",
    "sync-audience": "node scripts/sync-newsletter-audience.mjs",
    "sync-audience:apply": "node scripts/sync-newsletter-audience.mjs --apply"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260401.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  }
}
