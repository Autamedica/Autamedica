{
  "name": "@autamedica/scheduling",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openclaw": {
      "types": "./dist/openclaw.d.ts",
      "default": "./dist/openclaw.js"
    },
    "./reminder-worker": {
      "types": "./dist/reminder-worker.d.ts",
      "default": "./dist/reminder-worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist *.tsbuildinfo && tsc --build tsconfig.build.json --force",
    "dev": "tsc --build --watch tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@autamedica/types": "workspace:*",
    "@autamedica/shared": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "@autamedica/typescript-config": "workspace:*",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.2"
  }
}
