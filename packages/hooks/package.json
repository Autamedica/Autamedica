{
  "name": "@autamedica/hooks",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist *.tsbuildinfo && tsc --build tsconfig.build.json",
    "dev": "tsc --build --watch tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@supabase/supabase-js": "^2.98.0"
  },
  "dependencies": {
    "@autamedica/types": "workspace:*",
    "@autamedica/shared": "workspace:*",
    "@autamedica/telemedicine": "workspace:*"
  },
  "devDependencies": {
    "@autamedica/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^19.1.0",
    "happy-dom": "^18.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0"
  }
}
