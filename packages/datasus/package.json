{
  "name": "@autamedica/datasus",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/mtls.d.ts",
      "default": "./dist/node/mtls.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist .tsbuildinfo && tsup && tsc --build tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "devDependencies": {
    "@autamedica/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "rimraf": "^5.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@autamedica/shared": "workspace:*",
    "@autamedica/types": "workspace:*",
    "@supabase/supabase-js": "^2.48.1"
  }
}